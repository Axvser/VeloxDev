<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Demo.ViewModels"
        xmlns:cmd="using:Demo.Commands"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
        x:Class="Demo.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Demo">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16">
            <TextBlock Text="VeloxDev MVVM Demo" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="{Binding Greeting}" FontSize="16"/>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="增加" Command="{Binding PlusCommand}"/>
                <Button Content="减少" Command="{Binding MinusCommand}"/>
            </StackPanel>

            <Border Padding="16" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock Text="INotifyCollectionChanged 新特性演示" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CollectionStatus}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding CollectionTrace}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedItemSummary}"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="添加项" Command="{Binding AddItemCommand}"/>
                        <Button Content="移除选中" Command="{Binding RemoveSelectedItemCommand}"/>
                        <Button Content="末项移到首位" Command="{Binding MoveLastToFirstCommand}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="替换整个集合" Command="{Binding ReplaceItemsCommand}"/>
                        <Button Content="清空集合" Command="{Binding ClearItemsCommand}"/>
                    </StackPanel>

                    <ListBox Height="220"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem}"/>
                </StackPanel>
            </Border>

            <Border Padding="16" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock Text="命令签名画廊" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap"
                               Text="每个按钮是一条生成出来的命令。灰掉的按钮是它们各自的校验回调返回了 false：HandleNote 要求 Weight &gt; 0，NotifyWeight 要求 &gt; 0，GetStoreCommand&lt;T&gt;() 要求实参非 null。"/>
                    <ItemsControl ItemsSource="{Binding Gallery.Samples}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="cmd:CommandSample">
                                <Button Margin="0,0,8,8" Padding="12,6"
                                        Content="{Binding Name}"
                                        Command="{Binding Command}"
                                        CommandParameter="{Binding Parameter}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ListBox Height="200" ItemsSource="{Binding Gallery.Log}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</Window>