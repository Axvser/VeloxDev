<Project Sdk="Microsoft.NET.Sdk">

  <!--
    采样器一致性测试：把七个适配器注册的每一个采样器都对着闭式解验一遍。
    与同目录的 VeloxDev.AT 分开是有意的 —— 那个工程驱动真实 demo，刻意保持零工作负载依赖；
    这一个为了能加载全部适配器，必须接受 WinUI/MAUI 的 SDK 与工作负载，代价不该传染给验收套件。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);MSTEST0032;MSTEST0037;CS0067;MSTEST0001</NoWarn>
    <!-- 桌面 SDK 的隐式 using 集不含 System.IO，而这个工程要读文件做基线比对。 -->
    <IsPackable>false</IsPackable>
    <!-- 被引用的 MAUI 适配器已经带了 Microsoft.Maui.Controls，不需要这里再显式列一次。 -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
    <ProjectReference Include="../../../../Src/Core/VeloxDev.Core/VeloxDev.Core.csproj" />
    <ProjectReference Include="../../../../Src/Adapters/VeloxDev.WPF/VeloxDev.WPF.csproj" />
    <ProjectReference Include="../../../../Src/Adapters/VeloxDev.WinForms/VeloxDev.WinForms.csproj" />
    <ProjectReference Include="../../../../Src/Adapters/VeloxDev.Avalonia/VeloxDev.Avalonia.csproj" />
    <ProjectReference Include="../../../../Src/Adapters/VeloxDev.Razor/VeloxDev.Razor.csproj" />
    <ProjectReference Include="../../../../Src/Adapters/VeloxDev.Jalium/VeloxDev.Jalium.csproj" />
    <ProjectReference Include="../../../../Src/Adapters/VeloxDev.WinUI/VeloxDev.WinUI.csproj" />
    <ProjectReference Include="../../../../Src/Adapters/VeloxDev.MAUI/VeloxDev.MAUI.csproj" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
