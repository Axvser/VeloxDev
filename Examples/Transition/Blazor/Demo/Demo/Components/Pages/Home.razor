@page "/"
@rendermode InteractiveServer

<PageTitle>VeloxDev Transition — Blazor Demo</PageTitle>

<div class="demo-root">
    <h2 class="demo-title">VeloxDev Transition · Blazor</h2>
    <p class="demo-desc">
        VeloxDev 动画的核心概念是 <strong>"一切皆状态"</strong>。
        动画直接作用于 C# 对象的属性，Blazor 通过 PropertyChanged 驱动 UI 重渲染。
    </p>

    <!-- data-at 是验收套件的把手：七个加载模式按钮与过冲区用同一套 token 命名，跨平台一致。 -->
    <div class="demo-toolbar">
        <button class="btn btn-primary" data-at="over.btn.load.main" @onclick="LoadMainThread">主线程互斥</button>
        <button class="btn btn-dark" data-at="over.btn.load.background" @onclick="LoadAnimations">后台线程互斥</button>
        <button class="btn btn-success" data-at="over.btn.load.main.concurrent" @onclick="LoadMainThreadNonMutual">主线程并发</button>
        <button class="btn btn-info" data-at="over.btn.load.background.concurrent" @onclick="LoadAnimationsNonMutual">后台线程并发</button>
        <button class="btn btn-warning" data-at="over.btn.load.repeat" @onclick="LoadRepeatedMutual">连续互斥</button>
        <button class="btn btn-secondary" data-at="over.btn.reset.all" @onclick="ResetBox0">重置</button>
        <button class="btn btn-danger" data-at="over.btn.stop.all" @onclick="ExitAnimations">停止全部</button>
    </div>

    <div class="demo-stage">
        <!-- Box0: simple animation — translate + color + opacity -->
        <div class="box-row">
            <span class="box-label">Box0 · 位移 + 颜色 + 透明度</span>
            <div class="box-track">
                <div class="box" style="@Box0.Style"></div>
            </div>
        </div>

        <!-- Box1: delayed animation — rotate + scale after a 2s wait -->
        <div class="box-row">
            <span class="box-label">Box1 · 延迟 2s · 旋转 + 缩放</span>
            <div class="box-track">
                <div class="box" style="@Box1.Style"></div>
            </div>
        </div>

        <!-- Box2: combined animation — move first, wait, then recolor + shrink -->
        <div class="box-row">
            <span class="box-label">Box2 · 拼接 · 移动 → 等待 → 变色 + 缩小</span>
            <div class="box-track">
                <div class="box" style="@Box2.Style"></div>
            </div>
        </div>
    </div>

    <!-- 过冲演示区：四个并排目标互不干扰，Back 与 Elastic、颜色与尺寸可在同一次运行里对比。
         缓动曲线越过 1 时数值会冲过目标再回弹，这只有读数才看得出来。 -->
    <div class="over-strip-wrap">
        <div class="over-strip">
            <div class="over-cell">
                <span class="over-cell-label">Over0 · 位移 X（Back / Elastic）</span>
                <div class="box over-box" style="@Over0.Style"></div>
            </div>
            <div class="over-cell">
                <span class="over-cell-label">Over1 · 颜色（余量）</span>
                <div class="box over-box" style="@Over1.Style"></div>
            </div>
            <div class="over-cell">
                <span class="over-cell-label">Over2 · 宽度</span>
                <div class="box over-box" style="@Over2.Style"></div>
            </div>
            <div class="over-cell">
                <span class="over-cell-label">Over3 · 颜色（饱和）</span>
                <div class="box over-box" style="@Over3.Style"></div>
            </div>
        </div>
    </div>

    <!-- data-at 是验收套件的把手：Playwright 选 token 而不选中文文案，token 与语言无关且稳定，
         标签保持读者预期的样子。Blazor 端不加 id，一律走 data-at。 -->
    <div class="over-toolbar">
        <button class="btn btn-primary" data-at="over.btn.back" @onclick="OverShootScalarBack">位移 Back.Out</button>
        <button class="btn btn-primary" data-at="over.btn.elastic" @onclick="OverShootScalarElastic">位移 Elastic.Out</button>
        <button class="btn btn-success" data-at="over.btn.color" @onclick="OverShootColor">颜色过冲</button>
        <button class="btn btn-info" data-at="over.btn.size" @onclick="OverShootSize">尺寸过冲</button>
        <button class="btn btn-warning" data-at="over.btn.brush" @onclick="OverShootSaturate">颜色饱和</button>
        <button class="btn btn-secondary" data-at="over.btn.reset" @onclick="OverShootReset">重置过冲</button>
    </div>

    <div class="over-readout" data-at="over.readout">@_readoutSnapshot</div>

    <!-- 读数的机器可读孪生体：同一支定时器、同一次采样，但用固定的 key=value 载荷而不是散文，
         测试就不必去解析一份随时可能被重新排版的版式。 -->
    <div class="over-state" data-at="over.state">@_stateSnapshot</div>

    <!-- 采样器演示台：被写对象就是 StringSampler 写出的那个 CSS 颜色，直接当背景色用。 -->
    <!-- 令牌挂在**真正着色的那个 div** 上而不是外层容器：浏览器里"真实 UI 表现"就是计算样式，
         验收要读的是这个元素的 background-color，挂在容器上会读到全透明。 -->
    <div class="over-buttons">
        <div data-at="over.bench"
             style="width:64px;height:40px;border-radius:4px;border:1px solid #444;background-color:@_benchColor"></div>
    </div>

    <!-- 采样器一致性把手：一条采样器一个按钮，点一下跑那一条、把结果写进下面的载荷。
         把手与探针表同源，所以加一条采样器只需要改 SamplerProbe 一处。 -->
    <div class="over-buttons">
        @foreach (var sampler in Demo.Models.SamplerProbe.SamplerNames)
        {
            var name = sampler;
            <button class="btn btn-secondary" data-at="over.sampler.@name" @onclick="() => RunSamplerProbe(name)">@name</button>
        }
    </div>

    <!-- 采样器一致性载荷：与 over.state 同一套 key=value 形状，外加一个证明这次点击落地的 seq。 -->
    <div class="over-state" data-at="over.conf">@_confSnapshot</div>

    <div class="demo-tips">
        <p><code>Snapshot()</code> — 记录显式指定的属性路径（初始状态）</p>
        <p><code>SnapshotAll()</code> — 自动发现并记录当前对象中所有可动画的属性</p>
        <p><code>Transition.Exit()</code> — 终止对象持有的动画</p>
        <p>
            <code>Eases.Back.Out</code> / <code>Eases.Elastic.Out</code> — 实测峰值 1.100 / 1.373，会越过目标再回弹；
            读数显示的是目标的真实属性（由 50ms 定时器采样，不是 effect 事件——流水线每段都会 Clone effect）。<br />
            Razor 适配器只注册了 <code>string</code> 采样器（CSS 颜色），没有刷子对象，因此「非纯色刷」场景
            以「颜色饱和」替代：让红通道撞上 255，验证共享进度在边界停住而不是回绕
            （无钳位时 58+188×1.088≈263 会被裸转成 7）。
        </p>
    </div>
</div>

<style>
    .demo-root {
        padding: 1.5rem;
        background: #121212;
        min-height: 100vh;
        color: #e0e0e0;
    }
    .demo-title { color: #80cbc4; margin-bottom: .4rem; }
    .demo-desc  { color: #9e9e9e; margin-bottom: 1.2rem; font-size: .95rem; }
    .demo-toolbar { display: flex; gap: .75rem; margin-bottom: 2rem; flex-wrap: wrap; }
    .demo-stage { display: flex; flex-direction: column; gap: 1.5rem; }
    .box-row { display: flex; flex-direction: column; gap: .4rem; }
    .box-label { font-size: .8rem; color: #757575; letter-spacing: .04em; }
    /* 与过冲区同尺度：方块 60x60（见 Home.razor.cs 的 BoxStripWidth/Height），轨道留 10px 上下边距。 */
    .box-track {
        position: relative;
        height: 80px;
        background: #1e1e1e;
        border-radius: 8px;
        overflow: hidden;
    }
    .box {
        position: absolute;
        top: 10px;
        left: 10px;
        border-radius: 6px;
        transition: none; /* Fully controlled by VeloxDev; CSS transition disabled */
    }
    /* 过冲区：窄窗口横向滚动，避免四格被挤变形 */
    .over-strip-wrap { margin-top: 2rem; overflow-x: auto; }
    .over-strip { display: flex; gap: 1rem; }
    .over-cell {
        position: relative;
        flex: 1 1 0;
        min-width: 400px; /* 容得下 60px 的方块平移 220px（Elastic 峰值约 302px）后仍留在本格内 */
        height: 120px;
        background: #1e1e1e;
        border-radius: 8px;
        overflow: hidden;
    }
    .over-cell-label {
        position: absolute;
        top: .45rem;
        left: .7rem;
        font-size: .72rem;
        color: #757575;
        letter-spacing: .04em;
    }
    .over-box { top: 2.6rem; left: .5rem; }
    .over-toolbar { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: 1rem; }
    .over-readout {
        margin-top: .75rem;
        padding: .75rem 1rem;
        background: #1e1e1e;
        border-radius: 8px;
        font-family: Consolas, "Courier New", monospace;
        font-size: .85rem;
        line-height: 1.8;
        color: #cccccc;
        white-space: pre-wrap;
    }
    /* 载荷：同一批值的固定 key=value 版本，字号压小，与人类读数区分 */
    .over-state {
        margin-top: .25rem;
        padding: .5rem .75rem;
        background: #1e1e1e;
        border-radius: 8px;
        font-family: Consolas, "Courier New", monospace;
        font-size: .72rem;
        color: #808080;
        word-break: break-all;
    }
    .demo-tips {
        margin-top: 2rem;
        padding: 1rem 1.25rem;
        background: #1e1e1e;
        border-radius: 8px;
        font-size: .88rem;
        line-height: 1.8;
    }
    .demo-tips p { margin: 0; }
    .demo-tips code { color: #80cbc4; }
</style>
