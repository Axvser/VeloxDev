<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Demo"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Demo">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <!-- 窗口的高度是屏幕给的：内容再高它也不会跟着长，实测这一档只给到约 707 逻辑像素。所以下面的固定行都取
             够用即可，省出来的高度留给演示台和把手条；否则最后几行会落到窗口外 —— 落在窗外的控件 UIA 照样点得到，
             人却看不见，而那正是这块演示台要消掉的那种错觉。

             加载模式那一排按钮（第 0 行）必须是 Auto 而不是星号：星号拿的是"固定行与 Auto 行分完之后剩下的"，
             而演示台和把手条那一行就要 ~335 逻辑像素，剩下的分到四个星号行只有 ~27 —— 两排共 84 像素的按钮排在
             那里，第二排（连续互斥/重置/停止全部）会被整个挤出窗口外，UIA 照样点得到，人却看不见。Auto 让这一行
             永远拿到它声明的高度，缺口由下面三个纯间隔的星号行吸收（它们本来就是空的）。
             过冲条那一行同理：格子 80x60 加上 Grid 的 6 边距正好 72，多出来的 24 像素没有内容，让给间隔行。 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="60"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="60"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="60"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="72"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <!-- AutomationProperties.AutomationId 是验收套件抓取这些控件的把手：测试永远不匹配中文标签，
             token 与语言无关且稳定，标签则保持读者预期的样子。七个平台用的是同一组 token。 -->
        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Button Width="118" Height="38" Margin="2" AutomationProperties.AutomationId="over.btn.load.main"
                        Content="主线程互斥" Click="LoadMainThread"/>
                <Button Width="118" Height="38" Margin="2" AutomationProperties.AutomationId="over.btn.load.background"
                        Content="后台线程互斥" Click="LoadAnimations"/>
                <Button Width="118" Height="38" Margin="2" AutomationProperties.AutomationId="over.btn.load.main.concurrent"
                        Content="主线程并发" Click="LoadMainThreadNonMutual"/>
                <Button Width="118" Height="38" Margin="2" AutomationProperties.AutomationId="over.btn.load.background.concurrent"
                        Content="后台线程并发" Click="LoadAnimationsNonMutual"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Width="110" Height="38" Margin="2" AutomationProperties.AutomationId="over.btn.load.repeat"
                        Content="连续互斥" Click="LoadRepeatedMutual"/>
                <Button x:Name="btnReset" Width="110" Height="38" Margin="2" AutomationProperties.AutomationId="over.btn.reset.all"
                        Content="重置"/>
                <Button Width="110" Height="38" Margin="2" AutomationProperties.AutomationId="over.btn.stop.all"
                        Content="停止全部" Click="ExitAnimations"/>
            </StackPanel>
        </StackPanel>

        <!-- 三块目标取过冲条的格子尺寸（80x60），两块演示台于是读起来是同一张台子，验收套件也能用同一套
             方式驱动这一排。高度就是行高，不留任何缝，所以缩小的是宽度 —— 窗口高度是屏幕给死的，内容再多也不长。 -->
        <Rectangle Grid.Row="1" x:Name="Rec0" Fill="Cyan" Width="80" Height="60" HorizontalAlignment="Left"></Rectangle>
        <Rectangle Grid.Row="3" x:Name="Rec1" Fill="Lime" Width="80" Height="60" HorizontalAlignment="Center"></Rectangle>
        <Rectangle Grid.Row="5" x:Name="Rec2" Width="80" Height="60">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="Yellow" Offset="0"></GradientStop>
                    <GradientStop Color="Violet" Offset="1"></GradientStop>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- 过冲条：4 个互不干扰的目标并排，Back 与 Elastic、颜色与尺寸能在同一次运行里对比，
             而不是一次看一个。Over3 的渐变是 Yellow → Violet，过冲会推过 Violet 而不是回绕。 -->
        <Grid Grid.Row="7" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" x:Name="Over0" Width="80" Height="60" Fill="#3A6EA5"
                       HorizontalAlignment="Center" VerticalAlignment="Center"></Rectangle>
            <Rectangle Grid.Column="1" x:Name="Over1" Width="80" Height="60" Fill="#3A6EA5"
                       HorizontalAlignment="Center" VerticalAlignment="Center"></Rectangle>
            <Rectangle Grid.Column="2" x:Name="Over2" Width="80" Height="60" Fill="#7A5AA5"
                       HorizontalAlignment="Center" VerticalAlignment="Center"></Rectangle>
            <Rectangle Grid.Column="3" x:Name="Over3" Width="80" Height="60"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="Yellow" Offset="0"></GradientStop>
                        <GradientStop Color="Violet" Offset="1"></GradientStop>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <StackPanel Grid.Row="8" Margin="4">
            <StackPanel Orientation="Horizontal">
                <!-- AutomationProperties.AutomationId 是验收套件抓取这些控件的把手：测试永远不匹配中文标签，
                     token 与语言无关且稳定，标签则保持读者预期的样子。 -->
                <Button Width="128" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.back"
                        Content="位移 Back.Out" Click="OverShootScalarBack"/>
                <Button Width="140" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.elastic"
                        Content="位移 Elastic.Out" Click="OverShootScalarElastic"/>
                <Button Width="110" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.color"
                        Content="颜色过冲" Click="OverShootColor"/>
                <Button Width="110" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.size"
                        Content="尺寸过冲" Click="OverShootSize"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Width="110" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.brush"
                        Content="渐变过冲" Click="OverShootGradient"/>
                <Button Width="110" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.reset"
                        Content="重置过冲" Click="OverShootReset"/>
            </StackPanel>
            <!-- 读数是过冲能被观察到的关键：数字越过目标再回来，肉眼分辨不出这和一个更慢的缓动。
                 Fill 的色值同样读出来，颜色过冲是否偏移色相/回绕一眼可辨。 -->
            <TextBlock x:Name="Readout" Margin="4,6,4,2" FontFamily="Consolas" Foreground="#CCCCCC"
                       AutomationProperties.AutomationId="over.readout"
                       Text="按上面任一按钮；读数显示当前值与目标值"></TextBlock>
            <!-- 读数的机器可读孪生体：同一支定时器、同一批值，但用固定的 key=value 载荷而不是散文，
                 测试就不必去解析一份随时可能被重新排版的版式。 -->
            <TextBlock x:Name="OverState" Margin="4,0,4,2" FontFamily="Consolas" FontSize="10" Foreground="#808080"
                       AutomationProperties.AutomationId="over.state"
                       Text="v=1;seq=0"></TextBlock>
            <!-- 采样器演示台：把手条上方那条"看得见"的一半。每条采样器一小格，点它的把手就在格子里把这条
                 采样器按缓动跑一遍。格子由 SamplerProbe 的表生成，插在这里而不是写死在 XAML 里 ——
                 和把手一样，加一条采样器只需改 SamplerProbe 一处。 -->
            <StackPanel x:Name="SamplerBenchHost"></StackPanel>
            <!-- 采样器一致性把手：本适配器发布的每条采样器一个按钮，在代码里由探针表生成 —— 加一条采样器
                 只需改 SamplerProbe 一处。点一下只跑那一条，把结果写进下面的载荷。
                 用会折行的面板而不是横向 StackPanel：把手必须都留在可视范围内，被裁掉的那个点不着，
                 验收侧看到的就是"控件不在"，而不是"这条采样器坏了"。 -->
            <VariableSizedWrapGrid x:Name="SamplerButtons" Margin="0,4,0,0"
                                   Orientation="Horizontal" MaximumRowsOrColumns="5"></VariableSizedWrapGrid>
            <!-- 最近一次点击产出的载荷：与 over.state 同一套 key=value 形状，另加一个序号证明这次点击落了地。 -->
            <TextBlock x:Name="OverConf" Margin="4,2,4,2" FontFamily="Consolas" FontSize="10" Foreground="#808080"
                       AutomationProperties.AutomationId="over.conf"
                       Text="v=1;seq=0;n=0;"></TextBlock>
        </StackPanel>
    </Grid>
</Window>
