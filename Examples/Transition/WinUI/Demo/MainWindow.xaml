<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Demo"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Demo">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!--
        版面与其余几个平台的 Transition demo 对齐：顶栏（全局三件 + 五种加载方式 + 载荷读数）压在上面，
        下面是一张**可滚动的案例列表** —— 一条案例一行，行里是那条案例真正在动的元素、一句"这条在验什么"，
        以及这一行自己的 启动 / 关闭 / 重置。

        三种行（加载 3 条、过冲 5 条、每条采样器 1 条）长得一样，区别只在各自的令牌、描述与动作里，
        三条合成一处的定义在代码后置的 RebuildCaseList。行本身（连元素）都在代码里造：元素属于行，
        而行的顺序与数量由表决定 —— 所以这一份 XAML 只剩顶栏与那个滚动的容器，三块加载目标与五块过冲目标
        不再声明在这里（位移那两条曲线各有一块自己的目标：一个元素只能有一个父级，而每一行各自是一个父级）。

        两行的高度写法是承重的（它以前不是这样，踩过一次）：
          - 第 0 行 Auto：顶栏声明多少就拿多少。若把它写成星号，星号拿到的是"固定行与 Auto 行分完之后剩下的"，
            两排按钮会被整个挤出窗口 —— UIA 照样点得到，人却看不见，而那正是这块演示台要消掉的那种错觉。
          - 第 1 行 星号：列表自己滚，行数再多也不会把顶栏顶出去。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- 顶栏 + 读数：全部案例之外的东西都收在这一段里 -->
            <RowDefinition Height="Auto"></RowDefinition>
            <!-- 案例列表：一条案例一行，行多了就滚 -->
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4">
            <!-- AutomationProperties.AutomationId 是验收套件抓取这些控件的把手：测试永远不匹配中文标签，
                 token 与语言无关且稳定，标签则保持读者预期的样子。七个平台用的是同一组 token。 -->

            <!-- 全局面板：一次动到下面每一行。列表里那十几条各自是一条真 Transition，这里是同时发起它们，
                 顺带就是一个并发压力场景。 -->
            <StackPanel Orientation="Horizontal">
                <Button Width="110" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.start.all"
                        Content="全部启动" Click="StartAllCases"/>
                <Button Width="110" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.stop.all"
                        Content="停止全部" Click="ExitAll"/>
                <Button x:Name="btnReset" Width="110" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.reset.all"
                        Content="重置"/>
            </StackPanel>

            <!-- 加载模式那一排：它们是"怎么加载"，不是"加载什么" —— 它们驱动的三个形状在下面各占一行、各自有
                 自己的启动。把模式留在顶栏，列表才可能只有一种行：每行恰好 启动 / 关闭 / 重置，
                 而互斥与并发两条路仍然各自够得着，那正是加载模式套件要验的全部。 -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Width="118" Height="38" Margin="2" AutomationProperties.AutomationId="over.btn.load.main"
                        Content="主线程互斥" Click="LoadMainThread"/>
                <Button Width="118" Height="38" Margin="2" AutomationProperties.AutomationId="over.btn.load.background"
                        Content="后台线程互斥" Click="LoadAnimations"/>
                <Button Width="118" Height="38" Margin="2" AutomationProperties.AutomationId="over.btn.load.main.concurrent"
                        Content="主线程并发" Click="LoadMainThreadNonMutual"/>
                <Button Width="118" Height="38" Margin="2" AutomationProperties.AutomationId="over.btn.load.background.concurrent"
                        Content="后台线程并发" Click="LoadAnimationsNonMutual"/>
                <Button Width="110" Height="38" Margin="2" AutomationProperties.AutomationId="over.btn.load.repeat"
                        Content="连续互斥" Click="LoadRepeatedMutual"/>
            </StackPanel>

            <!--
                时间轴控制。作用对象是上面那排加载模式驱动的三块长动画（十来秒的循环），不是下面 900ms 的一次性
                过冲 —— 后者暂停与不暂停在屏幕上分不出来，而这一排既要给验收套件当把手，也要给人看。
            -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Width="86" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.pause"
                        Content="暂停" Click="PauseAll"/>
                <Button Width="86" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.resume"
                        Content="恢复" Click="ResumeAll"/>
                <Button Width="96" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.rate.slow"
                        Content="慢速 ×0.25" Click="RateSlow"/>
                <Button Width="96" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.rate.fast"
                        Content="快速 ×4" Click="RateFast"/>
                <Button Width="96" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.rate.normal"
                        Content="正常 ×1" Click="RateNormal"/>
                <Button Width="86" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.seek.next"
                        Content="下一程" Click="SeekNextPass"/>
            </StackPanel>

            <!--
                四份机器载荷：驱动的读取面，但**不占版面** —— Height=0，元素仍在自动化树里，套件照读控件属性。
                WinUI 的 Visibility 只有 Visible/Collapsed，Collapsed 会把元素整个摘出树，而 over.state 正是
                每个驱动的就绪握手（ReadyAutomationId），摘掉它 DesktopHost.Start 会一直等下去。
                给人看的那份读数删掉了：它只是这几份载荷的散文版，信息重复，还占着按钮和用例列表之间的位置。
            -->
            <!-- 机器可读载荷：同一支定时器、同一批值，但用固定的 key=value 形状而不是散文，
                 测试就不必去解析一份随时可能被重新排版的版式。
                 折行不是可有可无：这行载荷现在多出 rows/away/moving，而 nomutual 必须仍然看得见 —— 它排在最后，
                 所以标签得为这一份更长的载荷留出折行的位置。 -->
            <TextBlock x:Name="OverState" Height="0" FontFamily="Consolas" FontSize="10" Foreground="#808080"
                       TextWrapping="Wrap"
                       AutomationProperties.AutomationId="over.state" Text="v=1;seq=0"></TextBlock>
            <!-- 最近一次点击产出的载荷：与 over.state 同一套 key=value 形状，另加一个序号证明这次点击落了地。 -->
            <TextBlock x:Name="OverConf" Height="0" FontFamily="Consolas" FontSize="10" Foreground="#808080"
                       AutomationProperties.AutomationId="over.conf"
                       Text="v=1;seq=0;n=0;"></TextBlock>
            <!-- 那次点击把控件属性写成了什么：观察到的包络、有没有非有限值、最后停在哪。点击先写一份 done=0，
                 验收侧靠它把"新的还没跑完"与"上一次剩下的"分开。 -->
            <TextBlock x:Name="OverLive" Height="0" FontFamily="Consolas" FontSize="10" Foreground="#808080"
                       AutomationProperties.AutomationId="over.live"
                       Text="v=1;seq=0;done=1;"></TextBlock>
            <!-- 批量载荷：点一次"全部启动"，每一行的五帧闭式解与这一行的观察摘要都在这一份里。
                 逐行载荷是"点哪一行写哪一行"的形状，十几行一起跑只会互相覆盖，所以并发这一路另开一份。
                 MaxHeight 不是排版偏好：一份批量载荷有几千字符，让它按自然高度折行会长到把下面的列表整个挤出窗口。
                 控件**持有**的仍是完整载荷（套件读的是控件属性，不是像素），截的只是它画出来的那几行。 -->
            <TextBlock x:Name="OverBatch" Height="0" FontFamily="Consolas" FontSize="10" Foreground="#808080"
                       TextWrapping="Wrap"
                       AutomationProperties.AutomationId="over.batch" Text="v=1;seq=0;done=1;rows=0;"></TextBlock>
        </StackPanel>

        <!-- 案例列表：一条案例一行，建在代码后置里，与探针表、场景表同源。行是可滚的，所以套件点之前
             先把这一行弄进视野 —— 点完还**仍然**断言人够得着（滚之后才断言是关键）。 -->
        <ScrollViewer Grid.Row="1" Margin="4,2,4,4"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="CaseRows"></StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
