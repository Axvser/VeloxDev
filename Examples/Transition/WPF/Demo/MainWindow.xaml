<Window x:Class="Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Demo"
        mc:Ignorable="d"
        Title="MainWindow" Height="820" Width="1220"
        Background="#1e1e1e">
    <Grid>
        <Grid.RowDefinitions>
            <!-- 顶栏 + 读数：全部案例之外的东西都收在这一段里 -->
            <RowDefinition Height="Auto"></RowDefinition>
            <!-- 案例列表：一条案例一行，行多了就滚 -->
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4">
            <!--
                AutomationProperties.AutomationId is the acceptance suites' handle on these controls, so no test
                ever matches on the Chinese labels: the tokens are language-independent and stable, and the labels
                stay exactly as a reader expects them.
            -->

            <!-- 全局面板：一次动到下面每一行。列表里那十几条各自是一条真 Transition，这里是同时发起它们，
                 顺带就是一个并发压力场景。 -->
            <WrapPanel>
                <Button Width="110" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.start.all"
                        Content="全部启动" Click="StartAllCases"/>
                <Button Width="110" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.stop.all"
                        Content="停止全部" Click="ExitAll"/>
                <Button x:Name="btnReset" Width="110" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.reset.all"
                        Content="重置"/>
            </WrapPanel>

            <!--
                The loading modes. These are "how to load", not "what to load": the three shapes they drive are rows
                in the list below, each with its own start. Keeping the modes up here is what leaves the list uniform —
                every row has exactly 启动 / 关闭 / 重置 — while the mutually-exclusive and concurrent paths stay
                individually reachable, which is the whole of what the load-mode suite verifies.
            -->
            <WrapPanel Margin="0,4,0,0">
                <Button Width="118" Height="38" Margin="2" AutomationProperties.AutomationId="over.btn.load.main"
                        Content="主线程互斥" Click="LoadMainThread"/>
                <Button Width="118" Height="38" Margin="2" AutomationProperties.AutomationId="over.btn.load.background"
                        Content="后台线程互斥" Click="LoadBackground"/>
                <Button Width="118" Height="38" Margin="2" AutomationProperties.AutomationId="over.btn.load.main.concurrent"
                        Content="主线程并发" Click="LoadMainThreadNonMutual"/>
                <Button Width="118" Height="38" Margin="2" AutomationProperties.AutomationId="over.btn.load.background.concurrent"
                        Content="后台线程并发" Click="LoadBackgroundNonMutual"/>
                <Button Width="110" Height="38" Margin="2" AutomationProperties.AutomationId="over.btn.load.repeat"
                        Content="连续互斥" Click="RepeatMutual"/>
            </WrapPanel>

            <!--
                时间轴控制。作用对象是上面那排加载模式驱动的三块长动画（十来秒的循环），不是下面 900ms 的一次性
                过冲 —— 后者暂停与不暂停在屏幕上分不出来，而这一排既要给验收套件当把手，也要给人看。
            -->
            <WrapPanel Margin="0,4,0,0">
                <Button Width="86" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.pause"
                        Content="暂停" Click="PauseAll"/>
                <Button Width="86" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.resume"
                        Content="恢复" Click="ResumeAll"/>
                <Button Width="96" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.rate.slow"
                        Content="慢速 ×0.25" Click="RateSlow"/>
                <Button Width="96" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.rate.fast"
                        Content="快速 ×4" Click="RateFast"/>
                <Button Width="96" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.rate.normal"
                        Content="正常 ×1" Click="RateNormal"/>
                <Button Width="86" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.seek.next"
                        Content="下一程" Click="SeekNextPass"/>
            </WrapPanel>

            <!-- The readout is what makes an overshoot observable: the number passes the target and comes back,
                 which the eye alone cannot tell apart from a slower ease. -->
            <TextBlock x:Name="Readout" Margin="4,6,4,2" FontFamily="Consolas" Foreground="#CCCCCC"
                       AutomationProperties.AutomationId="over.readout"
                       Text="按下面任一行；读数显示当前值与目标值"></TextBlock>
            <!-- The machine-readable twin of the readout: same timer, same values, but a fixed key=value payload
                 instead of prose, so a test never has to parse a layout a designer may reformat. -->
            <!-- 折行不是可有可无：这行载荷现在多出 rows/away/moving，而 nomutual 必须仍然看得见 —— 它排在最后。 -->
            <TextBlock x:Name="OverState" Margin="4,0,4,2" FontFamily="Consolas" FontSize="10" Foreground="#808080"
                       TextWrapping="Wrap"
                       AutomationProperties.AutomationId="over.state" Text="v=1;seq=0"></TextBlock>
            <!-- What the last clicked row produced: same key=value shape as over.state, plus the sequence number
                 that proves a click landed. -->
            <TextBlock x:Name="OverConf" Margin="4,2,4,2" FontFamily="Consolas" FontSize="10" Foreground="#808080"
                       AutomationProperties.AutomationId="over.conf" Text="v=1;seq=0;n=0;"></TextBlock>
            <!-- What that row left on its element while a real Transition ran it to the end: the observed
                 envelope, whether any frame was non-finite, and the settled value. Clicking writes done=0 here
                 first, so a suite can tell the new run apart from the previous one before it has finished. -->
            <TextBlock x:Name="OverLive" Margin="4,2,4,2" FontFamily="Consolas" FontSize="10" Foreground="#808080"
                       AutomationProperties.AutomationId="over.live" Text="v=1;seq=0;done=1;"></TextBlock>
            <!-- 批量载荷：点一次"全部启动"，每一行的五帧闭式解与这一行的观察摘要都在这一份里。
                 逐行载荷是"点哪一行写哪一行"的形状，十几行一起跑只会互相覆盖，所以并发这一路另开一份。 -->
            <TextBlock x:Name="OverBatch" Margin="4,2,4,2" FontFamily="Consolas" FontSize="10" Foreground="#808080"
                       TextWrapping="Wrap"
                       AutomationProperties.AutomationId="over.batch" Text="v=1;seq=0;done=1;rows=0;"></TextBlock>
        </StackPanel>

        <!-- The case list: one row per case, built in code-behind from the probe table and the scenario table so a
             case is added in exactly one place. A row is its element, a sentence saying what it verifies, and the
             three controls that drive just that row. It scrolls, so the suite brings a row into view before clicking
             it — and still asserts afterwards that a person could have reached it. -->
        <ScrollViewer Grid.Row="1" Margin="4,2,4,4" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="CaseRows"></StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
