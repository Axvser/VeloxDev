<Window x:Class="Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Demo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Background="#1e1e1e">
    <Window.Resources>
        <LinearGradientBrush x:Key="Bs1" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="Yellow" Offset="0"></GradientStop>
            <GradientStop Color="Violet" Offset="1"></GradientStop>
        </LinearGradientBrush>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0">
            <Button Width="118" Height="38" Margin="2" Content="主线程互斥" Click="LoadMainThread"/>
            <Button Width="118" Height="38" Margin="2" Content="后台线程互斥" Click="LoadBackground"/>
            <Button Width="118" Height="38" Margin="2" Content="主线程并发" Click="LoadMainThreadNonMutual"/>
            <Button Width="118" Height="38" Margin="2" Content="后台线程并发" Click="LoadBackgroundNonMutual"/>
            <Button Width="110" Height="38" Margin="2" Content="连续互斥" Click="RepeatMutual"/>
            <Button x:Name="btnReset" Width="110" Height="38" Margin="2" Content="重置"/>
            <Button Width="110" Height="38" Margin="2" Content="停止全部" Click="ExitAll"/>
        </WrapPanel>

        <Rectangle Grid.Row="1" x:Name="Rec0" Fill="Cyan" Width="100" HorizontalAlignment="Left"></Rectangle>
        <Rectangle Grid.Row="3" x:Name="Rec1" Fill="Lime" Width="100" HorizontalAlignment="Center"></Rectangle>
        <Rectangle Grid.Row="5" x:Name="Rec2" Fill="{StaticResource Bs1}" Width="100"></Rectangle>
    </Grid>
</Window>