<Window x:Class="Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Demo"
        mc:Ignorable="d"
        Title="MainWindow" Height="640" Width="1000"
        Background="#1e1e1e">
    <Window.Resources>
        <LinearGradientBrush x:Key="Bs1" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="Yellow" Offset="0"></GradientStop>
            <GradientStop Color="Violet" Offset="1"></GradientStop>
        </LinearGradientBrush>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="110"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0">
            <Button Width="118" Height="38" Margin="2" Content="主线程互斥" Click="LoadMainThread"/>
            <Button Width="118" Height="38" Margin="2" Content="后台线程互斥" Click="LoadBackground"/>
            <Button Width="118" Height="38" Margin="2" Content="主线程并发" Click="LoadMainThreadNonMutual"/>
            <Button Width="118" Height="38" Margin="2" Content="后台线程并发" Click="LoadBackgroundNonMutual"/>
            <Button Width="110" Height="38" Margin="2" Content="连续互斥" Click="RepeatMutual"/>
            <Button x:Name="btnReset" Width="110" Height="38" Margin="2" Content="重置"/>
            <Button Width="110" Height="38" Margin="2" Content="停止全部" Click="ExitAll"/>
        </WrapPanel>

        <Rectangle Grid.Row="1" x:Name="Rec0" Fill="Cyan" Width="100" HorizontalAlignment="Left"></Rectangle>
        <Rectangle Grid.Row="3" x:Name="Rec1" Fill="Lime" Width="100" HorizontalAlignment="Center"></Rectangle>
        <Rectangle Grid.Row="5" x:Name="Rec2" Fill="{StaticResource Bs1}" Width="100"></Rectangle>

        <!-- Overshoot strip. Four independent targets, laid out side by side so Back and Elastic, colour and size can
             be compared on the same run instead of one after another. Bs1 flows from Yellow to Violet, so an
             overshoot on it pushes past Violet rather than wrapping. -->
        <UniformGrid Grid.Row="7" Rows="1" Columns="4" Margin="6">
            <Rectangle x:Name="Over0" Width="80" Height="60" Fill="#3A6EA5"
                       HorizontalAlignment="Center" VerticalAlignment="Center"></Rectangle>
            <Rectangle x:Name="Over1" Width="80" Height="60" Fill="#3A6EA5"
                       HorizontalAlignment="Center" VerticalAlignment="Center"></Rectangle>
            <Rectangle x:Name="Over2" Width="80" Height="60" Fill="#7A5AA5"
                       HorizontalAlignment="Center" VerticalAlignment="Center"></Rectangle>
            <Rectangle x:Name="Over3" Width="80" Height="60" Fill="{StaticResource Bs1}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"></Rectangle>
        </UniformGrid>

        <StackPanel Grid.Row="8" Margin="4">
            <!--
                AutomationProperties.AutomationId is the acceptance suites' handle on these controls, so no test
                ever matches on the Chinese labels: the tokens are language-independent and stable, and the labels
                stay exactly as a reader expects them.
            -->
            <WrapPanel>
                <Button Width="128" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.back"
                        Content="位移 Back.Out" Click="OverShootScalarBack"/>
                <Button Width="140" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.elastic"
                        Content="位移 Elastic.Out" Click="OverShootScalarElastic"/>
                <Button Width="110" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.color"
                        Content="颜色过冲" Click="OverShootColor"/>
                <Button Width="110" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.size"
                        Content="尺寸过冲" Click="OverShootSize"/>
                <Button Width="110" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.brush"
                        Content="渐变过冲" Click="OverShootGradient"/>
                <Button Width="110" Height="34" Margin="2" AutomationProperties.AutomationId="over.btn.reset"
                        Content="重置过冲" Click="OverShootReset"/>
            </WrapPanel>
            <!-- The readout is what makes an overshoot observable: the number passes the target and comes back,
                 which the eye alone cannot tell apart from a slower ease. -->
            <TextBlock x:Name="Readout" Margin="4,6,4,2" FontFamily="Consolas" Foreground="#CCCCCC"
                       AutomationProperties.AutomationId="over.readout"
                       Text="按上面任一按钮；读数显示当前值与目标值"></TextBlock>
            <!-- The machine-readable twin of the readout: same timer, same values, but a fixed key=value payload
                 instead of prose, so a test never has to parse a layout a designer may reformat. -->
            <TextBlock x:Name="OverState" Margin="4,0,4,2" FontFamily="Consolas" FontSize="10" Foreground="#808080"
                       AutomationProperties.AutomationId="over.state" Text="v=1;seq=0"></TextBlock>
        </StackPanel>
    </Grid>
</Window>
