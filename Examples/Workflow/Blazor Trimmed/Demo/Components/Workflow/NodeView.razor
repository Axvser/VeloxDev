@namespace Demo.Components.Workflow
@using VeloxDev.WorkflowSystem
@using VeloxDev.WorkflowSystem.AttachedBehaviors

@if (Node is not null)
{
    <WorkflowSlotLayoutBehavior Node="Node" IsEnabled="true">
        @* Geometry px use invariant 0.### — the same precision the zoom JS stamps (applyNodeGeometry),
           so a post-zoom re-render never rewrites a differently-rounded wrapper size. *@
        <WorkflowNodeDragBehavior Node="Node" IsEnabled="true"
                                  Style="@($"width:{Node.Size.Width.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)}px;height:{Node.Size.Height.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)}px;")">
            @* The card is laid out at its DESIGN size (260x180) and uniformly scaled by the zoom
               collapse factor (collapsed width / 260) via a CSS transform — matching the other
               frameworks' Viewbox. Header text, output labels and slot glyphs shrink together, so
               the right-side rows stay in proportion and nothing clips on zoom. *@
            <div class="veloxdev-wf-node-card"
                 style="position:relative;width:260px;height:180px;
                        transform:scale(@ScaleCss);transform-origin:top left;
                        background:@BackgroundCss;
                        border:@BorderThicknessCss solid @BorderBrushCss;
                        border-radius:@CornerRadiusCss;
                        overflow:@(AllowOverflow ? "visible" : "hidden");">
                <div class="veloxdev-wf-node-header"
                     style="height:36px;display:flex;align-items:center;padding:0 12px;
                            color:@ForegroundCss;font-weight:bold;font-size:13px;
                            white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                    @(Title ?? FallbackTitle)
                </div>
                <div class="veloxdev-wf-node-body" style="position:absolute;left:0;right:0;top:36px;bottom:0;">
                    @if (BodyContent is not null)
                    {
                        @BodyContent
                    }

                    @if (InputSlots is not null)
                    {
                        <div class="veloxdev-wf-node-input-host"
                             style="position:absolute;left:2px;top:50%;transform:translateY(-50%);z-index:1;">
                            @InputSlots
                        </div>
                    }

                    @if (OutputSlots is not null)
                    {
                        <div class="veloxdev-wf-node-output-host"
                             style="position:absolute;right:12px;top:50%;transform:translateY(-50%);z-index:1;">
                            @OutputSlots
                        </div>
                    }
                </div>
            </div>
        </WorkflowNodeDragBehavior>
    </WorkflowSlotLayoutBehavior>
}
