@namespace Demo.Components.Workflow
@using VeloxDev.WorkflowSystem.AttachedBehaviors

@if (Viewport is { } vp)
{
    <WorkflowMinimapOverlay Viewport="vp"
                            Width="@Width"
                            Height="@Height"
                            ScrollViewerId="@ScrollViewerId"
                            Background="@Background"
                            BorderColor="@Border"
                            NodeFill="@NodeFill"
                            ViewportFill="transparent"
                            ViewportStroke="@ViewportStroke">
        @* Razor has no render override: this fragment is the customization point after the default drawing. *@
        <DrawMinimap Context="minimap">
        </DrawMinimap>
    </WorkflowMinimapOverlay>
}
