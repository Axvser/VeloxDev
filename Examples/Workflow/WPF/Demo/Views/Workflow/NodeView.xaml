<UserControl x:Class="Demo.Views.Workflow.NodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.WPF"
             mc:Ignorable="d"
             ClipToBounds="False"
             d:DesignHeight="180" d:DesignWidth="260">

    <!-- The fallback node card: what the canvas draws for a node type that ships no view of its own.

         Bare on purpose. The framework's IWorkflowNodeViewModel carries geometry and slots and no display
         name — a title is a property of the concrete ViewModel — so this card cannot honestly label a node
         it knows nothing else about. Every node type in this demo has a view of its own (ControllerView,
         TimerNodeView, PythonNodeView, EnumSelectorNodeView), so this renders only for a foreign type.

         Only the chrome is shared now: the surface, the hairline and the accent bar come from
         Themes/CardTheme.xaml, so a foreign node still lands on the same visual family as the known ones
         without this file claiming to know anything about it. The accent is the neutral slate, because
         there is no type here to give it a colour. -->
    <Grid ClipToBounds="False">
        <Border Style="{StaticResource CardBorderStyle}"
                behaviors:WorkflowNodeDragBehavior.IsEnabled="True"
                behaviors:WorkflowNodeDragBehavior.CoordinateHostName="PART_Canvas">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardAccentStyle}" Background="#94A3B8" />
                <TextBlock Grid.Column="1"
                           Style="{StaticResource CardLabelTextStyle}"
                           Text="?"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
