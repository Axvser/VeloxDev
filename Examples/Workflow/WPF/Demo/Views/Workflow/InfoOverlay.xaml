<UserControl x:Class="Demo.Views.Workflow.InfoOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Real-time canvas-info HUD. The text layer is hit-test transparent so drags fall through; only the
         copy button is interactive. Offsets and the viewport come from the host, scale/actual size/visible
         counts from the Core model. -->
    <Grid>
        <Border IsHitTestVisible="False"
                CornerRadius="7"
                Background="{DynamicResource CanvasHudBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="1"
                Padding="11,7,56,7">
            <TextBlock x:Name="InfoText"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontFamily="{DynamicResource UiFontFamily}"
                       FontSize="11.5"
                       LineHeight="17"
                       IsHitTestVisible="False" />
        </Border>
        <Button x:Name="CopyButton"
                Content="复制"
                FontSize="11"
                Padding="8,2"
                Margin="0,0,8,8"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Style="{StaticResource ToolButtonStyle}"
                Foreground="{DynamicResource AccentTextBrush}"
                Click="OnCopyClicked" />
    </Grid>
</UserControl>
