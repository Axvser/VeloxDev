<UserControl x:Class="Demo.Views.Workflow.InfoOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 实时画布信息 HUD：文本层不吃命中测试，拖拽落到画布，只有“复制”按钮可交互；偏移与视口由宿主按
         小地图那套依赖属性喂入，缩放、实际尺寸、可见数由控件自己订阅 Core 模型取 -->
    <Grid>
        <Border IsHitTestVisible="False"
                CornerRadius="6"
                Background="#E612151B"
                BorderBrush="#CC8EA3B8"
                BorderThickness="1"
                Padding="12,8,58,8">
            <TextBlock x:Name="InfoText"
                       Foreground="#DDE4EA"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       LineHeight="18"
                       IsHitTestVisible="False" />
        </Border>
        <Button x:Name="CopyButton"
                Content="复制"
                FontSize="11"
                Padding="8,2"
                Margin="0,0,8,8"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="#1E3A5F"
                Foreground="#7EC8FF"
                BorderBrush="#7EC8FF"
                BorderThickness="1"
                Cursor="Hand"
                Click="OnCopyClicked" />
    </Grid>
</UserControl>
