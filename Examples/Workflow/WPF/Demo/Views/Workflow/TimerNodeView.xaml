<UserControl x:Class="Demo.Views.Workflow.TimerNodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Demo.Views.Workflow"
             xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.WPF"
             mc:Ignorable="d"
             ClipToBounds="False"
             d:DesignHeight="140" d:DesignWidth="200"
             behaviors:WorkflowSlotLayoutBehavior.IsEnabled="True"
             behaviors:WorkflowSlotLayoutBehavior.SlotNames="PART_InputSlot,PART_OutputSlot"
             behaviors:WorkflowSlotLayoutBehavior.CoordinateHostName="PART_Canvas">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <!-- Viewbox: content scales to the collapsed node size; child pins to the design size (scale 1) so the factor is 1/scale. -->
    <Viewbox Stretch="Uniform" ClipToBounds="False">
        <Grid Width="200" Height="140" ClipToBounds="False" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2" Style="{StaticResource CardBorderStyle}" />

            <!-- 标题行：左对齐 + 左侧 2px 类型色条；执行序号靠右。原来是居中白字压在一条蓝带上 -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    behaviors:WorkflowNodeDragBehavior.CoordinateHostName="PART_Canvas"
                    behaviors:WorkflowNodeDragBehavior.IsEnabled="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardAccentStyle}" Background="#6EC6FF" />
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource CardTitleTextStyle}"
                               Text="{Binding Title}"
                               Margin="12,0,6,0" />
                    <TextBlock Grid.Column="2"
                               Style="{StaticResource CardValueTextStyle}"
                               Text="{Binding ExecutionOrderText}"
                               Foreground="#6EE7A8"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Visibility="{Binding HasExecutionOrder, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>
            <Border Grid.Row="0" Style="{StaticResource CardDividerStyle}" />

            <Border Grid.Row="1" Padding="12,9">
                <!-- 不套 ScrollViewer（Avalonia 那版也没有）：WPF 的输入框比设计高一档
                     （PART_ContentHost 上下各留 4），四行加起来比这格多出不到 2 单位 —— 图省事
                     加一层 Auto 滚动条的话，就为这 2 单位长出一根浅色系统滚动条，比让底部内边距
                     少 2 单位难看得多。内容本来也没有溢出卡面。 -->
                <StackPanel>
                    <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="INTERVAL (MS)" />
                    <TextBox Style="{StaticResource CardFieldTextBoxStyle}"
                             Margin="0,5,0,0"
                             Text="{Binding IntervalMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="LAST TICK" Margin="0,9,0,0" />
                    <TextBlock Style="{StaticResource CardValueTextStyle}"
                               Margin="0,5,0,0"
                               Text="{Binding LastTick}"
                               Foreground="#6EC6FF"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ZIndex：端口有一半压在卡面上，不给序就会被卡面盖掉 -->
            <Grid Grid.RowSpan="2" Panel.ZIndex="6" ClipToBounds="False">
                <local:SlotView x:Name="PART_InputSlot"
                                Width="32" Height="32"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="-16,0,0,0"
                                DataContext="{Binding InputSlot}"
                                Visibility="{Binding HasInputSlot, Converter={StaticResource BooleanToVisibilityConverter}}"
                                SlotState="{Binding State}"
                                Channel="{Binding Channel}" />
                <local:SlotView x:Name="PART_OutputSlot"
                                Width="32" Height="32"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,-16,0"
                                DataContext="{Binding OutputSlot}"
                                Visibility="{Binding HasOutputSlot, Converter={StaticResource BooleanToVisibilityConverter}}"
                                SlotState="{Binding State}"
                                Channel="{Binding Channel}" />
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
