<UserControl x:Class="Demo.Views.Workflow.TimerNodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Demo.Views.Workflow"
             xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.WPF"
             mc:Ignorable="d"
             ClipToBounds="False"
             d:DesignHeight="140" d:DesignWidth="200"
             behaviors:WorkflowSlotLayoutBehavior.IsEnabled="True"
             behaviors:WorkflowSlotLayoutBehavior.SlotNames="PART_InputSlot,PART_OutputSlot"
             behaviors:WorkflowSlotLayoutBehavior.CoordinateHostName="PART_Canvas">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
	<!-- Viewbox: content scales to the collapsed node size; child pins to the design size (scale 1) so the factor is 1/scale. -->
	<Viewbox Stretch="Uniform">
    <Grid ClipToBounds="False" Width="200" Height="140">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2"
                CornerRadius="6"
                BorderThickness="1.5"
                BorderBrush="#6ec6ff"
                Background="#1e2a35" />

        <Grid Grid.RowSpan="2" Panel.ZIndex="6" ClipToBounds="False">
            <local:SlotView x:Name="PART_InputSlot"
                            Width="20" Height="20"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="-10,0,0,0"
                            DataContext="{Binding InputSlot}"
                            Visibility="{Binding HasInputSlot, Converter={StaticResource BooleanToVisibilityConverter}}"
                            SlotState="{Binding State}" />
            <local:SlotView x:Name="PART_OutputSlot"
                            Width="20" Height="20"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,-10,0"
                            DataContext="{Binding OutputSlot}"
                            Visibility="{Binding HasOutputSlot, Converter={StaticResource BooleanToVisibilityConverter}}"
                            PinDirection="Out"
                            SlotState="{Binding State}" />
        </Grid>

        <Border Grid.Row="0"
                Background="#253545"
                CornerRadius="4,4,0,0"
                BorderThickness="0,0,0,0.5"
                BorderBrush="#6ec6ff"
                behaviors:WorkflowNodeDragBehavior.CoordinateHostName="PART_Canvas"
                behaviors:WorkflowNodeDragBehavior.IsEnabled="True">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold" />
                <Border Margin="8,0,0,0" Background="#1f3d1f" BorderBrush="#7bd97b" BorderThickness="1"
                        CornerRadius="10" Padding="6,1"
                        Visibility="{Binding HasExecutionOrder, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ExecutionOrderText}" Foreground="#c8ffc8" FontWeight="Bold" />
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#1e2a35" CornerRadius="0,0,4,4">
            <StackPanel Margin="14">
                <TextBlock Text="Interval (ms)" Foreground="#bfbfbf" FontSize="11" />
                <TextBox Margin="0,4,0,0" Text="{Binding IntervalMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Last Tick" Foreground="#bfbfbf" FontSize="11" Margin="0,10,0,0" />
                <TextBlock Margin="0,4,0,0" Text="{Binding LastTick}" Foreground="#6ec6ff"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
	</Viewbox>
</UserControl>
