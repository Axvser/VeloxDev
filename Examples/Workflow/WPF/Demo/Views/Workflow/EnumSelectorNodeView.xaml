<UserControl x:Class="Demo.Views.Workflow.EnumSelectorNodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Demo.Views.Workflow"
             xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.WPF"
             mc:Ignorable="d"
             ClipToBounds="False"
             d:DesignHeight="380" d:DesignWidth="280"
             behaviors:WorkflowSlotLayoutBehavior.IsEnabled="True"
             behaviors:WorkflowSlotLayoutBehavior.SlotNames="PART_InputSlot"
             behaviors:WorkflowSlotLayoutBehavior.SlotEnumeratorNames="PART_OutputSlotsList"
             behaviors:WorkflowSlotLayoutBehavior.CoordinateHostName="PART_Canvas">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <!-- Viewbox: content scales to the collapsed node size; child pins to the design size (scale 1) so the factor is 1/scale. -->
    <Viewbox Stretch="Uniform" ClipToBounds="False">
        <Grid Width="280" Height="380" ClipToBounds="False" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2" Style="{StaticResource CardBorderStyle}" />

            <!-- 标题行：左对齐 + 类型色条，路由结果做成一个中性胶囊靠右 -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    behaviors:WorkflowNodeDragBehavior.CoordinateHostName="PART_Canvas"
                    behaviors:WorkflowNodeDragBehavior.IsEnabled="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardAccentStyle}" Background="#D6A0FF" />
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource CardTitleTextStyle}"
                               Text="{Binding Title}"
                               Margin="12,0,6,0" />
                    <TextBlock Grid.Column="2"
                               Style="{StaticResource CardValueTextStyle}"
                               Text="{Binding ExecutionOrderText}"
                               Foreground="#6EE7A8"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <Border Grid.Column="3"
                            Background="{StaticResource CardHoverBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="7,1"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding LastRouted}" Foreground="#D6A0FF" FontSize="10.5" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Row="0" Style="{StaticResource CardDividerStyle}" />

            <Border Grid.Row="1" ClipToBounds="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14,10">
                        <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="SELECTED METHOD" />
                        <ComboBox Style="{StaticResource CardFieldComboBoxStyle}"
                                  Margin="0,6,0,0"
                                  ItemsSource="{Binding EnumValues}"
                                  SelectedItem="{Binding SelectedValue, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="COMPILE MODE" Margin="0,10,0,0" />
                        <ComboBox Style="{StaticResource CardFieldComboBoxStyle}"
                                  Margin="0,6,0,0"
                                  ItemsSource="{Binding CompileModeOptions}"
                                  SelectedItem="{Binding CompileMode, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="OUTPUT SLOTS" Margin="0,12,0,0" />
                        <ItemsControl ItemsSource="{Binding OutputSlots.Items}" x:Name="PART_OutputSlotsList"
                                      Margin="0,6,0,0" ClipToBounds="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2" ClipToBounds="False">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   Style="{StaticResource CardValueTextStyle}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#D6A0FF"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,0,12,0" />
                                        <local:SlotView Grid.Column="1" Width="24" Height="24"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,-12,0"
                                                        DataContext="{Binding Slot}"
                                                        SlotState="{Binding State}"
                                                        Channel="{Binding Channel}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 端口挂在根 Grid 上，而不是上面那个 Border 里：Border 是 ClipToBounds="True" 的
                 （内容滚动时不该溢出圆角），而端口要外溢 16 单位骑在卡边上，放进去就被切掉一半。
                 ZIndex 那条同样要：端口有一半压在卡面上，不给序会被卡面盖掉 -->
            <Grid Grid.Row="1" Panel.ZIndex="6" ClipToBounds="False">
                <local:SlotView x:Name="PART_InputSlot"
                                Width="32" Height="32"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="-16,0,0,0"
                                DataContext="{Binding InputSlot}"
                                Visibility="{Binding HasInputSlot, Converter={StaticResource BooleanToVisibilityConverter}}"
                                SlotState="{Binding State}"
                                Channel="{Binding Channel}" />
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
