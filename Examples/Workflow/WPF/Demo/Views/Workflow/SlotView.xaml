<UserControl x:Class="Demo.Views.Workflow.SlotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="20" d:DesignWidth="20"
             Background="Transparent"
             behaviors:WorkflowSlotConnectionBehavior.IsEnabled="True"
             MouseLeftButtonUp="OnPointerReleased"
             MouseLeftButtonDown="OnPointerPressed">
    <Grid x:Name="PinRoot" ClipToBounds="False">
        <!-- IC/DIP chip-pin style port: a thin horizontal lead that flares into a wider rounded tip (like a
             through-hole IC pin). The Path is centered so the geometry's center sits at the slot anchor (where
             the connection line lands); the geometry is deliberately 2px above the vertical center so the line
             reads as meeting the pin cleanly (alignment tuned here, not in the adapter).
             PinDirection="In" (default) mirrors it to point left, "Out" points right. -->
        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
              Stroke="#40000000"
              StrokeThickness="1"
              Stretch="None"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <Path.Data>
                <GeometryGroup FillRule="Nonzero">
                    <RectangleGeometry Rect="1,6,12,4" />                              <!-- lead -->
                    <RectangleGeometry Rect="12,3,7,10" RadiusX="1.5" RadiusY="1.5" />  <!-- flared tip -->
                </GeometryGroup>
            </Path.Data>
        </Path>
    </Grid>
</UserControl>
