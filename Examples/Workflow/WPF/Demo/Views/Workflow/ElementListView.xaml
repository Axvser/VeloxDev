<UserControl x:Class="Demo.Views.Workflow.ElementListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Demo.Views.Workflow">
    <Border Padding="10"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <StackPanel>
            <TextBlock Text="元素"
                       Style="{StaticResource PanelTitleTextStyle}"
                       Foreground="{DynamicResource AccentTextBrush}" />

            <TabControl x:Name="Tabs"
                        Height="220"
                        Margin="0,6,0,0"
                        Background="Transparent"
                        BorderThickness="0">
                <TabItem Header="节点">
                    <ListBox x:Name="NodeList" Background="{DynamicResource PanelBackgroundBrush}" SelectionChanged="OnSelectionChanged" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1" Content="Locate" Margin="4,0,0,0" Click="OnLocate"
                                            Style="{StaticResource RowActionButtonStyle}"
                                            ToolTip="滚到视口中心；插槽定位所属节点，连线定位两端节点中心" />
                                    <Button Grid.Column="2" Content="Delete" Margin="4,0,0,0" Click="OnDelete"
                                            Style="{StaticResource RowActionButtonStyle}"
                                            ToolTip="删除该元素；插槽与节点会一并删除它们的连线" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
                <TabItem Header="插槽">
                    <ListBox x:Name="SlotList" Background="{DynamicResource PanelBackgroundBrush}" SelectionChanged="OnSelectionChanged" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1" Content="Locate" Margin="4,0,0,0" Click="OnLocate"
                                            Style="{StaticResource RowActionButtonStyle}"
                                            ToolTip="滚到视口中心；插槽定位所属节点，连线定位两端节点中心" />
                                    <Button Grid.Column="2" Content="Delete" Margin="4,0,0,0" Click="OnDelete"
                                            Style="{StaticResource RowActionButtonStyle}"
                                            ToolTip="删除该元素；插槽与节点会一并删除它们的连线" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
                <TabItem Header="连线">
                    <ListBox x:Name="LinkList" Background="{DynamicResource PanelBackgroundBrush}" SelectionChanged="OnSelectionChanged" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1" Content="Locate" Margin="4,0,0,0" Click="OnLocate"
                                            Style="{StaticResource RowActionButtonStyle}"
                                            ToolTip="滚到视口中心；插槽定位所属节点，连线定位两端节点中心" />
                                    <Button Grid.Column="2" Content="Delete" Margin="4,0,0,0" Click="OnDelete"
                                            Style="{StaticResource RowActionButtonStyle}"
                                            ToolTip="删除该元素；插槽与节点会一并删除它们的连线" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
            </TabControl>

            <TextBlock x:Name="StatusText"
                       Margin="0,6,0,0"
                       Style="{StaticResource MicroTextStyle}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
