<UserControl x:Class="Demo.Views.Workflow.ElementListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Demo.Views.Workflow">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0F3460" />
            <Setter Property="Foreground" Value="#7EC8FF" />
            <Setter Property="BorderBrush" Value="#7EC8FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <Border Padding="10"
            Background="#202020"
            BorderBrush="#4C4C4C"
            BorderThickness="1"
            CornerRadius="4">
        <StackPanel>
            <TextBlock Text="元素（从 Tree 加载）"
                       Foreground="#7EC8FF"
                       FontWeight="Bold" />

            <TabControl x:Name="Tabs"
                        Height="220"
                        Margin="0,6,0,0"
                        Background="Transparent"
                        BorderThickness="0">
                <TabItem Header="节点">
                    <ListBox x:Name="NodeList" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="#D8D8D8"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1" Content="Locate" Margin="4,0,0,0" Click="OnLocate"
                                            ToolTip="滚到视口中心；插槽定位所属节点，连线定位两端节点中心" />
                                    <Button Grid.Column="2" Content="Delete" Margin="4,0,0,0" Click="OnDelete"
                                            ToolTip="删除该元素；插槽与节点会一并删除它们的连线" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
                <TabItem Header="插槽">
                    <ListBox x:Name="SlotList" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="#D8D8D8"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1" Content="Locate" Margin="4,0,0,0" Click="OnLocate"
                                            ToolTip="滚到视口中心；插槽定位所属节点，连线定位两端节点中心" />
                                    <Button Grid.Column="2" Content="Delete" Margin="4,0,0,0" Click="OnDelete"
                                            ToolTip="删除该元素；插槽与节点会一并删除它们的连线" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
                <TabItem Header="连线">
                    <ListBox x:Name="LinkList" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="#D8D8D8"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1" Content="Locate" Margin="4,0,0,0" Click="OnLocate"
                                            ToolTip="滚到视口中心；插槽定位所属节点，连线定位两端节点中心" />
                                    <Button Grid.Column="2" Content="Delete" Margin="4,0,0,0" Click="OnDelete"
                                            ToolTip="删除该元素；插槽与节点会一并删除它们的连线" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
            </TabControl>

            <TextBlock x:Name="StatusText"
                       Margin="0,6,0,0"
                       Foreground="#A0A0A0"
                       FontSize="11"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
