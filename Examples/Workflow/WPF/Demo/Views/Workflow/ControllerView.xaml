<UserControl x:Class="Demo.Views.Workflow.ControllerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              xmlns:vm="clr-namespace:Demo.ViewModels;assembly=Lib"
              xmlns:local="clr-namespace:Demo.Views.Workflow"
              xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.WPF"
             mc:Ignorable="d"
             ClipToBounds="False"
             d:DesignHeight="340" d:DesignWidth="220"
              behaviors:WorkflowSlotLayoutBehavior.IsEnabled="True"
              behaviors:WorkflowSlotLayoutBehavior.SlotNames="PART_OutputSlot"
              behaviors:WorkflowSlotLayoutBehavior.CoordinateHostName="PART_Canvas">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid ClipToBounds="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="88" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="3"
                CornerRadius="5"
                BorderThickness="1"
                BorderBrush="White"
                Background="#2D2D2D" />

        <Border Grid.Row="0"
                CornerRadius="5,5,0,0"
                Background="#2D2D2D"
                behaviors:WorkflowNodeDragBehavior.CoordinateHostName="PART_Canvas"
                behaviors:WorkflowNodeDragBehavior.IsEnabled="True">
            <TextBlock Text="Network Flow Controller"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="White" />
        </Border>

        <Border Grid.Row="1"
                Background="#252525"
                Padding="12">
            <ScrollViewer>
            <StackPanel>
                <TextBlock Text="Seed" Foreground="#DCDCDC" FontSize="11" />
                <TextBox Margin="0,4,0,0" FontSize="11"
                         Text="{Binding SeedPayload, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Background="#2D2D2D"
                CornerRadius="0,0,5,5"
                Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Row="0" Grid.Column="0" Margin="0,0,3,3"
                        Content="Compile" Background="#1E3A5F" Foreground="White"
                        Command="{Binding CompileCommand}" />
                <Button Grid.Row="0" Grid.Column="1" Margin="3,0,0,3"
                        Content="Run" Background="#1E5F2E" Foreground="White"
                        IsEnabled="{Binding HasCompiledGraphs}"
                        Command="{Binding RunCommand}" />
                <Button Grid.Row="1" Grid.Column="0" Margin="0,3,3,0"
                        Content="Stop" Background="#5F1E1E" Foreground="White"
                        Command="{Binding StopCommand}" />
                <Button Grid.Row="1" Grid.Column="1" Margin="3,3,0,0"
                        Content="Close" Background="#1E1E1E" Foreground="White"
                        Command="{Binding CloseWorkflowCommand}" />
            </Grid>
        </Border>

        <local:SlotView x:Name="PART_OutputSlot"
                        Width="20"
                        Height="20"
                        Grid.RowSpan="3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,-10,0"
                        DataContext="{Binding OutputSlot}"
                        Visibility="{Binding HasOutputSlot, Converter={StaticResource BooleanToVisibilityConverter}}"
                        PinDirection="Out"
                        SlotState="{Binding State}" />
    </Grid>
</UserControl>
