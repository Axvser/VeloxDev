<UserControl x:Class="Demo.Views.Workflow.WorkflowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Demo.Views.Workflow"
             xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.WPF"
             xmlns:vm="clr-namespace:Demo.ViewModels;assembly=Lib"
             xmlns:workflow="clr-namespace:VeloxDev.WorkflowSystem;assembly=VeloxDev.Core"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1500"
             behaviors:WorkflowSurfaceBehavior.IsEnabled="True"
             behaviors:WorkflowSurfaceBehavior.ZoomEnabled="True"
             behaviors:WorkflowSurfaceBehavior.ScrollViewerName="PART_ScrollViewer"
             behaviors:WorkflowSurfaceBehavior.CanvasName="PART_Canvas"
             behaviors:WorkflowSurfaceBehavior.GridDecoratorName="PART_GridDecorator"
             behaviors:WorkflowSurfaceBehavior.PointerPressSourceName="PART_SurfaceBorder"
             behaviors:WorkflowSurfaceBehavior.MinimapOverlayName="PART_MinimapOverlay"
             behaviors:WorkflowSurfaceBehavior.LinkMenuKey="LinkContextMenu"
             PreviewKeyDown="OnGlobalKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <local:ZoomPercentConverter x:Key="ZoomPercent"/>
        <local:DepthIndentConverter x:Key="DepthIndent"/>
        <local:ZeroToVisibilityConverter x:Key="ZeroToVisibility"/>

        <DataTemplate x:Key="NodeTemplate">
            <local:NodeView Width="{Binding Size.Width}"
                            Height="{Binding Size.Height}"
                            Canvas.Left="{Binding Anchor.Horizontal}"
                            Canvas.Top="{Binding Anchor.Vertical}"
                            Panel.ZIndex="{Binding Anchor.Layer}"
                            RenderTransform="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:WorkflowView}}, Path=(behaviors:WorkflowCanvasTransformBehavior.Transform)}"/>
        </DataTemplate>
        <DataTemplate x:Key="ControllerTemplate" DataType="{x:Type vm:ControllerViewModel}">
            <local:ControllerView Width="{Binding Size.Width}"
                                  Height="{Binding Size.Height}"
                                  Canvas.Left="{Binding Anchor.Horizontal}"
                                  Canvas.Top="{Binding Anchor.Vertical}"
                                  Panel.ZIndex="{Binding Anchor.Layer}"
                                  RenderTransform="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:WorkflowView}}, Path=(behaviors:WorkflowCanvasTransformBehavior.Transform)}"/>
        </DataTemplate>
        <DataTemplate x:Key="EnumSelectorTemplate" DataType="{x:Type vm:EnumSelectorNodeViewModel}">
            <local:EnumSelectorNodeView Width="{Binding Size.Width}"
                                        Height="{Binding Size.Height}"
                                        Canvas.Left="{Binding Anchor.Horizontal}"
                                        Canvas.Top="{Binding Anchor.Vertical}"
                                        Panel.ZIndex="{Binding Anchor.Layer}"
                                        RenderTransform="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:WorkflowView}}, Path=(behaviors:WorkflowCanvasTransformBehavior.Transform)}"/>
        </DataTemplate>
        <DataTemplate x:Key="TimerTemplate" DataType="{x:Type vm:TimerNodeViewModel}">
            <local:TimerNodeView Width="{Binding Size.Width}"
                                 Height="{Binding Size.Height}"
                                 Canvas.Left="{Binding Anchor.Horizontal}"
                                 Canvas.Top="{Binding Anchor.Vertical}"
                                 Panel.ZIndex="{Binding Anchor.Layer}"
                                 RenderTransform="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:WorkflowView}}, Path=(behaviors:WorkflowCanvasTransformBehavior.Transform)}"/>
        </DataTemplate>
        <DataTemplate x:Key="PythonTemplate" DataType="{x:Type vm:PythonScriptNodeViewModel}">
            <local:PythonNodeView Width="{Binding Size.Width}"
                                  Height="{Binding Size.Height}"
                                  Canvas.Left="{Binding Anchor.Horizontal}"
                                  Canvas.Top="{Binding Anchor.Vertical}"
                                  Panel.ZIndex="{Binding Anchor.Layer}"
                                  RenderTransform="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:WorkflowView}}, Path=(behaviors:WorkflowCanvasTransformBehavior.Transform)}"/>
        </DataTemplate>
        <DataTemplate x:Key="LinkTemplate">
            <local:PolylineCurveView StartLeft="{Binding Sender.Anchor.Horizontal}"
                                     StartTop="{Binding Sender.Anchor.Vertical}"
                                     EndLeft="{Binding Receiver.Anchor.Horizontal}"
                                     EndTop="{Binding Receiver.Anchor.Vertical}"
                                     CanRender="{Binding IsVisible}"
                                     LineColor="#CC6E8BFF"
                                     Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type Canvas}}, Path=ActualWidth}"
                                     Height="{Binding RelativeSource={RelativeSource AncestorType={x:Type Canvas}}, Path=ActualHeight}"
                                     RenderTransform="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:WorkflowView}}, Path=(behaviors:WorkflowCanvasTransformBehavior.Transform)}"
                                     Panel.ZIndex="-1"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type workflow:ILinkComponent}">
            <local:PolylineCurveView StartLeft="{Binding Sender.Anchor.Horizontal}"
                                     StartTop="{Binding Sender.Anchor.Vertical}"
                                     EndLeft="{Binding Receiver.Anchor.Horizontal}"
                                     EndTop="{Binding Receiver.Anchor.Vertical}"
                                     CanRender="{Binding IsVisible}"
                                     LineColor="#CC6E8BFF"
                                     Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type Canvas}}, Path=ActualWidth}"
                                     Height="{Binding RelativeSource={RelativeSource AncestorType={x:Type Canvas}}, Path=ActualHeight}"
                                     RenderTransform="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:WorkflowView}}, Path=(behaviors:WorkflowCanvasTransformBehavior.Transform)}"
                                     Panel.ZIndex="-1"/>
        </DataTemplate>
        <local:CustomTemplateSelector x:Key="NodeSelector"
                                      Controller="{StaticResource ControllerTemplate}"
                                      Simulator="{StaticResource NodeTemplate}"
                                      EnumSelector="{StaticResource EnumSelectorTemplate}"
                                      Timer="{StaticResource TimerTemplate}"
                                      Python="{StaticResource PythonTemplate}"
                                      Link="{StaticResource LinkTemplate}"/>

        <!-- Link right-click menu; its DataContext is the link. Add or remove entries here. -->
        <ContextMenu x:Key="LinkContextMenu">
            <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
        </ContextMenu>

        <!-- Command-center menu. The button opens it on left click; entries use the same handlers as the
             title-strip menus, so there is one implementation per command. -->
        <ContextMenu x:Key="CommandMenu" Placement="Bottom">
            <MenuItem Header="保存工作流" InputGestureText="Ctrl+S" Click="SaveWorkflow" />
            <MenuItem Header="加载工作流" InputGestureText="Ctrl+O" Click="SelectWorkflow" />
            <MenuItem Header="重新载入示例" Click="LoadNetworkDemo" />
            <Separator />
            <MenuItem Header="撤销" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
            <MenuItem Header="重做" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
            <Separator />
            <MenuItem Header="资源管理器" Tag="explorer" Click="OnShowPanelMenu" />
            <MenuItem Header="运行" Tag="run" Click="OnShowPanelMenu" />
            <MenuItem Header="MCP 服务器" Tag="mcp" Click="OnShowPanelMenu" />
            <MenuItem Header="属性" Tag="properties" Click="OnShowPanelMenu" />
            <MenuItem Header="Agent 对话" Tag="agent" Click="OnShowPanelMenu" />
            <MenuItem Header="执行输出" Tag="output" Click="OnShowPanelMenu" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- Title strip: brand, menu, command center, window controls. -->
        <Border x:Name="TitleBarHost" Grid.Row="0"
                Background="{DynamicResource ActivityBarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <Grid Margin="12,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="20" Height="20" Source="/Assets/veloxdev-logo.png"
                           ToolTip="VeloxDev" />
                    <Menu Margin="6,0,0,0" VerticalAlignment="Center">
                        <MenuItem Header="文件">
                            <MenuItem Header="保存工作流" InputGestureText="Ctrl+S" Click="SaveWorkflow" />
                            <MenuItem Header="加载工作流" InputGestureText="Ctrl+O" Click="SelectWorkflow" />
                            <MenuItem Header="重新载入示例" Click="LoadNetworkDemo" />
                            <Separator />
                            <MenuItem Header="退出" Click="OnCloseWindow" />
                        </MenuItem>
                        <MenuItem Header="编辑">
                            <MenuItem Header="撤销" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
                            <MenuItem Header="重做" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
                            <Separator />
                            <MenuItem Header="命令中心" InputGestureText="Ctrl+Shift+P" Click="OnOpenCommandCenter" />
                        </MenuItem>
                        <MenuItem Header="视图">
                            <MenuItem Header="资源管理器" Tag="explorer" Click="OnShowPanelMenu" />
                            <MenuItem Header="运行" Tag="run" Click="OnShowPanelMenu" />
                            <MenuItem Header="MCP 服务器" Tag="mcp" Click="OnShowPanelMenu" />
                            <Separator />
                            <MenuItem Header="属性" Tag="properties" Click="OnShowPanelMenu" />
                            <MenuItem Header="Agent 对话" Tag="agent" Click="OnShowPanelMenu" />
                            <MenuItem Header="执行输出" Tag="output" Click="OnShowPanelMenu" />
                            <Separator />
                            <MenuItem Header="切换侧栏" Click="OnToggleSidebar" />
                            <MenuItem Header="切换右侧面板" Click="OnToggleInspector" />
                        </MenuItem>
                        <MenuItem Header="帮助">
                            <MenuItem Header="关于 VeloxDev" Click="OnShowAbout" />
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <Button x:Name="CommandCenterButton" Grid.Column="1"
                        Style="{StaticResource CommandCenterButtonStyle}"
                        Width="330"
                        Click="OnOpenCommandCenter"
                        ContextMenu="{StaticResource CommandMenu}"
                        ToolTip="搜索并运行命令（Ctrl+Shift+P）">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{DynamicResource IconFontFamily}"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Grid.Column="1" Text="搜索命令" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Ctrl+Shift+P" Style="{StaticResource MicroTextStyle}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButtonStyle}" Click="OnToggleSidebar" ToolTip="切换侧栏"
                            Content="&#xE8A0;" />
                    <Button Style="{StaticResource IconButtonStyle}" Click="OnToggleInspector" ToolTip="切换右侧面板"
                            Content="&#xE8A9;" />
                    <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}" Margin="6,0" />
                    <Button Style="{StaticResource CaptionButtonStyle}" Click="OnMinimizeWindow"
                            AutomationProperties.Name="最小化" ToolTip="最小化" Content="&#xE921;" />
                    <Button Style="{StaticResource CaptionButtonStyle}" Click="OnMaximizeWindow"
                            AutomationProperties.Name="最大化或还原" Content="&#xE922;" />
                    <Button Style="{StaticResource CloseCaptionButtonStyle}" Click="OnCloseWindow"
                            AutomationProperties.Name="关闭" ToolTip="关闭" Content="&#xE8BB;" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Workbench body: activity bar / sidebar / canvas / inspector. -->
        <Grid x:Name="WorkbenchGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="272" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="348" />
            </Grid.ColumnDefinitions>

            <!-- Activity bar -->
            <Border x:Name="ActivityBar" Grid.Column="0"
                    Background="{DynamicResource ActivityBarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,6,0,0">
                        <RadioButton x:Name="ExplorerActivity" Style="{StaticResource ActivityButtonStyle}"
                                     GroupName="SidebarActivity" Tag="explorer" IsChecked="True"
                                     Content="&#xE8B7;" ToolTip="资源管理器" Click="OnActivityClick" />
                        <RadioButton x:Name="RunActivity" Style="{StaticResource ActivityButtonStyle}"
                                     GroupName="SidebarActivity" Tag="run"
                                     Content="&#xE768;" ToolTip="运行" Click="OnActivityClick" />
                        <RadioButton x:Name="McpActivity" Style="{StaticResource ActivityButtonStyle}"
                                     GroupName="SidebarActivity" Tag="mcp"
                                     Content="&#xE774;" ToolTip="MCP 服务器" Click="OnActivityClick" />
                        <RadioButton x:Name="OutputActivity" Style="{StaticResource ActivityButtonStyle}"
                                     GroupName="OutputActivity" Tag="output"
                                     Content="&#xE756;" ToolTip="执行输出" Click="OnOutputActivityClick" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,0,0,6">
                        <RadioButton x:Name="InspectorPropertiesActivity" Style="{StaticResource ActivityButtonStyle}"
                                     GroupName="InspectorActivity" Tag="properties" IsChecked="True"
                                     Content="&#xE713;" ToolTip="属性" Click="OnInspectorActivityClick" />
                        <RadioButton x:Name="InspectorAgentActivity" Style="{StaticResource ActivityButtonStyle}"
                                     GroupName="InspectorActivity" Tag="agent"
                                     Content="&#xE8BD;" ToolTip="Agent 对话" Click="OnInspectorActivityClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sidebar -->
            <Border x:Name="SidebarHost" Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}" Height="34">
                        <Grid Margin="12,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SidebarHeader" Grid.Column="0" Text="资源管理器"
                                       Style="{StaticResource PanelTitleTextStyle}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButtonStyle}" Content="&#xE74E;" ToolTip="保存工作流" Click="SaveWorkflow" />
                                <Button Style="{StaticResource IconButtonStyle}" Content="&#xE8E5;" ToolTip="加载工作流" Click="SelectWorkflow" />
                                <Button Style="{StaticResource IconButtonStyle}" Content="&#xE7A7;" ToolTip="撤销" Command="{Binding UndoCommand}" />
                                <Button Style="{StaticResource IconButtonStyle}" Content="&#xE7A6;" ToolTip="重做" Command="{Binding RedoCommand}" />
                                <Button Style="{StaticResource IconButtonStyle}" Content="&#xE72C;" ToolTip="重新载入示例" Click="LoadNetworkDemo" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <!-- Explorer -->
                        <ScrollViewer x:Name="ExplorerPanel" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="12,10,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="小地图" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="1" Content="显示"
                                              IsChecked="{Binding IsMinimapVisible, ElementName=PART_MinimapOverlay}"
                                              VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="元素" Style="{StaticResource SectionTextStyle}" />
                                <local:ElementListView x:Name="ElementList" Margin="12,0,12,0" />
                                <TextBlock x:Name="ElementStatus" Margin="12,8,12,12"
                                           Style="{StaticResource MicroTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Run: every compile and run task, manual and Agent alike. -->
                        <ScrollViewer x:Name="RunPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="12,12,12,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="运行任务" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Runs.Summary}" Style="{StaticResource MicroTextStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="清除已完成" Style="{StaticResource RowActionButtonStyle}"
                                            Padding="8,3" Click="OnClearFinishedRuns" ToolTip="移除已结束的任务行" />
                                </Grid>

                                <TextBlock Margin="12,0,12,8" Style="{StaticResource MicroTextStyle}" TextWrapping="Wrap"
                                           Text="手动编译、手动运行，以及 Agent 编译 / 运行的任务都会出现在这里。选中一行，输出页会跟随它。" />

                                <ListBox x:Name="RunTaskList" ItemsSource="{Binding Runs.Tasks}"
                                         SelectedItem="{Binding Runs.Selected, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0" Margin="8,0"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" Padding="8"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1" CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="3"
                                                                    Padding="5,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SourceText}" FontSize="10"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding RootLabel}" FontWeight="SemiBold" Margin="6,0,0,0"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <TextBlock Text="{Binding StateText}" FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding StartedText}" Style="{StaticResource MicroTextStyle}" Margin="8,0,0,0" />
                                                            <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource MicroTextStyle}" Margin="8,0,0,0" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MicroTextStyle}"
                                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                        <Button Content="暂停" Style="{StaticResource RowActionButtonStyle}" Padding="6,1"
                                                                Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibility}}"
                                                                Click="OnPauseRunTask" />
                                                        <Button Content="继续" Style="{StaticResource RowActionButtonStyle}" Padding="6,1"
                                                                Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}"
                                                                Click="OnResumeRunTask" />
                                                        <Button Content="停止" Style="{StaticResource RowActionButtonStyle}" Padding="6,1"
                                                                Visibility="{Binding CanStop, Converter={StaticResource BoolToVisibility}}"
                                                                Click="OnStopRunTask" />
                                                        <Button Content="运行" Style="{StaticResource RowActionButtonStyle}" Padding="6,1"
                                                                Visibility="{Binding CanStart, Converter={StaticResource BoolToVisibility}}"
                                                                Click="OnStartRunTask" />
                                                        <Button Content="移除" Style="{StaticResource RowActionButtonStyle}" Padding="6,1"
                                                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"
                                                                Click="OnRemoveRunTask" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Margin="12,10,12,12" Style="{StaticResource MicroTextStyle}" TextWrapping="Wrap"
                                           Text="还没有任务。在控制器卡上编译一次，或让 Agent 编译 / 运行工作流。"
                                           Visibility="{Binding Runs.IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- MCP -->
                        <ScrollViewer x:Name="McpPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="服务器" Style="{StaticResource SectionTextStyle}" />
                                <Border x:Name="McpStatusPanel" Margin="12,0" Style="{StaticResource PropertyCardStyle}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="MCP 服务器" Foreground="{DynamicResource AccentTextBrush}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ConnectedCount, StringFormat=存活 {0}}"
                                                           Foreground="{DynamicResource NodeSuccessBrush}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding ErrorCount, StringFormat=· 错误 {0}}"
                                                           Foreground="{DynamicResource DangerBrush}" Margin="6,0,0,0" />
                                                <Button Content="重载" Margin="8,0,0,0" Padding="8,1" FontSize="11"
                                                        Click="OnReloadMcp" />
                                            </StackPanel>
                                        </Grid>
                                        <ListBox x:Name="McpServerList" Margin="0,6,0,0" MaxHeight="360"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ItemsSource="{Binding Servers}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,3">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="#888888" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                                <Setter Property="Fill" Value="{DynamicResource NodeSuccessBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                                                                <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                                                                <Setter Property="Fill" Value="{DynamicResource AccentTextBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding StateText}" Style="{StaticResource MutedTextStyle}" Margin="6,0,0,0" />
                                                            <TextBlock Text="{Binding ToolCount, StringFormat=· {0} tools}"
                                                                       Foreground="{DynamicResource NodeSuccessBrush}" Margin="6,0,0,0" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Error}"
                                                                   Foreground="{DynamicResource DangerBrush}"
                                                                   TextWrapping="Wrap" FontSize="11"
                                                                   Margin="14,1,0,0"
                                                                   Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter x:Name="LeftSplitter" Grid.Column="2" Width="4"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

            <!-- Main area: editor tabs + canvas or output. -->
            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="6,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <RadioButton x:Name="CanvasTab" Style="{StaticResource EditorTabStyle}"
                                         GroupName="MainTabs" Tag="canvas" IsChecked="True"
                                         Content="流程图" Click="OnMainTabClick" />
                            <RadioButton x:Name="OutputTab" Style="{StaticResource EditorTabStyle}"
                                         GroupName="MainTabs" Tag="output"
                                         Content="输出" Click="OnMainTabClick" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Ctrl+滚轮缩放" Style="{StaticResource MicroTextStyle}" />
                            <TextBlock Text="·" Style="{StaticResource MicroTextStyle}" Margin="8,0" />
                            <TextBlock Text="{Binding TotalElementText}" Style="{StaticResource MicroTextStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <!-- Canvas host. -->
                    <Grid x:Name="WorkflowContainer">
                        <Border x:Name="PART_SurfaceBorder"
                                BorderBrush="{DynamicResource CanvasBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <local:WorkflowGridDecorator x:Name="PART_GridDecorator">
                                <ScrollViewer x:Name="PART_ScrollViewer"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              PanningMode="Both">
                                    <Canvas x:Name="PART_Canvas"
                                            Width="{Binding Layout.ActualSize.Width}"
                                            Height="{Binding Layout.ActualSize.Height}"
                                            Background="Transparent"
                                            behaviors:ViewPool.ItemsSource="{Binding Helper.VisibleItems}"
                                            behaviors:ViewPool.TemplateSelector="{StaticResource NodeSelector}">
                                        <Canvas.RenderTransform>
                                            <TranslateTransform X="{Binding RulerThickness, ElementName=PART_GridDecorator}"
                                                                Y="{Binding RulerThickness, ElementName=PART_GridDecorator}" />
                                        </Canvas.RenderTransform>
                                    </Canvas>
                                </ScrollViewer>
                            </local:WorkflowGridDecorator>
                        </Border>
                        <behaviors:WorkflowMinimapOverlay x:Name="PART_MinimapOverlay"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch"
                                                          ScrollViewerName="PART_ScrollViewer"/>
                        <local:InfoOverlay x:Name="InfoOverlay"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Bottom"
                                           Margin="12,0,0,12"
                                           ScrollOffsetX="{Binding ScrollOffsetX, ElementName=PART_GridDecorator}"
                                           ScrollOffsetY="{Binding ScrollOffsetY, ElementName=PART_GridDecorator}"
                                           ContentOffsetX="{Binding ContentOffsetX, ElementName=PART_GridDecorator}"
                                           ContentOffsetY="{Binding ContentOffsetY, ElementName=PART_GridDecorator}"
                                           ViewportWidth="{Binding ActualWidth, ElementName=PART_SurfaceBorder}"
                                           ViewportHeight="{Binding ActualHeight, ElementName=PART_SurfaceBorder}" />
                    </Grid>

                    <!-- Output -->
                    <Grid x:Name="OutputPanel" Visibility="Collapsed" Background="{DynamicResource EditorBackgroundBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="执行输出" Style="{StaticResource PanelTitleTextStyle}" />
                                    <TextBlock Text="{Binding Runs.Selected.RootLabel}" Margin="8,0,0,0"
                                               Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"
                                               Visibility="{Binding Runs.HasSelection, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding Runs.Selected.StateText}" Margin="8,0,0,0"
                                               Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"
                                               Visibility="{Binding Runs.HasSelection, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding Runs.Selected.ProgressText}" Margin="8,0,0,0"
                                               Style="{StaticResource MicroTextStyle}" VerticalAlignment="Center"
                                               Visibility="{Binding Runs.HasSelection, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding ExecutionLog.Count, StringFormat=已记录 {0} 行}"
                                           Style="{StaticResource MicroTextStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" x:Name="ExecutionLogScroller" Margin="12,8,12,12" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="执行轨迹" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="运行一次，或让 Agent 编译 / 运行工作流。节点开始、完成、重试、重定向和运行收尾都会按发生顺序落在这里。"
                                           Style="{StaticResource MicroTextStyle}" TextWrapping="Wrap"
                                           Visibility="{Binding Runs.HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />
                                <ListBox ItemsSource="{Binding ExecutionLog}" Background="{DynamicResource PanelBackgroundBrush}" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding .}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5"
                                                       TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <GridSplitter x:Name="RightSplitter" Grid.Column="4" Width="4"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

            <!-- Right inspector -->
            <Border x:Name="InspectorHost" Grid.Column="5"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}" Height="34">
                        <Grid Margin="6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <RadioButton x:Name="PropertiesTab" Style="{StaticResource PanelTabStyle}"
                                             GroupName="RightTabs" Tag="properties" IsChecked="True"
                                             Content="属性" Click="OnRightTabClick" />
                                <RadioButton x:Name="AgentTab" Style="{StaticResource PanelTabStyle}"
                                             GroupName="RightTabs" Tag="agent"
                                             Content="Agent 对话" Click="OnRightTabClick" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <!-- Properties: the selected element, then the compiled structure. Run state and canvas
                             counts already live in the status bar and the run manager. -->
                        <ScrollViewer x:Name="PropertiesPanel" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="选中元素" Style="{StaticResource SectionTextStyle}" />
                                <Border Margin="12,0" Style="{StaticResource PropertyCardStyle}">
                                    <Grid>
                                        <StackPanel Visibility="{Binding HasSelectedElement, Converter={StaticResource BoolToVisibility}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SelectedElement.Label}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{Binding SelectedElement.KindText}"
                                                           Style="{StaticResource MutedTextStyle}" Margin="8,0,0,0" />
                                            </Grid>
                                            <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,8" />
                                            <TextBlock Text="{Binding SelectedElement.DetailText}"
                                                       FontFamily="{DynamicResource MonoFontFamily}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="定位" Margin="0,0,3,0"
                                                        Style="{StaticResource RowActionButtonStyle}"
                                                        HorizontalAlignment="Stretch" Click="OnLocateSelectedElement" />
                                                <Button Grid.Column="1" Content="删除" Margin="3,0,0,0"
                                                        Style="{StaticResource RowActionButtonStyle}"
                                                        HorizontalAlignment="Stretch" Click="OnDeleteSelectedElement" />
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock Text="在左侧「元素」列表里选一行，这里显示它的类型、位置、编译顺序与连接。"
                                                   Style="{StaticResource MicroTextStyle}" TextWrapping="Wrap"
                                                   Visibility="{Binding HasSelectedElement, Converter={StaticResource InverseBoolToVisibility}}" />
                                    </Grid>
                                </Border>

                                <TextBlock Text="编译结构" Style="{StaticResource SectionTextStyle}" />
                                <Border Margin="12,0,12,12" Style="{StaticResource PropertyCardStyle}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="分段" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Grid.Column="1" Text="{Binding CompiledStructure.Count, StringFormat={}{0} 段}"
                                                       Style="{StaticResource MicroTextStyle}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding CompiledStructure}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="{Binding Depth, Converter={StaticResource DepthIndent}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="58" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource WarningBrush}" FontSize="11" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="编译一次后这里列出实际执行段。" Style="{StaticResource MicroTextStyle}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding CompiledStructure.Count, Converter={StaticResource ZeroToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Agent -->
                        <Grid x:Name="AgentPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock Text="会话" Style="{StaticResource SectionTextStyle}" />
                                <Grid Margin="12,0,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="权限模式" Style="{StaticResource MutedTextStyle}"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox Grid.Column="1" x:Name="PermissionModePicker" MinWidth="120"
                                              HorizontalAlignment="Stretch"
                                              ToolTip="权限模式：决定哪些动作直接放行、哪些先问、哪些拒绝。宿主规则可以比模式更严，deny 规则在任何模式下都生效"
                                              SelectionChanged="OnPermissionModeChanged" />
                                </Grid>
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="12,8,12,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Agent 对话" Foreground="{DynamicResource AccentTextBrush}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="1" IsChecked="{Binding UseStreamingAgentResponse}"
                                          Content="流式" Foreground="{DynamicResource TextSecondaryBrush}"
                                          VerticalAlignment="Center" />
                            </Grid>
                            <ListBox Grid.Row="2" x:Name="AgentLogScroller" Margin="8,0"
                                     Background="{DynamicResource PanelBackgroundBrush}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ItemsSource="{Binding AgentLog}"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding .}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,2"
                                                   FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Grid.Row="3" Margin="12,6,12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AgentInput" Grid.Column="0" KeyDown="OnAgentInputKeyDown" />
                                <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Content="发送"
                                        Margin="6,0,0,0" Click="OnSendToAgent" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource StatusBarBackgroundBrush}"
                BorderBrush="{DynamicResource StatusBarBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,5,0"
                                     Visibility="{Binding IsWorkflowRunning, Converter={StaticResource BoolToVisibility}}" />
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,5,0"
                                     Visibility="{Binding IsWorkflowRunning, Converter={StaticResource InverseBoolToVisibility}}" />
                            <TextBlock Text="运行中" Foreground="{DynamicResource WarningBrush}" FontSize="11"
                                       Visibility="{Binding IsWorkflowRunning, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="空闲" Foreground="{DynamicResource StatusBarTextBrush}" FontSize="11"
                                       Visibility="{Binding IsWorkflowRunning, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatusItemStyle}">
                        <TextBlock Text="{Binding CompiledStructure.Count, StringFormat=编译 {0} 段}"
                                   Foreground="{DynamicResource StatusBarTextBrush}" FontSize="11" />
                    </Border>
                    <Border Style="{StaticResource StatusItemStyle}">
                        <TextBlock Text="{Binding TotalElementText, StringFormat=元素 {0}}"
                                   Foreground="{DynamicResource StatusBarTextBrush}" FontSize="11" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusItemStyle}">
                        <TextBlock Text="{Binding VisibleElementText, StringFormat=可见 {0}}"
                                   Foreground="{DynamicResource StatusBarTextBrush}" FontSize="11" />
                    </Border>
                    <Border Style="{StaticResource StatusItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71E;" FontFamily="{DynamicResource IconFontFamily}"
                                       Foreground="{DynamicResource StatusBarTextBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding Layout.Scale.Horizontal, Converter={StaticResource ZoomPercent}}"
                                       Foreground="{DynamicResource StatusBarTextBrush}" FontSize="11" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatusItemStyle}">
                        <TextBlock Text="Ctrl+滚轮缩放" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
