<UserControl x:Class="Demo.Views.Workflow.PythonNodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Demo.Views.Workflow"
             xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.WPF"
             mc:Ignorable="d"
             ClipToBounds="False"
             d:DesignHeight="260" d:DesignWidth="300"
             behaviors:WorkflowSlotLayoutBehavior.IsEnabled="True"
             behaviors:WorkflowSlotLayoutBehavior.SlotEnumeratorNames="PART_InputSlotsList,PART_OutputSlotsList"
             behaviors:WorkflowSlotLayoutBehavior.CoordinateHostName="PART_Canvas">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
	<!-- Viewbox: content scales to the collapsed node size; child pins to the design size (scale 1) so the factor is 1/scale. -->
	<Viewbox Stretch="Uniform">
    <Grid ClipToBounds="False" Width="280" Height="260">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2"
                CornerRadius="6"
                BorderThickness="1.5"
                BorderBrush="#6ec6ff"
                Background="#1e2a35" />

        <Border Grid.Row="0"
                Background="#253545"
                CornerRadius="4,4,0,0"
                BorderThickness="0,0,0,0.5"
                BorderBrush="#6ec6ff"
                behaviors:WorkflowNodeDragBehavior.CoordinateHostName="PART_Canvas"
                behaviors:WorkflowNodeDragBehavior.IsEnabled="True">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold" />
                <Border Margin="8,0,0,0" Background="#1f3d1f" BorderBrush="#7bd97b" BorderThickness="1"
                        CornerRadius="10" Padding="6,1"
                        Visibility="{Binding HasExecutionOrder, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ExecutionOrderText}" Foreground="#c8ffc8" FontWeight="Bold" />
                </Border>
                <Border Margin="8,0,0,0" Background="#2b2440" BorderBrush="#b799ff" BorderThickness="1"
                        CornerRadius="10" Padding="6,1">
                    <TextBlock Text="{Binding LastStatus}" Foreground="#e4d8ff" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#1e2a35" CornerRadius="0,0,4,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Purpose description (one-two lines, ellipsized) -->
                <Border Grid.Row="0" Padding="12,3" BorderBrush="#30363D" BorderThickness="0,0,0,1">
                    <TextBlock Text="{Binding Description}"
                               Foreground="#8B949E"
                               FontSize="10"
                               TextWrapping="Wrap"
                               MaxHeight="26" />
                </Border>

                <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="64" />
                </Grid.ColumnDefinitions>

                <!-- Input port strip (fixed, left) -->
                <ItemsControl Grid.Column="0"
                              ItemsSource="{Binding InputSlots.Items}"
                              x:Name="PART_InputSlotsList"
                              ClipToBounds="False"
                              VerticalAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4" ClipToBounds="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <local:SlotView Grid.Column="0"
                                                Width="16" Height="16"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Margin="-8,0,0,0"
                                                DataContext="{Binding Slot}"
                                                SlotState="{Binding State}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           Foreground="#6ec6ff"
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           Margin="4,0,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Python editor frame: a file-tab header, a dark code editor (the only part that scrolls), and a status bar. -->
                <Border Grid.Column="1"
                        Margin="4,6"
                        BorderThickness="1"
                        BorderBrush="#30363D"
                        CornerRadius="4"
                        Background="#0D1117">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Background="#161B22"
                                BorderThickness="0,0,0,1"
                                BorderBrush="#30363D"
                                Padding="8,4">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left"
                                           Text="script.py"
                                           Foreground="#7EE787"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                                <TextBlock DockPanel.Dock="Right"
                                           Text="Python 3"
                                           Foreground="#6E7681"
                                           FontSize="10" />
                            </DockPanel>
                        </Border>

                        <Border DockPanel.Dock="Bottom"
                                Background="#161B22"
                                BorderThickness="0,1,0,0"
                                BorderBrush="#30363D"
                                Padding="8,3">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="UTF-8" Foreground="#6E7681" FontSize="10" />
                                <TextBlock DockPanel.Dock="Right" FontSize="10" Foreground="#8B949E">
                                    <Run Text="{Binding LastRun, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding LastStatus, Mode=OneWay}" />
                                </TextBlock>
                            </DockPanel>
                        </Border>

                        <TextBox Text="{Binding Script, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Foreground="#E6EDF3"
                                 Background="#0D1117"
                                 CaretBrush="#6EC6FF"
                                 SelectionBrush="#264F78"
                                 BorderThickness="0"
                                 Padding="6,4"
                                 ToolTip="{Binding LastOutput}"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />
                    </DockPanel>
                </Border>

                <!-- Output port strip (fixed, right) -->
                <ItemsControl Grid.Column="2"
                              ItemsSource="{Binding OutputSlots.Items}"
                              x:Name="PART_OutputSlotsList"
                              ClipToBounds="False"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4" ClipToBounds="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Name}"
                                           Foreground="#6ec6ff"
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,4,0"
                                           TextTrimming="CharacterEllipsis" />
                                <local:SlotView Grid.Column="1"
                                                Width="16" Height="16"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,0,-8,0"
                                                DataContext="{Binding Slot}"
                                                PinDirection="Out"
                                                SlotState="{Binding State}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </Grid>
            </Grid>
        </Border>
    </Grid>
	</Viewbox>
</UserControl>
