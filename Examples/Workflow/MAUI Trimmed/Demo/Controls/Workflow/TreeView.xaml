<?xml version="1.0" encoding="utf-8" ?>
<!-- VeloxDev customization: Generate the Node, Slot, Link, selector, and grid-decorator templates, then update the local type names below if you renamed them. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Demo.Controls"
             xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.MAUI"
             x:Class="Demo.Controls.TreeView"
             x:Name="Root"
             behaviors:WorkflowSurfaceBehavior.IsEnabled="True" behaviors:WorkflowSurfaceBehavior.ZoomEnabled="True" behaviors:WorkflowSurfaceBehavior.ScrollViewerName="PART_ScrollViewer" behaviors:WorkflowSurfaceBehavior.CanvasName="PART_Canvas" behaviors:WorkflowSurfaceBehavior.GridDecoratorName="PART_GridDecorator" behaviors:WorkflowSurfaceBehavior.PointerPressSourceName="PART_SurfaceBorder" behaviors:WorkflowSurfaceBehavior.MinimapOverlayName="PART_MinimapOverlay" behaviors:WorkflowSurfaceBehavior.LinkMenuKey="LinkContextMenu">
    <ContentView.Resources>
        <DataTemplate x:Key="NodeTemplate">
            <local:NodeView WidthRequest="{Binding Size.Width}" HeightRequest="{Binding Size.Height}" />
        </DataTemplate>
        <!-- Nodes AND links share the pool: one view per visible item, each link drawn by its own
             path view (see LinkView.xaml.cs for the box its geometry is baked against). -->
        <DataTemplate x:Key="LinkTemplate">
            <local:LinkView StartHorizontal="{Binding Sender.Anchor.Horizontal}"
                            StartVertical="{Binding Sender.Anchor.Vertical}"
                            EndHorizontal="{Binding Receiver.Anchor.Horizontal}"
                            EndVertical="{Binding Receiver.Anchor.Vertical}"
                            CanRender="{Binding IsVisible}" />
        </DataTemplate>
        <local:CustomTemplateSelector x:Key="WorkflowTemplateSelector"
                                      NodeTemplate="{StaticResource NodeTemplate}"
                                      LinkTemplate="{StaticResource LinkTemplate}" />
        <!-- The link context menu: add or remove MenuFlyoutItem entries to change it. Each item's Command
             binds to the pressed link, so a new entry needs no code. The surface below shows this menu. -->
        <MenuFlyout x:Key="LinkContextMenu">
            <MenuFlyoutItem Text="Delete" Command="{Binding DeleteCommand}" />
        </MenuFlyout>
    </ContentView.Resources>

    <Grid>
        <Border x:Name="PART_SurfaceBorder"
                Stroke="#33FFFFFF"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 3"
                BackgroundColor="#1E1E1E">
            <local:WorkflowGridDecorator x:Name="PART_GridDecorator">
                <!-- Link input layer. The links themselves are drawn by their own views inside the
                     canvas; this layer hooks the surface's pointer and key events (this layer is
                     input-transparent) and forwards them to the Core interaction hub, and stays as the
                     painter for links no view draws. z order: grid < links < nodes < rulers. -->
                <behaviors:WorkflowLinkOverlay WorkflowTree="{Binding BindingContext, Source={x:Reference Root}}"
                                              InteractionSource="{x:Reference Root}"
                                              ScrollOffsetX="{Binding ScrollOffsetX, Source={x:Reference PART_GridDecorator}}"
                                              ScrollOffsetY="{Binding ScrollOffsetY, Source={x:Reference PART_GridDecorator}}"
                                              ContentOffsetX="{Binding ContentOffsetX, Source={x:Reference PART_GridDecorator}}"
                                              ContentOffsetY="{Binding ContentOffsetY, Source={x:Reference PART_GridDecorator}}"
                                              RulerThickness="{Binding RulerThickness, Source={x:Reference PART_GridDecorator}}"
                                              StrokeWidth="2" />
                <ScrollView x:Name="PART_ScrollViewer"
                            Orientation="Both">
                    <AbsoluteLayout x:Name="PART_RulerOffsetHost"
                                    TranslationX="{Binding RulerThickness, Source={x:Reference PART_GridDecorator}}"
                                    TranslationY="{Binding RulerThickness, Source={x:Reference PART_GridDecorator}}">
                        <AbsoluteLayout x:Name="PART_Canvas"
                                        BackgroundColor="Transparent"
                                        behaviors:ViewPool.ItemsSource="{Binding BindingContext.Helper.VisibleItems, Source={x:Reference Root}}"
                                        behaviors:ViewPool.TemplateSelector="{StaticResource WorkflowTemplateSelector}" />
                    </AbsoluteLayout>
                </ScrollView>
            </local:WorkflowGridDecorator>
        </Border>
        <local:MinimapOverlay x:Name="PART_MinimapOverlay"
                              HorizontalOptions="End"
                              VerticalOptions="Start"
                              Margin="0,12,12,0"
                              ScrollViewerName="PART_ScrollViewer" />
        <!-- Realtime canvas-info HUD (floating decorator layer, bottom-left). Refreshes from the Core
             model + the host's ScrollView.Scrolled (TreeView.xaml.cs). -->
        <local:InfoOverlay x:Name="InfoOverlay"
                           HorizontalOptions="Start"
                           VerticalOptions="End"
                           Margin="44,0,0,12" />
    </Grid>
</ContentView>
