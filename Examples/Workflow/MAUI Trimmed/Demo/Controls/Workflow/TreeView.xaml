<?xml version="1.0" encoding="utf-8" ?>
<!-- VeloxDev customization: Generate the Node, Slot, Link, selector, and grid-decorator templates, then update the local type names below if you renamed them. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Demo.Controls"
             xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.MAUI"
             x:Class="Demo.Controls.TreeView"
             behaviors:WorkflowSurfaceBehavior.IsEnabled="True" behaviors:WorkflowSurfaceBehavior.ZoomEnabled="True" behaviors:WorkflowSurfaceBehavior.ScrollViewerName="PART_ScrollViewer" behaviors:WorkflowSurfaceBehavior.CanvasName="PART_Canvas" behaviors:WorkflowSurfaceBehavior.GridDecoratorName="PART_GridDecorator" behaviors:WorkflowSurfaceBehavior.PointerPressSourceName="PART_SurfaceBorder" behaviors:WorkflowSurfaceBehavior.MinimapOverlayName="PART_MinimapOverlay">
    <ContentView.Resources>
        <DataTemplate x:Key="NodeTemplate">
            <local:NodeView WidthRequest="{Binding Size.Width}" HeightRequest="{Binding Size.Height}" />
        </DataTemplate>
        <DataTemplate x:Key="LinkTemplate">
            <local:LinkView StartLeft="{Binding Sender.Anchor.Horizontal}" StartTop="{Binding Sender.Anchor.Vertical}" EndLeft="{Binding Receiver.Anchor.Horizontal}" EndTop="{Binding Receiver.Anchor.Vertical}" CanRender="{Binding IsVisible}" />
        </DataTemplate>
        <local:CustomTemplateSelector x:Key="WorkflowTemplateSelector" NodeTemplate="{StaticResource NodeTemplate}" LinkTemplate="{StaticResource LinkTemplate}" />
    </ContentView.Resources>

    <Grid>
        <Border x:Name="PART_SurfaceBorder"
                Stroke="#33FFFFFF"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 3"
                BackgroundColor="#1E1E1E">
            <local:WorkflowGridDecorator x:Name="PART_GridDecorator">
                <ScrollView x:Name="PART_ScrollViewer"
                            Orientation="Both">
                    <AbsoluteLayout x:Name="PART_RulerOffsetHost"
                                    TranslationX="{Binding RulerThickness, Source={x:Reference PART_GridDecorator}}"
                                    TranslationY="{Binding RulerThickness, Source={x:Reference PART_GridDecorator}}">
                        <AbsoluteLayout x:Name="PART_Canvas"
                                        BackgroundColor="Transparent"
                                        behaviors:ViewPool.ItemsSource="{Binding Helper.VisibleItems}"
                                        behaviors:ViewPool.TemplateSelector="{StaticResource WorkflowTemplateSelector}" />
                    </AbsoluteLayout>
                </ScrollView>
            </local:WorkflowGridDecorator>
        </Border>
        <local:MinimapOverlay x:Name="PART_MinimapOverlay"
                              HorizontalOptions="End"
                              VerticalOptions="Start"
                              Margin="0,12,12,0"
                              ScrollViewerName="PART_ScrollViewer" />
        <!-- Realtime canvas-info HUD (floating decorator layer, bottom-left). Refreshes from the Core
             model + the host's ScrollView.Scrolled (TreeView.xaml.cs). -->
        <local:InfoOverlay x:Name="InfoOverlay"
                           HorizontalOptions="Start"
                           VerticalOptions="End"
                           Margin="44,0,0,12" />
    </Grid>
</ContentView>
