<!--
    节点卡共用的一套：简笔、暗色、靠字重与留白分区。放在这里而不是每张卡各写一遍 ——
    五张卡重复同一组色值与内边距，改一次要改五处，而且必然会漂（这个仓库的其它地方已经吃过这个亏）。

    与 Avalonia 版 CardTheme.axaml 是同一套色板与同一组类名，差别只在挂载方式：
    Avalonia 用 `Classes="card"` 的类选择器，MAUI 没有等价的类选择器（它的 StyleClass 是运行时
    在资源树里按名查找，本工程没法离线验证），所以这里把同一组 Setter 做成带 x:Key 的 Style，
    卡片用 `Style="{StaticResource Card...}"` 显式挂载 —— 落地的色值与字级完全一致，只是挂载点是
    属性而非类名。

    色板：
      卡面 #252526 ／ 边框 #3C3C3C（1px，圆角 8）／ 分隔线 #262626
      标题 #E7E7E7 12.5 SemiBold ／ 标签 #6E7681 10 ／ 正文 #A0A0A0 11.5
      输入底 #2A2A2A ／ 悬停底 #2A2D2E ／ 禁用字 #585858
    类型色条由各卡自己给（Controller #6E8BFF、Timer/Python #4FC1FF、Enum #C99BFF、兜底 #94A3B8）。
    MAUI 的 FontAttributes 只有 None/Bold/Italic，没有 SemiBold —— 标题在此落成 Bold。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ── 色板 ───────────────────────────────────────────────────────────── -->
    <Color x:Key="CardSurface">#252526</Color>
    <Color x:Key="CardBorder">#3C3C3C</Color>
    <Color x:Key="CardDivider">#262626</Color>
    <Color x:Key="CardTitleText">#E7E7E7</Color>
    <Color x:Key="CardLabelText">#6E7681</Color>
    <Color x:Key="CardValueText">#A0A0A0</Color>
    <Color x:Key="CardFieldSurface">#2A2A2A</Color>
    <Color x:Key="CardHoverSurface">#2A2D2E</Color>
    <Color x:Key="CardDisabledText">#585858</Color>
    <Color x:Key="CardDisabledBorder">#2E2E2E</Color>
    <Color x:Key="CardHoverBorder">#565656</Color>

    <!-- 标题行右侧那个执行序号 -->
    <Color x:Key="CardExecOrder">#7EE787</Color>

    <!-- 类型色条 -->
    <Color x:Key="AccentController">#6E8BFF</Color>
    <Color x:Key="AccentTimerPython">#4FC1FF</Color>
    <Color x:Key="AccentEnum">#C99BFF</Color>
    <Color x:Key="AccentFallback">#94A3B8</Color>

    <!-- 动作按钮的语义字色 -->
    <Color x:Key="GhostCompileText">#4FC1FF</Color>
    <Color x:Key="GhostRunText">#7EE787</Color>
    <Color x:Key="GhostStopText">#F85149</Color>
    <Color x:Key="GhostCloseText">#A0A0A0</Color>

    <!-- 代码面（Python 卡） -->
    <Color x:Key="CardCodeSurface">#0D1117</Color>
    <Color x:Key="CardCodeBorder">#262626</Color>
    <Color x:Key="CardCodeTitle">#7EE787</Color>
    <Color x:Key="CardCodeMuted">#585858</Color>

    <!-- ── 卡片外壳 ───────────────────────────────────────────────────────── -->

    <!-- 单层暗面 + 发丝边 -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CardSurface}" />
        <Setter Property="Stroke" Value="{StaticResource CardBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- 标题行左侧那条 2px 类型色条。圆角只削左上，与卡面左上角对齐 -->
    <Style x:Key="CardAccent" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 2" />
        <Setter Property="Margin" Value="0,8,0,8" />
    </Style>

    <!-- 分隔线。MAUI 的 Border 只有一条 StrokeThickness，写不出「只描底边」，
         所以分隔线是一条 1px 高的实心条（Avalonia 那边是 BorderThickness="0,0,0,1"） -->
    <Style x:Key="CardHairline" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CardDivider}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ── 字级 ───────────────────────────────────────────────────────────── -->

    <Style x:Key="CardTitle" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource CardTitleText}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="CardLabel" TargetType="Label">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="TextColor" Value="{StaticResource CardLabelText}" />
    </Style>

    <Style x:Key="CardValue" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource CardValueText}" />
    </Style>

    <!-- 插槽名（端口旁边那行小字） -->
    <Style x:Key="CardSlotName" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <!-- ── 输入 ───────────────────────────────────────────────────────────── -->

    <!-- 输入底 + 发丝边 + 圆角 6。MAUI 的 Entry/Picker 没有自己的边框与圆角属性，
         所以这一圈壳由外层 Border 提供，控件本身只留透明底与字色 -->
    <Style x:Key="CardFieldBox" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CardFieldSurface}" />
        <Setter Property="Stroke" Value="{StaticResource CardBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
        <Setter Property="Padding" Value="7,2" />
    </Style>

    <Style x:Key="CardField" TargetType="Entry">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource CardValueText}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource CardDisabledText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="0" />
    </Style>

    <Style x:Key="CardPicker" TargetType="Picker">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource CardValueText}" />
        <Setter Property="TitleColor" Value="{StaticResource CardLabelText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="0" />
    </Style>

    <Style x:Key="CardEditor" TargetType="Editor">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="monospace" />
        <Setter Property="TextColor" Value="{StaticResource CardValueText}" />
        <Setter Property="BackgroundColor" Value="{StaticResource CardCodeSurface}" />
        <Setter Property="MinimumHeightRequest" Value="0" />
    </Style>

    <!-- ── 状态胶囊（ExecutionOrder / LastStatus / LastRouted 那个小圆角框） ── -->
    <Style x:Key="CardPill" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CardHoverSurface}" />
        <Setter Property="Stroke" Value="{StaticResource CardBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 9" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="CardPillText" TargetType="Label">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="TextColor" Value="{StaticResource CardValueText}" />
    </Style>

    <!-- ── 代码面（Python 卡） ─────────────────────────────────────────────── -->
    <Style x:Key="CardCodeBox" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CardCodeSurface}" />
        <Setter Property="Stroke" Value="{StaticResource CardCodeBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="CardCodeHeader" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CardSurface}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 6,6,0,0" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- ── 动作按钮 ───────────────────────────────────────────────────────── -->

    <!--
        同形的「幽灵按钮」：透明底 + 发丝边 + 圆角 6，语义只体现在各卡给的前景色上，不靠高饱和色块。
        这些卡用的是同一个按钮样式，语义色由下面四个派生样式给（走 Style 而不是内联属性：
        VisualState 的 Setter 特异度高于 Style，但低于元素上的本地值 —— 内联写死字色，
        禁用态那份压暗的字色就盖不上去了）。
    -->
    <Style x:Key="CardGhost" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderColor" Value="{StaticResource CardBorder}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="11" />
        <!-- 平台默认的触摸目标（MAUI 模板给 Button 定的是 44）会把一排小按钮撑破卡片 -->
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="MinimumWidthRequest" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <!-- 悬停只抬边框与底，不换色 —— 动作语义已经写在各自的前景色里了 -->
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource CardHoverSurface}" />
                            <Setter Property="BorderColor" Value="{StaticResource CardHoverBorder}" />
                        </VisualState.Setters>
                    </VisualState>
                    <!-- 禁用态只压暗边与字，形状不变（默认 Button 样式会把它填成一块实灰，
                         在一排幽灵按钮里格外突兀） -->
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="Transparent" />
                            <Setter Property="BorderColor" Value="{StaticResource CardDisabledBorder}" />
                            <Setter Property="TextColor" Value="{StaticResource CardDisabledText}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="CardGhostCompile" TargetType="Button" BasedOn="{StaticResource CardGhost}">
        <Setter Property="TextColor" Value="{StaticResource GhostCompileText}" />
    </Style>

    <Style x:Key="CardGhostRun" TargetType="Button" BasedOn="{StaticResource CardGhost}">
        <Setter Property="TextColor" Value="{StaticResource GhostRunText}" />
    </Style>

    <Style x:Key="CardGhostStop" TargetType="Button" BasedOn="{StaticResource CardGhost}">
        <Setter Property="TextColor" Value="{StaticResource GhostStopText}" />
    </Style>

    <Style x:Key="CardGhostClose" TargetType="Button" BasedOn="{StaticResource CardGhost}">
        <Setter Property="TextColor" Value="{StaticResource GhostCloseText}" />
    </Style>

    <!-- ── 工作台外壳（标题条 / 活动栏 / 面板 / 状态栏） ─────────────────────
         与 Avalonia 版 Theme/Tokens.axaml、Theme/Styles.axaml 同一组色值与字级。
         外壳只补卡片色板没有的那几档（面板底、编辑器底、状态栏、强调蓝），
         其余直接复用上面的 Card* 资源 —— 整份 UI 仍然只有一个调色板。 -->

    <Color x:Key="WorkPanelBackground">#1F1F1F</Color>
    <Color x:Key="WorkEditorBackground">#141414</Color>
    <Color x:Key="WorkActivityBar">#181818</Color>
    <Color x:Key="WorkBorderSubtle">#262626</Color>
    <Color x:Key="WorkBorder">#333333</Color>
    <Color x:Key="WorkBorderStrong">#404040</Color>
    <Color x:Key="WorkDivider">#2B2B2B</Color>
    <Color x:Key="WorkTextTertiary">#6E7681</Color>
    <Color x:Key="WorkAccent">#0078D4</Color>
    <Color x:Key="WorkAccentText">#4FC1FF</Color>
    <Color x:Key="WorkWarning">#D29922</Color>
    <Color x:Key="WorkDanger">#F85149</Color>
    <Color x:Key="WorkStatusText">#B8B8B8</Color>
    <Color x:Key="WorkRowSelection">#1AFFFFFF</Color>
    <Color x:Key="WorkActivityActive">#14FFFFFF</Color>

    <Style x:Key="WorkbenchTitle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource CardTitleText}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="WorkbenchPanelTitle" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource CardValueText}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="WorkbenchSectionLabel" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource CardValueText}" />
        <Setter Property="Margin" Value="12,14,12,6" />
    </Style>

    <Style x:Key="WorkbenchMuted" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{StaticResource WorkTextTertiary}" />
    </Style>

    <Style x:Key="WorkbenchMicro" TargetType="Label">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="TextColor" Value="{StaticResource WorkTextTertiary}" />
    </Style>

    <Style x:Key="WorkbenchValue" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{StaticResource CardTitleText}" />
    </Style>

    <Style x:Key="WorkbenchStatusText" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{StaticResource WorkStatusText}" />
    </Style>

    <Style x:Key="WorkbenchTabLabel" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource WorkTextTertiary}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="WorkbenchPanelTabLabel" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{StaticResource WorkTextTertiary}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- 行内动作：无底无边的轻按钮。类选择器在 MAUI 里不可用，所以用显式 Style 挂载。 -->
    <Style x:Key="WorkbenchRowAction" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="TextColor" Value="{StaticResource WorkTextTertiary}" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="MinimumWidthRequest" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource CardHoverSurface}" />
                            <Setter Property="TextColor" Value="{StaticResource CardTitleText}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource CardDisabledText}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="WorkbenchIconButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="WidthRequest" Value="26" />
        <Setter Property="HeightRequest" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource CardValueText}" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="MinimumWidthRequest" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource CardHoverSurface}" />
                            <Setter Property="TextColor" Value="{StaticResource CardTitleText}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="WorkbenchMenuButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{StaticResource CardValueText}" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="MinimumWidthRequest" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource CardHoverSurface}" />
                            <Setter Property="TextColor" Value="{StaticResource CardTitleText}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="WorkbenchCommandCenter" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource CardFieldSurface}" />
        <Setter Property="BorderColor" Value="{StaticResource CardBorder}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HeightRequest" Value="24" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{StaticResource CardLabelText}" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="MinimumWidthRequest" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource CardHoverSurface}" />
                            <Setter Property="BorderColor" Value="{StaticResource CardHoverBorder}" />
                            <Setter Property="TextColor" Value="{StaticResource CardValueText}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="WorkbenchSendButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource WorkAccent}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HeightRequest" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="MinimumWidthRequest" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#1184DE" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- 命令中心是 Border + TapGestureRecognizer：MAUI 的 Button 只有文本，挂不了搜索框那一行。 -->
    <Style x:Key="WorkbenchCommandCenterBox" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CardFieldSurface}" />
        <Setter Property="Stroke" Value="{StaticResource CardBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 4" />
        <Setter Property="HeightRequest" Value="24" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <Style x:Key="WorkbenchCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CardSurface}" />
        <Setter Property="Stroke" Value="{StaticResource CardBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <Style x:Key="WorkbenchFieldBox" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CardFieldSurface}" />
        <Setter Property="Stroke" Value="{StaticResource CardBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 4" />
        <Setter Property="Padding" Value="7,0" />
    </Style>

    <Style x:Key="WorkbenchEntry" TargetType="Entry">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource CardTitleText}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource CardDisabledText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="HeightRequest" Value="30" />
    </Style>

    <Style x:Key="WorkbenchPicker" TargetType="Picker">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource CardValueText}" />
        <Setter Property="TitleColor" Value="{StaticResource CardLabelText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="HeightRequest" Value="30" />
    </Style>

</ResourceDictionary>
