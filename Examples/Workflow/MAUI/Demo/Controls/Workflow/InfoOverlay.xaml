<?xml version="1.0" encoding="utf-8" ?>
<!-- 实时画布信息 HUD：根层 InputTransparent（CascadeInputTransparent=False），Border 与 Label 同样
     不吃点击，只留“复制”按钮可交互；宿主在滚动/视口变化时刷新，数据订阅 Core 模型 -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Demo.Controls.InfoOverlay">
    <Grid InputTransparent="True" CascadeInputTransparent="False">
        <Border InputTransparent="True"
                Stroke="#CC8EA3B8"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 6"
                BackgroundColor="#E612151B"
                Padding="12,8,58,8">
            <Label x:Name="InfoText"
                   TextColor="#DDE4EA"
                   FontSize="12"
                   LineHeight="1.3"
                   InputTransparent="True" />
        </Border>
        <Button x:Name="CopyButton"
                Text="复制"
                FontSize="11"
                Padding="8,2"
                Margin="0,0,8,8"
                HorizontalOptions="End"
                VerticalOptions="End"
                BackgroundColor="#1E3A5F"
                TextColor="#7EC8FF"
                BorderColor="#7EC8FF"
                BorderWidth="1"
                Clicked="OnCopyClicked" />
    </Grid>
</ContentView>
