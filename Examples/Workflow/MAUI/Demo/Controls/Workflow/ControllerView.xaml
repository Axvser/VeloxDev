<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Demo.ViewModels;assembly=Lib"
             xmlns:controls="clr-namespace:Demo.Controls"
             xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.MAUI"
             x:Class="Demo.Controls.ControllerView"
             behaviors:WorkflowSlotLayoutBehavior.IsEnabled="True"
             behaviors:WorkflowSlotLayoutBehavior.SlotNames="PART_OutputSlot"
             behaviors:WorkflowSlotLayoutBehavior.CoordinateHostName="PART_Canvas">
    <Grid RowDefinitions="52,*,88">
        <Border Grid.RowSpan="3"
                Stroke="White"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 5"
                BackgroundColor="#2D2D2D" />

        <Border Grid.Row="0"
                BackgroundColor="#2D2D2D"
                StrokeShape="RoundRectangle 5,5,0,0"
                behaviors:WorkflowNodeDragBehavior.CoordinateHostName="PART_Canvas"
                behaviors:WorkflowNodeDragBehavior.IsEnabled="True">
            <Label Text="Network Flow Controller"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   TextColor="White" />
        </Border>

        <Border Grid.Row="1" BackgroundColor="#252525" Padding="12">
            <ScrollView>
            <VerticalStackLayout Spacing="4">
                <Label Text="Seed" TextColor="#DCDCDC" FontSize="11" />
                <Entry Text="{Binding SeedPayload}" FontSize="11" />
            </VerticalStackLayout>
            </ScrollView>
        </Border>

        <Border Grid.Row="2" BackgroundColor="#2D2D2D" StrokeShape="RoundRectangle 0,0,5,5" Padding="8">
            <Grid RowDefinitions="*,*" ColumnDefinitions="*,*" ColumnSpacing="6" RowSpacing="6">
                <Button Grid.Row="0" Grid.Column="0" Text="Compile"
                        BackgroundColor="#1E3A5F" TextColor="White"
                        HorizontalOptions="Fill" VerticalOptions="Fill"
                        Command="{Binding CompileCommand}" />
                <Button Grid.Row="0" Grid.Column="1" Text="Run"
                        BackgroundColor="#1E5F2E" TextColor="White"
                        HorizontalOptions="Fill" VerticalOptions="Fill"
                        IsEnabled="{Binding HasCompiledGraphs}"
                        Command="{Binding RunCommand}" />
                <Button Grid.Row="1" Grid.Column="0" Text="Stop"
                        BackgroundColor="#5F1E1E" TextColor="White"
                        HorizontalOptions="Fill" VerticalOptions="Fill"
                        Command="{Binding StopCommand}" />
                <Button Grid.Row="1" Grid.Column="1" Text="Close"
                        BackgroundColor="#1E1E1E" TextColor="White"
                        HorizontalOptions="Fill" VerticalOptions="Fill"
                        Command="{Binding CloseWorkflowCommand}" />
            </Grid>
        </Border>

        <controls:SlotView x:Name="PART_OutputSlot"
                           WidthRequest="20"
                           HeightRequest="20"
                           Grid.RowSpan="3"
                           HorizontalOptions="End"
                           VerticalOptions="Center"
                           Margin="0,0,-10,0"
                           BindingContext="{Binding OutputSlot}"
                           SlotState="{Binding State}" />
    </Grid>
</ContentView>
