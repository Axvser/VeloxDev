<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Demo.Controls"
             xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.MAUI"
             xmlns:vm="clr-namespace:Demo.ViewModels;assembly=Lib"
             xmlns:workflow="clr-namespace:VeloxDev.WorkflowSystem;assembly=VeloxDev.Core"
             x:Class="Demo.Controls.WorkflowView"
             x:Name="Root"
             behaviors:WorkflowSurfaceBehavior.IsEnabled="True" behaviors:WorkflowSurfaceBehavior.ZoomEnabled="True"
             behaviors:WorkflowSurfaceBehavior.ScrollViewerName="PART_ScrollViewer"
             behaviors:WorkflowSurfaceBehavior.CanvasName="PART_Canvas"
             behaviors:WorkflowSurfaceBehavior.GridDecoratorName="PART_GridDecorator"
             behaviors:WorkflowSurfaceBehavior.PointerPressSourceName="PART_SurfaceBorder"
             behaviors:WorkflowSurfaceBehavior.MinimapOverlayName="PART_MinimapOverlay"
             behaviors:WorkflowSurfaceBehavior.LinkMenuKey="LinkContextMenu">
    <ContentView.Resources>
        <DataTemplate x:Key="NodeTemplate">
            <controls:NodeView WidthRequest="{Binding Size.Width}"
                               HeightRequest="{Binding Size.Height}" />
        </DataTemplate>
        <DataTemplate x:Key="ControllerTemplate" x:DataType="vm:ControllerViewModel">
            <controls:ControllerView WidthRequest="{Binding Size.Width}"
                                     HeightRequest="{Binding Size.Height}" />
        </DataTemplate>
        <DataTemplate x:Key="EnumSelectorTemplate" x:DataType="vm:EnumSelectorNodeViewModel">
            <controls:EnumSelectorNodeView WidthRequest="{Binding Size.Width}"
                                           HeightRequest="{Binding Size.Height}" />
        </DataTemplate>
        <DataTemplate x:Key="PythonTemplate" x:DataType="vm:PythonScriptNodeViewModel">
            <controls:PythonNodeView WidthRequest="{Binding Size.Width}"
                                     HeightRequest="{Binding Size.Height}" />
        </DataTemplate>
        <DataTemplate x:Key="TimerTemplate" x:DataType="vm:TimerNodeViewModel">
            <controls:TimerNodeView WidthRequest="{Binding Size.Width}"
                                    HeightRequest="{Binding Size.Height}" />
        </DataTemplate>
        <controls:CustomTemplateSelector x:Key="NodeSelector"
                                         ControllerTemplate="{StaticResource ControllerTemplate}"
                                         NodeTemplate="{StaticResource NodeTemplate}"
                                         EnumSelectorTemplate="{StaticResource EnumSelectorTemplate}"
                                         PythonTemplate="{StaticResource PythonTemplate}"
                                         TimerTemplate="{StaticResource TimerTemplate}" />
        <!-- The link context menu: add or remove MenuFlyoutItem entries to change it. Each item's Command
             binds to the pressed link, so a new entry needs no code. The surface below shows this menu. -->
        <MenuFlyout x:Key="LinkContextMenu">
            <MenuFlyoutItem Text="Delete" Command="{Binding DeleteCommand}" />
        </MenuFlyout>

        <!-- VS Code-style sidebar: a flat section heading and compact action row. -->
        <Style x:Key="SidebarSectionStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#BBBBBB" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="12,14,12,6" />
        </Style>
        <Style x:Key="SidebarActionButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="#CCCCCC" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HeightRequest" Value="26" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
    </ContentView.Resources>

    <Grid ColumnDefinitions="Auto,*">
        <!-- Left rail: 48px activity bar plus the 300px sidebar. -->
        <Grid Grid.Column="0" ColumnDefinitions="48,300">
            <!-- Activity bar -->
            <Border Grid.Column="0" BackgroundColor="#333333" StrokeThickness="0">
                <VerticalStackLayout Spacing="0">
                    <Grid x:Name="ActivityExplorer"
                          HeightRequest="48"
                          WidthRequest="48"
                          BackgroundColor="#333333"
                          ToolTipProperties.Text="资源管理器">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnActivityTapped" CommandParameter="explorer" />
                        </Grid.GestureRecognizers>
                        <BoxView x:Name="ActivityExplorerIndicator"
                                 WidthRequest="2"
                                 HorizontalOptions="Start"
                                 Color="#007ACC"
                                 InputTransparent="True" />
                        <!-- A document outline. -->
                        <Path Data="M5,3 L13,3 L19,9 L19,21 L5,21 Z M13,3 L13,9 L19,9 M8,13 L16,13 M8,16 L16,16"
                              Fill="Transparent"
                              Stroke="#CCCCCC"
                              StrokeThickness="1.4"
                              Aspect="Uniform"
                              WidthRequest="20"
                              HeightRequest="20"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              InputTransparent="True" />
                    </Grid>

                    <Grid x:Name="ActivityRun"
                          HeightRequest="48"
                          WidthRequest="48"
                          BackgroundColor="#333333"
                          ToolTipProperties.Text="运行">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnActivityTapped" CommandParameter="run" />
                        </Grid.GestureRecognizers>
                        <BoxView x:Name="ActivityRunIndicator"
                                 WidthRequest="2"
                                 HorizontalOptions="Start"
                                 Color="Transparent"
                                 InputTransparent="True" />
                        <!-- A play triangle. -->
                        <Path Data="M8,4 L20,12 L8,20 Z"
                              Fill="#CCCCCC"
                              Aspect="Uniform"
                              WidthRequest="20"
                              HeightRequest="20"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              InputTransparent="True" />
                    </Grid>

                    <Grid x:Name="ActivityAgent"
                          HeightRequest="48"
                          WidthRequest="48"
                          BackgroundColor="#333333"
                          ToolTipProperties.Text="Agent 对话">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnActivityTapped" CommandParameter="agent" />
                        </Grid.GestureRecognizers>
                        <BoxView x:Name="ActivityAgentIndicator"
                                 WidthRequest="2"
                                 HorizontalOptions="Start"
                                 Color="Transparent"
                                 InputTransparent="True" />
                        <!-- A chat bubble. -->
                        <Path Data="M4,4 L20,4 L20,15 L11,15 L7,20 L7,15 L4,15 Z"
                              Fill="Transparent"
                              Stroke="#CCCCCC"
                              StrokeThickness="1.4"
                              Aspect="Uniform"
                              WidthRequest="20"
                              HeightRequest="20"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              InputTransparent="True" />
                    </Grid>

                    <Grid x:Name="ActivityMcp"
                          HeightRequest="48"
                          WidthRequest="48"
                          BackgroundColor="#333333"
                          ToolTipProperties.Text="MCP 服务器">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnActivityTapped" CommandParameter="mcp" />
                        </Grid.GestureRecognizers>
                        <BoxView x:Name="ActivityMcpIndicator"
                                 WidthRequest="2"
                                 HorizontalOptions="Start"
                                 Color="Transparent"
                                 InputTransparent="True" />
                        <!-- A plug. -->
                        <Path Data="M9,3 L9,7 M15,3 L15,7 M6,7 L18,7 L18,11 C18,14.3 15.3,17 12,17 C8.7,17 6,14.3 6,11 Z M12,17 L12,21"
                              Fill="Transparent"
                              Stroke="#CCCCCC"
                              StrokeThickness="1.4"
                              Aspect="Uniform"
                              WidthRequest="20"
                              HeightRequest="20"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              InputTransparent="True" />
                    </Grid>

                    <Grid x:Name="ActivityOutput"
                          HeightRequest="48"
                          WidthRequest="48"
                          BackgroundColor="#333333"
                          ToolTipProperties.Text="执行输出">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnActivityTapped" CommandParameter="output" />
                        </Grid.GestureRecognizers>
                        <BoxView x:Name="ActivityOutputIndicator"
                                 WidthRequest="2"
                                 HorizontalOptions="Start"
                                 Color="Transparent"
                                 InputTransparent="True" />
                        <!-- A terminal prompt. -->
                        <Path Data="M4,4 L20,4 L20,20 L4,20 Z M7,9 L10,12 L7,15 M12,15 L17,15"
                              Fill="Transparent"
                              Stroke="#CCCCCC"
                              StrokeThickness="1.4"
                              Aspect="Uniform"
                              WidthRequest="20"
                              HeightRequest="20"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              InputTransparent="True" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Sidebar -->
            <Border Grid.Column="1" BackgroundColor="#252526" StrokeThickness="0">
                <Grid RowDefinitions="Auto,*">
                    <Label x:Name="SidebarHeader"
                           Grid.Row="0"
                           Text="资源管理器"
                           Margin="12,12,12,4"
                           TextColor="#CCCCCC"
                           FontSize="11"
                           FontAttributes="Bold" />

                    <Grid Grid.Row="1">
                        <!-- Explorer: file actions and the element list. -->
                        <ScrollView x:Name="ExplorerPanel" VerticalScrollBarVisibility="Default">
                            <VerticalStackLayout Spacing="0">
                                <HorizontalStackLayout Margin="10,2,10,0" Spacing="2">
                                    <Button Text="保存"
                                            Style="{StaticResource SidebarActionButtonStyle}"
                                            ToolTipProperties.Text="保存工作流"
                                            Clicked="OnSaveClicked" />
                                    <Button Text="加载"
                                            Style="{StaticResource SidebarActionButtonStyle}"
                                            ToolTipProperties.Text="加载工作流"
                                            Clicked="OnSelectClicked" />
                                    <Button Text="撤销"
                                            Style="{StaticResource SidebarActionButtonStyle}"
                                            ToolTipProperties.Text="撤销"
                                            Command="{Binding UndoCommand}" />
                                    <Button Text="重做"
                                            Style="{StaticResource SidebarActionButtonStyle}"
                                            ToolTipProperties.Text="重做"
                                            Command="{Binding RedoCommand}" />
                                    <Button Text="重载"
                                            Style="{StaticResource SidebarActionButtonStyle}"
                                            ToolTipProperties.Text="重新载入示例"
                                            Clicked="OnLoadNetworkDemoClicked" />
                                </HorizontalStackLayout>

                                <Label Text="元素" Style="{StaticResource SidebarSectionStyle}" />

                                <!-- Element list: nodes, slots and links from the tree, each row can
                                     Locate / Delete. Fixed heights let the three lists scroll here. -->
                                <Border Margin="12,0,12,0"
                                        Padding="10"
                                        BackgroundColor="#202020"
                                        Stroke="#4C4C4C"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 4">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="元素（从 Tree 加载）"
                                               TextColor="#7EC8FF"
                                               FontAttributes="Bold" />

                                        <Label Text="节点"
                                               TextColor="#B0B0B0"
                                               FontSize="11" />
                                        <CollectionView x:Name="ElementNodeList"
                                                        HeightRequest="150"
                                                        SelectionMode="None">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate x:DataType="vm:WorkflowElementEntry">
                                                    <Grid ColumnDefinitions="*,Auto,Auto"
                                                          ColumnSpacing="4"
                                                          Margin="0,1">
                                                        <Label Text="{Binding Label}"
                                                               TextColor="#E0E0E0"
                                                               FontSize="10"
                                                               VerticalTextAlignment="Center"
                                                               LineBreakMode="TailTruncation" />
                                                        <Button Grid.Column="1"
                                                                Text="Locate"
                                                                FontSize="9"
                                                                Padding="4,0"
                                                                HeightRequest="24"
                                                                BackgroundColor="#0F3460"
                                                                TextColor="#7EC8FF"
                                                                Clicked="OnLocateElement" />
                                                        <Button Grid.Column="2"
                                                                Text="Delete"
                                                                FontSize="9"
                                                                Padding="4,0"
                                                                HeightRequest="24"
                                                                BackgroundColor="#0F3460"
                                                                TextColor="#7EC8FF"
                                                                Clicked="OnDeleteElement" />
                                                    </Grid>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>

                                        <Label Text="插槽"
                                               TextColor="#B0B0B0"
                                               FontSize="11" />
                                        <CollectionView x:Name="ElementSlotList"
                                                        HeightRequest="150"
                                                        SelectionMode="None">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate x:DataType="vm:WorkflowElementEntry">
                                                    <Grid ColumnDefinitions="*,Auto,Auto"
                                                          ColumnSpacing="4"
                                                          Margin="0,1">
                                                        <Label Text="{Binding Label}"
                                                               TextColor="#E0E0E0"
                                                               FontSize="10"
                                                               VerticalTextAlignment="Center"
                                                               LineBreakMode="TailTruncation" />
                                                        <Button Grid.Column="1"
                                                                Text="Locate"
                                                                FontSize="9"
                                                                Padding="4,0"
                                                                HeightRequest="24"
                                                                BackgroundColor="#0F3460"
                                                                TextColor="#7EC8FF"
                                                                Clicked="OnLocateElement" />
                                                        <Button Grid.Column="2"
                                                                Text="Delete"
                                                                FontSize="9"
                                                                Padding="4,0"
                                                                HeightRequest="24"
                                                                BackgroundColor="#0F3460"
                                                                TextColor="#7EC8FF"
                                                                Clicked="OnDeleteElement" />
                                                    </Grid>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>

                                        <Label Text="连线"
                                               TextColor="#B0B0B0"
                                               FontSize="11" />
                                        <CollectionView x:Name="ElementLinkList"
                                                        HeightRequest="150"
                                                        SelectionMode="None">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate x:DataType="vm:WorkflowElementEntry">
                                                    <Grid ColumnDefinitions="*,Auto,Auto"
                                                          ColumnSpacing="4"
                                                          Margin="0,1">
                                                        <Label Text="{Binding Label}"
                                                               TextColor="#E0E0E0"
                                                               FontSize="10"
                                                               VerticalTextAlignment="Center"
                                                               LineBreakMode="TailTruncation" />
                                                        <Button Grid.Column="1"
                                                                Text="Locate"
                                                                FontSize="9"
                                                                Padding="4,0"
                                                                HeightRequest="24"
                                                                BackgroundColor="#0F3460"
                                                                TextColor="#7EC8FF"
                                                                Clicked="OnLocateElement" />
                                                        <Button Grid.Column="2"
                                                                Text="Delete"
                                                                FontSize="9"
                                                                Padding="4,0"
                                                                HeightRequest="24"
                                                                BackgroundColor="#0F3460"
                                                                TextColor="#7EC8FF"
                                                                Clicked="OnDeleteElement" />
                                                    </Grid>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>

                                        <Label x:Name="ElementStatus"
                                               TextColor="#A0A0A0"
                                               FontSize="10"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </ScrollView>

                        <!-- Run: pause / resume / checkpoint and the canvas counts. -->
                        <ScrollView x:Name="RunPanel"
                                    IsVisible="False"
                                    VerticalScrollBarVisibility="Default">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="运行" Style="{StaticResource SidebarSectionStyle}" />
                                <Border Margin="12,0,12,0"
                                        Padding="10"
                                        BackgroundColor="#1E1E1E"
                                        Stroke="#3C3C3C"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 4">
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="运行控制" TextColor="#E2E8F0" FontAttributes="Bold" VerticalOptions="Center"/>
                                            <Label x:Name="RunGateState" Grid.Column="1" Text="空闲" TextColor="#A0A0A0" VerticalOptions="Center"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                            <Button Text="Pause"
                                                    HeightRequest="40"
                                                    BackgroundColor="#0f3460"
                                                    TextColor="White"
                                                    Clicked="OnPauseClicked"/>
                                            <Button Grid.Column="1"
                                                    Text="Resume"
                                                    HeightRequest="40"
                                                    BackgroundColor="#0f3460"
                                                    TextColor="White"
                                                    Clicked="OnResumeClicked"/>
                                        </Grid>
                                        <Button x:Name="ContinueFromCheckpointButton"
                                                Text="从检查点继续"
                                                HeightRequest="40"
                                                BackgroundColor="#0f3460"
                                                TextColor="White"
                                                IsEnabled="False"
                                                Clicked="OnContinueFromCheckpointClicked"/>
                                    </VerticalStackLayout>
                                </Border>

                                <Label Text="画布" Style="{StaticResource SidebarSectionStyle}" />
                                <VerticalStackLayout Margin="12,0,12,0">
                                    <Label Text="总元素数：" TextColor="#CCCCCC"/>
                                    <Label Text="{Binding TotalElementText}" TextColor="#E7E7E7"/>
                                    <Label Margin="0,8,0,0" Text="可见元素数：" TextColor="#CCCCCC"/>
                                    <Label Text="{Binding VisibleElementText}" TextColor="#E7E7E7"/>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </ScrollView>

                        <!-- Agent: session permission first, then the chat. -->
                        <Grid x:Name="AgentPanel"
                              IsVisible="False"
                              RowDefinitions="Auto,Auto,*,Auto">
                            <!-- Session permission belongs to the Agent: it decides what the model may do,
                                 not how a run is driven. It is not the AgentModes build/plan pair, which
                                 changes what the model is told; this one changes what is allowed to run. -->
                            <VerticalStackLayout Grid.Row="0" Margin="0,0,0,4">
                                <Label Text="会话" Style="{StaticResource SidebarSectionStyle}" />
                                <Grid Margin="12,0,12,0" ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                    <Label Text="权限模式"
                                           TextColor="#CCCCCC"
                                           VerticalOptions="Center" />
                                    <Picker Grid.Column="1"
                                            x:Name="PermissionModePicker"
                                            TextColor="White"
                                            FontSize="12"
                                            HorizontalOptions="Fill"
                                            ToolTipProperties.Text="权限模式：决定哪些动作直接放行、哪些先问、哪些拒绝。宿主规则可以比模式更严，deny 规则在任何模式下都生效"
                                            SelectedIndexChanged="OnPermissionModeChanged" />
                                </Grid>
                            </VerticalStackLayout>

                            <Grid Grid.Row="1" Margin="12,4,12,4" ColumnDefinitions="*,Auto">
                                <Label Text="Agent 对话"
                                       TextColor="#7EC8FF"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="流式"
                                           TextColor="#CBD5E1"
                                           FontSize="11"
                                           VerticalTextAlignment="Center" />
                                    <Switch IsToggled="{Binding UseStreamingAgentResponse}"
                                            Scale="0.7" />
                                </HorizontalStackLayout>
                            </Grid>

                            <CollectionView x:Name="AgentLogScroller"
                                            Grid.Row="2"
                                            Margin="8,0,8,0"
                                            VerticalScrollBarVisibility="Always"
                                            ItemsSource="{Binding AgentLog}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Label Text="{Binding .}"
                                               TextColor="#D8D8D8"
                                               FontSize="10"
                                               Margin="0,1" />
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <Grid Grid.Row="3" Margin="12,6,12,12" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                <Entry x:Name="AgentInput"
                                       Placeholder="输入消息..."
                                       BackgroundColor="#2D2D2D"
                                       TextColor="White"
                                       FontSize="12"
                                       HeightRequest="32"
                                       Completed="OnAgentInputCompleted" />
                                <Button Grid.Column="1"
                                        Text="发送"
                                        FontSize="12"
                                        HeightRequest="32"
                                        BackgroundColor="#0f3460"
                                        TextColor="White"
                                        Clicked="OnSendToAgent" />
                            </Grid>
                        </Grid>

                        <!-- MCP servers -->
                        <ScrollView x:Name="McpPanel"
                                    IsVisible="False"
                                    VerticalScrollBarVisibility="Default">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="服务器" Style="{StaticResource SidebarSectionStyle}" />
                                <Border x:Name="McpStatusPanel"
                                        Margin="12,0,12,0"
                                        Padding="10"
                                        BackgroundColor="#1E1E1E"
                                        Stroke="#3C3C3C"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 4">
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="MCP 服务器" TextColor="#7EC8FF" FontAttributes="Bold" VerticalOptions="Center"/>
                                            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                                <Label Text="{Binding Helper.Mcp.Status.ConnectedCount, StringFormat='存活 {0}'}" TextColor="#6BFFB8" FontAttributes="Bold"/>
                                                <Label Text="{Binding Helper.Mcp.Status.ErrorCount, StringFormat='· 错误 {0}'}" TextColor="#FF6B6B"/>
                                                <Button Text="重载" FontSize="11" Clicked="OnReloadMcp"/>
                                            </HorizontalStackLayout>
                                        </Grid>
                                        <CollectionView ItemsSource="{Binding Helper.Mcp.Status.Servers}" HeightRequest="140">
                                            <CollectionView.ItemsLayout>
                                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="2"/>
                                            </CollectionView.ItemsLayout>
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate>
                                                    <VerticalStackLayout Spacing="2">
                                                        <HorizontalStackLayout Spacing="6">
                                                            <Label Text="{Binding Name}" TextColor="#E0E0E0" FontAttributes="Bold"/>
                                                            <Label Text="{Binding StateText}" TextColor="#A0A0A0"/>
                                                            <Label Text="{Binding ToolCount, StringFormat='· {0} tools'}" TextColor="#6BFFB8"/>
                                                        </HorizontalStackLayout>
                                                        <Label Text="{Binding Error}" TextColor="#FF6B6B" FontSize="11"
                                                               IsVisible="{Binding IsError}"/>
                                                    </VerticalStackLayout>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </ScrollView>

                        <!-- Output: the tree's ExecutionLog. -->
                        <Grid x:Name="OutputPanel"
                              IsVisible="False"
                              RowDefinitions="Auto,Auto,*">
                            <Label Grid.Row="0" Text="执行输出" Style="{StaticResource SidebarSectionStyle}" />
                            <Label Grid.Row="1"
                                   Text="{Binding ExecutionLog.Count, StringFormat='已记录: {0}'}"
                                   Margin="12,0,12,4"
                                   TextColor="#BDBDBD"
                                   FontSize="11" />
                            <CollectionView x:Name="ExecutionLogScroller"
                                            Grid.Row="2"
                                            Margin="8,0,8,8"
                                            VerticalScrollBarVisibility="Always"
                                            ItemsSource="{Binding ExecutionLog}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Label Text="{Binding .}"
                                               TextColor="#D8D8D8"
                                               FontSize="10"
                                               LineBreakMode="WordWrap"
                                               Margin="4,1" />
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Workflow surface -->
        <Grid Grid.Column="1">
            <Border x:Name="PART_SurfaceBorder"
                    Margin="0"
                    Stroke="#33FFFFFF"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 3"
                    BackgroundColor="#0B1120">
                <controls:WorkflowGridDecorator x:Name="PART_GridDecorator">
                    <!-- Viewport-sized link layer: a sibling of the scroll viewer (NOT inside the
                         growing world canvas, so it never hits the Win2D texture cap). Renders every
                         connection in one GraphicsView at px = Ruler + anchor + ContentOffset − Scroll.
                         Child order gives z: grid background < links < node views < ruler bands.
                         This layer stays input-transparent and never takes the pointer: hit testing is
                         geometric, driven by the input the page root already receives — that is what keeps
                         link hover (highlight, Delete, the link menu) from eating canvas gestures. -->
                    <behaviors:WorkflowLinkOverlay x:Name="PART_LinkLayer"
                                                  WorkflowTree="{Binding BindingContext, Source={x:Reference Root}}"
                                                  InteractionSource="{x:Reference Root}"
                                                  ScrollOffsetX="{Binding ScrollOffsetX, Source={x:Reference PART_GridDecorator}}"
                                                  ScrollOffsetY="{Binding ScrollOffsetY, Source={x:Reference PART_GridDecorator}}"
                                                  ContentOffsetX="{Binding ContentOffsetX, Source={x:Reference PART_GridDecorator}}"
                                                  ContentOffsetY="{Binding ContentOffsetY, Source={x:Reference PART_GridDecorator}}"
                                                  RulerThickness="{Binding RulerThickness, Source={x:Reference PART_GridDecorator}}"
                                                  LinkLineColor="#CC38BDF8"
                                                  VirtualLineColor="#E2E8F0"
                                                  VirtualValidTargetColor="#FF34D399"
                                                  VirtualInvalidTargetColor="#FFF87171"
                                                  StrokeWidth="2"
                                                  LinkFlowEnabled="True" />
                    <!-- VeloxDev customization: 悬停高亮是本 demo 的一层（适配器的连线层只画静息线）。 -->
                    <controls:LinkHighlightLayer Tree="{Binding BindingContext, Source={x:Reference Root}}"
                                             ScrollOffsetX="{Binding ScrollOffsetX, Source={x:Reference PART_GridDecorator}}"
                                             ScrollOffsetY="{Binding ScrollOffsetY, Source={x:Reference PART_GridDecorator}}"
                                             ContentOffsetX="{Binding ContentOffsetX, Source={x:Reference PART_GridDecorator}}"
                                             ContentOffsetY="{Binding ContentOffsetY, Source={x:Reference PART_GridDecorator}}"
                                             RulerThickness="{Binding RulerThickness, Source={x:Reference PART_GridDecorator}}" />
                    <ScrollView x:Name="PART_ScrollViewer"
                                Orientation="Both"
                                BackgroundColor="Transparent">
                        <AbsoluteLayout x:Name="PART_RulerOffsetHost"
                                        TranslationX="{Binding RulerThickness, Source={x:Reference PART_GridDecorator}}"
                                        TranslationY="{Binding RulerThickness, Source={x:Reference PART_GridDecorator}}">
                            <AbsoluteLayout x:Name="PART_Canvas"
                                            BackgroundColor="Transparent"
                                            behaviors:ViewPool.ItemsSource="{Binding BindingContext.Helper.VisibleItems, Source={x:Reference Root}}"
                                            behaviors:ViewPool.TemplateSelector="{StaticResource NodeSelector}" />
                        </AbsoluteLayout>
                    </ScrollView>
                </controls:WorkflowGridDecorator>
            </Border>
            <!-- 小地图：画布按 MinimapOverlayName="PART_MinimapOverlay" 找到此元素，把滚动/内容/视口推给
                 它，取代原先手写的绑定 -->
            <controls:MinimapOverlay x:Name="PART_MinimapOverlay"
                                     HorizontalOptions="End"
                                     VerticalOptions="Start"
                                     Margin="0,8,8,0"
                                     ScrollViewerName="PART_ScrollViewer" />
            <!-- 实时画布信息 HUD：随模型与画布的滚动变化刷新（WorkflowView.xaml.cs）；文本层不吃命中测试，
                 拖拽仍落到画布 -->
            <controls:InfoOverlay x:Name="InfoOverlay"
                                  HorizontalOptions="Start"
                                  VerticalOptions="End"
                                  Margin="44,0,0,12" />
        </Grid>
    </Grid>
</ContentView>
