<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Demo.Controls"
             xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.MAUI"
             xmlns:vm="clr-namespace:Demo.ViewModels;assembly=Lib"
             xmlns:workflow="clr-namespace:VeloxDev.WorkflowSystem;assembly=VeloxDev.Core"
             x:Class="Demo.Controls.WorkflowView"
             x:Name="Root"
             behaviors:WorkflowSurfaceBehavior.IsEnabled="True" behaviors:WorkflowSurfaceBehavior.ZoomEnabled="True"
             behaviors:WorkflowSurfaceBehavior.ScrollViewerName="PART_ScrollViewer"
             behaviors:WorkflowSurfaceBehavior.CanvasName="PART_Canvas"
             behaviors:WorkflowSurfaceBehavior.GridDecoratorName="PART_GridDecorator"
             behaviors:WorkflowSurfaceBehavior.PointerPressSourceName="PART_SurfaceBorder">
    <ContentView.Resources>
        <DataTemplate x:Key="NodeTemplate" x:DataType="vm:NodeViewModel">
            <controls:NodeView WidthRequest="{Binding Size.Width}"
                               HeightRequest="{Binding Size.Height}" />
        </DataTemplate>
        <DataTemplate x:Key="ControllerTemplate" x:DataType="vm:ControllerViewModel">
            <controls:ControllerView WidthRequest="{Binding Size.Width}"
                                     HeightRequest="{Binding Size.Height}" />
        </DataTemplate>
        <DataTemplate x:Key="BoolSelectorTemplate" x:DataType="vm:BoolSelectorNodeViewModel">
            <controls:BoolSelectorNodeView WidthRequest="{Binding Size.Width}"
                                           HeightRequest="{Binding Size.Height}" />
        </DataTemplate>
        <DataTemplate x:Key="EnumSelectorTemplate" x:DataType="vm:EnumSelectorNodeViewModel">
            <controls:EnumSelectorNodeView WidthRequest="{Binding Size.Width}"
                                           HeightRequest="{Binding Size.Height}" />
        </DataTemplate>
        <DataTemplate x:Key="PythonTemplate" x:DataType="vm:PythonScriptNodeViewModel">
            <controls:PythonNodeView WidthRequest="{Binding Size.Width}"
                                     HeightRequest="{Binding Size.Height}" />
        </DataTemplate>
        <DataTemplate x:Key="TimerTemplate" x:DataType="vm:TimerNodeViewModel">
            <controls:TimerNodeView WidthRequest="{Binding Size.Width}"
                                    HeightRequest="{Binding Size.Height}" />
        </DataTemplate>
        <controls:CustomTemplateSelector x:Key="NodeSelector"
                                         ControllerTemplate="{StaticResource ControllerTemplate}"
                                         NodeTemplate="{StaticResource NodeTemplate}"
                                         BoolSelectorTemplate="{StaticResource BoolSelectorTemplate}"
                                         EnumSelectorTemplate="{StaticResource EnumSelectorTemplate}"
                                         PythonTemplate="{StaticResource PythonTemplate}"
                                         TimerTemplate="{StaticResource TimerTemplate}" />
    </ContentView.Resources>

    <Grid ColumnDefinitions="Auto,*">
        <!-- Sidebar -->
        <ScrollView Grid.Column="0"
                    BackgroundColor="#1a1a2e"
                    Padding="8">
            <VerticalStackLayout Spacing="6"
                                 WidthRequest="140">
                <Button Text="Undo"
                        HeightRequest="40"
                        BackgroundColor="#0f3460"
                        TextColor="White"
                        Command="{Binding UndoCommand}" />
                <Button Text="Redo"
                        HeightRequest="40"
                        BackgroundColor="#0f3460"
                        TextColor="White"
                        Command="{Binding RedoCommand}" />
                <BoxView HeightRequest="1"
                         Color="#333344" />
                <Button Text="Save"
                        HeightRequest="40"
                        BackgroundColor="#0f3460"
                        TextColor="White"
                        Clicked="OnSaveClicked" />
                <Button Text="Select"
                        HeightRequest="40"
                        BackgroundColor="#0f3460"
                        TextColor="White"
                        Clicked="OnSelectClicked" />
                <BoxView HeightRequest="1"
                         Color="#333344" />
                <Button Text="Load Workflow Demo"
                        HeightRequest="40"
                        BackgroundColor="#0f3460"
                        TextColor="White"
                        Clicked="OnLoadNetworkDemoClicked" />
                <BoxView HeightRequest="1"
                         Color="#333344" />
                <Label Text="节点总数："
                       TextColor="#b0b0b0"
                       FontSize="11"
                       Margin="0,6,0,0" />
                <Label Text="{Binding Nodes.Count}"
                       TextColor="White"
                       FontSize="13" />
                <Label Text="可见组件数："
                       TextColor="#b0b0b0"
                       FontSize="11"
                       Margin="0,6,0,0" />
                <Label Text="{Binding Helper.VisibleItems.Count}"
                       TextColor="White"
                       FontSize="13" />
                <BoxView HeightRequest="1"
                         Color="#333344" />
                <!-- Agent Chat -->
                <Label Text="Agent 对话"
                       FontAttributes="Bold"
                       FontSize="14"
                       TextColor="#7EC8FF"
                       Margin="0,4,0,0" />
                <HorizontalStackLayout Spacing="4">
                    <Label Text="流式"
                           TextColor="#CBD5E1"
                           FontSize="11"
                           VerticalTextAlignment="Center" />
                    <Switch IsToggled="{Binding UseStreamingAgentResponse}"
                            Scale="0.7" />
                </HorizontalStackLayout>
                <CollectionView x:Name="AgentLogScroller"
                                HeightRequest="120"
                                VerticalScrollBarVisibility="Always"
                                ItemsSource="{Binding AgentLog}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Label Text="{Binding .}"
                                   TextColor="#D8D8D8"
                                   FontSize="10"
                                   Margin="0,1" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                    <Entry x:Name="AgentInput"
                           Placeholder="输入消息..."
                           BackgroundColor="#2D2D2D"
                           TextColor="White"
                           FontSize="12"
                           HeightRequest="32"
                           Completed="OnAgentInputCompleted" />
                    <Button Grid.Column="1"
                            Text="发送"
                            FontSize="12"
                            HeightRequest="32"
                            BackgroundColor="#0f3460"
                            TextColor="White"
                            Clicked="OnSendToAgent" />
                </Grid>

                <!-- MCP servers -->
                <Border x:Name="McpStatusPanel"
                        Margin="0,12,0,0"
                        Padding="10"
                        BackgroundColor="#202020"
                        Stroke="#4C4C4C"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 4">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="MCP 服务器" TextColor="#7EC8FF" FontAttributes="Bold" VerticalOptions="Center"/>
                            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <Label Text="{Binding Helper.Mcp.Status.ConnectedCount, StringFormat='存活 {0}'}" TextColor="#6BFFB8" FontAttributes="Bold"/>
                                <Label Text="{Binding Helper.Mcp.Status.ErrorCount, StringFormat='· 错误 {0}'}" TextColor="#FF6B6B"/>
                                <Button Text="重载" FontSize="11" Clicked="OnReloadMcp"/>
                            </HorizontalStackLayout>
                        </Grid>
                        <CollectionView ItemsSource="{Binding Helper.Mcp.Status.Servers}" HeightRequest="140">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="2"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="2">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding Name}" TextColor="#E0E0E0" FontAttributes="Bold"/>
                                            <Label Text="{Binding StateText}" TextColor="#A0A0A0"/>
                                            <Label Text="{Binding ToolCount, StringFormat='· {0} tools'}" TextColor="#6BFFB8"/>
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding Error}" TextColor="#FF6B6B" FontSize="11"
                                               IsVisible="{Binding IsError}"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Workflow surface -->
        <Grid Grid.Column="1">
            <Border x:Name="PART_SurfaceBorder"
                    Margin="0"
                    Stroke="White"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 3"
                    BackgroundColor="#0B1120">
                <controls:WorkflowGridDecorator x:Name="PART_GridDecorator">
                    <ScrollView x:Name="PART_ScrollViewer"
                                Orientation="Both"
                                BackgroundColor="Transparent">
                        <AbsoluteLayout x:Name="PART_RulerOffsetHost"
                                        TranslationX="{Binding RulerThickness, Source={x:Reference PART_GridDecorator}}"
                                        TranslationY="{Binding RulerThickness, Source={x:Reference PART_GridDecorator}}">
                            <AbsoluteLayout x:Name="PART_Canvas"
                                            BackgroundColor="Transparent"
                                            behaviors:ViewPool.ItemsSource="{Binding NodeItemsSource, Source={x:Reference Root}}"
                                            behaviors:ViewPool.TemplateSelector="{StaticResource NodeSelector}">
                                <!-- Single link layer: renders every connection in one GraphicsView
                                     (world-anchored, fills the canvas, translates with it). The node
                                     ViewPool must therefore only materialize node views — WorkflowView
                                     filters links out of NodeItemsSource. -->
                                <controls:LinkLayerView AbsoluteLayout.LayoutFlags="All"
                                                        AbsoluteLayout.LayoutBounds="0,0,1,1" />
                            </AbsoluteLayout>
                        </AbsoluteLayout>
                    </ScrollView>
                </controls:WorkflowGridDecorator>
            </Border>
            <!-- Minimap overlay -->
            <behaviors:WorkflowMinimapOverlay HorizontalOptions="End"
                                              VerticalOptions="Start"
                                              Margin="0,8,8,0"
                                              ScrollViewerName="PART_ScrollViewer"
                                              WorkflowTree="{Binding Source={x:Reference PART_SurfaceBorder}, Path=BindingContext}"
                                              ScrollOffsetX="{Binding ScrollOffsetX, Source={x:Reference PART_GridDecorator}}"
                                              ScrollOffsetY="{Binding ScrollOffsetY, Source={x:Reference PART_GridDecorator}}"
                                              ContentOffsetX="{Binding ContentOffsetX, Source={x:Reference PART_GridDecorator}}"
                                              ContentOffsetY="{Binding ContentOffsetY, Source={x:Reference PART_GridDecorator}}"
                                              ViewportWidth="{Binding Width, Source={x:Reference PART_SurfaceBorder}}"
                                              ViewportHeight="{Binding Height, Source={x:Reference PART_SurfaceBorder}}"/>
        </Grid>
    </Grid>
</ContentView>
