<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Demo.Controls"
             xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.MAUI"
             x:Class="Demo.Controls.TimerNodeView"
             behaviors:WorkflowSlotLayoutBehavior.IsEnabled="True"
             behaviors:WorkflowSlotLayoutBehavior.SlotNames="PART_InputSlot,PART_OutputSlot"
             behaviors:WorkflowSlotLayoutBehavior.CoordinateHostName="PART_Canvas">
    <Grid RowDefinitions="40,*">
        <Border Grid.RowSpan="2"
                Stroke="#6EC6FF"
                StrokeThickness="1.5"
                StrokeShape="RoundRectangle 6"
                BackgroundColor="#1E2A35" />

        <Grid Grid.RowSpan="2" ZIndex="6" InputTransparent="True" CascadeInputTransparent="False">
            <controls:SlotView x:Name="PART_InputSlot"
                               WidthRequest="20"
                               HeightRequest="20"
                               HorizontalOptions="Start"
                               VerticalOptions="Center"
                               Margin="-10,0,0,0"
                               BindingContext="{Binding InputSlot}"
                               IsVisible="{Binding HasInputSlot}"
                               SlotState="{Binding State}" />
            <controls:SlotView x:Name="PART_OutputSlot"
                               WidthRequest="20"
                               HeightRequest="20"
                               HorizontalOptions="End"
                               VerticalOptions="Center"
                               Margin="0,0,-10,0"
                               BindingContext="{Binding OutputSlot}"
                               IsVisible="{Binding HasOutputSlot}"
                               SlotState="{Binding State}" />
        </Grid>

        <Border Grid.Row="0"
                BackgroundColor="#253545"
                Stroke="#6EC6FF"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 4,4,0,0"
                behaviors:WorkflowNodeDragBehavior.CoordinateHostName="PART_Canvas"
                behaviors:WorkflowNodeDragBehavior.IsEnabled="True">
            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                <Label Text="{Binding Title}" TextColor="White" FontAttributes="Bold" />
                <Label Text="{Binding ExecutionOrderText}" TextColor="#C8FFC8" FontAttributes="Bold"
                       IsVisible="{Binding HasExecutionOrder}" />
            </HorizontalStackLayout>
        </Border>

        <Border Grid.Row="1" BackgroundColor="#1E2A35" StrokeShape="RoundRectangle 0,0,4,4">
            <VerticalStackLayout Margin="14" Spacing="6">
                <Label Text="Interval (ms)" TextColor="#BFBFBF" FontSize="11" />
                <Entry Text="{Binding IntervalMilliseconds}" Keyboard="Numeric" FontSize="11" />
                <Label Text="Last Tick" TextColor="#BFBFBF" FontSize="11" />
                <Label Text="{Binding LastTick}" TextColor="#6EC6FF" FontAttributes="Bold" FontSize="11" LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
