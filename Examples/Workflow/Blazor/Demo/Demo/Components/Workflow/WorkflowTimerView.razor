@using Demo.ViewModels
@using System.ComponentModel
@implements IDisposable

@* Body-only content rendered inside the generated TemplateNodeView (BodyContent): the
   interval field and the last tick. Lower-case labels over embedded fields — the label
   tells you what the box is, so the box needs no placeholder repeating it. *@
<div class="timer-body">
    <label class="wf-label" for="timer-interval">INTERVAL (MS)</label>
    <input id="timer-interval" class="wf-field" type="number" value="@_interval"
           @onchange="OnIntervalChanged" />

    <label class="wf-label" style="margin-top:4px;">LAST TICK</label>
    <span class="timer-tick">@(Selector?.LastTick)</span>
</div>
