@namespace Demo.Components.Workflow
@using VeloxDev.WorkflowSystem
@using VeloxDev.WorkflowSystem.AttachedBehaviors
@using Demo.Workflow

@if (Node is not null)
{
    <WorkflowSlotLayoutBehavior Node="Node" IsEnabled="true">
        <WorkflowNodeDragBehavior Node="Node" IsEnabled="true"
                                  Style="@($"width:{Node.Size.Width.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)}px;height:{Node.Size.Height.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)}px;")">
            @* The card is authored at its DESIGN size (the type's [DefaultSize]) and uniformly scaled
               into the collapsed Node.Size host by a CSS transform (the Blazor equivalent of the XAML
               Viewbox). Header text, body content, scrollbars and slot glyphs shrink together, so the
               interior never re-flows / overflows the collapsed card on zoom. Body content scrolls at
               design coordinates inside the body (overflow-y auto). Edge slot hosts are SIBLINGS of the
               scrollable body box, so a half-outside glyph is never clipped by the body's own overflow. *@
            @{ var design = Design; }
            <div class="wf-card @(IsRunning ? "veloxdev-wf-node-running" : null) @(AgentSelection.IsSelected(Node) ? "agent-selected" : null)"
                 style="position:relative;width:@(design.Width.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))px;height:@(design.Height.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))px;
                        transform:scale(@ScaleCss);transform-origin:top left;
                        overflow:@OverflowCss;@SurfaceOverrideCss">
                @* One 32px title row: the type accent bar, a left-aligned title, then the readouts.
                   Nothing here is centred and nothing sits on a coloured band — the accent is a 2px
                   rule at the head of the row, which leaves the title the whole width to be read in.
                   The layout menu hangs off the header only: right-clicking a body input must keep the
                   browser's own text menu. *@
                <div class="wf-card-header" @oncontextmenu="OnContextMenu" @oncontextmenu:preventDefault>
                    <span class="wf-card-accent" style="background:@AccentCss;"></span>
                    <span class="wf-card-title">@(Title ?? FallbackTitle)</span>
                    @if (HasOrderBadge)
                    {
                        <span class="wf-card-order" title="执行步骤编号">@OrderText</span>
                    }
                    @if (!string.IsNullOrEmpty(StatusValue))
                    {
                        <span class="wf-card-pill" title="最近一次状态">@StatusValue</span>
                    }
                    @if (IsRunning)
                    {
                        <span class="wf-card-pill wf-card-pill-running">
                            <span class="veloxdev-wf-node-pulse"></span>执行中
                        </span>
                    }
                </div>
                <div class="wf-card-body" style="top:32px;">
                    @if (BodyContent is not null)
                    {
                        <div class="wf-card-scroll">
                            @BodyContent
                        </div>
                    }
                </div>

                @* Ports hang off the card's edge, centred on it. Outside the scrolling body box on
                   purpose: that box owns an overflow rule, and an overflow rule is the one thing here
                   that would cut a port in half. *@
                @if (InputSlots is not null)
                {
                    <div class="wf-card-slot-host wf-card-slot-in">@InputSlots</div>
                }

                @if (OutputSlots is not null)
                {
                    <div class="wf-card-slot-host wf-card-slot-out">@OutputSlots</div>
                }
            </div>
        </WorkflowNodeDragBehavior>
    </WorkflowSlotLayoutBehavior>

    @if (_layoutMenuOpen)
    {
        <div class="wf-layout-menu-backdrop" @onclick="CloseLayoutMenu"></div>
        <div class="wf-layout-menu" @onclick:stopPropagation
             style="left:@(_layoutMenuX.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))px;top:@(_layoutMenuY.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))px;">
            @foreach (var (label, traversal) in WorkflowLayoutDemo.Traversals)
            {
                <button type="button" @onclick="() => ApplyLayoutAsync(traversal)">@label</button>
            }
            <div class="wf-layout-menu-sep"></div>
            <div class="wf-layout-menu-title">布局容差</div>
            @foreach (var (label, tolerance) in WorkflowLayoutDemo.Tolerances)
            {
                <button type="button" class="@(_layoutTolerance == tolerance ? "selected" : null)"
                        @onclick="() => SetLayoutTolerance(tolerance)">@label</button>
            }
        </div>
    }
}
