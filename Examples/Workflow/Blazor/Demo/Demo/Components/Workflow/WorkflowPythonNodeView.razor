@using Demo.ViewModels
@using System.ComponentModel
@implements IDisposable

@* Body-only content rendered inside the generated TemplateNodeView (BodyContent).
   Three bands, exactly as the Avalonia card: a full-width description strip, then the
   workspace — an input port strip, the script surface, an output port strip. The strips
   are wide enough for a port glyph plus its label, and each port sits on the card's edge
   with half of the glyph hanging over it. *@
<div class="py-root">
    <div class="py-desc">@(Selector?.Description)</div>

    <div class="py-workspace">
        <div class="py-port-strip py-port-strip-in">
            @if (Selector?.InputSlots is { } inputs)
            {
                @foreach (var item in inputs.Items)
                {
                    <div class="py-port-row">
                        @* TemplateSlotView 已为插槽开启连接行为，再包一层会让锚点与手势处理翻倍 *@
                        <TemplateSlotView Slot="item.Slot" Tree="Tree" SlotSize="24" />
                        <span class="py-port-label">@item.Name</span>
                    </div>
                }
            }
        </div>

        @* The editor gets its own near-black surface with a title bar, because code wants to
           read as code: a field tint under a mono block reads as a disabled form control. *@
        <div class="py-editor">
            <div class="py-editor-bar">
                <span class="py-editor-file">script.py</span>
                <span class="py-editor-lang">Python 3</span>
            </div>
            <textarea class="wf-field-code"
                      value="@_script"
                      @oninput="OnScriptChanged"
                      title="@(Selector?.LastOutput)"></textarea>
        </div>

        <div class="py-port-strip py-port-strip-out">
            @if (Selector?.OutputSlots is { } outputs)
            {
                @foreach (var item in outputs.Items)
                {
                    <div class="py-port-row py-port-row-out">
                        <span class="py-port-label">@item.Name</span>
                        <TemplateSlotView Slot="item.Slot" Tree="Tree" SlotSize="24" />
                    </div>
                }
            }
        </div>
    </div>
</div>
