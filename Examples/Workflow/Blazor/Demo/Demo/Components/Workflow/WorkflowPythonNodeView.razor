@using Demo.ViewModels
@using System.ComponentModel
@implements IDisposable

@* Body-only content rendered inside the generated TemplateNodeView (BodyContent).
   The card header (node title) and border come from TemplateNodeView, so this view
   shows only the description, the Python editor, and the dynamic input/output ports. *@
<div style="display:flex;height:100%;">
    <div style="flex:0 0 72px;display:flex;flex-direction:column;justify-content:flex-start;gap:4px;padding:4px 0;overflow:visible;">
        @if (Selector?.InputSlots is { } inputs)
        {
            @foreach (var item in inputs.Items)
            {
                <div style="display:flex;align-items:center;gap:4px;min-width:0;">
                    <WorkflowSlotConnectionBehavior Slot="item.Slot" Tree="Tree">
                        <TemplateSlotView Slot="item.Slot" Tree="Tree" SlotSize="16" />
                    </WorkflowSlotConnectionBehavior>
                    <span style="color:#6ec6ff;font-size:11px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@item.Name</span>
                </div>
            }
        }
    </div>

    <div style="flex:1;display:flex;flex-direction:column;gap:4px;min-width:0;padding:4px 0;">
        <div style="color:#8b949e;font-size:10px;line-height:1.3;max-height:26px;overflow:hidden;padding:0 2px;">@(Selector?.Description)</div>
        <div style="display:flex;gap:6px;background:#161b22;border:1px solid #30363d;border-radius:4px;padding:2px 6px;">
            <span style="color:#7ee787;font-family:Consolas,monospace;font-size:11px;font-weight:600;">script.py</span>
            <span style="color:#6e7681;font-size:10px;margin-left:auto;">Python 3</span>
        </div>
        <textarea class="python-script"
                  value="@_script"
                  @oninput="OnScriptChanged"
                  title="@(Selector?.LastOutput)"
                  style="flex:1;width:100%;resize:none;background:#0d1117;color:#e6edf3;
                         font-family:Consolas,monospace;font-size:12px;border:1px solid #30363d;
                         border-radius:4px;padding:6px;white-space:pre;overflow:auto;"></textarea>
    </div>

    <div style="flex:0 0 72px;display:flex;flex-direction:column;align-items:flex-end;gap:4px;padding:4px 0;overflow:visible;">
        @if (Selector?.OutputSlots is { } outputs)
        {
            @foreach (var item in outputs.Items)
            {
                <div style="display:flex;align-items:center;gap:4px;min-width:0;">
                    <span style="color:#6ec6ff;font-size:11px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@item.Name</span>
                    <WorkflowSlotConnectionBehavior Slot="item.Slot" Tree="Tree">
                        <TemplateSlotView Slot="item.Slot" Tree="Tree" SlotSize="16" />
                    </WorkflowSlotConnectionBehavior>
                </div>
            }
        }
    </div>
</div>
