@namespace Demo.Components.Workflow
@using VeloxDev.WorkflowSystem
@using VeloxDev.WorkflowSystem.AttachedBehaviors
@using Demo.Components.Workflow

@if (Tree is not null)
{
    <WorkflowSurfaceBehavior Tree="Tree"
                             IsEnabled="true"
                             ScrollViewerId="@ScrollViewerId"
                             CanvasId="@CanvasId"
                             GridSpacing="@GridSpacing"
                             GridColor="@MinorGridColor"
                             Background="@Background">
        <GridDecorator Context="vp">
            <GridDecorator Viewport="vp"
                           RulerThickness="28"
                           GridSpacing="@GridSpacing"
                           RulerBackground="@RulerBackground"
                           TickColor="@RulerTickColor"
                           DividerColor="@RulerDividerColor" />
        </GridDecorator>
        <Minimap Context="vp">
            <MinimapOverlay Viewport="vp"
                            Width="180" Height="120"
                            ScrollViewerId="@ScrollViewerId" />
        </Minimap>
        <ChildContent Context="sc">
            @* Links layer: one full-canvas link view per connection (absolute, overflow visible). *@
            <div class="veloxdev-wf-links" style="position:absolute;left:0;top:0;width:@sc.Width.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)px;height:@sc.Height.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)px;pointer-events:none;">
                @foreach (var link in Tree.Links)
                {
                    <LinkView Link="link" CanvasWidth="@sc.Width" CanvasHeight="@sc.Height" />
                }
                @if (Tree.VirtualLink.IsVisible)
                {
                    <LinkView Link="Tree.VirtualLink" CanvasWidth="@sc.Width" CanvasHeight="@sc.Height" />
                }
            </div>

            @* Nodes layer: pooled node views with generically-populated slot hosts. *@
            <ViewPool ItemsSource="Tree.Nodes" KeySelector="n => n">
                <ItemTemplate Context="item">
                    @if (item is IWorkflowNodeViewModel n && NodeTemplate is not null)
                    {
                        @NodeTemplate(n)
                    }
                    else if (item is IWorkflowNodeViewModel n2)
                    {
                        var names = SlotNamesOf(n2);
                        <NodeView Node="n2" Tree="Tree" AllowOverflow="true">
                            <InputSlots>
                                @* SlotView already opens the connection behavior for its slot; do not
                                   wrap it in another one (double-stamped wrapper → doubled anchor
                                   writes and duplicated gesture handlers). *@
                                @foreach (var slot in InputSlotsOf(n2))
                                {
                                    <SlotView Slot="slot" Tree="Tree" SlotSize="18" />
                                }
                            </InputSlots>
                            <OutputSlots>
                                @foreach (var slot in OutputSlotsOf(n2))
                                {
                                    names.TryGetValue(slot, out var name);
                                    <div style="display:flex;align-items:center;">
                                        @if (name is not null)
                                        {
                                            <span style="margin-left:auto;margin-right:8px;color:@NodeForegroundCss;font-size:11px;white-space:nowrap;">@name</span>
                                        }
                                        <SlotView Slot="slot" Tree="Tree" SlotSize="14" Style="margin-right:-7px;" />
                                    </div>
                                }
                            </OutputSlots>
                        </NodeView>
                    }
                </ItemTemplate>
            </ViewPool>
        </ChildContent>
    </WorkflowSurfaceBehavior>
}
