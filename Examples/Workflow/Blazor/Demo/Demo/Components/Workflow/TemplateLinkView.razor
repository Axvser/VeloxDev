@namespace Demo.Components.Workflow
@using VeloxDev.WorkflowSystem
@using VeloxDev.WorkflowSystem.AttachedBehaviors

@if (EffectiveCanRender && Link is not null && Prepare())
{
    // Stable DOM ids (mirroring the adapter's node/slot data ids) so the zoom JS can re-sync this
    // link from the live endpoint slots in the same frame the nodes collapse.
    var link = Link;
    var wfLinkId = link is null ? null : WorkflowRuntimeIds.Get(link);
    var wfSenderSlotId = link?.Sender is { } wfSender ? WorkflowRuntimeIds.Get(wfSender) : null;
    var wfReceiverSlotId = link?.Receiver is { } wfReceiver ? WorkflowRuntimeIds.Get(wfReceiver) : null;

    @* The whole link is one cubic curve, and the comet travelling along it is cut out of that curve
       BY ARC LENGTH rather than by a gradient brush. That is why this view keeps its own sample
       table: a gradient's axis is the straight line between the two ends, so on a curve it lights
       the string and not the rope — the brightness stops tracking the bend, the light appears to
       speed up and slow down as it goes round, and the kink where an orthogonal stub met its
       diagonal reads as a kink in the light itself. Cutting by arc length is also what gives each
       tail segment its own colour and opacity, so the tail is drawn as a run of separate elements.

       Paths rather than <polyline>s on purpose: the adapter's zoom pass re-syncs every link's FIRST
       <polyline> from the live slot boxes using the template's orthogonal golden-ratio formula, and
       it would overwrite a bezier's geometry with an orthogonal route for the length of the zoom
       settle. A <path> is not what that selector looks for, so the geometry here stays the only
       thing that ever writes it. *@
    <svg width="@CanvasWidthCss" height="@CanvasHeightCss"
         data-veloxdev-link-id="@wfLinkId"
         data-veloxdev-sender-slot="@wfSenderSlotId"
         data-veloxdev-receiver-slot="@wfReceiverSlotId"
         style="position:absolute;left:0;top:0;overflow:visible;pointer-events:none;">

        @* The svg stays click-through, so every canvas gesture still reaches the layer below. Hit
           testing is handed back on the painted strokes alone — what is drawn is what responds, and
           the browser does the distance maths. The outer halo is the widest thing drawn, so that is
           the reach of the target; a virtual link stays untouched, because it is the rubber band
           under the pointer and must not intercept the drag that is producing it. *@
        <g fill="none" stroke-linecap="round"
           pointer-events="@HitTargetCss"
           @onmouseenter="OnPointerEnter"
           @onmouseleave="OnPointerExit"
           @oncontextmenu="OnContextMenu"
           @oncontextmenu:preventDefault="true">
            @* 管壁：两层更宽的同色低透明描边垫在下面，整条线因此像在发光而不是贴在背景上 *@
            <path d="@BodyPath"
                  stroke="@LitColor"
                  stroke-opacity="0.10"
                  stroke-width="@N(HaloOuterWidth)" />
            <path d="@BodyPath"
                  stroke="@LitColor"
                  stroke-opacity="0.16"
                  stroke-width="@N(HaloInnerWidth)" />

            @if (EffectiveIsVirtual)
            {
                @* 虚拟连线是指针下的橡皮筋：虚线、不流动 *@
                <path d="@BodyPath"
                      stroke="@LineColor"
                      stroke-opacity="0.75"
                      stroke-width="@ThicknessCss"
                      stroke-dasharray="4 2" />
            }
            else
            {
                @* The resting curve is dim: with the light absent it is only a dark line, and that is
                   what lets the comet read as contrast. Selected, it turns OrangeRed and grows 1.5. *@
                <path d="@BodyPath"
                      stroke="@LitColor"
                      stroke-opacity="@BodyOpacity"
                      stroke-width="@LitThicknessCss" />

                @* 彗星：光晕一遍（更宽更淡）在前，本体一遍在后，两遍都跟着头走。
                   段数固定，够不着的那几段只是把不透明度压到零 —— 元素数不变，DOM 才稳定。 *@
                @foreach (var s in _comet)
                {
                    <path d="@s.D" stroke="@s.Color" stroke-opacity="@s.Opacity" stroke-width="@s.Width" />
                }
            }
        </g>
    </svg>
}
