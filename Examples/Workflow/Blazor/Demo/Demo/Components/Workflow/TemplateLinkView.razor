@namespace Demo.Components.Workflow
@using VeloxDev.WorkflowSystem
@using VeloxDev.WorkflowSystem.AttachedBehaviors

@if (EffectiveCanRender && Link is not null)
{
    // Stable DOM ids (mirroring the adapter's node/slot data ids) so the zoom JS can re-sync this
    // link's polyline from the live endpoint slots in the same frame the nodes collapse.
    var link = Link;
    var wfLinkId = link is null ? null : WorkflowRuntimeIds.Get(link);
    var wfSenderSlotId = link?.Sender is { } wfSender ? WorkflowRuntimeIds.Get(wfSender) : null;
    var wfReceiverSlotId = link?.Receiver is { } wfReceiver ? WorkflowRuntimeIds.Get(wfReceiver) : null;
    var points = BuildPoints();
    var markerId = $"veloxdev-arrow-{MarkerSuffix}";
    var dash = EffectiveIsVirtual ? "6 4" : "none";
    var markerEnd = EffectiveIsVirtual ? "" : $"url(#{markerId})";

    // 行进的高光：三个停靠点用周期写在本组件上的偏移，轴取链接自身两端（userSpaceOnUse），光带才沿链接走
    // 轴每次渲染从锚点重算，不反过来写：偏移归周期所有，渲染可读不可写
    var axis = FlowAxis;

    <svg width="@CanvasWidthCss" height="@CanvasHeightCss"
         data-veloxdev-link-id="@wfLinkId"
         data-veloxdev-sender-slot="@wfSenderSlotId"
         data-veloxdev-receiver-slot="@wfReceiverSlotId"
         style="position:absolute;left:0;top:0;overflow:visible;">
        <defs>
            <marker id="@markerId" markerWidth="10" markerHeight="7"
                    refX="9" refY="3.5" orient="auto">
                <polygon points="0 0, 10 3.5, 0 7" fill="@LitCss" />
            </marker>
            @if (!EffectiveIsVirtual)
            {
                <linearGradient id="@FlowId" gradientUnits="userSpaceOnUse"
                                x1="@axis[0]" y1="@axis[1]" x2="@axis[2]" y2="@axis[3]">
                    <stop offset="@N(BandTail)" stop-color="@DimCss" />
                    <stop offset="@N(BandCentre)" stop-color="@BandColor" />
                    <stop offset="@N(BandLead)" stop-color="@DimCss" />
                </linearGradient>
            }
        </defs>
        @if (EffectiveIsVirtual)
        {
            <polyline points="@points"
                      fill="none"
                      stroke="@LineColor"
                      stroke-width="@ThicknessCss"
                      stroke-dasharray="@dash" />
        }
        else
        {
            <polyline points="@points"
                      fill="none"
                      stroke="@FlowStroke"
                      stroke-width="@ThicknessCss"
                      marker-end="@markerEnd" />
        }
    </svg>
}
