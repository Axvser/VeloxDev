@namespace Demo.Components.Workflow
@using VeloxDev.WorkflowSystem
@using VeloxDev.WorkflowSystem.AttachedBehaviors

@if (Slot is not null)
{
    <WorkflowSlotConnectionBehavior Slot="Slot" Tree="Tree" IsEnabled="true" Style="@Style">
        @* A fine ring, a small core, and ONE travelling ripple. SVG rather than the old filled
           glyph path: the ripple's radius and its opacity are rewritten every frame, and a
           circle's r is a number the browser re-rasterises for free, where a path's d is not.
           Three circles is the whole drawing, in paint order — ripple, ring, core — because the
           ring and core have to land on top of the ripple rather than under it. *@
        <svg class="veloxdev-wf-slot-svg"
             width="@SizeCss" height="@SizeCss"
             viewBox="0 0 @SizeCss @SizeCss"
             @onmouseenter="OnPointerEnter"
             @onmouseleave="OnPointerExit">
            @if (HasRipple)
            {
                @* 能发＝外散（越远越淡）；能收＝内聚（外缘淡、环上实）；双向＝同屏两道。 *@
                if (CanSend)
                {
                    <circle cx="@CentreCss" cy="@CentreCss" r="@SendRadiusCss"
                            fill="none"
                            stroke="@ColorCss"
                            stroke-width="@RippleThicknessCss"
                            stroke-opacity="@SendOpacityCss" />
                }
                if (CanReceive)
                {
                    <circle cx="@CentreCss" cy="@CentreCss" r="@ReceiveRadiusCss"
                            fill="none"
                            stroke="@ColorCss"
                            stroke-width="@RippleThicknessCss"
                            stroke-opacity="@ReceiveOpacityCss" />
                }
            }
            <circle cx="@CentreCss" cy="@CentreCss" r="@RingRadiusCss"
                    fill="none"
                    stroke="@ColorCss"
                    stroke-width="@RingThicknessCss"
                    stroke-opacity="@RingOpacityCss" />
            <circle cx="@CentreCss" cy="@CentreCss" r="@CoreRadiusCss"
                    fill="@ColorCss"
                    fill-opacity="@CoreOpacityCss" />
        </svg>
    </WorkflowSlotConnectionBehavior>
}
