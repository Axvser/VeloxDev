@using Demo.ViewModels
@using System.ComponentModel
@implements IDisposable

<div class="enum-root">
    <div class="enum-header">
        <span>@_title</span>
    </div>
    <div class="enum-body">
        <label class="enum-label">Selected Method</label>
        <select class="enum-select" @onchange="OnValueChanged">
            @foreach (var opt in _items)
            {
                <option value="@opt" selected="@(opt == _selectedValue)">@opt</option>
            }
        </select>
        <div class="selector-slots">
            @if (Selector?.OutputSlots is { } slots)
            {
                @foreach (var item in slots.Items)
                {
                    <div class="selector-slot-row">
                        <span class="selector-slot-label">@item.Name</span>
                        <WorkflowSlotConnectionBehavior Slot="item.Slot" Tree="Tree">
                            <TemplateSlotView Slot="item.Slot" Tree="Tree" SlotSize="16" />
                        </WorkflowSlotConnectionBehavior>
                    </div>
                }
            }
        </div>
    </div>
</div>
