@using Demo.ViewModels
@using System.ComponentModel
@implements IDisposable

@* Body-only content rendered inside the generated TemplateNodeView (BodyContent).
   The card header (node title) and border come from TemplateNodeView, so the inner
   view no longer draws its own card/header. *@
<div class="bool-root">
    <div class="bool-body">
        <label class="bool-label">
            <input type="checkbox" checked="@_condition" @onchange="OnConditionChanged" />
            Condition = True
        </label>
        <label class="bool-label">Compile Mode</label>
        <select class="bool-select" @onchange="OnModeChanged">
            @foreach (var opt in _modeOptions)
            {
                <option value="@opt" selected="@(opt == _compileMode)">@opt</option>
            }
        </select>
        <div class="selector-slots">
            @if (Selector?.OutputSlots is { } slots)
            {
                @foreach (var item in slots.Items)
                {
                    <div class="selector-slot-row">
                        <span class="selector-slot-label">@item.Name</span>
                        <WorkflowSlotConnectionBehavior Slot="item.Slot" Tree="Tree" IsEnabled="true">
                            <TemplateSlotView Slot="item.Slot" Tree="Tree" SlotSize="16" />
                        </WorkflowSlotConnectionBehavior>
                    </div>
                }
            }
        </div>
    </div>
</div>
