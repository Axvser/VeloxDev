@page "/"
@page "/workflow"
@rendermode RenderMode.InteractiveServer
@using System.Collections.Specialized
@using System.ComponentModel
@using VeloxDev.AI
@implements IDisposable

<PageTitle>VeloxDev Workflow — Blazor Demo</PageTitle>

<div class="wf-app">
    <!-- Sidebar -->
    <aside class="wf-sidebar">
        <button class="sb-btn" title="Undo" @onclick="Undo" disabled="@(_session?.Tree?.UndoCommand?.CanExecute(null) != true)">
            ↩ Undo
        </button>
        <button class="sb-btn" title="Redo" @onclick="Redo" disabled="@(_session?.Tree?.RedoCommand?.CanExecute(null) != true)">
            ↪ Redo
        </button>
        <button class="sb-btn" title="Save workflow as JSON" @onclick="SaveWorkflow">
            Save
        </button>
        <button class="sb-btn" title="Load workflow from JSON" @onclick="LoadWorkflow">
            Load
        </button>
        <div class="sb-divider"></div>

        <div class="sb-info">
            <span>节点总数: <strong>@(_session?.Tree?.Nodes.Count ?? 0)</strong></span>
            <span>连接数: <strong>@(_session?.Tree?.Links.Count ?? 0)</strong></span>
        </div>

        <div class="sb-divider"></div>

        <!-- Agent Chat Panel -->
        <div class="sb-panel">
            <div class="sb-panel-header">
                <span>Agent 对话</span>
                <label class="sb-toggle">
                    <input type="checkbox" checked="@_useStreaming" @onchange="OnStreamingToggle" />
                    流式
                </label>
            </div>
            <div class="sb-agent-log">
                @if (_session?.Tree?.AgentLog is { } log)
                {
                    @foreach (var entry in log)
                    {
                        <div class="sb-log-entry">@entry</div>
                    }
                }
            </div>
            <div class="sb-agent-input-row">
                <input class="sb-agent-input" type="text" @bind="_agentMessage"
                       @onkeydown="OnAgentKeyDown" placeholder="输入消息..." />
                <button class="sb-agent-send" @onclick="SendToAgent" disabled="@string.IsNullOrWhiteSpace(_agentMessage)">
                    发送
                </button>
            </div>
        </div>

        <div class="sb-divider"></div>

        <!-- Execution Log Panel -->
        <div class="sb-panel">
            <div class="sb-panel-header">
                <span>实际执行顺序</span>
            </div>
            <div class="sb-exec-log">
                @if (_session?.Tree?.ExecutionLog is { } execLog)
                {
                    <div class="sb-log-entry">已记录: @execLog.Count</div>
                    @foreach (var entry in execLog)
                    {
                        <div class="sb-log-entry">@entry</div>
                    }
                }
            </div>
        </div>

        <!-- MCP Server Status Panel -->
        <div class="sb-panel">
            <div class="sb-panel-header">
                <span>MCP 服务器</span>
            </div>
            <div class="sb-exec-log">
                @if (McpStatus is { } mcp)
                {
                    <div class="sb-log-entry">存活 @mcp.ConnectedCount · 错误 @mcp.ErrorCount · 安装/连接 @mcp.WorkingCount</div>
                    @foreach (var s in mcp.Servers)
                    {
                        <div class="sb-log-entry">
                            <span>@s.Name — @s.StateText</span>
                            @if (s.ToolCount > 0)
                            {
                                <span> · @s.ToolCount tools</span>
                            }
                        </div>
                        @if (s.IsError && !string.IsNullOrEmpty(s.Error))
                        {
                            <div class="sb-log-entry" style="color:#ff6b6b">@s.Error</div>
                        }
                    }
                    <button class="sb-action-btn" @onclick="ReloadMcpAsync">重载</button>
                }
            </div>
        </div>
    </aside>

    <!-- Main Canvas Area -->
    <main class="wf-main">
        <div class="wf-toolbar">
            <button class="tb-btn tb-close" @onclick="StopWorkflow" disabled="@(_session?.Controller?.IsActive != true)">
                ■ Close Tree
            </button>
            <button class="tb-btn tb-reset" @onclick="ResetDemo">
                ↩ Reset
            </button>
            <span class="tb-status">@(_session?.Controller?.IsActive == true ? "● Running" : "○ Idle")</span>
            <span class="tb-layout">Layout: @_canvasLayoutSize</span>
        </div>

        @if (_session?.Tree is { } tree)
        {
            <div class="wf-canvas-wrapper">
                <WorkflowSurfaceBehavior Tree="tree"
                                         IsEnabled="true"
                                         ScrollViewerId="wf-scroll"
                                         CanvasId="wf-canvas"
                                         GridSpacing="40"
                                         GridColor="#2A2D2E"
                                         MajorGridColor="#3A3D40"
                                         MajorLineEvery="5"
                                         AxisColor="#4D4D4D"
                                         Background="#1E1E1E">
                    <GridDecorator Context="vp">
                        <WorkflowGridDecorator Viewport="vp"
                                               RulerThickness="28" Spacing="40"
                                               MajorLineEvery="5"
                                               RulerBackground="#252526"
                                               TickColor="#555555"
                                               LabelColor="#888888"
                                               AxisColor="#4D4D4D"
                                               DividerColor="#3A3D40" />
                    </GridDecorator>
                    <Minimap Context="vp">
                        <WorkflowMinimapOverlay Viewport="vp"
                                                Width="180" Height="120"
                                                ScrollViewerId="wf-scroll"
                                                Background="#1C2330"
                                                BorderColor="#475569"
                                                NodeFill="#38BDF8"
                                                ViewportStroke="#FFFFFF" />
                    </Minimap>
                    <ChildContent Context="sc">
                        @* Links layer: one full-canvas TemplateLinkView per connection (template product,
                           absolute, overflow visible). Each link draws the golden-ratio orthogonal polyline. *@
                        <div class="veloxdev-wf-links"
                             style="position:absolute;left:0;top:0;width:@sc.Width.ToString("0")px;height:@sc.Height.ToString("0")px;pointer-events:none;">
                            @foreach (var link in tree.Links)
                            {
                                <TemplateLinkView Link="link" CanvasWidth="@sc.Width" CanvasHeight="@sc.Height" />
                            }
                            @if (tree.VirtualLink.IsVisible)
                            {
                                <TemplateLinkView Link="tree.VirtualLink" CanvasWidth="@sc.Width" CanvasHeight="@sc.Height" />
                            }
                        </div>

                        @* Nodes layer: generated TemplateNodeView cards with type-specific body content
                           (template product). Each card wires slot-layout + node-drag behaviors itself. *@
                        <ViewPool ItemsSource="tree.Nodes" KeySelector="n => n">
                            <ItemTemplate Context="node">
                                @switch (node)
                                {
                                    case ControllerViewModel c:
                                        <TemplateNodeView Node="c" Title="Network Flow Controller"
                                                          AllowOverflow="true"
                                                          Background="#DD2D2D2D" Foreground="#DDECECEC"
                                                          BorderBrush="@(c.IsActive ? "#DD67E8F9" : "#DD4B5563")"
                                                          BorderThickness="1.5" CornerRadius="6">
                                            <BodyContent>
                                                <WorkflowControllerView Controller="c" />
                                            </BodyContent>
                                            <OutputSlots>
                                                <WorkflowSlotConnectionBehavior Slot="c.OutputSlot" Tree="tree">
                                                    <TemplateSlotView Slot="c.OutputSlot" Tree="tree" SlotSize="20" />
                                                </WorkflowSlotConnectionBehavior>
                                            </OutputSlots>
                                        </TemplateNodeView>
                                        break;
                                    case NodeViewModel w:
                                        <TemplateNodeView Node="w"
                                                          AllowOverflow="true"
                                                          Background="#DD2D2D2D" Foreground="#DDECECEC"
                                                          BorderBrush="#DD4B5563" BorderThickness="1.5" CornerRadius="6">
                                            <BodyContent>
                                                <WorkflowNodeView Node="w" />
                                            </BodyContent>
                                            <InputSlots>
                                                <WorkflowSlotConnectionBehavior Slot="w.InputSlot" Tree="tree">
                                                    <TemplateSlotView Slot="w.InputSlot" Tree="tree" SlotSize="20" />
                                                </WorkflowSlotConnectionBehavior>
                                            </InputSlots>
                                            <OutputSlots>
                                                <WorkflowSlotConnectionBehavior Slot="w.OutputSlot" Tree="tree">
                                                    <TemplateSlotView Slot="w.OutputSlot" Tree="tree" SlotSize="20" />
                                                </WorkflowSlotConnectionBehavior>
                                            </OutputSlots>
                                        </TemplateNodeView>
                                        break;
                                    case BoolSelectorNodeViewModel b:
                                        <TemplateNodeView Node="b"
                                                          AllowOverflow="true"
                                                          Background="#DD2D2D2D" Foreground="#DDECECEC"
                                                          BorderBrush="#DD4B5563" BorderThickness="1.5" CornerRadius="6">
                                            <BodyContent>
                                                <WorkflowBoolSelectorView Selector="b" Tree="tree" />
                                            </BodyContent>
                                            <InputSlots>
                                                <WorkflowSlotConnectionBehavior Slot="b.InputSlot" Tree="tree">
                                                    <TemplateSlotView Slot="b.InputSlot" Tree="tree" SlotSize="20" />
                                                </WorkflowSlotConnectionBehavior>
                                            </InputSlots>
                                        </TemplateNodeView>
                                        break;
                                    case EnumSelectorNodeViewModel e:
                                        <TemplateNodeView Node="e"
                                                          AllowOverflow="true"
                                                          Background="#DD2D2D2D" Foreground="#DDECECEC"
                                                          BorderBrush="#DD4B5563" BorderThickness="1.5" CornerRadius="6">
                                            <BodyContent>
                                                <WorkflowEnumSelectorView Selector="e" Tree="tree" />
                                            </BodyContent>
                                            <InputSlots>
                                                <WorkflowSlotConnectionBehavior Slot="e.InputSlot" Tree="tree">
                                                    <TemplateSlotView Slot="e.InputSlot" Tree="tree" SlotSize="20" />
                                                </WorkflowSlotConnectionBehavior>
                                            </InputSlots>
                                        </TemplateNodeView>
                                        break;
                                    case PythonScriptNodeViewModel p:
                                        <TemplateNodeView Node="p"
                                                          AllowOverflow="true"
                                                          Background="#DD2D2D2D" Foreground="#DDECECEC"
                                                          BorderBrush="#DD4B5563" BorderThickness="1.5" CornerRadius="6">
                                            <BodyContent>
                                                <WorkflowPythonNodeView Selector="p" Tree="tree" />
                                            </BodyContent>
                                        </TemplateNodeView>
                                        break;
                                    case TimerNodeViewModel t:
                                        <TemplateNodeView Node="t"
                                                          AllowOverflow="true"
                                                          Background="#DD2D2D2D" Foreground="#DDECECEC"
                                                          BorderBrush="#DD4B5563" BorderThickness="1.5" CornerRadius="6">
                                            <BodyContent>
                                                <WorkflowTimerView Selector="t" />
                                            </BodyContent>
                                            <InputSlots>
                                                <WorkflowSlotConnectionBehavior Slot="t.InputSlot" Tree="tree">
                                                    <TemplateSlotView Slot="t.InputSlot" Tree="tree" SlotSize="20" />
                                                </WorkflowSlotConnectionBehavior>
                                            </InputSlots>
                                            <OutputSlots>
                                                <WorkflowSlotConnectionBehavior Slot="t.OutputSlot" Tree="tree">
                                                    <TemplateSlotView Slot="t.OutputSlot" Tree="tree" SlotSize="20" />
                                                </WorkflowSlotConnectionBehavior>
                                            </OutputSlots>
                                        </TemplateNodeView>
                                        break;
                                }
                            </ItemTemplate>
                        </ViewPool>
                    </ChildContent>
                </WorkflowSurfaceBehavior>
            </div>
        }
    </main>

    <!-- Agent interaction modals (RequestSelection / RequestConfirmation) -->
    @if (_selection is { } sel)
    {
        <div class="wf-modal-overlay">
            <div class="wf-modal">
                <div class="wf-modal-header">@(sel.AllowMultiSelect ? "Agent · 请多选" : "Agent · 请选择")</div>
                <div class="wf-modal-body">
                    <p class="wf-modal-prompt">@sel.Prompt</p>
                    <div class="wf-modal-options">
                        @if (sel.AllowMultiSelect)
                        {
                            @foreach (var idx in System.Linq.Enumerable.Range(0, sel.Options.Length))
                            {
                                <label class="wf-opt">
                                    <input type="checkbox" checked="@sel.Checked[idx]" @onchange="e => OnCheckChanged(sel, idx, (bool)(e.Value ?? false))" />
                                    <span>@sel.Options[idx]</span>
                                </label>
                            }
                        }
                        else
                        {
                            @foreach (var opt in sel.Options)
                            {
                                <button class="wf-opt-btn" @onclick="() => PickOption(opt)">@opt</button>
                            }
                        }
                    </div>
                    <div class="wf-modal-freetext-label">@sel.FreeTextPrompt</div>
                    <input class="wf-modal-freetext" type="text" @bind="sel.FreeText" @bind:event="oninput" placeholder="@sel.FreeTextPrompt" />
                    <div class="wf-modal-actions">
                        @if (sel.AllowMultiSelect)
                        {
                            <button class="wf-btn-cancel" @onclick="CancelSelection">取消</button>
                            <button class="wf-btn-confirm" @onclick="ConfirmMultiSelection">确认选择</button>
                        }
                        else
                        {
                            <button class="wf-btn-cancel" @onclick="CancelSelection">取消（不选择）</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_confirmation is { } conf)
    {
        <div class="wf-modal-overlay">
            <div class="wf-modal">
                <div class="wf-modal-header" style="color:#ffd166;">Agent · 操作确认</div>
                <div class="wf-modal-body">
                    <div class="wf-modal-key">@conf.OperationKey</div>
                    <p class="wf-modal-prompt">@conf.Description</p>
                    <div class="wf-modal-actions">
                        <button class="wf-btn-deny" @onclick="() => CompleteConfirmation(AgentConfirmationResult.Deny)">拒绝</button>
                        <button class="wf-btn-once" @onclick="() => CompleteConfirmation(AgentConfirmationResult.AllowOnce)">仅同意一次</button>
                        <button class="wf-btn-always" @onclick="() => CompleteConfirmation(AgentConfirmationResult.AllowAlways)">本次会话始终同意</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
