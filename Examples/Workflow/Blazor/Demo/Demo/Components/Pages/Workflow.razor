@page "/"
@page "/workflow"
@rendermode RenderMode.InteractiveServer
@using System.Collections.Specialized
@using System.ComponentModel
@using VeloxDev.AI
@using VeloxDev.AI.Safety
@using VeloxDev.WorkflowSystem
@implements IDisposable

<PageTitle>VeloxDev Workflow — Blazor Demo</PageTitle>

<div class="wf-app">
    <!-- Sidebar -->
    <aside class="wf-sidebar">
        <button class="sb-btn" title="Undo" @onclick="Undo" disabled="@(_session?.Tree?.UndoCommand?.CanExecute(null) != true)">
            ↩ Undo
        </button>
        <button class="sb-btn" title="Redo" @onclick="Redo" disabled="@(_session?.Tree?.RedoCommand?.CanExecute(null) != true)">
            ↪ Redo
        </button>
        <button class="sb-btn" title="Save workflow as JSON" @onclick="SaveWorkflow">
            Save
        </button>
        <button class="sb-btn" title="Load workflow from JSON" @onclick="LoadWorkflow">
            Load
        </button>
        <div class="sb-divider"></div>

        <div class="sb-info">
            <span>节点总数: <strong>@(_session?.Tree?.Nodes.Count ?? 0)</strong></span>
            <span>连接数: <strong>@(_session?.Tree?.Links.Count ?? 0)</strong></span>
        </div>

        @* 权限模式：会话级设置，所以留在侧栏上部 —— 对话面板在侧栏底部，下拉在那里会被窗口底边
           裁掉，五个模式只剩第一项点得到。它也不是 AgentModes 的 build/plan 那一对：那一对改的是
           模型被告知什么，这一个改的是什么允许跑。切换运行期生效：门逐调用读策略，下一次工具调用
           就按新模式判，提示词下一轮跟上。 *@
        <div class="sb-panel">
            <div class="sb-panel-header">
                <span>权限模式</span>
            </div>
            <select class="wf-field" @onchange="OnPermissionModeChanged">
                @foreach (var mode in Enum.GetValues<AgentPermissionMode>())
                {
                    <option value="@mode" selected="@(mode == _permissionMode)">@mode</option>
                }
            </select>
        </div>

        <div class="sb-divider"></div>

        @* 运行控制：编译执行能力里「得有人按一下」的那两件 —— 暂停门与检查点恢复。其余几件
           （观察者、重试、错误 sink、补偿、日志落文件）在运行里自己生效，不需要控件。
           按钮走 code-behind 而不是 Command 绑定：门与检查点都在会话上、不在树上
           —— 与同栏的 Save / Load 同一个理由。 *@
        <div class="sb-panel">
            <div class="sb-panel-header">
                <span>运行控制</span>
                <span style="color:#a0a0a0;font-weight:normal;">@_runGateState</span>
            </div>
            <div style="display:flex;gap:6px;">
                <button class="sb-btn" style="flex:1;" @onclick="PauseWorkflow">Pause</button>
                <button class="sb-btn" style="flex:1;" @onclick="ResumeWorkflow">Resume</button>
            </div>
            <button class="sb-btn" @onclick="ContinueFromCheckpoint" disabled="@(!_hasCheckpoint)">
                从检查点继续
            </button>
        </div>

        <div class="sb-divider"></div>

        <!-- Agent Chat Panel -->
        <div class="sb-panel">
            <div class="sb-panel-header">
                <span>Agent 对话</span>
                <label class="sb-toggle">
                    <input type="checkbox" checked="@_useStreaming" @onchange="OnStreamingToggle" />
                    流式
                </label>
            </div>
            <div class="sb-agent-log">
                @if (_session?.Tree?.AgentLog is { } log)
                {
                    @foreach (var entry in log)
                    {
                        <div class="sb-log-entry">@entry</div>
                    }
                }
            </div>
            <div class="sb-agent-input-row">
                <input class="sb-agent-input" type="text" @bind="_agentMessage"
                       @onkeydown="OnAgentKeyDown" placeholder="输入消息..." />
                <button class="sb-agent-send" @onclick="SendToAgent" disabled="@string.IsNullOrWhiteSpace(_agentMessage)">
                    发送
                </button>
            </div>
        </div>

        <div class="sb-divider"></div>

        <!-- Execution Log Panel -->
        <div class="sb-panel">
            <div class="sb-panel-header">
                <span>实际执行顺序</span>
            </div>
            <div class="sb-exec-log">
                @if (_session?.Tree?.ExecutionLog is { } execLog)
                {
                    <div class="sb-log-entry">已记录: @execLog.Count</div>
                    @foreach (var entry in execLog)
                    {
                        <div class="sb-log-entry">@entry</div>
                    }
                }
            </div>
        </div>

        <!-- MCP Server Status Panel -->
        <div class="sb-panel">
            <div class="sb-panel-header">
                <span>MCP 服务器</span>
            </div>
            <div class="sb-exec-log">
                @if (McpStatus is { } mcp)
                {
                    <div class="sb-log-entry">存活 @mcp.ConnectedCount · 错误 @mcp.ErrorCount · 安装/连接 @mcp.WorkingCount</div>
                    @foreach (var s in mcp.Servers)
                    {
                        <div class="sb-log-entry">
                            <span>@s.Name — @s.StateText</span>
                            @if (s.ToolCount > 0)
                            {
                                <span> · @s.ToolCount tools</span>
                            }
                        </div>
                        @if (s.IsError && !string.IsNullOrEmpty(s.Error))
                        {
                            <div class="sb-log-entry" style="color:#ff6b6b">@s.Error</div>
                        }
                    }
                    <button class="sb-action-btn" @onclick="ReloadMcpAsync">重载</button>
                }
            </div>
        </div>
    </aside>

    <!-- Main Canvas Area -->
    <main class="wf-main">
        <div class="wf-toolbar">
            <button class="tb-btn tb-close" @onclick="StopWorkflow" disabled="@(_session?.Controller?.IsActive != true)">
                ■ Close Tree
            </button>
            <button class="tb-btn tb-reset" @onclick="ResetDemo">
                ↩ Reset
            </button>
            <span class="tb-status">@(_session?.Controller?.IsActive == true ? "● Running" : "○ Idle")</span>
            <span class="tb-layout">Layout: @_canvasLayoutSize</span>
        </div>

        @if (_session?.Tree is { } tree)
        {
            <div class="wf-canvas-wrapper">
                <WorkflowSurfaceBehavior @ref="_surface"
                                         Tree="tree"
                                         IsEnabled="true"
                                         ZoomEnabled="true"
                                         ScrollViewerId="wf-scroll"
                                         CanvasId="wf-canvas"
                                         GridSpacing="40"
                                         GridColor="#2A2D2E"
                                         MajorGridColor="#3A3D40"
                                         MajorLineEvery="5"
                                         AxisColor="#4D4D4D"
                                         Background="#1E1E1E">
                    <GridDecorator Context="vp">
                        <WorkflowGridDecorator Viewport="vp"
                                               RulerThickness="28" Spacing="40"
                                               MajorLineEvery="5"
                                               RulerBackground="rgba(37,37,38,0.78)"
                                               TickColor="#555555"
                                               LabelColor="#888888"
                                               AxisColor="#4D4D4D"
                                               DividerColor="#3A3D40" />
                    </GridDecorator>
                    <Minimap Context="vp">
                        <WorkflowMinimapOverlay Viewport="vp"
                                                Width="180" Height="120"
                                                ScrollViewerId="wf-scroll"
                                                Background="#1C2330"
                                                BorderColor="#475569"
                                                NodeFill="#38BDF8"
                                                ViewportStroke="#FFFFFF" />
                        @* 实时画布信息 HUD（左下浮动文本 + 复制按钮） *@
                        <InfoOverlay Tree="tree" Viewport="vp" />
                    </Minimap>
                    <ChildContent Context="sc">
                        @* Links layer: one full-canvas TemplateLinkView per connection (template product,
                           absolute, overflow visible). Each link draws a cubic curve with a light running
                           along it by arc length. The layer itself stays click-through — each link hands hit
                           testing back on its own strokes — and the surface's root is the keyboard host:
                           focus lands there on hover so Delete reaches the page without a click first. *@
                        <div class="veloxdev-wf-links"
                             style="position:absolute;left:0;top:0;width:@sc.Width.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)px;height:@sc.Height.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)px;pointer-events:none;outline:none;">
                            @foreach (var link in tree.Links)
                            {
                                @* Keyed by the link itself: a view carries per-link state that only
                                   OnInitialized seeds (visibility, endpoint subscriptions) plus the
                                   hover flag, and a positional diff would hand all of it to the
                                   neighbouring link whenever one is deleted. *@
                                <TemplateLinkView @key="link" Link="link" CanvasWidth="@sc.Width" CanvasHeight="@sc.Height"
                                                  IsSelected="@(_surface?.MenuLink == link)" />
                            }
                            @if (tree.VirtualLink.IsVisible)
                            {
                                <TemplateLinkView Link="tree.VirtualLink" CanvasWidth="@sc.Width" CanvasHeight="@sc.Height" />
                            }
                        </div>

                        @* Nodes layer: generated TemplateNodeView cards with type-specific body content
                           (template product). Each card wires slot-layout + node-drag behaviors itself,
                           and each card states only what is its own: its type accent (the 2px bar at the
                           head of the title row) and, when it has one, the status capsule it reads live.
                           The surface, the hairline and the title row are the shared card design system
                           in app.css — no card paints its own palette any more.

                           A port on the card's edge is 32 design units, a port inside a list is 24:
                           the card is authored at its design size and scaled, so these are design
                           lengths and they match the Avalonia cards' 32 / 24. *@
                        <ViewPool ItemsSource="tree.Nodes" KeySelector="n => n">
                            <ItemTemplate Context="node">
                                @switch (node)
                                {
                                    case ControllerViewModel c:
                                        <TemplateNodeView Node="c" Title="Network Flow Controller"
                                                          Accent="var(--wf-accent-controller)"
                                                          AllowOverflow="true"
                                                          BorderBrush="@(c.IsActive ? "var(--wf-accent-controller)" : null)">
                                            <BodyContent>
                                                <WorkflowControllerView Controller="c" />
                                            </BodyContent>
                                            <OutputSlots>
                                                @* TemplateSlotView 已为插槽开启连接行为，再包一层会让锚点与手势处理翻倍 *@
                                                <TemplateSlotView Slot="c.OutputSlot" Tree="tree" SlotSize="32" />
                                            </OutputSlots>
                                        </TemplateNodeView>
                                        break;
                                    case EnumSelectorNodeViewModel e:
                                        <TemplateNodeView Node="e"
                                                          Accent="var(--wf-accent-enum)"
                                                          StatusProperty="LastRouted"
                                                          AllowOverflow="true">
                                            <BodyContent>
                                                <WorkflowEnumSelectorView Selector="e" Tree="tree" />
                                            </BodyContent>
                                            <InputSlots>
                                                <TemplateSlotView Slot="e.InputSlot" Tree="tree" SlotSize="32" />
                                            </InputSlots>
                                        </TemplateNodeView>
                                        break;
                                    case PythonScriptNodeViewModel p:
                                        <TemplateNodeView Node="p"
                                                          Accent="var(--wf-accent-worker)"
                                                          StatusProperty="LastStatus"
                                                          AllowOverflow="true">
                                            <BodyContent>
                                                <WorkflowPythonNodeView Selector="p" Tree="tree" />
                                            </BodyContent>
                                        </TemplateNodeView>
                                        break;
                                    case TimerNodeViewModel t:
                                        <TemplateNodeView Node="t"
                                                          Accent="var(--wf-accent-worker)"
                                                          AllowOverflow="true">
                                            <BodyContent>
                                                <WorkflowTimerView Selector="t" />
                                            </BodyContent>
                                            <InputSlots>
                                                <TemplateSlotView Slot="t.InputSlot" Tree="tree" SlotSize="32" />
                                            </InputSlots>
                                            <OutputSlots>
                                                <TemplateSlotView Slot="t.OutputSlot" Tree="tree" SlotSize="32" />
                                            </OutputSlots>
                                        </TemplateNodeView>
                                        break;
                                    case IWorkflowNodeViewModel g:
                                        @* Generic catch-all: a foreign node still lands on the same card
                                           family, with the neutral slate accent, because there is no type
                                           here to give it a colour. *@
                                        <TemplateNodeView Node="g" AllowOverflow="true">
                                            <BodyContent>
                                                <WorkflowNodeView Node="g" />
                                            </BodyContent>
                                        </TemplateNodeView>
                                        break;
                                }
                            </ItemTemplate>
                        </ViewPool>
                    </ChildContent>
                    <LinkMenu Context="link">
                        @* VeloxDev customization: add or remove the item buttons here. The menu chrome,
                           its position, and the input wiring all live in the surface; each entry just
                           receives the link it acts on. *@
                        <button class="wf-link-menu-item" @onclick="() => link.DeleteCommand.Execute(null)">Delete</button>
                    </LinkMenu>
                </WorkflowSurfaceBehavior>
            </div>
        }
    </main>

    <!-- Agent interaction modals (RequestSelection / RequestConfirmation) -->
    @if (_selection is { } sel)
    {
        <div class="wf-modal-overlay">
            <div class="wf-modal">
                <div class="wf-modal-header">@(sel.AllowMultiSelect ? "Agent · 请多选" : "Agent · 请选择")</div>
                <div class="wf-modal-body">
                    <p class="wf-modal-prompt">@sel.Prompt</p>
                    <div class="wf-modal-options">
                        @if (sel.AllowMultiSelect)
                        {
                            @foreach (var idx in System.Linq.Enumerable.Range(0, sel.Options.Length))
                            {
                                <label class="wf-opt">
                                    <input type="checkbox" checked="@sel.Checked[idx]" @onchange="e => OnCheckChanged(sel, idx, (bool)(e.Value ?? false))" />
                                    <span>@sel.Options[idx]</span>
                                </label>
                            }
                        }
                        else
                        {
                            @foreach (var opt in sel.Options)
                            {
                                <button class="wf-opt-btn" @onclick="() => PickOption(opt)">@opt</button>
                            }
                        }
                    </div>
                    <div class="wf-modal-freetext-label">@sel.FreeTextPrompt</div>
                    <input class="wf-modal-freetext" type="text" @bind="sel.FreeText" @bind:event="oninput" placeholder="@sel.FreeTextPrompt" />
                    <div class="wf-modal-actions">
                        @if (sel.AllowMultiSelect)
                        {
                            <button class="wf-btn-cancel" @onclick="CancelSelection">取消</button>
                            <button class="wf-btn-confirm" @onclick="ConfirmMultiSelection">确认选择</button>
                        }
                        else
                        {
                            <button class="wf-btn-confirm" @onclick="SubmitFreeTextSelection" disabled="@string.IsNullOrWhiteSpace(sel.FreeText)">使用输入</button>
                            <button class="wf-btn-cancel" @onclick="CancelSelection">取消（不选择）</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_confirmation is { } conf)
    {
        <div class="wf-modal-overlay">
            <div class="wf-modal">
                <div class="wf-modal-header" style="color:#ffd166;">Agent · 操作确认</div>
                <div class="wf-modal-body">
                    <div class="wf-modal-key">@conf.OperationKey</div>
                    <p class="wf-modal-prompt">@conf.Description</p>
                    <div class="wf-modal-actions">
                        <button class="wf-btn-deny" @onclick="() => CompleteConfirmation(AgentConfirmationResult.Deny)">拒绝</button>
                        <button class="wf-btn-once" @onclick="() => CompleteConfirmation(AgentConfirmationResult.AllowOnce)">仅同意一次</button>
                        <button class="wf-btn-always" @onclick="() => CompleteConfirmation(AgentConfirmationResult.AllowAlways)">本次会话始终同意</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
