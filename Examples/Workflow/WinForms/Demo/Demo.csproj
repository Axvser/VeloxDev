<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The visual backend draws in 96-DPI coordinates; let Windows scale the whole window so a 100-unit
         width is the same physical size as WPF's 100 DIP (the XamlGallery demo uses the same mode). -->
    <ApplicationHighDpiMode>DpiUnawareGdiScaled</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Common\Lib\Lib.csproj" />
    <ProjectReference Include="..\..\..\..\Src\Adapters\VeloxDev.WinForms\VeloxDev.WinForms.csproj" />
    <ProjectReference Include="..\..\..\..\Src\Generators\VeloxDev.WinForms.Generator\VeloxDev.WinForms.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="**/*.xaml" />
  </ItemGroup>

</Project>