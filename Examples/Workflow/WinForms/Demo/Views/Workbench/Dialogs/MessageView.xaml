<local:WorkbenchViewBase
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views.Workbench"
    x:Class="Demo.Views.Workbench.MessageView"
    Background="{StaticResource WbDialogDeep}"
    Width="440">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource WbDialogHead}" Padding="18,14" CornerRadius="0">
      <TextBlock x:Name="TitleLabel" Text="" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WbAccentText}" />
    </Border>

    <TextBlock x:Name="BodyLabel"
               Grid.Row="1"
               Text=""
               FontSize="10"
               Foreground="{StaticResource WbTextPrimary}"
               Wrap="True"
               Margin="18,14,18,6" />

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,10,18,16">
      <Button x:Name="OkButton" Text="确定" Width="88" Height="32" Style="{StaticResource WbPrimary}" Click="OnOk" />
    </StackPanel>
  </Grid>
</local:WorkbenchViewBase>
