<local:WorkbenchViewBase
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views.Workbench"
    x:Class="Demo.Views.Workbench.AgentSelectionView"
    Background="{StaticResource WbDialogDeep}"
    Width="460">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource WbDialogHead}" Padding="18,14" CornerRadius="0">
      <StackPanel Spacing="6">
        <TextBlock x:Name="TitleLabel" Text="Agent · 请选择" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WbAccentText}" />
        <TextBlock x:Name="PromptLabel" Text="" FontSize="10" Foreground="{StaticResource WbTextPrimary}" Wrap="True" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="OptionsPanel" Spacing="4" Margin="16,12,16,0" />
    </ScrollViewer>

    <StackPanel Grid.Row="2" Margin="16,10,16,0" Spacing="4">
      <TextBlock x:Name="FreeTextPromptLabel" Text="" FontSize="9" Foreground="{StaticResource WbTextSecondary}" />
      <TextBox x:Name="FreeTextInput" Style="{StaticResource WbInputBox}" Height="30" />
    </StackPanel>

    <StackPanel x:Name="ButtonRow" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="16,12,16,16" />
  </Grid>
</local:WorkbenchViewBase>
