<local:WorkbenchViewBase
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views.Workbench"
    x:Class="Demo.Views.Workbench.ElementListView"
    Background="{StaticResource WbSurface}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="30" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource WbSurface}" BorderBrush="{StaticResource WbBorderSubtle}" BorderThickness="0,0,0,1" Padding="0" CornerRadius="0">
      <StackPanel Orientation="Horizontal" Spacing="2" Padding="2,0,0,0">
        <local:TabButton x:Name="NodeTab" Text="节点" Width="52" IsActive="True" Click="OnKindClick" />
        <local:TabButton x:Name="SlotTab" Text="插槽" Width="52" Click="OnKindClick" />
        <local:TabButton x:Name="LinkTab" Text="连线" Width="52" Click="OnKindClick" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Background="{StaticResource WbSurface}" Padding="0" CornerRadius="0">
      <ScrollViewer x:Name="RowScroll"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="RowStack" Spacing="1" Padding="0,2,0,2" />
      </ScrollViewer>
    </Border>

    <TextBlock x:Name="StatusLine"
               Grid.Row="2"
               Style="{StaticResource WbCaption}"
               Margin="6,6,6,4" />
  </Grid>
</local:WorkbenchViewBase>
