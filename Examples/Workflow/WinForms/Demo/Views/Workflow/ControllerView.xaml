<local:ControllerView
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views.Workflow"
    xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.WinForms"
    x:Class="Demo.Views.Workflow.ControllerView"
    ClipToBounds="False"
    behaviors:WorkflowSlotLayoutBehavior.IsEnabled="True"
    behaviors:WorkflowSlotLayoutBehavior.SlotNames="PART_OutputSlot"
    behaviors:WorkflowSlotLayoutBehavior.CoordinateHostName="PART_Canvas">

  <!-- VeloxDev customization: the Controller card, mirroring the WPF Full demo's 230x170 layout. The design size
       equals [DefaultSize], so the Viewbox keeps scale 1 at the default node size. PART_OutputSlot is the single
       output port the engine publishes through WorkflowSlotLayoutBehavior.SlotNames, rather than the raw
       Node.Slots fallback. -->
  <Viewbox Stretch="Uniform" ClipToBounds="False">
    <Grid Width="230" Height="170" ClipToBounds="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="32" />
        <RowDefinition Height="*" />
        <RowDefinition Height="66" />
      </Grid.RowDefinitions>

      <Border Grid.RowSpan="3"
              Background="#FF252526"
              BorderBrush="#FF3C3C3C"
              BorderThickness="1"
              CornerRadius="8"
              Padding="0" />

      <Border Grid.Row="0"
              Background="#FF252526"
              BorderBrush="#FF262626"
              BorderThickness="0,0,0,1"
              Padding="0"
              behaviors:WorkflowNodeDragBehavior.IsEnabled="True"
              behaviors:WorkflowNodeDragBehavior.CoordinateHostName="PART_Canvas">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border x:Name="accentBar" Grid.Column="0" CornerRadius="2" Margin="0,8,0,8" />
          <TextBlock x:Name="titleText"
                     Grid.Column="1"
                     Text="Controller"
                     Foreground="#FFE7E7E7"
                     Margin="12,0,0,0"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Border Grid.Row="1" Padding="12,9" Background="Transparent">
        <StackPanel>
          <TextBlock x:Name="seedLabel"
                     Text="SEED"
                     Foreground="#FF6E7681" />
          <TextBox x:Name="seedBox"
                   Height="28"
                   Margin="0,5,0,0"
                   Padding="7,4"
                   CornerRadius="6"
                   Background="#FF2A2A2A"
                   BorderBrush="#FF3C3C3C"
                   BorderThickness="1"
                   Foreground="#FFA0A0A0" />
        </StackPanel>
      </Border>

      <Border Grid.Row="2"
              Background="#FF1B1B1C"
              BorderBrush="#FF262626"
              BorderThickness="0,1,0,0"
              Padding="0" />

      <Grid Grid.Row="2" Margin="12,7">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button x:Name="compileButton"
                Grid.Row="0" Grid.Column="0"
                Margin="0,0,3,3"
                Text="Compile"
                Command="{Binding CompileCommand}"
                Background="Transparent"
                BorderBrush="#FF3C3C3C"
                BorderThickness="1"
                CornerRadius="6"
                Padding="5,3"
                HorizontalAlignment="Stretch" />
        <Button x:Name="runButton"
                Grid.Row="0" Grid.Column="1"
                Margin="3,0,0,3"
                Text="Run"
                Command="{Binding RunCommand}"
                IsEnabled="{Binding HasCompiledGraphs}"
                Background="Transparent"
                BorderBrush="#FF3C3C3C"
                BorderThickness="1"
                CornerRadius="6"
                Padding="5,3"
                HorizontalAlignment="Stretch" />
        <Button x:Name="stopButton"
                Grid.Row="1" Grid.Column="0"
                Margin="0,3,3,0"
                Text="Stop"
                Command="{Binding StopCommand}"
                Background="Transparent"
                BorderBrush="#FF3C3C3C"
                BorderThickness="1"
                CornerRadius="6"
                Padding="5,3"
                HorizontalAlignment="Stretch" />
        <Button x:Name="closeButton"
                Grid.Row="1" Grid.Column="1"
                Margin="3,3,0,0"
                Text="Close"
                Command="{Binding CloseWorkflowCommand}"
                Background="Transparent"
                BorderBrush="#FF3C3C3C"
                BorderThickness="1"
                CornerRadius="6"
                Padding="5,3"
                HorizontalAlignment="Stretch" />
      </Grid>

      <local:FullSlotView x:Name="PART_OutputSlot"
                      Width="32" Height="32"
                      Grid.RowSpan="3"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,-16,0"
                      DataContext="{Binding OutputSlot}"
                      SlotState="{Binding State}"
                      behaviors:WorkflowSlotConnectionBehavior.IsEnabled="True" />
    </Grid>
  </Viewbox>

</local:ControllerView>
