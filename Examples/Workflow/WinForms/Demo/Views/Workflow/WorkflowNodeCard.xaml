<local:WorkflowNodeCard
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views.Workflow"
    xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.WinForms"
    x:Class="Demo.Views.Workflow.WorkflowNodeCard"
    IsHitTestVisible="True"
    ClipToBounds="False"
    behaviors:WorkflowSlotLayoutBehavior.IsEnabled="True"
    behaviors:WorkflowSlotLayoutBehavior.CoordinateHostName="PART_Canvas">

  <!-- VeloxDev customization: the foreign-node fallback card. It carries the shared chrome and drag surface but no
       PART_* slot parts, so an unknown node type keeps the engine's raw slot fallback. -->
  <Viewbox Stretch="Uniform" ClipToBounds="False">
    <Grid Width="260" Height="180" ClipToBounds="False">
      <Border Background="#FF252526"
              BorderBrush="#FF3C3C3C"
              BorderThickness="1"
              CornerRadius="8"
              Padding="0"
              behaviors:WorkflowNodeDragBehavior.IsEnabled="True"
              behaviors:WorkflowNodeDragBehavior.CoordinateHostName="PART_Canvas">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="#FF94A3B8" CornerRadius="2" Margin="0,8,0,8" />
          <TextBlock x:Name="cardTitle"
                     Grid.Column="1"
                     Foreground="#FFE7E7E7"
                     VerticalAlignment="Center"
                     Margin="12,0,0,0" />
        </Grid>
      </Border>
    </Grid>
  </Viewbox>

</local:WorkflowNodeCard>
