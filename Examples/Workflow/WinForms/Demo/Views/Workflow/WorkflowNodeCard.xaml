<local:WorkflowNodeCard
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views.Workflow"
    x:Class="Demo.Views.Workflow.WorkflowNodeCard"
    Padding="1"
    Margin="0">

  <!-- The card frame: a single column of header / divider / body / divider / footer. The rows are
       created per node type and the cell placement plus every section's content stay in code-behind,
       because the generator has no TableLayoutPanel cell-position attribute. The two surface colours
       are applied in code so CardTheme stays the single source of the palette. -->
  <TableLayoutPanel x:Name="_rootLayout"
                    Dock="Fill"
                    Margin="0"
                    Padding="1"
                    ColumnCount="1"
                    RowCount="5" />

</local:WorkflowNodeCard>
