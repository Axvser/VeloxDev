<local:TimerNodeView
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views.Workflow"
    xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.WinForms"
    x:Class="Demo.Views.Workflow.TimerNodeView"
    ClipToBounds="False"
    behaviors:WorkflowSlotLayoutBehavior.IsEnabled="True"
    behaviors:WorkflowSlotLayoutBehavior.SlotNames="PART_InputSlot,PART_OutputSlot"
    behaviors:WorkflowSlotLayoutBehavior.CoordinateHostName="PART_Canvas">

  <local:TimerNodeView.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolVisibility" />
  </local:TimerNodeView.Resources>

  <!-- VeloxDev customization: the Timer card, mirroring the WPF Full demo's 200x140 layout. The single input and
       output ports are template slots named for the visual engine. -->
  <Viewbox Stretch="Uniform" ClipToBounds="False">
    <Grid Width="200" Height="140" ClipToBounds="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="32" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.RowSpan="2"
              Background="#FF252526"
              BorderBrush="#FF3C3C3C"
              BorderThickness="1"
              CornerRadius="8"
              Padding="0" />

      <Border Grid.Row="0"
              Background="#FF252526"
              BorderBrush="#FF262626"
              BorderThickness="0,0,0,1"
              Padding="0"
              behaviors:WorkflowNodeDragBehavior.IsEnabled="True"
              behaviors:WorkflowNodeDragBehavior.CoordinateHostName="PART_Canvas">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border x:Name="accentBar" Grid.Column="0" CornerRadius="2" Margin="0,8,0,8" />
          <TextBlock x:Name="titleText"
                     Grid.Column="1"
                     Text="{Binding Title}"
                     Foreground="#FFE7E7E7"
                     Margin="12,0,6,0"
                     VerticalAlignment="Center" />
          <TextBlock x:Name="orderText"
                     Grid.Column="2"
                     Text="{Binding ExecutionOrderText}"
                     Foreground="#FF7EE787"
                     Margin="0,0,12,0"
                     VerticalAlignment="Center"
                     Visibility="{Binding HasExecutionOrder, Converter={StaticResource BoolVisibility}}" />
        </Grid>
      </Border>

      <Border Grid.Row="1" Padding="12,9" Background="Transparent">
        <StackPanel>
          <TextBlock x:Name="intervalLabel"
                     Text="INTERVAL (MS)"
                     Foreground="#FF6E7681" />
          <TextBox x:Name="intervalBox"
                   Height="28"
                       Margin="0,5,0,0"
                       Padding="7,4"
                       CornerRadius="6"
                       Wrap="False"
                       Background="#FF2A2A2A"
                       BorderBrush="#FF3C3C3C"
                       BorderThickness="1"
                       Foreground="#FFA0A0A0" />
          <TextBlock x:Name="tickLabel"
                     Text="LAST TICK"
                     Foreground="#FF6E7681"
                     Margin="0,9,0,0" />
          <TextBlock x:Name="tickValue"
                     Text="{Binding LastTick}"
                     Foreground="#FF4FC1FF"
                     Margin="0,5,0,0"
                     Wrap="True" />
        </StackPanel>
      </Border>

      <local:FullSlotView x:Name="PART_InputSlot"
                      Width="32" Height="32"
                      Grid.RowSpan="2"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Margin="-16,0,0,0"
                      DataContext="{Binding InputSlot}"
                      SlotState="{Binding State}"
                      behaviors:WorkflowSlotConnectionBehavior.IsEnabled="True" />
      <local:FullSlotView x:Name="PART_OutputSlot"
                      Width="32" Height="32"
                      Grid.RowSpan="2"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,-16,0"
                      DataContext="{Binding OutputSlot}"
                      SlotState="{Binding State}"
                      behaviors:WorkflowSlotConnectionBehavior.IsEnabled="True" />
    </Grid>
  </Viewbox>

</local:TimerNodeView>
