<local:EnumSelectorNodeView
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views.Workflow"
    xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.WinForms"
    x:Class="Demo.Views.Workflow.EnumSelectorNodeView"
    ClipToBounds="False"
    behaviors:WorkflowSlotLayoutBehavior.IsEnabled="True"
    behaviors:WorkflowSlotLayoutBehavior.SlotNames="PART_InputSlot"
    behaviors:WorkflowSlotLayoutBehavior.SlotEnumeratorNames="PART_OutputSlotsList"
    behaviors:WorkflowSlotLayoutBehavior.CoordinateHostName="PART_Canvas">

  <!-- VeloxDev customization: the enum selector card, mirroring the WPF Full demo's 280x380 layout. Its output list
       binds OutputSlots.Items only: the card never shows the node's raw slot collection, so a selector that swapped
       its enum cannot leave stale ports behind. -->
  <Viewbox Stretch="Uniform" ClipToBounds="False">
    <Grid Width="280" Height="380" ClipToBounds="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="32" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.RowSpan="2"
              Background="#FF252526"
              BorderBrush="#FF3C3C3C"
              BorderThickness="1"
              CornerRadius="8"
              Padding="0" />

      <Border Grid.Row="0"
              Background="#FF252526"
              BorderBrush="#FF262626"
              BorderThickness="0,0,0,1"
              Padding="0"
              behaviors:WorkflowNodeDragBehavior.IsEnabled="True"
              behaviors:WorkflowNodeDragBehavior.CoordinateHostName="PART_Canvas">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border x:Name="accentBar" Grid.Column="0" CornerRadius="2" Margin="0,8,0,8" />
          <TextBlock x:Name="titleText"
                     Grid.Column="1"
                     Text="{Binding Title}"
                     Foreground="#FFE7E7E7"
                     Margin="12,0,6,0"
                     VerticalAlignment="Center" />
          <TextBlock x:Name="orderText"
                     Grid.Column="2"
                     Text="{Binding ExecutionOrderText}"
                     Foreground="#FF7EE787"
                     Margin="0,0,12,0"
                     VerticalAlignment="Center" />
          <Border Grid.Column="3"
                  Background="#FF2A2D2E"
                  BorderBrush="#FF3C3C3C"
                  BorderThickness="1"
                  CornerRadius="9"
                  Padding="7,1"
                  Margin="0,0,12,0"
                  VerticalAlignment="Center">
            <TextBlock x:Name="routedText"
                       Text="{Binding LastRouted}"
                       Foreground="#FFC99BFF" />
          </Border>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1">
        <StackPanel Margin="14,10">
          <TextBlock x:Name="valueLabel"
                     Text="SELECTED METHOD"
                     Foreground="#FF6E7681" />
          <ComboBox x:Name="valuePicker"
                    ItemsSource="{Binding EnumValues}"
                    SelectedItem="{Binding SelectedValue, Mode=TwoWay}"
                    Margin="0,6,0,0"
                    Height="28"
                    Padding="7,3"
                    CornerRadius="6"
                    Background="#FF2A2A2A"
                    BorderBrush="#FF3C3C3C"
                    BorderThickness="1"
                    HorizontalAlignment="Stretch" />
          <TextBlock x:Name="modeLabel"
                     Text="COMPILE MODE"
                     Foreground="#FF6E7681"
                     Margin="0,10,0,0" />
          <ComboBox x:Name="modePicker"
                    ItemsSource="{Binding CompileModeNames}"
                    SelectedItem="{Binding CompileModeName, Mode=TwoWay}"
                    Margin="0,6,0,0"
                    Height="28"
                    Padding="7,3"
                    CornerRadius="6"
                    Background="#FF2A2A2A"
                    BorderBrush="#FF3C3C3C"
                    BorderThickness="1"
                    HorizontalAlignment="Stretch" />
          <TextBlock x:Name="outputLabel"
                     Text="OUTPUT SLOTS"
                     Foreground="#FF6E7681"
                     Margin="0,12,0,0" />
          <ItemsControl x:Name="PART_OutputSlotsList"
                        ItemsSource="{Binding OutputSlots.Items}"
                        Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0"
                             Text="{Binding Name}"
                             Foreground="#FFC99BFF"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Right"
                             Margin="0,0,12,0" />
                  <local:FullSlotView Grid.Column="1"
                                  Width="24" Height="24"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,-12,0"
                                  DataContext="{Binding Slot}"
                                  SlotState="{Binding State}"
                                  behaviors:WorkflowSlotConnectionBehavior.IsEnabled="True" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <local:FullSlotView x:Name="PART_InputSlot"
                      Width="32" Height="32"
                      Grid.Row="1"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Margin="-16,0,0,0"
                      DataContext="{Binding InputSlot}"
                      SlotState="{Binding State}"
                      behaviors:WorkflowSlotConnectionBehavior.IsEnabled="True" />
    </Grid>
  </Viewbox>

</local:EnumSelectorNodeView>
