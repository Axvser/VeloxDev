<local:WorkflowSurfaceView
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.WinForms"
    xmlns:local="clr-namespace:Demo.Views.Workflow"
    x:Class="Demo.Views.Workflow.WorkflowSurfaceView"
    behaviors:WorkflowSurfaceBehavior.IsEnabled="True"
    behaviors:WorkflowSurfaceBehavior.CanvasName="PART_Canvas"
    behaviors:WorkflowSurfaceBehavior.ScrollViewerName="PART_ScrollViewer"
    behaviors:WorkflowSurfaceBehavior.GridDecoratorName="PART_GridDecorator"
    behaviors:WorkflowSurfaceBehavior.MinimapOverlayName="PART_MinimapOverlay"
    behaviors:WorkflowSurfaceBehavior.PointerPressSourceName="PART_SurfaceBorder"
    behaviors:WorkflowSurfaceBehavior.ZoomEnabled="True"
    behaviors:WorkflowSurfaceBehavior.LinkMenuKey="LinkContextMenu"
    behaviors:WorkflowSurfaceBehavior.VisualLinkColor="#CC6E8BFF"
    behaviors:WorkflowSurfaceBehavior.VisualLinkThickness="2"
    behaviors:WorkflowSurfaceBehavior.VisualLinkHoverColor="White"
    behaviors:WorkflowSurfaceBehavior.VisualLinkHoverThickness="3.5"
    behaviors:WorkflowSurfaceBehavior.VisualLinkVirtualColor="#CC6E8BFF"
    behaviors:WorkflowSurfaceBehavior.VisualLinkGlow="True"
    ClipToBounds="True">

  <local:WorkflowSurfaceView.Resources>
    <DataTemplate x:Key="ControllerTemplate">
      <local:ControllerView Width="{Binding Size.Width}"
                            Height="{Binding Size.Height}"
                            Canvas.Left="{Binding Anchor.Horizontal}"
                            Canvas.Top="{Binding Anchor.Vertical}"
                            Panel.ZIndex="{Binding Anchor.Layer}" />
    </DataTemplate>
    <DataTemplate x:Key="TimerTemplate">
      <local:TimerNodeView Width="{Binding Size.Width}"
                           Height="{Binding Size.Height}"
                           Canvas.Left="{Binding Anchor.Horizontal}"
                           Canvas.Top="{Binding Anchor.Vertical}"
                           Panel.ZIndex="{Binding Anchor.Layer}" />
    </DataTemplate>
    <DataTemplate x:Key="PythonTemplate">
      <local:PythonNodeView Width="{Binding Size.Width}"
                            Height="{Binding Size.Height}"
                            Canvas.Left="{Binding Anchor.Horizontal}"
                            Canvas.Top="{Binding Anchor.Vertical}"
                            Panel.ZIndex="{Binding Anchor.Layer}" />
    </DataTemplate>
    <DataTemplate x:Key="EnumTemplate">
      <local:EnumSelectorNodeView Width="{Binding Size.Width}"
                                  Height="{Binding Size.Height}"
                                  Canvas.Left="{Binding Anchor.Horizontal}"
                                  Canvas.Top="{Binding Anchor.Vertical}"
                                  Panel.ZIndex="{Binding Anchor.Layer}" />
    </DataTemplate>
    <DataTemplate x:Key="NodeTemplate">
      <local:WorkflowNodeCard Width="{Binding Size.Width}"
                              Height="{Binding Size.Height}"
                              Canvas.Left="{Binding Anchor.Horizontal}"
                              Canvas.Top="{Binding Anchor.Vertical}"
                              Panel.ZIndex="{Binding Anchor.Layer}" />
    </DataTemplate>
    <DataTemplate x:Key="SlotTemplate">
      <local:FullSlotView />
    </DataTemplate>
    <DataTemplate x:Key="LinkTemplate">
      <local:LinkView StartLeft="{Binding Sender.Anchor.Horizontal}"
                      StartTop="{Binding Sender.Anchor.Vertical}"
                      EndLeft="{Binding Receiver.Anchor.Horizontal}"
                      EndTop="{Binding Receiver.Anchor.Vertical}"
                      CanRender="{Binding IsVisible}"
                      Width="{Binding Width, ElementName=PART_Canvas}"
                      Height="{Binding Height, ElementName=PART_Canvas}"
                      Panel.ZIndex="-1" />
    </DataTemplate>
    <VisualContextMenu x:Key="LinkContextMenu">
      <VisualContextMenu.Items>
        <VisualMenuItem Header="Delete" CommandPath="DeleteCommand" />
      </VisualContextMenu.Items>
    </VisualContextMenu>
    <local:CustomTemplateSelector x:Key="WorkflowTemplateSelector"
                                  ControllerTemplate="{StaticResource ControllerTemplate}"
                                  TimerTemplate="{StaticResource TimerTemplate}"
                                  PythonTemplate="{StaticResource PythonTemplate}"
                                  EnumTemplate="{StaticResource EnumTemplate}"
                                  NodeTemplate="{StaticResource NodeTemplate}"
                                  SlotTemplate="{StaticResource SlotTemplate}"
                                  LinkTemplate="{StaticResource LinkTemplate}" />
  </local:WorkflowSurfaceView.Resources>

  <Grid ClipToBounds="False">
    <Border x:Name="PART_SurfaceBorder"
            Padding="0"
            Background="#1E1E1E"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="0"
            ClipToBounds="False">
      <local:GridDecorator x:Name="PART_GridDecorator"
                           GridSpacing="40"
                           MajorLineEvery="5"
                           RulerThickness="28"
                           DrawSurface="False"
                           ClipToBounds="False">
        <ScrollViewer x:Name="PART_ScrollViewer" IsScrollInputEnabled="False">
          <Canvas x:Name="PART_Canvas"
                  UnboundedHitTest="True"
                  ClipToBounds="False"
                  behaviors:ViewPool.ItemsSource="{Binding Helper.VisibleItems}"
                  behaviors:ViewPool.TemplateSelector="{StaticResource WorkflowTemplateSelector}" />
        </ScrollViewer>
      </local:GridDecorator>
    </Border>

    <local:MinimapOverlay x:Name="PART_MinimapOverlay"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />

    <behaviors:WorkflowInfoOverlay x:Name="PART_InfoOverlay"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Bottom"
                                   Margin="46,0,0,12"
                                   ScrollOffsetX="{Binding ScrollOffsetX, ElementName=PART_GridDecorator}"
                                   ScrollOffsetY="{Binding ScrollOffsetY, ElementName=PART_GridDecorator}"
                                   ContentOffsetX="{Binding ContentOffsetX, ElementName=PART_GridDecorator}"
                                   ContentOffsetY="{Binding ContentOffsetY, ElementName=PART_GridDecorator}" />
  </Grid>

</local:WorkflowSurfaceView>
