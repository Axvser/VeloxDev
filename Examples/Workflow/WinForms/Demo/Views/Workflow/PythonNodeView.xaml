<local:PythonNodeView
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views.Workflow"
    xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.WinForms"
    x:Class="Demo.Views.Workflow.PythonNodeView"
    ClipToBounds="False"
    behaviors:WorkflowSlotLayoutBehavior.IsEnabled="True"
    behaviors:WorkflowSlotLayoutBehavior.SlotEnumeratorNames="PART_InputSlotsList,PART_OutputSlotsList"
    behaviors:WorkflowSlotLayoutBehavior.CoordinateHostName="PART_Canvas">

  <local:PythonNodeView.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolVisibility" />
  </local:PythonNodeView.Resources>

  <!-- VeloxDev customization: the Python card, mirroring the WPF Full demo's 280x260 layout. Input and output port
       strips are their own scroll viewports, inset so the edge glyphs ride the card border without clipping. -->
  <Viewbox Stretch="Uniform" ClipToBounds="False">
    <Grid Width="280" Height="260" ClipToBounds="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="32" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.RowSpan="3"
              Background="#FF252526"
              BorderBrush="#FF3C3C3C"
              BorderThickness="1"
              CornerRadius="8"
              Padding="0" />

      <Border Grid.Row="0"
              Background="#FF252526"
              BorderBrush="#FF262626"
              BorderThickness="0,0,0,1"
              Padding="0"
              behaviors:WorkflowNodeDragBehavior.IsEnabled="True"
              behaviors:WorkflowNodeDragBehavior.CoordinateHostName="PART_Canvas">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border x:Name="accentBar" Grid.Column="0" CornerRadius="2" Margin="0,8,0,8" />
          <TextBlock x:Name="titleText"
                     Grid.Column="1"
                     Text="{Binding Title}"
                     Foreground="#FFE7E7E7"
                     Margin="12,0,6,0"
                     VerticalAlignment="Center" />
          <TextBlock x:Name="orderText"
                     Grid.Column="2"
                     Text="{Binding ExecutionOrderText}"
                     Foreground="#FF7EE787"
                     Margin="0,0,12,0"
                     VerticalAlignment="Center"
                     Visibility="{Binding HasExecutionOrder, Converter={StaticResource BoolVisibility}}" />
          <Border Grid.Column="3"
                  Background="#FF2A2D2E"
                  BorderBrush="#FF3C3C3C"
                  BorderThickness="1"
                  CornerRadius="9"
                  Padding="7,1"
                  Margin="0,0,12,0"
                  VerticalAlignment="Center">
            <TextBlock x:Name="statusText"
                       Text="{Binding LastStatus}"
                       Foreground="#FFA0A0A0" />
          </Border>
        </Grid>
      </Border>

      <Border Grid.Row="1"
              Padding="12,5"
              Background="Transparent"
              BorderBrush="#FF262626"
              BorderThickness="0,0,0,1">
        <TextBlock x:Name="descriptionText"
                   Text="{Binding Description}"
                   Foreground="#FF6E7681"
                   Wrap="True" />
      </Border>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="64" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="64" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" Margin="-12,0,0,0">
          <ItemsControl x:Name="PART_InputSlotsList"
                        ItemsSource="{Binding InputSlots.Items}"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <local:FullSlotView Grid.Column="0"
                                  Width="24" Height="24"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Margin="-12,0,0,0"
                                  DataContext="{Binding Slot}"
                                  SlotState="{Binding State}"
                                  behaviors:WorkflowSlotConnectionBehavior.IsEnabled="True" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding Name}"
                             Foreground="#FF00A7A7"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Left"
                             Margin="4,0,0,0" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Border Grid.Column="1"
                Margin="4,6"
                Background="#FF0D1117"
                BorderBrush="#FF262626"
                BorderThickness="1"
                CornerRadius="6"
                Padding="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="#FF1B1B1C"
                    BorderBrush="#FF262626"
                    BorderThickness="0,0,0,1"
                    CornerRadius="6"
                    Padding="8,4">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="scriptNameText"
                           Grid.Column="0"
                           Text="script.py"
                           Foreground="#FF7EE787" />
                <TextBlock x:Name="scriptKindText"
                           Grid.Column="1"
                           Text="Python 3"
                           Foreground="#FF585858" />
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" IsScrollInputEnabled="True">
              <TextBox x:Name="scriptBox"
                       AcceptsReturn="True"
                       Wrap="False"
                       Background="Transparent"
                       Foreground="#FFD6DCE6"
                       BorderThickness="0"
                       Padding="6,4" />
            </ScrollViewer>
          </Grid>
        </Border>

        <ScrollViewer Grid.Column="2" Margin="0,0,-12,0">
          <ItemsControl x:Name="PART_OutputSlotsList"
                        ItemsSource="{Binding OutputSlots.Items}"
                        Margin="0,0,12,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0"
                             Text="{Binding Name}"
                             Foreground="#FF00A7A7"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Right"
                             Margin="0,0,4,0" />
                  <local:FullSlotView Grid.Column="1"
                                  Width="24" Height="24"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,-12,0"
                                  DataContext="{Binding Slot}"
                                  SlotState="{Binding State}"
                                  behaviors:WorkflowSlotConnectionBehavior.IsEnabled="True" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Viewbox>

</local:PythonNodeView>
