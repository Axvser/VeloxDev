<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views.Workflow"
    xmlns:hosting="clr-namespace:VeloxDev.WorkflowSystem.VisualHosting;assembly=VeloxDev.WinForms"
    x:Class="Demo.Views.Workflow.WorkflowCanvas"
    BackColor="#FF171717">

  <!-- VeloxDev customization: the workflow surface is the HWND-free visual host; the HUD stays a normal
       WinForms overlay pinned over it. -->

  <Panel x:Name="surfaceRoot" Dock="Fill" BackColor="#FF171717">
    <hosting:VisualWorkflowSurface x:Name="workflowHost" Dock="Fill" />
    <local:InfoOverlay x:Name="_infoOverlay" />
  </Panel>

</UserControl>
