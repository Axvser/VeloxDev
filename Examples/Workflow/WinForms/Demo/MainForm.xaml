<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:workbench="clr-namespace:Demo.Views.Workbench"
    x:Class="Demo.MainForm"
    Title="VeloxDev Workflow Demo"
    Width="1440"
    Height="820"
    StartPosition="CenterScreen"
    WindowState="Maximized">
  <!-- The workbench is one visual tree; the window only owns the surface. -->
  <workbench:WorkbenchView x:Name="View" />
</Window>
