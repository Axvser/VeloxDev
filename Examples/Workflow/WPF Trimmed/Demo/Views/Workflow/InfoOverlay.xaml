<UserControl x:Class="Demo.Views.Workflow.InfoOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Realtime canvas-info HUD. The text layer (translucent Border + TextBlock) is hit-test
         transparent so drags fall through to the surface; only the 复制 button is interactive.
         The window/host feeds ScrollOffset/ContentOffset/Viewport DPs the same way as the minimap,
         and the control subscribes to the Core model for scale / actual size / visible counts. -->
    <Grid>
        <Border IsHitTestVisible="False"
                CornerRadius="6"
                Background="#E612151B"
                BorderBrush="#CC8EA3B8"
                BorderThickness="1"
                Padding="12,8,58,8">
            <TextBlock x:Name="InfoText"
                       Foreground="#DDE4EA"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       LineHeight="18"
                       IsHitTestVisible="False" />
        </Border>
        <Button x:Name="CopyButton"
                Content="复制"
                FontSize="11"
                Padding="8,2"
                Margin="0,0,8,8"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="#1E3A5F"
                Foreground="#7EC8FF"
                BorderBrush="#7EC8FF"
                BorderThickness="1"
                Cursor="Hand"
                Click="OnCopyClicked" />
    </Grid>
</UserControl>
