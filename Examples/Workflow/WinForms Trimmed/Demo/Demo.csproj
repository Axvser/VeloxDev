<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The visual backend keeps its public layout in logical DIPs (96 DPI) and scales its own Graphics by
         DeviceDpi/96. Run per-monitor aware so the window itself is laid out at the real monitor DPI instead
         of letting Windows bitmap-scale a DpiUnaware window. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- The XAML views take their base types from VeloxDev.WinForms.Xaml; the implicit WinForms
         namespace would make Control/UserControl/Panel ambiguous in those files. Every other file
         imports it explicitly. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Src\Adapters\VeloxDev.WinForms\VeloxDev.WinForms.csproj" />
    <ProjectReference Include="..\..\..\..\Src\Core\VeloxDev.Core\VeloxDev.Core.csproj" />
    <ProjectReference Include="..\..\..\..\Src\Generators\VeloxDev.WinForms.Generator\VeloxDev.WinForms.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="**/*.xaml" />
  </ItemGroup>
</Project>
