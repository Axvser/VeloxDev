<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views.Workflow"
    xmlns:hosting="clr-namespace:VeloxDev.WorkflowSystem.VisualHosting;assembly=VeloxDev.WinForms"
    x:Class="Demo.Views.Workflow.TreeView"
    BackColor="#FF1E1E1E">

  <!-- VeloxDev customization: the workflow surface is the HWND-free visual host; the HUD stays a WinForms overlay. -->
  <Panel x:Name="surfaceRoot" Dock="Fill" BackColor="#FF1E1E1E">
    <hosting:VisualWorkflowSurface x:Name="workflowHost" Dock="Fill" />
    <local:InfoOverlay x:Name="_infoOverlay" />
  </Panel>

</UserControl>
