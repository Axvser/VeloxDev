<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views.Workflow"
    xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.WinForms"
    x:Class="Demo.Views.Workflow.TreeView"
    BackColor="#FF1E1E1E"
    behaviors:WorkflowSurfaceBehavior.IsEnabled="True"
    behaviors:WorkflowSurfaceBehavior.ZoomEnabled="True"
    behaviors:WorkflowSurfaceBehavior.TemplateSelector="{StaticResource WorkflowTemplateSelector}"
    behaviors:WorkflowSurfaceBehavior.ScrollViewerName="PART_ScrollViewer"
    behaviors:WorkflowSurfaceBehavior.CanvasName="PART_Canvas"
    behaviors:WorkflowSurfaceBehavior.GridDecoratorName="PART_GridDecorator"
    behaviors:WorkflowSurfaceBehavior.MinimapOverlayName="PART_MinimapOverlay"
    behaviors:WorkflowSurfaceBehavior.PointerPressSourceName="PART_Surface">

  <!-- VeloxDev customization: the workflow surface shell. Keep the PART_* names in step with the
       attached properties above; the behavior resolves them by Control.Name. -->

  <UserControl.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="NodeTemplate">
        <local:NodeView />
      </DataTemplate>
      <DataTemplate x:Key="LinkTemplate">
        <local:LinkView />
      </DataTemplate>
      <!-- VeloxDev customization: which view each pooled item kind gets. -->
      <local:CustomTemplateSelector x:Key="WorkflowTemplateSelector"
                                    NodeTemplate="{StaticResource NodeTemplate}"
                                    LinkTemplate="{StaticResource LinkTemplate}" />
      <!-- Restyle the surface scroll bars here; the bar draws itself instead of the native theme. -->
      <Style x:Key="SurfaceScrollBarStyle" TargetType="ScrollBar">
        <Style.Setters>
          <Setter Property="TrackBrush" Value="#22FFFFFF" />
          <Setter Property="ThumbBrush" Value="#66FFFFFF" />
          <Setter Property="ThumbHoverBrush" Value="#AAFFFFFF" />
          <Setter Property="ThumbBorderBrush" Value="#30FFFFFF" />
          <Setter Property="ThumbBorderThickness" Value="1" />
          <Setter Property="ThumbCornerRadius" Value="6" />
          <Setter Property="BarThickness" Value="12" />
          <Setter Property="ThumbMinLength" Value="24" />
        </Style.Setters>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <Panel x:Name="surfaceHost"
           Name="PART_Surface"
           Dock="Fill"
           BackColor="#FF1E1E1E">
    <!-- The grid decorator hosts the viewport and the canvas so the transparent canvas composites over the grid. -->
    <local:GridDecorator x:Name="gridDecorator"
                         Name="PART_GridDecorator"
                         Dock="Fill"
                         GridSpacing="40"
                         MajorLineEvery="5"
                         RulerThickness="36"
                         SurfaceBorderThickness="1"
                         SurfaceCornerRadius="3">
      <ScrollViewer x:Name="surfaceScrollHost"
                      Name="PART_ScrollViewer"
                      Dock="Fill"
                      BackColor="Transparent"
                      BarThickness="12"
                      HorizontalBarStyle="{StaticResource SurfaceScrollBarStyle}"
                      VerticalBarStyle="{StaticResource SurfaceScrollBarStyle}">
        <local:SurfaceCanvas x:Name="surfaceCanvas"
                             Name="PART_Canvas"
                             Dock="Fill"
                             behaviors:WorkflowLinkLayer.IsEnabled="True"
                             behaviors:WorkflowLinkLayer.LineColor="#DDFFFFFF"
                             behaviors:WorkflowLinkLayer.Thickness="2"
                             behaviors:WorkflowLinkLayer.HoveredLineColor="#FFFFFFFF"
                             behaviors:WorkflowLinkLayer.HoveredThickness="3.5" />
      </ScrollViewer>
    </local:GridDecorator>

    <!-- The bottom-left HUD and the top-right minimap float above the surface. -->
    <local:InfoOverlay x:Name="_infoOverlay" />
    <local:MinimapOverlay x:Name="minimapOverlay"
                          Name="PART_MinimapOverlay" />
  </Panel>

</UserControl>
