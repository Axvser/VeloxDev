<local:SlotView
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.WinForms"
    xmlns:local="clr-namespace:Demo.Views.Workflow"
    x:Class="Demo.Views.Workflow.SlotView"
    Background="#01000000"
    IsHitTestVisible="True"
    ClipToBounds="False"
    behaviors:WorkflowSlotConnectionBehavior.IsEnabled="True">
  <!-- VeloxDev customization: this visual UserControl draws the connector; PART_Glyph keeps a fixed colour. -->
  <Ellipse x:Name="PART_Glyph"
           Fill="#DD1E1E1E"
           Stroke="#FFFFFFFF"
           StrokeThickness="1.5" />

</local:SlotView>
