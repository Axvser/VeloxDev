<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.WinForms"
    xmlns:native="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
    x:Class="Demo.Views.Workflow.NodeView"
    Foreground="#DD1E1E1E"
    behaviors:WorkflowNodeViewBehavior.IsEnabled="True"
    behaviors:WorkflowNodeViewBehavior.CardName="PART_Card"
    behaviors:WorkflowNodeTitleBehavior.IsEnabled="True"
    behaviors:WorkflowNodeTitleBehavior.LabelName="PART_Title"
    behaviors:WorkflowNodeTitleBehavior.HeaderName="PART_Header"
    behaviors:WorkflowNodeRowsBehavior.IsEnabled="True"
    behaviors:WorkflowNodeRowsBehavior.RowsHostName="PART_OutputSlots"
    behaviors:WorkflowNodeRowsBehavior.SlotViewType="SlotView">

  <!-- VeloxDev customization: the card shell. The border paints the chrome; the header and PART_OutputSlots keep
       the title and the generated port rows. Swap the colors or the corner radius here. -->
  <Border x:Name="PART_Card"
            Dock="Fill"
            Padding="1"
            Background="#DDFFFFFF"
            BorderBrush="#331E1E1E"
            BorderThickness="1"
            CornerRadius="6">
    <Panel Dock="Fill">
      <Panel x:Name="PART_OutputSlots"
               Dock="Fill" />
      <Panel x:Name="PART_Header"
               Dock="Top"
               Height="36">
        <native:Label x:Name="PART_Title"
                      Dock="Fill"
                      AutoEllipsis="True"
                      TextAlign="MiddleLeft"
                      Padding="12,0,12,0" />
      </Panel>
    </Panel>
  </Border>

</UserControl>
