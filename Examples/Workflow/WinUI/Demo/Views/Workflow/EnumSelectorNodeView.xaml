<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Demo.Views.EnumSelectorNodeView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Demo.Views"
    xmlns:vm="using:Demo.ViewModels"
    xmlns:behaviors="using:VeloxDev.WorkflowSystem.AttachedBehaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Clip="{x:Null}"
    behaviors:WorkflowSlotLayoutBehavior.IsEnabled="True"
    behaviors:WorkflowSlotLayoutBehavior.SlotNames="PART_InputSlot"
    behaviors:WorkflowSlotLayoutBehavior.SlotEnumeratorNames="PART_OutputSlotsList"
    behaviors:WorkflowSlotLayoutBehavior.CoordinateHostName="PART_Canvas">

    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <!-- Design-canvas: DataTemplate binds Width/Height to the collapsed Node.Size; the Viewbox
         uniformly scales this fixed 280x380 design grid (Enum selector's [DefaultSize]) into that host.
         色值与字级来自 Views/Workflow/CardTheme.xaml。 -->
    <Viewbox Stretch="Uniform">
        <Grid Width="280" Height="380" Clip="{x:Null}" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2" Style="{StaticResource CardBorderStyle}" />

            <!-- 标题行：左对齐 + 类型色条，路由结果做成一个中性胶囊靠右 -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    behaviors:WorkflowNodeDragBehavior.CoordinateHostName="PART_Canvas"
                    behaviors:WorkflowNodeDragBehavior.IsEnabled="True">
                <Grid ColumnDefinitions="2,*,Auto,Auto">
                    <Border Grid.Column="0" Style="{StaticResource CardAccentStyle}" Background="#D6A0FF" />
                    <TextBlock Grid.Column="1" Style="{StaticResource CardTitleTextStyle}"
                               Text="{Binding Title}" Margin="12,0,6,0" />
                    <TextBlock Grid.Column="2" Style="{StaticResource CardValueTextStyle}"
                               Text="{Binding ExecutionOrderText}"
                               Foreground="{StaticResource CardActionRunBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <Border Grid.Column="3"
                            Background="{StaticResource CardHoverBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9" Padding="7,1" Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding LastRouted}" Foreground="#D6A0FF" FontSize="10.5" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Row="0" Style="{StaticResource CardDividerStyle}" />

            <!-- 主体滚动。端口不在这里面：这一层要挡住溢出的内容，而端口必须外溢 12 单位骑在卡边上 -->
            <Border Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14,10" Spacing="6">
                        <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="SELECTED METHOD" />
                        <ComboBox FontSize="11.5"
                                  Padding="7,3"
                                  MinHeight="26"
                                  CornerRadius="6"
                                  HorizontalAlignment="Stretch"
                                  Background="{StaticResource CardFieldBrush}"
                                  BorderBrush="{StaticResource CardBorderBrush}"
                                  BorderThickness="1"
                                  Foreground="{StaticResource CardValueBrush}"
                                  ItemsSource="{Binding EnumValues}"
                                  SelectedItem="{Binding SelectedValue, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="COMPILE MODE" Margin="0,4,0,0" />
                        <ComboBox FontSize="11.5"
                                  Padding="7,3"
                                  MinHeight="26"
                                  CornerRadius="6"
                                  HorizontalAlignment="Stretch"
                                  Background="{StaticResource CardFieldBrush}"
                                  BorderBrush="{StaticResource CardBorderBrush}"
                                  BorderThickness="1"
                                  Foreground="{StaticResource CardValueBrush}"
                                  ItemsSource="{Binding CompileModeOptions}"
                                  SelectedItem="{Binding CompileMode, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="OUTPUT SLOTS" Margin="0,6,0,0" />
                        <ItemsControl ItemsSource="{Binding OutputSlots.Items}"
                                      x:Name="PART_OutputSlotsList"
                                      Clip="{x:Null}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2" Clip="{x:Null}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   Style="{StaticResource CardValueTextStyle}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#D6A0FF"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,0,12,0" />
                                        <local:SlotView Grid.Column="1" Width="24" Height="24"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,-12,0"
                                                        DataContext="{Binding Slot}"
                                                        SlotState="{Binding State}"
                                                        Channel="{Binding Channel}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 端口挂在根 Grid 上，而不是上面那个 Border 里：Border 会裁内容（内容滚动时不该溢出），
                 而端口要外溢 12 单位骑在卡边外，放进去就被切掉一半。它排在卡面之后，不必再问 ZIndex。
                 Visibility 走 ElementName 回到根，理由同 TimerNodeView（DataContext 已被换成 InputSlot）。 -->
            <Grid Grid.Row="1" Clip="{x:Null}">
                <local:SlotView x:Name="PART_InputSlot"
                                Width="32" Height="32"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="-16,0,0,0"
                                DataContext="{Binding InputSlot}"
                                Visibility="{Binding DataContext.HasInputSlot, ElementName=Root, Converter={StaticResource BoolToVisibility}}"
                                SlotState="{Binding State}"
                                Channel="{Binding Channel}" />
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
