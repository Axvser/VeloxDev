<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Demo.Views.InfoOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 实时画布信息 HUD：文本层不吃命中测试，拖拽落到画布，只有“复制”按钮可交互；宿主像绑小地图一样
         绑偏移与视口，缩放与实际尺寸由控件订阅 Core 模型，ViewChanged 时刷新 -->
    <Grid>
        <Border IsHitTestVisible="False"
                CornerRadius="6"
                Background="#E612151B"
                BorderBrush="#CC8EA3B8"
                BorderThickness="1"
                Padding="12,8,58,8">
            <TextBlock x:Name="InfoText"
                       Foreground="#DDE4EA"
                       FontSize="12"
                       LineHeight="18"
                       IsHitTestVisible="False" />
        </Border>
        <Button x:Name="CopyButton"
                Content="复制"
                FontSize="11"
                Padding="8,2"
                Margin="0,0,8,8"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="#1E3A5F"
                Foreground="#7EC8FF"
                BorderBrush="#7EC8FF"
                BorderThickness="1"
                Click="OnCopyClicked" />
    </Grid>
</UserControl>
