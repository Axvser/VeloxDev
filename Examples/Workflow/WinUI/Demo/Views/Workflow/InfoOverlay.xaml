<UserControl x:Class="Demo.Views.InfoOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 实时画布信息 HUD：文本层不吃命中测试，拖拽落到画布，只有“复制”按钮可交互；宿主像绑小地图一样
         绑偏移与视口，缩放与实际尺寸由控件订阅 Core 模型，ViewChanged 时刷新 -->
    <Grid>
        <Border IsHitTestVisible="False"
                CornerRadius="7"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="1"
                Padding="12,8,58,8">
            <TextBlock x:Name="InfoText"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       LineHeight="18"
                       IsHitTestVisible="False" />
        </Border>
        <Button x:Name="CopyButton"
                Content="复制"
                FontSize="11"
                Padding="8,2"
                Margin="0,0,8,8"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{StaticResource SurfaceElevatedBrush}"
                Foreground="{StaticResource AccentTextBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="1"
                Click="OnCopyClicked" />
    </Grid>
</UserControl>
