<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Demo.Views.NodeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:VeloxDev.WorkflowSystem.AttachedBehaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Clip="{x:Null}">

    <!-- The fallback node card: what the canvas draws for a node type that ships no view of its own.

         Bare on purpose. The framework's IWorkflowNodeViewModel carries geometry and slots and no display
         name — a title is a property of the concrete ViewModel — so this card cannot honestly label a node
         it knows nothing else about. Every node type in this demo has a view of its own (ControllerView,
         TimerNodeView, PythonNodeView, EnumSelectorNodeView), so this renders only for a foreign type.

         只共用外壳：面、发丝边与色条都来自 Views/Workflow/CardTheme.xaml，所以外来的节点也落在同一族里，
         而这个文件仍然不必假装知道它是谁。色条取中性石板色，因为这里没有类型可以给它上色。
         WinUI 默认会裁元素内容，故与同级视图一样清掉 Clip。 -->
    <Grid Clip="{x:Null}">
        <Border Style="{StaticResource CardBorderStyle}"
                Padding="0"
                behaviors:WorkflowNodeDragBehavior.IsEnabled="True"
                behaviors:WorkflowNodeDragBehavior.CoordinateHostName="PART_Canvas">
            <Grid ColumnDefinitions="2,*">
                <Border Grid.Column="0" Style="{StaticResource CardAccentStyle}" Background="#94A3B8" />
                <TextBlock Grid.Column="1" Style="{StaticResource CardLabelTextStyle}"
                           Text="?" Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
