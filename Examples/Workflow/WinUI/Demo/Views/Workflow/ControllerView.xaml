<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Demo.Views.ControllerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Demo.Views"
    xmlns:vm="using:Demo.ViewModels"
    xmlns:behaviors="using:VeloxDev.WorkflowSystem.AttachedBehaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Clip="{x:Null}"
    behaviors:WorkflowSlotLayoutBehavior.IsEnabled="True"
    behaviors:WorkflowSlotLayoutBehavior.SlotNames="PART_OutputSlot"
    behaviors:WorkflowSlotLayoutBehavior.CoordinateHostName="PART_Canvas">

    <!-- Design-canvas: DataTemplate binds Width/Height to the collapsed Node.Size; the Viewbox
         uniformly scales this fixed 230x170 design grid (Controller's [DefaultSize]) into that host.

         色值与字级都来自 Views/Workflow/CardTheme.xaml（App.xaml 里合并的），这里只取类名同名的那几条
         Style，不写死色。尺寸必须与 [DefaultSize] 一致，否则 Viewbox 会把设计整体缩放 —— Controller
         从 220x340 改成 230x170 之后，这个文件是照着新尺寸重排的。 -->
    <Viewbox Stretch="Uniform">
        <!-- Clip="{x:Null}"：端口有一半骑在卡边外，整条祖先链上任何一处裁剪都会把它切掉 -->
        <Grid Width="230" Height="170" Clip="{x:Null}" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="66" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="3" Style="{StaticResource CardBorderStyle}" />

            <!-- 标题行：左对齐 + 左侧 2px 类型色条。原来是居中白字压在自己的灰带上 -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    behaviors:WorkflowNodeDragBehavior.CoordinateHostName="PART_Canvas"
                    behaviors:WorkflowNodeDragBehavior.IsEnabled="True">
                <Grid ColumnDefinitions="2,*">
                    <Border Grid.Column="0" Style="{StaticResource CardAccentStyle}" Background="#38BDF8" />
                    <TextBlock Grid.Column="1" Style="{StaticResource CardTitleTextStyle}" Text="Controller" Margin="12,0,0,0" />
                </Grid>
            </Border>
            <Border Grid.Row="0" Style="{StaticResource CardDividerStyle}" />

            <Border Grid.Row="1" Padding="12,9">
                <StackPanel Spacing="5">
                    <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="SEED" />
                    <!-- 字段的形状就地写、色值取自共用字典；成不了 Style 的原因见 CardTheme.xaml -->
                    <TextBox FontSize="11.5"
                             Padding="7,4"
                             MinHeight="26"
                             CornerRadius="6"
                             Background="{StaticResource CardFieldBrush}"
                             BorderBrush="{StaticResource CardBorderBrush}"
                             BorderThickness="1"
                             Foreground="{StaticResource CardValueBrush}"
                             Text="{Binding SeedPayload, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="payload" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" BorderBrush="{StaticResource CardDividerBrush}" BorderThickness="0,1,0,0" />

            <!-- 动作：2×2 的同形「幽灵按钮」，语义只体现在文字颜色上。原来是一排四块高饱和色块 -->
            <Grid Grid.Row="2" ColumnSpacing="6" RowSpacing="6" Margin="12,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource CardGhostButtonStyle}" Content="Compile"
                        Foreground="{StaticResource CardActionCompileBrush}" Command="{Binding CompileCommand}" />
                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource CardGhostButtonStyle}" Content="Run"
                        Foreground="{StaticResource CardActionRunBrush}"
                        IsEnabled="{Binding HasCompiledGraphs}"
                        Command="{Binding RunCommand}" />
                <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource CardGhostButtonStyle}" Content="Stop"
                        Foreground="{StaticResource CardActionStopBrush}" Command="{Binding StopCommand}" />
                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource CardGhostButtonStyle}" Content="Close"
                        Foreground="{StaticResource CardActionCloseBrush}" Command="{Binding CloseWorkflowCommand}" />
            </Grid>

            <!-- 端口最后加：它有一半压在卡面上，排在卡面之后就不必再问 ZIndex 在这台机子上认不认 -->
            <local:SlotView x:Name="PART_OutputSlot"
                            Width="32"
                            Height="32"
                            Grid.RowSpan="3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,-16,0"
                            DataContext="{Binding OutputSlot}"
                            SlotState="{Binding State}"
                            Channel="{Binding Channel}" />
        </Grid>
    </Viewbox>
</UserControl>
