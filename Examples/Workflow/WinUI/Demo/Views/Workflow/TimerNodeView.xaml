<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Demo.Views.TimerNodeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Demo.Views"
    xmlns:behaviors="using:VeloxDev.WorkflowSystem.AttachedBehaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Clip="{x:Null}"
    behaviors:WorkflowSlotLayoutBehavior.IsEnabled="True"
    behaviors:WorkflowSlotLayoutBehavior.SlotNames="PART_InputSlot,PART_OutputSlot"
    behaviors:WorkflowSlotLayoutBehavior.CoordinateHostName="PART_Canvas"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Clip="{x:Null}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2"
                CornerRadius="6"
                BorderThickness="1.5"
                BorderBrush="#6ec6ff"
                Background="#1e2a35"/>

        <Grid Grid.RowSpan="2" Canvas.ZIndex="6" Clip="{x:Null}">
            <local:SlotView x:Name="PART_InputSlot"
                            Width="20" Height="20"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="-10,0,0,0"
                            DataContext="{Binding InputSlot}"
                            Visibility="{Binding HasInputSlot, Converter={StaticResource BoolToVisibility}}"
                            SlotState="{Binding State}"/>
            <local:SlotView x:Name="PART_OutputSlot"
                            Width="20" Height="20"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,-10,0"
                            DataContext="{Binding OutputSlot}"
                            Visibility="{Binding HasOutputSlot, Converter={StaticResource BoolToVisibility}}"
                            SlotState="{Binding State}"/>
        </Grid>

        <Border Grid.Row="0"
                Background="#253545"
                CornerRadius="4,4,0,0"
                BorderThickness="0,0,0,0.5"
                BorderBrush="#6ec6ff"
                behaviors:WorkflowNodeDragBehavior.CoordinateHostName="PART_Canvas"
                behaviors:WorkflowNodeDragBehavior.IsEnabled="True">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold"/>
                <Border Background="#1f3d1f" BorderBrush="#7bd97b" BorderThickness="1" CornerRadius="10" Padding="6,1"
                        Visibility="{Binding HasExecutionOrder, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ExecutionOrderText}" Foreground="#c8ffc8" FontWeight="Bold"/>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#1e2a35" CornerRadius="0,0,4,4">
            <StackPanel Margin="14" Spacing="6">
                <TextBlock Text="Interval (ms)" Foreground="#bfbfbf" FontSize="11"/>
                <TextBox Text="{Binding IntervalMilliseconds, UpdateSourceTrigger=PropertyChanged}" FontSize="11"/>
                <TextBlock Text="Last Tick" Foreground="#bfbfbf" FontSize="11"/>
                <TextBlock Text="{Binding LastTick}" Foreground="#6ec6ff" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
