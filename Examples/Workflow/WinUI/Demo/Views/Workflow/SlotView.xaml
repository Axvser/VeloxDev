<?xml version="1.0" encoding="utf-8"?>
<!--
    端口字形：一个细环 + 一个小芯 + 一道会走的波纹。

    字形本身在 SlotView.xaml.cs 里算（比例、周期、方向语义都在那边，与 Avalonia 的
    Views/Workflow/SlotView.cs 一一对应），这里只是四个能改尺寸的圆。

    为什么是四个 Ellipse 而不是一个自绘面：WinUI 没有 OnRender，Avalonia 那版在
    Render(DrawingContext) 里逐帧画，这里只能落到保留模式上。四个同心圆正好一形一元素，
    颜色只有一种（GlyphBrush，由 SlotState 决定），每帧变的只有直径与不透明度 ——
    每帧一次的量级因此是「四个元素的 Width/Height 与 Opacity」，不是一条重画指令。

    这里没有走「一个 Path + EllipseGeometry，只改 Center/Radius」那条更省布局的路：
    形状是 Fill 模式、椭圆自己的框就是它画的全部内容，尺寸怎么写都落在自己的框内，
    任何一层裁剪都碰不到它。换成 Path 就得反过来确认 Path 的排布框能不能装下几何。
    四个圆各自的框都在端口里，只有靠尺寸换观感，代价可忽略。

    Ellipse 用 HorizontalAlignment/VerticalAlignment="Center" 自动居中，所以每帧只写
    Width/Height，不用再算 Canvas.Left/Top。

    全部 IsHitTestVisible="False"：命中面是控件自己的 Background，圆不该把指针挡在
    连接行为之外。
-->
<UserControl
    x:Class="Demo.Views.SlotView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:behaviors="using:VeloxDev.WorkflowSystem.AttachedBehaviors"
    mc:Ignorable="d"
    Clip="{x:Null}"
    Background="#01000000"
    behaviors:WorkflowSlotConnectionBehavior.IsEnabled="True">

    <Grid x:Name="Root" Background="Transparent" Clip="{x:Null}">
        <!-- 波纹在环下面，外散/内聚各一条；方向不声明时收起来 -->
        <Ellipse x:Name="RippleOut"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False" Visibility="Collapsed" />
        <Ellipse x:Name="RippleIn"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False" Visibility="Collapsed" />
        <Ellipse x:Name="Ring"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False" />
        <Ellipse x:Name="Core"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False" />
    </Grid>
</UserControl>
