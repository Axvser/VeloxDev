<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Demo.App"
             xmlns:local="using:Demo"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Demo/Theme/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <!-- Workbench control styles first; the node-card family layers on top of them. -->
        <StyleInclude Source="avares://Demo/Theme/Styles.axaml" />
        <StyleInclude Source="avares://Demo/Views/Workflow/CardTheme.axaml" />
    </Application.Styles>
</Application>
