<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================ -->
  <!--  Workbench tokens                                             -->
  <!--  One source of truth for the demo shell. New colours go here. -->
  <!-- ============================================================ -->

  <!-- Surfaces: darkest = canvas/editor, panels sit one step up. -->
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#141414" />
  <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1F1F1F" />
  <SolidColorBrush x:Key="PanelRaisedBrush" Color="#252526" />
  <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#141414" />
  <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#202020" />
  <SolidColorBrush x:Key="ActivityBarBackgroundBrush" Color="#181818" />
  <SolidColorBrush x:Key="CanvasHudBrush" Color="#E6222222" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#252526" />
  <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#2D2D2D" />
  <SolidColorBrush x:Key="InputBackgroundBrush" Color="#2A2A2A" />
  <SolidColorBrush x:Key="InputBackgroundHoverBrush" Color="#303030" />
  <SolidColorBrush x:Key="HoverBrush" Color="#2A2D2E" />
  <SolidColorBrush x:Key="RowHoverBrush" Color="#0DFFFFFF" />
  <SolidColorBrush x:Key="RowSelectionBrush" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="HoverStrongBrush" Color="#333333" />
  <SolidColorBrush x:Key="PressedBrush" Color="#3A3A3A" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#094771" />
  <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#99000000" />

  <!-- Dividers -->
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="#262626" />
  <SolidColorBrush x:Key="BorderBrush" Color="#333333" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="#404040" />
  <SolidColorBrush x:Key="DividerBrush" Color="#2B2B2B" />
  <SolidColorBrush x:Key="TreeGuideBrush" Color="#3A3A3A" />

  <!-- Text -->
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E7E7E7" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A0A0A0" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6E7681" />
  <SolidColorBrush x:Key="TextDisabledBrush" Color="#585858" />
  <SolidColorBrush x:Key="TextInverseBrush" Color="#FFFFFF" />

  <!-- Accent and state -->
  <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#1184DE" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#005A9E" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#0E3A5C" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="#4FC1FF" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#3FB950" />
  <SolidColorBrush x:Key="SuccessMutedBrush" Color="#1D3A27" />
  <SolidColorBrush x:Key="WarningBrush" Color="#D29922" />
  <SolidColorBrush x:Key="WarningMutedBrush" Color="#3A2E12" />
  <SolidColorBrush x:Key="DangerBrush" Color="#F85149" />
  <SolidColorBrush x:Key="DangerMutedBrush" Color="#3A1D1D" />
  <SolidColorBrush x:Key="InfoBrush" Color="#4FC1FF" />
  <SolidColorBrush x:Key="FocusBorderBrush" Color="#0078D4" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#40FFFFFF" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#70FFFFFF" />

  <!-- Status bar -->
  <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#181818" />
  <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#2B2B2B" />
  <SolidColorBrush x:Key="StatusBarTextBrush" Color="#B8B8B8" />
  <SolidColorBrush x:Key="StatusBarHoverBrush" Color="#2A2A2A" />

  <!-- Canvas and nodes -->
  <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#171717" />
  <SolidColorBrush x:Key="CanvasBorderBrush" Color="#2B2B2B" />
  <SolidColorBrush x:Key="NodeBackgroundBrush" Color="#F2252526" />
  <SolidColorBrush x:Key="NodeBorderBrush" Color="#3C3C3C" />
  <SolidColorBrush x:Key="NodeFooterBrush" Color="#1B1B1C" />
  <SolidColorBrush x:Key="NodeHoverBorderBrush" Color="#565656" />

  <!-- Node type accents. One colour per kind, like a language-coloured tab. -->
  <SolidColorBrush x:Key="NodeControllerAccentBrush" Color="#6E8BFF" />
  <SolidColorBrush x:Key="NodeTimerAccentBrush" Color="#4FC1FF" />
  <SolidColorBrush x:Key="NodeScriptAccentBrush" Color="#00A7A7" />
  <SolidColorBrush x:Key="NodeEnumAccentBrush" Color="#C99BFF" />
  <SolidColorBrush x:Key="NodeFallbackAccentBrush" Color="#94A3B8" />
  <SolidColorBrush x:Key="NodeSuccessBrush" Color="#7EE787" />

  <!-- Typography -->
  <FontFamily x:Key="UiFontFamily">Inter, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei, Noto Sans CJK SC, sans-serif</FontFamily>
  <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons</FontFamily>
  <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, JetBrains Mono, DejaVu Sans Mono, Noto Sans Mono CJK SC, monospace</FontFamily>
  <x:Double x:Key="UiFontSize">12</x:Double>
  <x:Double x:Key="SmallFontSize">11</x:Double>
  <x:Double x:Key="MicroFontSize">10</x:Double>

  <!-- Geometry -->
  <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="PanelCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
  <Thickness x:Key="ControlPadding">8,3</Thickness>
  <Thickness x:Key="PanelPadding">12</Thickness>

  <DropShadowEffect x:Key="FlyoutShadow" BlurRadius="16" OffsetX="0" OffsetY="4" Opacity="0.45" Color="#000000" />
</ResourceDictionary>
