<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="140"
			 x:Class="Demo.TimerNodeView"
			 xmlns:local="using:Demo"
			 xmlns:behaviors="using:VeloxDev.WorkflowSystem.AttachedBehaviors"
			 xmlns:vm="using:Demo.ViewModels"
			 ClipToBounds="False"
			 behaviors:WorkflowSlotLayoutBehavior.IsEnabled="True"
			 behaviors:WorkflowSlotLayoutBehavior.SlotNames="PART_InputSlot,PART_OutputSlot"
			 behaviors:WorkflowSlotLayoutBehavior.CoordinateHostName="PART_Canvas"
			 x:DataType="vm:TimerNodeViewModel">
	<Viewbox Stretch="Uniform" ClipToBounds="False">
		<Grid RowDefinitions="32,*" Width="200" Height="140" ClipToBounds="False" Background="Transparent">
			<Grid.Styles>
				<Style Selector="local|SlotView">
					<Setter Property="Foreground" Value="White" />
				</Style>
				<Style Selector="local|SlotView[SlotState=8]">
					<Setter Property="Foreground" Value="Tomato" />
				</Style>
				<Style Selector="local|SlotView[SlotState=16]">
					<Setter Property="Foreground" Value="Lime" />
				</Style>
				<Style Selector="local|SlotView[SlotState=24]">
					<Setter Property="Foreground" Value="Violet" />
				</Style>
			</Grid.Styles>

			<Border Grid.RowSpan="2" Classes="card" />

			<!-- 标题行：左对齐 + 左侧 2px 类型色条；执行序号靠右。原来是居中白字压在一条蓝带上 -->
			<Border Grid.Row="0"
					Background="Transparent"
					behaviors:WorkflowNodeDragBehavior.CoordinateHostName="PART_Canvas"
					behaviors:WorkflowNodeDragBehavior.IsEnabled="True">
				<Grid ColumnDefinitions="2,*,Auto">
					<Border Grid.Column="0" Classes="card-accent" Background="#6EC6FF" />
					<TextBlock Grid.Column="1" Classes="card-title" Text="{Binding Title}" Margin="12,0,6,0" />
					<TextBlock Grid.Column="2"
							   Classes="card-value"
							   Text="{Binding ExecutionOrderText}"
							   Foreground="#6EE7A8"
							   VerticalAlignment="Center"
							   Margin="0,0,12,0"
							   IsVisible="{Binding HasExecutionOrder}" />
				</Grid>
			</Border>
			<Border Grid.Row="0" Classes="card-divider" />

			<Border Grid.Row="1" Padding="12,9">
				<StackPanel Spacing="5">
					<TextBlock Classes="card-label" Text="INTERVAL (MS)" />
					<TextBox Classes="card-field"
							 Text="{Binding IntervalMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Classes="card-label" Text="LAST TICK" Margin="0,4,0,0" />
					<TextBlock Classes="card-value"
							   Text="{Binding LastTick}"
							   Foreground="#6EC6FF"
							   FontWeight="SemiBold"
							   TextWrapping="Wrap" />
				</StackPanel>
			</Border>

			<!-- ZIndex：端口有一半压在卡面上，不给序就会被卡面盖掉 -->
			<Grid Grid.RowSpan="2" ZIndex="6" ClipToBounds="False">
				<local:SlotView x:Name="PART_InputSlot"
								Width="32" Height="32"
								HorizontalAlignment="Left"
								VerticalAlignment="Center"
								Margin="-16,0,0,0"
								DataContext="{Binding InputSlot}"
								IsVisible="{Binding $parent[local:TimerNodeView].DataContext.HasInputSlot}"
								SlotState="{Binding State}"
								Channel="{Binding Channel}" />
				<local:SlotView x:Name="PART_OutputSlot"
								Width="32" Height="32"
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								Margin="0,0,-16,0"
								DataContext="{Binding OutputSlot}"
								IsVisible="{Binding $parent[local:TimerNodeView].DataContext.HasOutputSlot}"
								SlotState="{Binding State}"
								Channel="{Binding Channel}" />
			</Grid>
		</Grid>
	</Viewbox>
</UserControl>
