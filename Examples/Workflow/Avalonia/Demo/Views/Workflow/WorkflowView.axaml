<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="Demo.WorkflowView"
			 xmlns:local="using:Demo"
			 xmlns:behaviors="using:VeloxDev.WorkflowSystem.AttachedBehaviors"
			 xmlns:vm="using:Demo.ViewModels"
			 xmlns:workflow="using:VeloxDev.WorkflowSystem"
			 xmlns:mcp="using:VeloxDev.AI.MCP"
			 xmlns:md="clr-namespace:AvalonMarkdown.Views;assembly=AvalonMarkdown"
			 x:DataType="vm:TreeViewModel"
             behaviors:WorkflowSurfaceBehavior.IsEnabled="True" behaviors:WorkflowSurfaceBehavior.ZoomEnabled="True"
			 behaviors:WorkflowSurfaceBehavior.ScrollViewerName="PART_ScrollViewer"
			 behaviors:WorkflowSurfaceBehavior.CanvasName="PART_Canvas"
			 behaviors:WorkflowSurfaceBehavior.GridDecoratorName="PART_GridDecorator"
			 behaviors:WorkflowSurfaceBehavior.PointerPressSourceName="PART_SurfaceBorder"
			 behaviors:WorkflowSurfaceBehavior.MinimapOverlayName="PART_MinimapOverlay">

	<!-- Templates -->
	<UserControl.DataTemplates>
		<!-- Node template -->
		<DataTemplate DataType="vm:TimerNodeViewModel">
			<local:TimerNodeView Width="{Binding Size.Width}"
								 Height="{Binding Size.Height}"
								 Canvas.Left="{Binding Anchor.Horizontal}"
								 Canvas.Top="{Binding Anchor.Vertical}"
								 ZIndex="{Binding Anchor.Layer}"
								 RenderTransform="{Binding $parent[local:WorkflowView].(behaviors:WorkflowCanvasTransformBehavior.Transform)}"/>
		</DataTemplate>
		<DataTemplate DataType="vm:PythonScriptNodeViewModel">
			<local:PythonNodeView Width="{Binding Size.Width}"
								  Height="{Binding Size.Height}"
								  Canvas.Left="{Binding Anchor.Horizontal}"
								  Canvas.Top="{Binding Anchor.Vertical}"
								  ZIndex="{Binding Anchor.Layer}"
								  RenderTransform="{Binding $parent[local:WorkflowView].(behaviors:WorkflowCanvasTransformBehavior.Transform)}"/>
		</DataTemplate>
		<DataTemplate DataType="vm:ControllerViewModel">
			<local:ControllerView Width="{Binding Size.Width}"
								  Height="{Binding Size.Height}"
								  Canvas.Left="{Binding Anchor.Horizontal}"
								  Canvas.Top="{Binding Anchor.Vertical}"
								  ZIndex="{Binding Anchor.Layer}"
								  RenderTransform="{Binding $parent[local:WorkflowView].(behaviors:WorkflowCanvasTransformBehavior.Transform)}"/>
		</DataTemplate>
		<DataTemplate DataType="vm:EnumSelectorNodeViewModel">
			<local:EnumSelectorNodeView Width="{Binding Size.Width}"
										Height="{Binding Size.Height}"
										Canvas.Left="{Binding Anchor.Horizontal}"
										Canvas.Top="{Binding Anchor.Vertical}"
										ZIndex="{Binding Anchor.Layer}"
										RenderTransform="{Binding $parent[local:WorkflowView].(behaviors:WorkflowCanvasTransformBehavior.Transform)}"/>
		</DataTemplate>
		<!-- Any remaining workflow node (no dedicated view) falls back to the generic node card. -->
		<DataTemplate DataType="workflow:IWorkflowNodeViewModel">
			<local:NodeView Width="{Binding Size.Width}"
							Height="{Binding Size.Height}"
							Canvas.Left="{Binding Anchor.Horizontal}"
							Canvas.Top="{Binding Anchor.Vertical}"
							ZIndex="{Binding Anchor.Layer}"
							RenderTransform="{Binding $parent[local:WorkflowView].(behaviors:WorkflowCanvasTransformBehavior.Transform)}"/>
		</DataTemplate>
		<!-- Link template -->
		<DataTemplate DataType="vm:LinkViewModel">
			<Panel ZIndex="-1">
				<local:BezierCurveView StartLeft="{Binding Sender.Anchor.Horizontal}"
									   StartTop="{Binding Sender.Anchor.Vertical}"
									   EndLeft="{Binding Receiver.Anchor.Horizontal}"
									   EndTop="{Binding Receiver.Anchor.Vertical}"
									   CanRender="{Binding IsVisible}"
									   IsVisible="{Binding !UsePolyline}"
									   Width="{Binding $parent[Canvas].Bounds.Width}"
									   Height="{Binding $parent[Canvas].Bounds.Height}"
									   RenderTransform="{Binding $parent[local:WorkflowView].(behaviors:WorkflowCanvasTransformBehavior.Transform)}"/>
				<local:PolylineCurveView StartLeft="{Binding Sender.Anchor.Horizontal}"
										 StartTop="{Binding Sender.Anchor.Vertical}"
										 EndLeft="{Binding Receiver.Anchor.Horizontal}"
										 EndTop="{Binding Receiver.Anchor.Vertical}"
										 CanRender="{Binding IsVisible}"
										 IsVisible="{Binding UsePolyline}"
										 Width="{Binding $parent[Canvas].Bounds.Width}"
										 Height="{Binding $parent[Canvas].Bounds.Height}"
										 RenderTransform="{Binding $parent[local:WorkflowView].(behaviors:WorkflowCanvasTransformBehavior.Transform)}"/>
			</Panel>
		</DataTemplate>
		<DataTemplate DataType="workflow:IWorkflowLinkViewModel">
			<local:BezierCurveView StartLeft="{Binding Sender.Anchor.Horizontal}"
								   StartTop="{Binding Sender.Anchor.Vertical}"
								   EndLeft="{Binding Receiver.Anchor.Horizontal}"
								   EndTop="{Binding Receiver.Anchor.Vertical}"
								   CanRender="{Binding IsVisible}"
								   Width="{Binding $parent[Canvas].Bounds.Width}"
								   Height="{Binding $parent[Canvas].Bounds.Height}"
								   RenderTransform="{Binding $parent[local:WorkflowView].(behaviors:WorkflowCanvasTransformBehavior.Transform)}"
								   ZIndex="-1"/>
		</DataTemplate>
	</UserControl.DataTemplates>

	<Grid ColumnDefinitions="2*,auto,8*">
		<!-- Node editor rendering (virtualization support + minimap thumbnail) -->
		<Grid Grid.Column="2" x:Name="WorkflowContainer">
			<Border x:Name="PART_SurfaceBorder" BorderBrush="White" BorderThickness="1" CornerRadius="3">
			   <local:WorkflowGridDecorator x:Name="PART_GridDecorator">
				  <ScrollViewer HorizontalScrollBarVisibility="Auto"
								 x:Name="PART_ScrollViewer">
						<Canvas x:DataType="vm:TreeViewModel"
								x:Name="PART_Canvas"
								Width="{Binding Layout.ActualSize.Width}"
								Height="{Binding Layout.ActualSize.Height}"
								HorizontalAlignment="Left"
								VerticalAlignment="Top"
							 behaviors:ViewPool.ItemsSource="{Binding Helper.VisibleItems}">
							<Canvas.RenderTransform>
								<TranslateTransform X="{Binding RulerThickness, ElementName=PART_GridDecorator}"
													Y="{Binding RulerThickness, ElementName=PART_GridDecorator}" />
							</Canvas.RenderTransform>
							<Canvas.DataTemplates>
								<!-- Resolve the data template by priority: Self > Parent > App -->
							</Canvas.DataTemplates>
						</Canvas>
					</ScrollViewer>
				</local:WorkflowGridDecorator>
			</Border>
			<!-- Minimap. The surface pushes scroll / content / viewport into it because
			     MinimapOverlayName="PART_MinimapOverlay" names this element; wiring those same five values
			     by hand here is what the attached property replaces. -->
			<local:MinimapOverlay x:Name="PART_MinimapOverlay"
								  HorizontalAlignment="Right"
								  VerticalAlignment="Top"
								  Margin="0,36,8,0"
								  ScrollViewerName="PART_ScrollViewer"/>
			<!-- Realtime canvas-info HUD. Refreshes from the model and the surface's scroll changes
			     (WorkflowView.axaml.cs); its text layer is hit-test transparent so drags reach the canvas. -->
			<local:InfoOverlay x:Name="InfoOverlay"
							   HorizontalAlignment="Left"
							   VerticalAlignment="Bottom"
							   Margin="44,0,0,12"/>
		</Grid>

		<!-- 宿主外壳：侧栏是本 demo 自己的界面（模板止于画布）；按带内边距与背景的面板排，而不是贴窗
		     口边缘——2:8 分栏下侧栏只占五分之一，不换行不拉伸的内容会被裁掉而非回流 -->
		<Border Grid.Column="0" Background="#12161C" Padding="12,12,12,12"
				BorderBrush="#1F2937" BorderThickness="0,0,1,0">
			<ScrollViewer HorizontalScrollBarVisibility="Disabled">
				<StackPanel Orientation="Vertical" Spacing="10">

					<!-- 命令按钮：拉伸而非固定像素宽，才跟得上分隔条 -->
					<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="6">
						<Button Grid.Row="0" Grid.Column="0" Content="Undo" Command="{Binding UndoCommand}" HorizontalAlignment="Stretch" />
						<Button Grid.Row="0" Grid.Column="1" Content="Redo" Command="{Binding RedoCommand}" HorizontalAlignment="Stretch" />
						<Button Grid.Row="1" Grid.Column="0" Content="Save" Click="SaveWorkflow" HorizontalAlignment="Stretch" />
						<Button Grid.Row="1" Grid.Column="1" Content="Select" Click="SelectWorkflow" HorizontalAlignment="Stretch" />
						<Button Grid.Row="2" Grid.ColumnSpan="2" Content="Load Workflow Demo" Click="LoadNetworkDemo" HorizontalAlignment="Stretch" />
					</Grid>

					<!-- 模型计数：标签与数值分列，长数值挤不掉标签 -->
					<Border Background="#1A2029" CornerRadius="4" Padding="10">
						<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
							<TextBlock Grid.Row="0" Grid.Column="0" Text="节点总数" Foreground="#94A3B8" />
							<TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Nodes.Count}" Foreground="#E2E8F0" FontWeight="SemiBold" />
							<TextBlock Grid.Row="1" Grid.Column="0" Text="可见组件数 ( Node / Link )" Foreground="#94A3B8" TextWrapping="Wrap" />
							<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Helper.VisibleItems.Count}" Foreground="#E2E8F0" FontWeight="SemiBold" />
						</Grid>
					</Border>

					<!-- 小地图开关 -->
					<Grid Margin="0,2,0,0" ColumnDefinitions="*,Auto">
						<TextBlock Text="小地图" Foreground="#94A3B8" VerticalAlignment="Center" />
						<ToggleSwitch Grid.Column="1"
									  IsChecked="{Binding IsMinimapVisible, ElementName=PART_MinimapOverlay}" />
					</Grid>
						<!-- Agent chat -->
						<Border Margin="0,12,0,0" Padding="10" Background="#202020" BorderBrush="#4c4c4c" BorderThickness="1" CornerRadius="4">
							<StackPanel Spacing="6">
								<Grid ColumnDefinitions="*,Auto">
									<TextBlock Text="Agent 对话" Foreground="#7ec8ff" FontWeight="Bold"/>
									<ToggleSwitch Grid.Column="1"
												  IsChecked="{Binding UseStreamingAgentResponse}"
												  OnContent="流式"
												  OffContent="普通"
												  FontSize="11"
												  Margin="0,-6,0,-6"/>
								</Grid>
								<!-- MarkdownView has its own internal scrolling; put it directly in the panel, not inside a ScrollViewer -->
								<md:MarkdownView Text="{Binding ConversationMarkdown}"
												 Height="360"
												 HorizontalAlignment="Stretch"
												 VerticalAlignment="Stretch"/>
								<Grid ColumnDefinitions="*,Auto">
									<TextBox x:Name="AgentInput"
											 Grid.Column="0"
											 PlaceholderText="输入消息..."
											 Background="#2d2d2d"
											 Foreground="White"
											 AcceptsReturn="False"
											 KeyDown="OnAgentInputKeyDown"/>
									<Button Grid.Column="1"
											Content="发送"
											Margin="4,0,0,0"
											Click="OnSendToAgent"/>
								</Grid>
							</StackPanel>
						</Border>
						<!-- MCP servers -->
						<Border x:Name="McpStatusPanel" x:DataType="mcp:McpStatusViewModel" Margin="0,12,0,0" Padding="10" Background="#202020" BorderBrush="#4c4c4c" BorderThickness="1" CornerRadius="4">
							<StackPanel Spacing="6">
								<Grid ColumnDefinitions="*,Auto">
									<TextBlock Text="MCP 服务器" Foreground="#7ec8ff" FontWeight="Bold" VerticalAlignment="Center"/>
									<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
										<TextBlock Text="{Binding ConnectedCount, StringFormat=存活 {0}}" Foreground="#6bffb8" FontWeight="Bold"/>
										<TextBlock Text="{Binding ErrorCount, StringFormat=· 错误 {0}}" Foreground="#ff6b6b"/>
										<Button Content="重载" FontSize="11" Click="OnReloadMcp"/>
									</StackPanel>
								</Grid>
								<ItemsControl ItemsSource="{Binding Servers}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="mcp:McpServerStatusViewModel">
											<StackPanel Spacing="2">
												<StackPanel Orientation="Horizontal" Spacing="6">
													<TextBlock Text="{Binding Name}" Foreground="#e0e0e0" FontWeight="SemiBold"/>
													<TextBlock Text="{Binding StateText}" Foreground="#a0a0a0"/>
													<TextBlock Text="{Binding ToolCount, StringFormat=· {0} tools}" Foreground="#6bffb8"/>
												</StackPanel>
												<TextBlock Text="{Binding Error}" Foreground="#ff6b6b" FontSize="11" TextWrapping="Wrap"
														   IsVisible="{Binding IsError}" Margin="14,0,0,0"/>
											</StackPanel>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>
						<!-- Execution log -->
						<Border Margin="0,12,0,0" Padding="10" Background="#202020" BorderBrush="#4c4c4c" BorderThickness="1" CornerRadius="4">
							<ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto" x:Name="ExecutionLogScroller">
								<StackPanel Spacing="6">
									<TextBlock Text="实际执行顺序" Foreground="#7ec8ff" FontWeight="Bold"/>
									<TextBlock Text="{Binding ExecutionLog.Count, StringFormat=已记录: {0}}" Foreground="#bdbdbd"/>
									<ListBox ItemsSource="{Binding ExecutionLog}"
											 Background="Transparent" BorderThickness="0"
											 ScrollViewer.VerticalScrollBarVisibility="Disabled">
										<ListBox.ItemsPanel>
											<ItemsPanelTemplate>
												<VirtualizingStackPanel/>
											</ItemsPanelTemplate>
										</ListBox.ItemsPanel>
										<ListBox.ItemTemplate>
											<DataTemplate>
												<TextBlock Text="{Binding .}" Foreground="#d8d8d8" TextWrapping="Wrap"/>
											</DataTemplate>
										</ListBox.ItemTemplate>
									</ListBox>
								</StackPanel>
							</ScrollViewer>
						</Border>
				</StackPanel>
			</ScrollViewer>
		</Border>

		<GridSplitter Grid.Column="1" Width="5" Background="#1F2937"/>
	</Grid>
</UserControl>
