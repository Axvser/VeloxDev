<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="Demo.WorkflowView"
			 xmlns:local="using:Demo"
			 xmlns:behaviors="using:VeloxDev.WorkflowSystem.AttachedBehaviors"
			 xmlns:vm="using:Demo.ViewModels"
			 xmlns:workflow="using:VeloxDev.WorkflowSystem"
			 xmlns:mcp="using:VeloxDev.AI.MCP"
			 xmlns:sub="using:VeloxDev.AI.SubAgents"
			 xmlns:cex="using:VeloxDev.Core.WorkflowSystem.CompilerEx"
			 xmlns:md="clr-namespace:AvalonMarkdown.Views;assembly=AvalonMarkdown"
			 x:DataType="vm:TreeViewModel"
             behaviors:WorkflowSurfaceBehavior.IsEnabled="True" behaviors:WorkflowSurfaceBehavior.ZoomEnabled="True"
			 behaviors:WorkflowSurfaceBehavior.ScrollViewerName="PART_ScrollViewer"
			 behaviors:WorkflowSurfaceBehavior.CanvasName="PART_Canvas"
			 behaviors:WorkflowSurfaceBehavior.GridDecoratorName="PART_GridDecorator"
			 behaviors:WorkflowSurfaceBehavior.PointerPressSourceName="PART_SurfaceBorder"
			 behaviors:WorkflowSurfaceBehavior.MinimapOverlayName="PART_MinimapOverlay"
			 behaviors:WorkflowSurfaceBehavior.LinkMenuKey="WorkflowTreeMenu">

	<!-- 子代理树是只读的：没有任何东西会因为「某一行被选中」而改变，所以选中与悬停都不该画出色块。
	     Fluent 的主题会画，而 SelectionMode 没有 None 这一档（只有 Single/Multiple/Toggle/AlwaysSelected），
	     只能在两处同时盖：Theme 资源键（下面）与 Style（再下面）。两处都写是因为 Fluent 12 把主题编译进了
	     二进制资源、取不到它到底用了哪个键或哪个模板部件 —— 键名不存在时只是多一个没人用的资源，无害；
	     命中一处就够。 -->
	<UserControl.Resources>
		<SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="Transparent" />
		<SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="Transparent" />
		<SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="Transparent" />
		<SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="Transparent" />
		<local:DepthIndentConverter x:Key="DepthIndent" />
		<!-- 连线右键菜单：条目在此增删，弹出前把菜单的 DataContext 设成那条连线，条目据此绑定命令。 -->
		<ContextMenu x:Key="WorkflowTreeMenu">
			<MenuItem Header="Delete" Command="{ReflectionBinding DeleteCommand}" />
		</ContextMenu>
	</UserControl.Resources>

	<!-- 子代理树的展开状态由库里那一行自己持有（SubAgentTreeNodeViewModel.IsExpanded，默认展开），而
	     TreeViewItem 默认是收起的 —— 这块面板的全部意义就是一眼看见孩子，不该让用户逐个点开。
	     用 ReflectionBinding 而非编译绑定：Style 里没有 x:DataType 作用域，编译绑定在此无从下手。 -->
	<UserControl.Styles>
		<Style Selector="TreeViewItem">
			<Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
		</Style>
		<!-- 这块面板是只读的：没有任何东西会因为「某一行被选中」而改变，所以选中与悬停都不该画出色块。
		     Fluent 的主题会画，而 SelectionMode 没有 None 这一档（只有 Single/Multiple/Toggle/AlwaysSelected），
		     只能用样式盖。三项都要盖：单击会同时置上选中与指针悬停，只盖一个仍然会闪出色块来。 -->
		<Style Selector="TreeViewItem">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="TreeViewItem:selected">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="TreeViewItem:pointerover">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="TreeViewItem:selected:pointerover">
			<Setter Property="Background" Value="Transparent" />
		</Style>

		<!-- VS Code-style rail: activity buttons, flat sidebar actions, and section headers. -->
		<!-- Icon font: Segoe MDL2 Assets does not resolve on Avalonia 12 here (the code points render
		     as tofu boxes); Segoe Fluent Icons covers the same code points, so this demo uses it. -->
		<Style Selector="RadioButton.Activity">
			<Setter Property="Width" Value="48" />
			<Setter Property="Height" Value="48" />
			<Setter Property="FontFamily" Value="Segoe Fluent Icons" />
			<Setter Property="FontSize" Value="19" />
			<Setter Property="Foreground" Value="#9D9D9D" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Template">
				<ControlTemplate>
					<Border x:Name="Chrome" Background="Transparent"
							BorderBrush="Transparent" BorderThickness="2,0,0,0">
						<!-- A ContentPresenter inside a control template does not pick up the content or
						     the text properties on its own; without these bindings the icons are invisible. -->
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
										  Content="{TemplateBinding Content}"
										  ContentTemplate="{TemplateBinding ContentTemplate}"
										  FontFamily="{TemplateBinding FontFamily}"
										  FontSize="{TemplateBinding FontSize}"
										  Foreground="{TemplateBinding Foreground}" />
					</Border>
				</ControlTemplate>
			</Setter>
		</Style>
		<Style Selector="RadioButton.Activity:pointerover">
			<Setter Property="Foreground" Value="#E7E7E7" />
		</Style>
		<Style Selector="RadioButton.Activity:pointerover /template/ Border#Chrome">
			<Setter Property="Background" Value="#2A2D2E" />
		</Style>
		<Style Selector="RadioButton.Activity:checked">
			<Setter Property="Foreground" Value="#FFFFFF" />
		</Style>
		<Style Selector="RadioButton.Activity:checked /template/ Border#Chrome">
			<Setter Property="BorderBrush" Value="#007ACC" />
		</Style>

		<Style Selector="Button.SidebarIcon">
			<Setter Property="Width" Value="26" />
			<Setter Property="Height" Value="26" />
			<Setter Property="Margin" Value="0,0,4,0" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="FontFamily" Value="Segoe Fluent Icons" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Foreground" Value="#CCCCCC" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<ControlTemplate>
					<Border x:Name="Chrome" Background="Transparent" CornerRadius="3">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
										  Content="{TemplateBinding Content}"
										  ContentTemplate="{TemplateBinding ContentTemplate}"
										  FontFamily="{TemplateBinding FontFamily}"
										  FontSize="{TemplateBinding FontSize}"
										  Foreground="{TemplateBinding Foreground}" />
					</Border>
				</ControlTemplate>
			</Setter>
		</Style>
		<Style Selector="Button.SidebarIcon:pointerover /template/ Border#Chrome">
			<Setter Property="Background" Value="#3A3D41" />
		</Style>

		<Style Selector="TextBlock.SidebarSection">
			<Setter Property="Foreground" Value="#BBBBBB" />
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Margin" Value="12,14,12,6" />
		</Style>
	</UserControl.Styles>

	<!-- Templates -->
	<UserControl.DataTemplates>
		<!-- Node template -->
		<DataTemplate DataType="vm:TimerNodeViewModel">
			<local:TimerNodeView Width="{Binding Size.Width}"
								 Height="{Binding Size.Height}"
								 Canvas.Left="{Binding Anchor.Horizontal}"
								 Canvas.Top="{Binding Anchor.Vertical}"
								 ZIndex="{Binding Anchor.Layer}"
								 RenderTransform="{Binding $parent[local:WorkflowView].(behaviors:WorkflowCanvasTransformBehavior.Transform)}"/>
		</DataTemplate>
		<DataTemplate DataType="vm:PythonScriptNodeViewModel">
			<local:PythonNodeView Width="{Binding Size.Width}"
								  Height="{Binding Size.Height}"
								  Canvas.Left="{Binding Anchor.Horizontal}"
								  Canvas.Top="{Binding Anchor.Vertical}"
								  ZIndex="{Binding Anchor.Layer}"
								  RenderTransform="{Binding $parent[local:WorkflowView].(behaviors:WorkflowCanvasTransformBehavior.Transform)}"/>
		</DataTemplate>
		<DataTemplate DataType="vm:ControllerViewModel">
			<local:ControllerView Width="{Binding Size.Width}"
								  Height="{Binding Size.Height}"
								  Canvas.Left="{Binding Anchor.Horizontal}"
								  Canvas.Top="{Binding Anchor.Vertical}"
								  ZIndex="{Binding Anchor.Layer}"
								  RenderTransform="{Binding $parent[local:WorkflowView].(behaviors:WorkflowCanvasTransformBehavior.Transform)}"/>
		</DataTemplate>
		<DataTemplate DataType="vm:EnumSelectorNodeViewModel">
			<local:EnumSelectorNodeView Width="{Binding Size.Width}"
										Height="{Binding Size.Height}"
										Canvas.Left="{Binding Anchor.Horizontal}"
										Canvas.Top="{Binding Anchor.Vertical}"
										ZIndex="{Binding Anchor.Layer}"
										RenderTransform="{Binding $parent[local:WorkflowView].(behaviors:WorkflowCanvasTransformBehavior.Transform)}"/>
		</DataTemplate>
		<!-- Any remaining workflow node (no dedicated view) falls back to the generic node card. -->
		<DataTemplate DataType="workflow:IWorkflowNodeViewModel">
			<local:NodeView Width="{Binding Size.Width}"
							Height="{Binding Size.Height}"
							Canvas.Left="{Binding Anchor.Horizontal}"
							Canvas.Top="{Binding Anchor.Vertical}"
							ZIndex="{Binding Anchor.Layer}"
							RenderTransform="{Binding $parent[local:WorkflowView].(behaviors:WorkflowCanvasTransformBehavior.Transform)}"/>
		</DataTemplate>
		<!-- Link template -->
		<DataTemplate DataType="vm:LinkViewModel">
			<Panel ZIndex="-1">
				<local:BezierCurveView StartLeft="{Binding Sender.Anchor.Horizontal}"
									   StartTop="{Binding Sender.Anchor.Vertical}"
									   EndLeft="{Binding Receiver.Anchor.Horizontal}"
									   EndTop="{Binding Receiver.Anchor.Vertical}"
									   CanRender="{Binding IsVisible}"
									   IsVisible="{Binding !UsePolyline}"
									   Width="{Binding $parent[Canvas].Bounds.Width}"
									   Height="{Binding $parent[Canvas].Bounds.Height}"
									   RenderTransform="{Binding $parent[local:WorkflowView].(behaviors:WorkflowCanvasTransformBehavior.Transform)}"/>
				<local:PolylineCurveView StartLeft="{Binding Sender.Anchor.Horizontal}"
										 StartTop="{Binding Sender.Anchor.Vertical}"
										 EndLeft="{Binding Receiver.Anchor.Horizontal}"
										 EndTop="{Binding Receiver.Anchor.Vertical}"
										 CanRender="{Binding IsVisible}"
										 IsVisible="{Binding UsePolyline}"
										 Width="{Binding $parent[Canvas].Bounds.Width}"
										 Height="{Binding $parent[Canvas].Bounds.Height}"
										 RenderTransform="{Binding $parent[local:WorkflowView].(behaviors:WorkflowCanvasTransformBehavior.Transform)}"/>
			</Panel>
		</DataTemplate>
		<DataTemplate DataType="workflow:IWorkflowLinkViewModel">
			<local:BezierCurveView StartLeft="{Binding Sender.Anchor.Horizontal}"
								   StartTop="{Binding Sender.Anchor.Vertical}"
								   EndLeft="{Binding Receiver.Anchor.Horizontal}"
								   EndTop="{Binding Receiver.Anchor.Vertical}"
								   CanRender="{Binding IsVisible}"
								   Width="{Binding $parent[Canvas].Bounds.Width}"
								   Height="{Binding $parent[Canvas].Bounds.Height}"
								   RenderTransform="{Binding $parent[local:WorkflowView].(behaviors:WorkflowCanvasTransformBehavior.Transform)}"
								   ZIndex="-1"/>
		</DataTemplate>
	</UserControl.DataTemplates>

	<!-- 左侧固定 48 活动栏 + 300 侧栏，与 WPF 复杂 demo 一致；剩余宽度给画布。 -->
	<Grid ColumnDefinitions="348,auto,*">
		<!-- Node editor rendering (virtualization support + minimap thumbnail) -->
		<Grid Grid.Column="2" x:Name="WorkflowContainer">
			<Border x:Name="PART_SurfaceBorder" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="3">
			   <local:WorkflowGridDecorator x:Name="PART_GridDecorator">
				  <ScrollViewer HorizontalScrollBarVisibility="Auto"
								 x:Name="PART_ScrollViewer">
						<Canvas x:DataType="vm:TreeViewModel"
								x:Name="PART_Canvas"
								Width="{Binding Layout.ActualSize.Width}"
								Height="{Binding Layout.ActualSize.Height}"
								HorizontalAlignment="Left"
								VerticalAlignment="Top"
							 behaviors:ViewPool.ItemsSource="{Binding Helper.VisibleItems}">
							<Canvas.RenderTransform>
								<TranslateTransform X="{Binding RulerThickness, ElementName=PART_GridDecorator}"
													Y="{Binding RulerThickness, ElementName=PART_GridDecorator}" />
							</Canvas.RenderTransform>
							<Canvas.DataTemplates>
								<!-- Resolve the data template by priority: Self > Parent > App -->
							</Canvas.DataTemplates>
						</Canvas>
					</ScrollViewer>
				</local:WorkflowGridDecorator>
			</Border>
			<!-- Minimap. The surface pushes scroll / content / viewport into it because
			     MinimapOverlayName="PART_MinimapOverlay" names this element; wiring those same five values
			     by hand here is what the attached property replaces. -->
			<local:MinimapOverlay x:Name="PART_MinimapOverlay"
								  HorizontalAlignment="Right"
								  VerticalAlignment="Top"
								  Margin="0,36,8,0"
								  ScrollViewerName="PART_ScrollViewer"/>
			<!-- Realtime canvas-info HUD. Refreshes from the model and the surface's scroll changes
			     (WorkflowView.axaml.cs); its text layer is hit-test transparent so drags reach the canvas. -->
			<local:InfoOverlay x:Name="InfoOverlay"
							   HorizontalAlignment="Left"
							   VerticalAlignment="Bottom"
							   Margin="44,0,0,12"/>
		</Grid>

		<!-- Host shell: a VS Code-style rail. The canvas is all the template owns; this is the demo's own UI. -->
		<Grid Grid.Column="0" ColumnDefinitions="48,*">
			<!-- Activity bar -->
			<Border Grid.Column="0" Background="#333333">
				<StackPanel>
					<RadioButton Classes="Activity" GroupName="SidebarActivity" Tag="explorer" IsChecked="True"
								 Content="&#xE8B7;" ToolTip.Tip="资源管理器" Click="OnActivityClick" />
					<RadioButton Classes="Activity" GroupName="SidebarActivity" Tag="run"
								 Content="&#xE768;" ToolTip.Tip="运行" Click="OnActivityClick" />
					<RadioButton Classes="Activity" GroupName="SidebarActivity" Tag="agent"
								 Content="&#xE8BD;" ToolTip.Tip="Agent 对话" Click="OnActivityClick" />
					<RadioButton Classes="Activity" GroupName="SidebarActivity" Tag="mcp"
								 Content="&#xE774;" ToolTip.Tip="MCP 服务器" Click="OnActivityClick" />
					<RadioButton Classes="Activity" GroupName="SidebarActivity" Tag="output"
								 Content="&#xE756;" ToolTip.Tip="执行输出" Click="OnActivityClick" />
				</StackPanel>
			</Border>

			<!-- Sidebar: one page visible at a time -->
			<Border Grid.Column="1" Background="#252526">
				<Grid RowDefinitions="Auto,*">
					<TextBlock x:Name="SidebarHeader" Grid.Row="0" Text="资源管理器"
							   Margin="12,12,12,4" Foreground="#CCCCCC" FontSize="11" FontWeight="SemiBold" />

					<Grid Grid.Row="1">
						<!-- Explorer -->
						<ScrollViewer x:Name="ExplorerPanel" VerticalScrollBarVisibility="Auto">
							<StackPanel>
								<StackPanel Orientation="Horizontal" Margin="10,2,10,0">
									<Button Classes="SidebarIcon" Content="&#xE74E;" ToolTip.Tip="保存工作流" Click="SaveWorkflow" />
									<Button Classes="SidebarIcon" Content="&#xE8E5;" ToolTip.Tip="加载工作流" Click="SelectWorkflow" />
									<Button Classes="SidebarIcon" Content="&#xE7A7;" ToolTip.Tip="撤销" Command="{Binding UndoCommand}" />
									<Button Classes="SidebarIcon" Content="&#xE7A6;" ToolTip.Tip="重做" Command="{Binding RedoCommand}" />
									<Button Classes="SidebarIcon" Content="&#xE72C;" ToolTip.Tip="重新载入示例" Click="LoadNetworkDemo" />
								</StackPanel>

								<!-- Minimap toggle -->
								<Grid Margin="12,8,12,0" ColumnDefinitions="*,Auto">
									<TextBlock Text="小地图" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" />
									<ToggleSwitch Grid.Column="1"
												  IsChecked="{Binding IsMinimapVisible, ElementName=PART_MinimapOverlay}" />
								</Grid>

								<TextBlock Text="元素" Classes="SidebarSection" />
								<Border Margin="12,0,12,0" Padding="4" Background="#1E1E1E"
										BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="4">
									<TabControl Height="220">
										<TabItem Header="节点">
											<ListBox x:Name="ElementNodeList" Background="Transparent">
												<ListBox.ItemTemplate>
													<DataTemplate x:DataType="vm:WorkflowElementEntry">
														<Grid ColumnDefinitions="*,Auto,Auto" Margin="0,1">
															<TextBlock Text="{Binding Label}" Foreground="#E2E8F0"
																	   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
															<Button Grid.Column="1" Content="Locate" Margin="4,0,0,0"
																	Padding="6,1" FontSize="11" Click="OnLocateElement"
																	ToolTip.Tip="滚到视口中心；插槽定位所属节点，连线定位两端节点中心"/>
															<Button Grid.Column="2" Content="Delete" Margin="4,0,0,0"
																	Padding="6,1" FontSize="11" Click="OnDeleteElement"/>
														</Grid>
													</DataTemplate>
												</ListBox.ItemTemplate>
											</ListBox>
										</TabItem>
										<TabItem Header="插槽">
											<ListBox x:Name="ElementSlotList" Background="Transparent">
												<ListBox.ItemTemplate>
													<DataTemplate x:DataType="vm:WorkflowElementEntry">
														<Grid ColumnDefinitions="*,Auto,Auto" Margin="0,1">
															<TextBlock Text="{Binding Label}" Foreground="#E2E8F0"
																	   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
															<Button Grid.Column="1" Content="Locate" Margin="4,0,0,0"
																	Padding="6,1" FontSize="11" Click="OnLocateElement"/>
															<Button Grid.Column="2" Content="Delete" Margin="4,0,0,0"
																	Padding="6,1" FontSize="11" Click="OnDeleteElement"/>
														</Grid>
													</DataTemplate>
												</ListBox.ItemTemplate>
											</ListBox>
										</TabItem>
										<TabItem Header="连线">
											<ListBox x:Name="ElementLinkList" Background="Transparent">
												<ListBox.ItemTemplate>
													<DataTemplate x:DataType="vm:WorkflowElementEntry">
														<Grid ColumnDefinitions="*,Auto,Auto" Margin="0,1">
															<TextBlock Text="{Binding Label}" Foreground="#E2E8F0"
																	   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
															<Button Grid.Column="1" Content="Locate" Margin="4,0,0,0"
																	Padding="6,1" FontSize="11" Click="OnLocateElement"/>
															<Button Grid.Column="2" Content="Delete" Margin="4,0,0,0"
																	Padding="6,1" FontSize="11" Click="OnDeleteElement"/>
														</Grid>
													</DataTemplate>
												</ListBox.ItemTemplate>
											</ListBox>
										</TabItem>
									</TabControl>
								</Border>
								<TextBlock x:Name="ElementStatus" Margin="12,8,12,12" Foreground="#94A3B8"
										   FontSize="11" TextWrapping="Wrap" />
							</StackPanel>
						</ScrollViewer>

						<!-- Run -->
						<ScrollViewer x:Name="RunPanel" IsVisible="False" VerticalScrollBarVisibility="Auto">
							<StackPanel>
								<TextBlock Text="运行" Classes="SidebarSection" />
								<Border Margin="12,0,12,0" Padding="10" Background="#1E1E1E"
										BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="4">
									<StackPanel Spacing="6">
										<Grid ColumnDefinitions="*,Auto">
											<TextBlock Grid.Column="0" Text="运行控制" Foreground="#E2E8F0" FontWeight="SemiBold" VerticalAlignment="Center" />
											<TextBlock Grid.Column="1" x:Name="RunGateState" Text="空闲" Foreground="#A0A0A0" VerticalAlignment="Center" />
										</Grid>
										<Grid ColumnDefinitions="*,*" ColumnSpacing="6">
											<Button Grid.Column="0" Content="Pause" Margin="0,0,3,0" HorizontalAlignment="Stretch" Click="PauseWorkflow" />
											<Button Grid.Column="1" Content="Resume" Margin="3,0,0,0" HorizontalAlignment="Stretch" Click="ResumeWorkflow" />
										</Grid>
										<Button x:Name="ContinueFromCheckpointButton" Content="从检查点继续" Margin="0,6,0,0"
												HorizontalAlignment="Stretch" Click="ContinueFromCheckpoint" IsEnabled="False" />
									</StackPanel>
								</Border>

								<TextBlock Text="画布" Classes="SidebarSection" />
								<StackPanel Margin="12,0,12,0" Spacing="2">
									<TextBlock Text="总元素数：" Foreground="#CCCCCC" />
									<TextBlock Text="{Binding TotalElementText}" Foreground="#E7E7E7" TextWrapping="Wrap" />
									<TextBlock Margin="0,8,0,0" Text="可见元素数：" Foreground="#CCCCCC" />
									<TextBlock Text="{Binding VisibleElementText}" Foreground="#E7E7E7" TextWrapping="Wrap" />
								</StackPanel>

								<!-- Compiled outline: one span per row, indented by Depth. Filled by the controller
								     (TreeViewModel.RefreshCompiledStructure); this panel does not subscribe to it. -->
								<Border x:Name="CompiledStructurePanel" Margin="12,14,12,12" Padding="10" Background="#1E1E1E" BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="4">
									<StackPanel Spacing="6">
										<Grid ColumnDefinitions="*,Auto">
											<TextBlock Text="编译结构" Foreground="#7ec8ff" FontWeight="Bold" VerticalAlignment="Center"/>
											<TextBlock Grid.Column="1" Text="{Binding CompiledStructure.Count, StringFormat={}{0} 段}" Foreground="#a0a0a0"/>
										</Grid>
										<ItemsControl ItemsSource="{Binding CompiledStructure}">
											<ItemsControl.ItemTemplate>
												<DataTemplate x:DataType="cex:CompiledOutlineRow">
													<Grid ColumnDefinitions="Auto,*" Margin="{Binding Depth, Converter={StaticResource DepthIndent}}">
														<TextBlock Text="{Binding Kind}" Foreground="#f0c674" FontSize="11" Width="58"/>
														<TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="#e0e0e0" FontSize="11" TextWrapping="Wrap"/>
													</Grid>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</StackPanel>
								</Border>
							</StackPanel>
						</ScrollViewer>

						<!-- Agent -->
						<Grid x:Name="AgentPanel" IsVisible="False" RowDefinitions="Auto,Auto,*,Auto,Auto">
							<!-- Session permission belongs to the Agent: it decides what the model may do, not how a run is driven. -->
							<StackPanel Grid.Row="0" Margin="0,0,0,4">
								<TextBlock Text="会话" Classes="SidebarSection" />
								<Grid Margin="12,0,12,0" ColumnDefinitions="Auto,*">
									<TextBlock Text="权限模式" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,6,0" />
									<ComboBox Grid.Column="1" x:Name="PermissionModePicker" MinWidth="120" HorizontalAlignment="Stretch"
											  ToolTip.Tip="权限模式：决定哪些动作直接放行、哪些先问、哪些拒绝。宿主规则可以比模式更严，deny 规则在任何模式下都生效"
											  SelectionChanged="OnPermissionModeChanged" />
								</Grid>
							</StackPanel>
							<Grid Grid.Row="1" Margin="12,4,12,4" ColumnDefinitions="*,Auto">
								<TextBlock Text="Agent 对话" Foreground="#7EC8FF" FontWeight="Bold" VerticalAlignment="Center" />
								<ToggleSwitch Grid.Column="1" IsChecked="{Binding UseStreamingAgentResponse}"
											  OnContent="流式" OffContent="普通" FontSize="11" Margin="0,-6,0,-6" />
							</Grid>
							<!-- MarkdownView scrolls internally; put it straight in the page, not in a ScrollViewer. -->
							<md:MarkdownView Grid.Row="2" Text="{Binding ConversationMarkdown}" Margin="8,0"
											 MinHeight="120" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
							<Grid Grid.Row="3" Margin="12,6,12,8" ColumnDefinitions="*,Auto">
								<TextBox x:Name="AgentInput" Grid.Column="0" PlaceholderText="输入消息..."
										 Background="#2d2d2d" Foreground="White" AcceptsReturn="False"
										 KeyDown="OnAgentInputKeyDown" />
								<Button Grid.Column="1" Content="发送" Margin="4,0,0,0" Click="OnSendToAgent" />
							</Grid>
							<!-- Sub-agents the Agent dispatched, at every depth, under the scope's own node. The tree is the
							     library's own (VeloxDev.AI.SubAgents.SubAgentTreeViewModel), built over helper.SubAgents in the
							     code-behind once the subsystem exists. IsVisible starts False because a host with no key never gets
							     one — the panel is wired on, not assumed. -->
							<Border x:Name="SubAgentPanel" Grid.Row="4" x:DataType="sub:SubAgentTreeViewModel" IsVisible="False"
									Margin="12,4,12,12" Padding="10" Background="#1E1E1E" BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="4">
								<StackPanel Spacing="6">
									<Grid ColumnDefinitions="*,Auto">
										<TextBlock Text="子代理" Foreground="#7ec8ff" FontWeight="Bold" VerticalAlignment="Center"/>
										<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
											<TextBlock Text="{Binding RunningCount, StringFormat=运行中 {0}}" Foreground="#6bffb8" FontWeight="Bold" IsVisible="{Binding !IsIdle}"/>
											<TextBlock Text="{Binding TotalCount, StringFormat={}{0} 个}" Foreground="#a0a0a0"/>
											<TextBlock Text="{Binding SubtreeTokensText, StringFormat=· {0} tokens}" Foreground="#c8b6ff" IsVisible="{Binding ScopeRoot.HasTokens}"/>
											<TextBlock Text="{Binding FailedCount, StringFormat=· 失败 {0}}" Foreground="#ff6b6b" IsVisible="{Binding HasFailed}"/>
										</StackPanel>
									</Grid>
									<TextBlock Text="尚无子代理。让 Agent「派一个子代理去数一数节点」试试。" Foreground="#6b7280" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}"/>
									<ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
										<TreeView ItemsSource="{Binding Tree}" Background="Transparent" BorderThickness="0">
											<TreeView.ItemTemplate>
												<TreeDataTemplate x:DataType="sub:SubAgentTreeNodeViewModel" ItemsSource="{Binding Children}">
													<!-- What an agent map is read for. A lamp for the state, the title for which piece of work this is, and
													     under it what the run cost: how long it took, what it spent, and the subtree total beside the node's
													     own when the two differ. The task and the result are deliberately absent — a task is often a paragraph
													     and a result often longer, and printing them made every row four wrapped blocks and turned the tree
													     unreadable at exactly the moment it got interesting, a fan-out. Both live on SubAgentSummary and come
													     back through the tools, which is where anyone who needs them should look.
													     Everything is bound off the node, never through Row: the top node stands for the scope and has none. -->
													<Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
														<local:SubAgentStatusLight Grid.Column="0" Row="{Binding Row}" Width="9" Height="9"
																		   VerticalAlignment="Top" Margin="0,4,7,0"/>
														<StackPanel Grid.Column="1" Spacing="1">
															<TextBlock Text="{Binding Title}" Foreground="#e0e0e0" FontWeight="SemiBold"
																	   TextTrimming="CharacterEllipsis"/>
															<StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding !IsScopeRoot}">
																<TextBlock Text="{Binding DurationText}" Foreground="#8a8a8a" FontSize="11"
																		   IsVisible="{Binding HasDuration}"/>
																<TextBlock Text="{Binding TokensText, StringFormat=· {0}}" Foreground="#9d8cff" FontSize="11"
																		   IsVisible="{Binding HasTokens}"/>
																<TextBlock Text="{Binding SubtreeTokensText, StringFormat=· 子树 {0}}" Foreground="#7ec8ff" FontSize="11"
																		   IsVisible="{Binding ShowSubtreeTokens}"/>
																<TextBlock Text="{Binding DroppedRequestCount, StringFormat=· 有 {0} 项请求被拒}" Foreground="#ffd166" FontSize="11"
																		   IsVisible="{Binding HasDroppedRequests}"/>
																<TextBlock Text="{Binding StateText}" Foreground="#8a8a8a" FontSize="11"
																		   IsVisible="{Binding ShowStateText}"/>
															</StackPanel>
														</StackPanel>
													</Grid>
												</TreeDataTemplate>
											</TreeView.ItemTemplate>
										</TreeView>
									</ScrollViewer>
								</StackPanel>
							</Border>
						</Grid>

						<!-- MCP -->
						<ScrollViewer x:Name="McpPanel" IsVisible="False" VerticalScrollBarVisibility="Auto">
							<StackPanel>
								<TextBlock Text="服务器" Classes="SidebarSection" />
								<Border x:Name="McpStatusPanel" x:DataType="mcp:McpStatusViewModel" Margin="12,0,12,0" Padding="10" Background="#1E1E1E" BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="4">
									<StackPanel Spacing="6">
										<Grid ColumnDefinitions="*,Auto">
											<TextBlock Text="MCP 服务器" Foreground="#7ec8ff" FontWeight="Bold" VerticalAlignment="Center"/>
											<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
												<TextBlock Text="{Binding ConnectedCount, StringFormat=存活 {0}}" Foreground="#6bffb8" FontWeight="Bold"/>
												<TextBlock Text="{Binding ErrorCount, StringFormat=· 错误 {0}}" Foreground="#ff6b6b"/>
												<Button Content="重载" FontSize="11" Click="OnReloadMcp"/>
											</StackPanel>
										</Grid>
										<ItemsControl ItemsSource="{Binding Servers}">
											<ItemsControl.ItemTemplate>
												<DataTemplate x:DataType="mcp:McpServerStatusViewModel">
													<StackPanel Spacing="2">
														<StackPanel Orientation="Horizontal" Spacing="6">
															<TextBlock Text="{Binding Name}" Foreground="#e0e0e0" FontWeight="SemiBold"/>
															<TextBlock Text="{Binding StateText}" Foreground="#a0a0a0"/>
															<TextBlock Text="{Binding ToolCount, StringFormat=· {0} tools}" Foreground="#6bffb8"/>
														</StackPanel>
														<TextBlock Text="{Binding Error}" Foreground="#ff6b6b" FontSize="11" TextWrapping="Wrap"
																   IsVisible="{Binding IsError}" Margin="14,0,0,0"/>
													</StackPanel>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</StackPanel>
								</Border>
							</StackPanel>
						</ScrollViewer>

						<!-- Output -->
						<Grid x:Name="OutputPanel" IsVisible="False" RowDefinitions="Auto,*">
							<TextBlock Grid.Row="0" Text="执行输出" Classes="SidebarSection" />
							<ScrollViewer Grid.Row="1" x:Name="ExecutionLogScroller" Margin="8,0,8,8" VerticalScrollBarVisibility="Auto">
								<StackPanel Spacing="6">
									<TextBlock Text="实际执行顺序" Foreground="#7ec8ff" FontWeight="Bold" Margin="4,0,0,0"/>
									<TextBlock Text="{Binding ExecutionLog.Count, StringFormat=已记录: {0}}" Foreground="#bdbdbd" Margin="4,0,0,0"/>
									<ListBox ItemsSource="{Binding ExecutionLog}"
											 Background="Transparent" BorderThickness="0"
											 ScrollViewer.VerticalScrollBarVisibility="Disabled">
										<ListBox.ItemsPanel>
											<ItemsPanelTemplate>
												<VirtualizingStackPanel/>
											</ItemsPanelTemplate>
										</ListBox.ItemsPanel>
										<ListBox.ItemTemplate>
											<DataTemplate>
												<TextBlock Text="{Binding .}" Foreground="#d8d8d8" TextWrapping="Wrap"/>
											</DataTemplate>
										</ListBox.ItemTemplate>
									</ListBox>
								</StackPanel>
							</ScrollViewer>
						</Grid>
					</Grid>
				</Grid>
			</Border>
		</Grid>

		<GridSplitter Grid.Column="1" Width="5" Background="#1F2937"/>
	</Grid>
</UserControl>
