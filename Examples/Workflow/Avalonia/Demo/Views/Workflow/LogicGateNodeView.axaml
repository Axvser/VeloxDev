<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="220"
			 x:Class="Demo.LogicGateNodeView"
			 xmlns:local="using:Demo"
			 xmlns:behaviors="using:VeloxDev.WorkflowSystem.AttachedBehaviors"
			 xmlns:vm="using:Demo.ViewModels"
			 ClipToBounds="False"
			 behaviors:WorkflowSlotLayoutBehavior.IsEnabled="True"
			 behaviors:WorkflowSlotLayoutBehavior.SlotNames="PART_InputSlot"
			 behaviors:WorkflowSlotLayoutBehavior.SlotEnumeratorNames="PART_OutputSlotsList"
			 behaviors:WorkflowSlotLayoutBehavior.CoordinateHostName="PART_Canvas"
			 x:DataType="vm:LogicGateNodeViewModel">
	<Grid RowDefinitions="48,*" ClipToBounds="False">
		<Border Grid.RowSpan="2"
				CornerRadius="6"
				BorderThickness="1.5"
				BorderBrush="#6ec6ff"
				Background="#1e2a35"/>
		<Grid Grid.RowSpan="2" ZIndex="6" ClipToBounds="False">
			<Grid.Styles>
				<Style Selector="local|SlotView">
					<Setter Property="Foreground" Value="White"/>
				</Style>
				<Style Selector="local|SlotView[SlotState=16]">
					<Setter Property="Foreground" Value="Lime"/>
				</Style>
				<Style Selector="local|SlotView[SlotState=8]">
					<Setter Property="Foreground" Value="Tomato"/>
				</Style>
			</Grid.Styles>
			<local:SlotView x:Name="PART_InputSlot"
							Width="20" Height="20"
							HorizontalAlignment="Left"
							VerticalAlignment="Center"
							Margin="-10,0,0,0"
							DataContext="{Binding InputSlot}"
							IsVisible="{Binding $parent[local:LogicGateNodeView].DataContext.HasInputSlot}"
							SlotState="{Binding State}"/>
		</Grid>
		<Border Grid.Row="0"
				Background="#253545"
				CornerRadius="4,4,0,0"
				BorderThickness="0,0,0,0.5"
				BorderBrush="#6ec6ff"
				behaviors:WorkflowNodeDragBehavior.CoordinateHostName="PART_Canvas"
				behaviors:WorkflowNodeDragBehavior.IsEnabled="True">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
				<TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold"/>
				<Border Background="#2b2440" BorderBrush="#b799ff" BorderThickness="1" CornerRadius="10" Padding="6,1">
					<TextBlock Text="{Binding LastRouted}" Foreground="#e4d8ff" FontWeight="Bold"/>
				</Border>
				<Border Background="#1f3d1f" BorderBrush="#7bd97b" BorderThickness="1" CornerRadius="10" Padding="6,1"
						IsVisible="{Binding HasExecutionOrder}">
					<TextBlock Text="{Binding ExecutionOrderText}" Foreground="#c8ffc8" FontWeight="Bold"/>
				</Border>
			</StackPanel>
		</Border>
		<Border Grid.Row="1" Background="#1e2a35" CornerRadius="0,0,4,4">
			<Grid Margin="14" RowDefinitions="Auto,Auto,Auto,*">
				<TextBlock Grid.Row="0" Text="Gate Op" Foreground="#bfbfbf" FontSize="11"/>
				<ComboBox Grid.Row="1"
						  ItemsSource="{Binding GateOpOptions}"
						  SelectedItem="{Binding GateOp, Mode=TwoWay}"
						  HorizontalAlignment="Stretch"
						  Margin="0,4,0,0"/>
				<TextBlock Grid.Row="2" Text="Output Slots" Foreground="#bfbfbf" FontSize="11" Margin="0,8,0,0"/>
				<ItemsControl Grid.Row="3" ItemsSource="{Binding OutputSlots.Items}"
							  x:Name="PART_OutputSlotsList" ClipToBounds="False">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Grid ColumnDefinitions="*,Auto" Margin="0,4" ClipToBounds="False">
								<TextBlock Grid.Column="0"
										   Text="{Binding Name}"
										   Foreground="#6ec6ff"
										   FontWeight="SemiBold"
										   VerticalAlignment="Center"
										   HorizontalAlignment="Right"
										   Margin="0,0,8,0"/>
								<local:SlotView Grid.Column="1" Width="16" Height="16"
												HorizontalAlignment="Right"
												VerticalAlignment="Center"
												Margin="0,0,-8,0"
												DataContext="{Binding Slot}"
												SlotState="{Binding State}"/>
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</Grid>
		</Border>
	</Grid>
</UserControl>
