<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:behaviors="using:VeloxDev.WorkflowSystem.AttachedBehaviors"
			 mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="180"
			 x:Class="Demo.NodeView"
			 ClipToBounds="False">

	<!-- The fallback node card: what the canvas draws for a node type that ships no view of its own.

	     Bare on purpose. The framework's IWorkflowNodeViewModel carries geometry and slots and no display
	     name — a title is a property of the concrete ViewModel — so this card cannot honestly label a node
	     it knows nothing else about. Every node type in this demo has a view of its own (ControllerView,
	     TimerNodeView, PythonNodeView, EnumSelectorNodeView), so this renders only for a foreign type.

	     This file used to be a copy of the timer node's view: the fallback advertised a Delay box, an
	     Execution panel and Run/Forward buttons on any node type it happened to render, and its chrome was
	     bound to ChromeBackground / ChromeBorderBrush — properties that exist nowhere in this repository,
	     so the card drew with no background and no border at all. Chrome is a property of the view rather
	     than of a ViewModel that has to stay portable across seven GUI toolkits, which is why the colours
	     here are static, exactly as the item template's node view writes them. -->

	<Grid ClipToBounds="False">
		<Border CornerRadius="6"
				Background="#1E293B"
				BorderBrush="#334155"
				BorderThickness="1.5"
				behaviors:WorkflowNodeDragBehavior.IsEnabled="True"
				behaviors:WorkflowNodeDragBehavior.CoordinateHostName="PART_Canvas" />
	</Grid>
</UserControl>
