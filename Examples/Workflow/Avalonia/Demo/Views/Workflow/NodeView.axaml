<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:behaviors="using:VeloxDev.WorkflowSystem.AttachedBehaviors"
			 mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="120"
			 x:Class="Demo.NodeView"
			 ClipToBounds="False">

	<!-- The fallback node card: what the canvas draws for a node type that ships no view of its own.

	     Bare on purpose. The framework's IWorkflowNodeViewModel carries geometry and slots and no display
	     name — a title is a property of the concrete ViewModel — so this card cannot honestly label a node
	     it knows nothing else about. Every node type in this demo has a view of its own (ControllerView,
	     TimerNodeView, PythonNodeView, EnumSelectorNodeView), so this renders only for a foreign type.

	     Only the chrome is shared now: the surface, the hairline and the accent bar come from
	     CardTheme.axaml, so a foreign node still lands on the same visual family as the known ones
	     without this file claiming to know anything about it. The accent is the neutral slate, because
	     there is no type here to give it a colour. -->

	<Border Classes="card" Padding="0" behaviors:WorkflowNodeDragBehavior.IsEnabled="True"
			behaviors:WorkflowNodeDragBehavior.CoordinateHostName="PART_Canvas">
		<Grid ColumnDefinitions="2,*">
			<Border Grid.Column="0" Classes="card-accent" Background="#94A3B8" />
			<TextBlock Grid.Column="1" Classes="card-label" Text="?" Margin="12,0,0,0" VerticalAlignment="Center" />
		</Grid>
	</Border>
</UserControl>
