<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Node cards share one chrome: a near-black surface, a coloured type stripe, a hairline header,
	     and a muted footer. Every card takes its colours from Theme/Tokens.axaml, so the canvas, the
	     inspector and the node family read as one system. -->

	<Style Selector="Border.card">
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="BorderBrush" Value="{DynamicResource NodeBorderBrush}" />
		<Setter Property="Background" Value="{DynamicResource NodeBackgroundBrush}" />
		<Setter Property="BoxShadow" Value="0 6 20 0 #48000000" />
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="Border.card:pointerover">
		<Setter Property="BorderBrush" Value="{DynamicResource NodeHoverBorderBrush}" />
	</Style>

	<!-- Agent working set: violet outline + same-colour glow. The class is attached to the outer
	     UserControl by AgentSelectionVisual; the card only paints. -->
	<Style Selector=".agent-selected Border.card">
		<Setter Property="BorderBrush" Value="#A78BFA" />
		<Setter Property="BoxShadow" Value="0 0 18 2 #A78BFA" />
	</Style>

	<Style Selector="Border.card-divider">
		<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
		<Setter Property="BorderThickness" Value="0,0,0,1" />
	</Style>

	<!-- The type stripe: 3px, inset vertically like a language-coloured editor tab. -->
	<Style Selector="Border.card-accent">
		<Setter Property="CornerRadius" Value="2" />
		<Setter Property="Margin" Value="0,8,0,8" />
	</Style>

	<Style Selector="TextBlock.card-title">
		<Setter Property="FontSize" Value="15" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="TextTrimming" Value="CharacterEllipsis" />
	</Style>

	<Style Selector="TextBlock.card-label">
		<Setter Property="FontSize" Value="10.5" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
		<Setter Property="LetterSpacing" Value="0.6" />
	</Style>

	<Style Selector="TextBlock.card-value">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
	</Style>

	<Style Selector="TextBox.card-field">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="MinHeight" Value="26" />
		<Setter Property="Padding" Value="7,4" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
	</Style>

	<Style Selector="ComboBox.card-field">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="MinHeight" Value="26" />
		<Setter Property="Padding" Value="7,2" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
	</Style>

	<!-- Action buttons: one ghost shape; semantics live in the foreground colour, not a saturated block. -->
	<Style Selector="Button.ghost">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="Padding" Value="10,4" />
		<Setter Property="MinHeight" Value="26" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Background" Duration="0:0:0.10" />
				<BrushTransition Property="BorderBrush" Duration="0:0:0.10" />
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
	</Style>

	<Style Selector="Button.ghost:disabled /template/ ContentPresenter">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
		<Setter Property="TextElement.Foreground" Value="{DynamicResource TextDisabledBrush}" />
	</Style>

	<!-- The status pill used by script nodes. -->
	<Style Selector="Border.card-badge">
		<Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="9" />
		<Setter Property="Padding" Value="7,1" />
	</Style>
</Styles>
