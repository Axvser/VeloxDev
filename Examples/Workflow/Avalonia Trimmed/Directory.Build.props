<Project>
	<!-- MSBuild imports only the nearest Directory.Build.props, so the
		 parent's roots must be imported explicitly or they are shadowed. -->
	<Import Project="..\Directory.Build.props" />

	<!--
		This tree used to root VeloxDev.Core.Extension so its reflection metadata survived a trimmed
		publish. It no longer needs to: the assembly resolves everything it used to reflect for out of the
		compiled agent context tree and the generated archive serializer, and it has no trim warnings left.
		Rooting it now would keep metadata alive that nothing reads.
	-->
</Project>
