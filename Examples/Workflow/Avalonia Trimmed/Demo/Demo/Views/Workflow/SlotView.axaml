<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" Background="#01000000"
			 x:Class="Demo.SlotView"
			 xmlns:behaviors="using:VeloxDev.WorkflowSystem.AttachedBehaviors"
			 x:CompileBindings="False"
			 behaviors:WorkflowSlotConnectionBehavior.IsEnabled="True" >

	<Ellipse Fill="#DD1E1E1E"
			 Stroke="#FFFFFFFF"
			 StrokeThickness="1.5"
			 Stretch="Fill" />

</UserControl>
