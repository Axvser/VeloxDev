<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="140"
             x:Class="Demo.InfoOverlay">
    <!-- Realtime canvas-info HUD. The text layer (Border + TextBlock) is hit-test transparent so drags
         fall through to the surface; only the 复制 button is interactive. The TreeView host refreshes it
         on scroll/viewport changes and it subscribes to the Core model for layout / visible counts. -->
    <Grid>
        <Border IsHitTestVisible="False"
                CornerRadius="6"
                Background="#E612151B"
                BorderBrush="#CC8EA3B8"
                BorderThickness="1"
                Padding="12,8,58,8">
            <TextBlock x:Name="InfoText"
                       Foreground="#DDE4EA"
                       FontSize="12"
                       LineHeight="18"
                       IsHitTestVisible="False" />
        </Border>
        <Button x:Name="CopyButton"
                Content="复制"
                FontSize="11"
                Padding="8,2"
                Margin="0,0,8,8"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="#1E3A5F"
                Foreground="#7EC8FF"
                BorderBrush="#7EC8FF"
                BorderThickness="1"
                Click="OnCopyClicked" />
    </Grid>
</UserControl>
