<Window x:Class="Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VeloxDev 主题 — 规模与时间轴"
        Height="960" Width="1240">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <WrapPanel Margin="8,8,8,0">
                <Button Content="动画切换" Click="OnAnimate" Padding="10,4" Margin="0,0,6,0" />
                <Button Content="瞬切" Click="OnJump" Padding="10,4" Margin="0,0,6,0" />
                <Button Content="暂停 / 继续" Click="OnTogglePause" Padding="10,4" Margin="0,0,6,0" />
                <Button Content="慢放 0.25×" Click="OnSlow" Padding="10,4" Margin="0,0,6,0" />
                <Button Content="常速" Click="OnNormalRate" Padding="10,4" Margin="0,0,6,0" />
                <Button Content="拖到 50%" Click="OnSeekHalf" Padding="10,4" Margin="0,0,6,0" />
                <Button Content="停止" Click="OnStop" Padding="10,4" Margin="0,0,6,0" />
                <CheckBox Content="自动循环" x:Name="AutoLoop" VerticalAlignment="Center" Margin="12,0,0,0"
                          Checked="OnAutoLoopChanged" Unchecked="OnAutoLoopChanged" />
            </WrapPanel>

            <WrapPanel Margin="8,6,8,0">
                <TextBlock Text="元素数：" VerticalAlignment="Center" />
                <Button Content="200" Tag="200" Click="OnSizeClick" Padding="10,4" Margin="0,0,6,0" />
                <Button Content="1000" Tag="1000" Click="OnSizeClick" Padding="10,4" Margin="0,0,6,0" />
                <Button Content="2000" Tag="2000" Click="OnSizeClick" Padding="10,4" Margin="0,0,6,0" />
                <Button Content="改 Light 的背景" Click="OnEditThemeValue" Padding="10,4" Margin="16,0,6,0" />
                <Button Content="还原" Click="OnRestoreThemeValue" Padding="10,4" Margin="0,0,6,0" />
            </WrapPanel>

            <TextBlock x:Name="Status" Margin="8,6,8,0" FontFamily="Consolas" TextWrapping="Wrap" />
            <TextBlock x:Name="Live" Margin="8,2,8,0" FontFamily="Consolas" TextWrapping="Wrap" />
            <TextBlock x:Name="Hooks" Margin="8,2,8,6" FontFamily="Consolas" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="Host" />
        </ScrollViewer>
    </DockPanel>
</Window>
