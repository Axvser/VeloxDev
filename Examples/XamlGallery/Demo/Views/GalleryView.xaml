<v:UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="clr-namespace:VeloxDev.WinForms.Xaml;assembly=VeloxDev.WinForms"
    xmlns:app="clr-namespace:Demo.Views"
    xmlns:local="clr-namespace:Demo.Views.Sections"
    x:Class="Demo.Views.GalleryView">

  <!-- Palette brushes are replaced by the code-behind when the theme mode changes;
       every consumer follows them through DynamicResource. -->
  <v:UserControl.Resources>
    <v:ResourceDictionary>
      <v:SolidColorBrush x:Key="WindowBrush" Color="#FF0F1115" />
      <v:SolidColorBrush x:Key="HeaderBrush" Color="#FF14171D" />
      <v:SolidColorBrush x:Key="SurfaceBrush" Color="#FF16191F" />
      <v:SolidColorBrush x:Key="CardBrush" Color="#FF181C23" />
      <v:SolidColorBrush x:Key="FieldBrush" Color="#FF20242D" />
      <v:SolidColorBrush x:Key="BorderBrush" Color="#FF2C3340" />
      <v:SolidColorBrush x:Key="TextBrush" Color="#FFE9ECF2" />
      <v:SolidColorBrush x:Key="MutedBrush" Color="#FF98A2B3" />
      <v:SolidColorBrush x:Key="AccentBrush" Color="#FF5B8CFF" />
      <v:SolidColorBrush x:Key="AccentSoftBrush" Color="#335B8CFF" />
      <v:SolidColorBrush x:Key="SelectionBrush" Color="#FF2B3F66" />
      <v:SolidColorBrush x:Key="SuccessBrush" Color="#FF3DD68C" />
      <v:SolidColorBrush x:Key="WarningBrush" Color="#FFF2B44B" />
      <v:SolidColorBrush x:Key="DangerBrush" Color="#FFFF6B6B" />

      <v:LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <v:LinearGradientBrush.GradientStops>
          <v:GradientStop Color="#FF5B8CFF" Offset="0" />
          <v:GradientStop Color="#FF9B6BFF" Offset="1" />
        </v:LinearGradientBrush.GradientStops>
      </v:LinearGradientBrush>

      <v:Style TargetType="v:TextBlock">
        <v:Style.Setters>
          <v:Setter Property="Font" Value="{x:Static app:GalleryTypography.Body}" />
          <v:Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </v:Style.Setters>
      </v:Style>

      <v:Style TargetType="v:Border">
        <v:Style.Setters>
          <v:Setter Property="Background" Value="{DynamicResource CardBrush}" />
          <v:Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
          <v:Setter Property="BorderThickness" Value="1" />
          <v:Setter Property="CornerRadius" Value="10" />
          <v:Setter Property="Padding" Value="20" />
        </v:Style.Setters>
      </v:Style>
    </v:ResourceDictionary>
  </v:UserControl.Resources>

  <v:Grid Dock="Fill" Background="{DynamicResource WindowBrush}">
    <v:Grid.RowDefinitions>
      <v:RowDefinition Height="Auto" />
      <v:RowDefinition Height="*" />
    </v:Grid.RowDefinitions>

    <v:Border Height="112"
              Background="{DynamicResource HeaderBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1"
              CornerRadius="0"
              Padding="28,0">
      <v:Grid>
        <v:Grid.ColumnDefinitions>
          <v:ColumnDefinition Width="*" />
          <v:ColumnDefinition Width="Auto" />
        </v:Grid.ColumnDefinitions>

        <v:StackPanel Orientation="Horizontal"
                      Spacing="14"
                      VerticalAlignment="Center">
          <v:Border Width="38"
                    Height="38"
                    Background="{DynamicResource AccentGradient}"
                    BorderThickness="0"
                    CornerRadius="10"
                    Padding="0">
            <v:Path Width="19"
                    Height="19"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Stretch="Uniform"
                    Data="M 4 3 L 10 16 L 16 3"
                    Stroke="#FFFFFFFF"
                    StrokeThickness="2.5" />
          </v:Border>

          <v:StackPanel Spacing="3" VerticalAlignment="Center">
            <v:TextBlock Text="WinForms XAML Gallery"
                         Font="{x:Static app:GalleryTypography.Title}" />
            <v:TextBlock Text="Every layer of the VeloxDev XAML runtime, authored in the same markup it compiles."
                         Font="{x:Static app:GalleryTypography.Subtitle}"
                         Foreground="{DynamicResource MutedBrush}" />
          </v:StackPanel>
        </v:StackPanel>

        <v:StackPanel v:Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="10"
                      VerticalAlignment="Center">
          <v:Border Width="146"
                    Height="26"
                    Background="{DynamicResource FieldBrush}"
                    BorderThickness="1"
                    CornerRadius="999"
                    Padding="10,4"
                    VerticalAlignment="Center">
            <v:TextBlock Text="net10.0-windows"
                         Margin="0"
                         VerticalAlignment="Center"
                         Font="{x:Static app:GalleryTypography.Mono}"
                         Foreground="{DynamicResource MutedBrush}" />
          </v:Border>
          <v:Border Width="72"
                    Height="26"
                    Background="{DynamicResource FieldBrush}"
                    BorderThickness="1"
                    CornerRadius="999"
                    Padding="10,4"
                    VerticalAlignment="Center">
            <v:TextBlock Text="v12.0.0"
                         Margin="0"
                         VerticalAlignment="Center"
                         Font="{x:Static app:GalleryTypography.Mono}"
                         Foreground="{DynamicResource MutedBrush}" />
          </v:Border>
          <v:Button x:Name="themeToggleButton"
                    Content="Light mode"
                    Height="34"
                    Click="OnThemeToggleClick" />
        </v:StackPanel>
      </v:Grid>
    </v:Border>

    <v:TabControl x:Name="galleryTabs"
                  v:Grid.Row="1"
                  Dock="Fill"
                  Padding="20,14,20,18">
      <v:TabItem Header="Layout">
        <local:LayoutSection />
      </v:TabItem>
      <v:TabItem Header="Text">
        <local:TextSection />
      </v:TabItem>
      <v:TabItem Header="Data">
        <local:DataSection />
      </v:TabItem>
      <v:TabItem Header="Input">
        <local:InputSection />
      </v:TabItem>
      <v:TabItem Header="Graphics">
        <local:GraphicsSection />
      </v:TabItem>
      <v:TabItem Header="Animation">
        <local:AnimationSection />
      </v:TabItem>
      <v:TabItem Header="Binding">
        <local:BindingSection />
      </v:TabItem>
      <v:TabItem Header="Styles">
        <local:StylesSection />
      </v:TabItem>
      <v:TabItem Header="Theme">
        <local:ThemeSection />
      </v:TabItem>
      <v:TabItem Header="Navigation">
        <local:NavigationSection />
      </v:TabItem>
    </v:TabControl>
  </v:Grid>
</v:UserControl>
