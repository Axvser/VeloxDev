<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:Demo.Views"
    x:Class="Demo.Views.GalleryView">

  <!-- Palette brushes are replaced by the code-behind when the theme mode changes;
       every consumer follows them through DynamicResource. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="WindowBrush" Color="#FF0F1115" />
      <SolidColorBrush x:Key="HeaderBrush" Color="#FF14171D" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FF16191F" />
      <SolidColorBrush x:Key="CardBrush" Color="#FF181C23" />
      <SolidColorBrush x:Key="FieldBrush" Color="#FF20242D" />
      <SolidColorBrush x:Key="BorderBrush" Color="#FF2C3340" />
      <SolidColorBrush x:Key="TextBrush" Color="#FFE9ECF2" />
      <SolidColorBrush x:Key="MutedBrush" Color="#FF98A2B3" />
      <SolidColorBrush x:Key="AccentBrush" Color="#FF5B8CFF" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#335B8CFF" />
      <SolidColorBrush x:Key="SelectionBrush" Color="#FF2B3F66" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#FF3DD68C" />
      <SolidColorBrush x:Key="WarningBrush" Color="#FFF2B44B" />
      <SolidColorBrush x:Key="DangerBrush" Color="#FFFF6B6B" />

      <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <LinearGradientBrush.GradientStops>
          <GradientStop Color="#FF5B8CFF" Offset="0" />
          <GradientStop Color="#FF9B6BFF" Offset="1" />
        </LinearGradientBrush.GradientStops>
      </LinearGradientBrush>

      <Style TargetType="TextBlock">
        <Style.Setters>
          <Setter Property="Font" Value="{x:Static app:GalleryTypography.Body}" />
          <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style.Setters>
      </Style>

      <Style TargetType="Border">
        <Style.Setters>
          <Setter Property="Background" Value="{DynamicResource CardBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="Padding" Value="20" />
        </Style.Setters>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Dock="Fill" Background="{DynamicResource WindowBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border x:Name="titleStrip"
            Grid.Row="0"
            Height="44"
            Background="{DynamicResource HeaderBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            CornerRadius="0"
            Padding="16,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="28"
                  Height="28"
                  Background="{DynamicResource AccentGradient}"
                  BorderThickness="0"
                  CornerRadius="8"
                  Padding="0">
            <Path Width="15"
                  Height="15"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Stretch="Uniform"
                  Data="M 4 3 L 10 16 L 16 3"
                  Stroke="#FFFFFFFF"
                  StrokeThickness="2.5" />
          </Border>
          <TextBlock Text="WinForms XAML Gallery"
                     Font="{x:Static app:GalleryTypography.Title}"
                     MinHeight="34"
                     VerticalAlignment="Center" />
          <Border Height="24"
                  Background="{DynamicResource FieldBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="999"
                  Padding="9,3"
                  VerticalAlignment="Center">
            <TextBlock Text="VeloxDev 12.0.0"
                       Font="{x:Static app:GalleryTypography.Mono}"
                       Foreground="{DynamicResource MutedBrush}"
                       MinHeight="15"
                       VerticalAlignment="Center" />
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
          <TextBlock x:Name="titleStatus"
                     Font="{x:Static app:GalleryTypography.Caption}"
                     Foreground="{DynamicResource MutedBrush}"
                     VerticalAlignment="Center" />
          <Button x:Name="themeToggleButton"
                  Content="Light mode"
                  Height="32"
                  Click="OnThemeToggleClick" />
        </StackPanel>
      </Grid>
    </Border>

    <DockPanel Grid.Row="1" LastChildFill="True">

      <!-- Left: catalog tree -->
      <Border x:Name="catalogPane"
              DockPanel.Dock="Left"
              Width="300"
              MinWidth="200"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,1,0"
              CornerRadius="0"
              Padding="12,10,12,10">
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Top"
                     Text="CATALOG"
                     Font="{x:Static app:GalleryTypography.Caption}"
                     Foreground="{DynamicResource MutedBrush}"
                     Margin="2,0,0,8" />
          <TextBox x:Name="catalogSearch"
                   DockPanel.Dock="Top"
                   Height="28"
                   PlaceholderText="Filter entries"
                   Margin="0,0,0,8"
                   TextChanged="OnCatalogSearchTextChanged" />
          <TextBlock x:Name="catalogCount"
                     DockPanel.Dock="Bottom"
                     Font="{x:Static app:GalleryTypography.Caption}"
                     Foreground="{DynamicResource MutedBrush}"
                     Margin="2,8,0,0" />
          <TreeView x:Name="catalogTree"
                    BorderThickness="0"
                    CornerRadius="0"
                    Background="{DynamicResource SurfaceBrush}"
                    SelectionChanged="OnCatalogSelectionChanged" />
        </DockPanel>
      </Border>

      <GridSplitter x:Name="catalogSplitter"
                    DockPanel.Dock="Left"
                    Width="6"
                    Orientation="Vertical"
                    ResizeDirection="Columns"
                    ResizeBehavior="Previous" />

      <!-- Right: selected-element inspector -->
      <Border x:Name="inspectorPane"
              DockPanel.Dock="Right"
              Width="328"
              MinWidth="260"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1,0,0,0"
              CornerRadius="0"
              Padding="12,10,12,10">
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Top"
                     Text="PROPERTIES"
                     Font="{x:Static app:GalleryTypography.Caption}"
                     Foreground="{DynamicResource MutedBrush}"
                     Margin="2,0,0,8" />

          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
            <Border Height="24"
                    Width="196"
                    Background="{DynamicResource FieldBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="999"
                    Padding="9,3"
                    HorizontalAlignment="Left">
              <TextBlock x:Name="inspectorTypeText"
                         Text="No selection"
                         Font="{x:Static app:GalleryTypography.Mono}"
                         Foreground="{DynamicResource AccentBrush}"
                         MinHeight="15"
                         VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="inspectorPathText"
                       Text="Click an element in the preview."
                       Font="{x:Static app:GalleryTypography.Mono}"
                       Foreground="{DynamicResource MutedBrush}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <TextBox x:Name="propertySearch"
                   DockPanel.Dock="Top"
                   Height="28"
                   PlaceholderText="Filter properties"
                   Margin="0,0,0,6"
                   TextChanged="OnPropertySearchTextChanged" />

          <TextBlock x:Name="inspectorHint"
                     DockPanel.Dock="Bottom"
                     Text="Edits write local values; the × reset clears them."
                     Font="{x:Static app:GalleryTypography.Caption}"
                     Foreground="{DynamicResource MutedBrush}"
                     TextWrapping="Wrap"
                     Margin="0,6,0,0" />

          <Button x:Name="advancedButton"
                  DockPanel.Dock="Bottom"
                  Content="Show all properties"
                  Height="30"
                  Margin="0,8,0,0"
                  Click="OnAdvancedClick" />

          <ScrollableControl x:Name="inspectorScroll"
                             Background="{DynamicResource SurfaceBrush}">
            <StackPanel x:Name="inspectorRows" Dock="Top" Spacing="2" />
          </ScrollableControl>
        </DockPanel>
      </Border>

      <GridSplitter x:Name="inspectorSplitter"
                    DockPanel.Dock="Right"
                    Width="6"
                    Orientation="Vertical"
                    ResizeDirection="Columns"
                    ResizeBehavior="Previous" />

      <!-- Center: preview -->
      <Grid x:Name="previewPane">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource WindowBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                CornerRadius="0"
                Padding="20,12,20,12">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Top">
              <Border Height="26"
                      Background="{DynamicResource FieldBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="999"
                      Padding="10,4"
                      VerticalAlignment="Center">
                <TextBlock x:Name="entryKindText"
                           Text="Card"
                           Font="{x:Static app:GalleryTypography.Mono}"
                           Foreground="{DynamicResource MutedBrush}"
                           MinHeight="15"
                           VerticalAlignment="Center" />
              </Border>
              <Button x:Name="copyUsageButton"
                      Content="Copy XAML"
                      Height="32"
                      Click="OnCopyUsageClick" />
              <Button x:Name="resetPreviewButton"
                      Content="Reset preview"
                      Height="32"
                      Click="OnResetPreviewClick" />
            </StackPanel>

            <StackPanel Spacing="3">
              <TextBlock x:Name="entryBreadcrumb"
                         Text="01 · LAYOUT / STACKPANEL"
                         Font="{x:Static app:GalleryTypography.Mono}"
                         Foreground="{DynamicResource AccentBrush}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="entryTitle"
                         Text="StackPanel"
                         Font="{x:Static app:GalleryTypography.SectionTitle}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="entrySummary"
                         Text="Choose an entry from the catalogue."
                         Font="{x:Static app:GalleryTypography.Body}"
                         Foreground="{DynamicResource MutedBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="20,14,20,14"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="0">
          <AdornerDecorator x:Name="previewAdorner">
            <ContentControl x:Name="previewHost" Background="{DynamicResource SurfaceBrush}" />
          </AdornerDecorator>
        </Border>

        <Expander x:Name="usageExpander"
                  Grid.Row="2"
                  Header="Usage"
                  IsExpanded="False"
                  Margin="20,0,20,14">
          <TextBox x:Name="usageText"
                   Height="140"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   Font="{x:Static app:GalleryTypography.Mono}"
                   Background="{DynamicResource FieldBrush}"
                   Foreground="{DynamicResource TextBrush}" />
        </Expander>
      </Grid>
    </DockPanel>

    <Border x:Name="statusBar"
            Grid.Row="2"
            Height="24"
            Background="{DynamicResource HeaderBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            CornerRadius="0"
            Padding="12,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="statusLeft"
                   Font="{x:Static app:GalleryTypography.Caption}"
                   Foreground="{DynamicResource MutedBrush}"
                   VerticalAlignment="Center" />
        <TextBlock x:Name="statusRight"
                   Grid.Column="1"
                   Font="{x:Static app:GalleryTypography.Mono}"
                   Foreground="{DynamicResource MutedBrush}"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
