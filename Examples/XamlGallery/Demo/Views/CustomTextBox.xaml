<StackPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Demo.Views.CustomTextBox"
    Width="360"
    Spacing="10">

  <StackPanel.Resources>
    <ControlTemplate x:Key="PillField" TargetType="TextBox">
      <Border Background="{StaticResource FieldBackground}"
              BorderBrush="{StaticResource FieldBorder}"
              BorderThickness="1"
              CornerRadius="16"
              Padding="14,8">
        <TextBoxContentHost x:Name="PART_ContentHost" />
      </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="AccentField" TargetType="TextBox">
      <Border Background="{StaticResource AccentFieldBackground}"
              BorderBrush="{StaticResource Accent}"
              BorderThickness="1"
              CornerRadius="16"
              Padding="14,8">
        <TextBoxContentHost x:Name="PART_ContentHost" />
      </Border>
    </ControlTemplate>
  </StackPanel.Resources>

  <TextBlock Text="A templated TextBox with UseNativeEditor=false"
             Foreground="{StaticResource Text}"
             FontSize="15"
             Wrap="True" />

  <TextBlock Text="No child HWND: the caret, selection, clipboard, undo and every dependency property stay on the visual path."
             Foreground="{StaticResource Muted}"
             Wrap="True" />

  <TextBox UseNativeEditor="False"
           Template="{StaticResource PillField}"
           Placeholder="Rounded, XAML-styled input" />

  <TextBox UseNativeEditor="False"
           Template="{StaticResource AccentField}"
           Text="Accent border · no airspace island" />

  <TextBlock Text="Turn UseNativeEditor back on only when IME composition or the native accessibility peer is needed."
             Foreground="{StaticResource Muted}"
             Wrap="True" />

</StackPanel>
