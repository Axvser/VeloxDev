<StackPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Demo.Views.VisualSample"
    Orientation="Horizontal"
    Spacing="12">

  <Border Width="300"
            Height="110"
            Background="#FF252526"
            BorderBrush="#FF3C3C3C"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14">
    <StackPanel Spacing="6">
      <TextBlock x:Name="sampleTitle"
                   Text="Visual XAML"
                   Foreground="#FFCCCCCC" />
      <TextBlock x:Name="sampleStatus"
                   Text="Generated from visual XAML"
                   Foreground="#FF858585"
                   Wrap="True" />
    </StackPanel>
  </Border>

  <Button x:Name="sampleAction"
            Text="Compile again"
            Height="32"
            Click="OnSampleClick" />

</StackPanel>
