<v:UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="clr-namespace:VeloxDev.WinForms.Xaml;assembly=VeloxDev.WinForms"
    xmlns:app="clr-namespace:Demo.Views"
    xmlns:local="clr-namespace:Demo"
    x:Class="Demo.Views.Sections.AnimationSection">

  <v:ScrollableControl Dock="Fill" Background="{DynamicResource WindowBrush}">
    <v:StackPanel Dock="Top" Spacing="16" Padding="4,4,20,28">

      <v:StackPanel Spacing="6">
        <v:TextBlock Text="06 · Animation" Font="{x:Static app:GalleryTypography.Mono}" Foreground="{DynamicResource AccentBrush}" />
        <v:TextBlock Text="Transitions, keyframes and states" Font="{x:Static app:GalleryTypography.SectionTitle}" />
        <v:TextBlock Text="Dependency properties animate through the WinForms transition system; actions can be grouped, looped or replaced by a custom action."
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MutedBrush}"
                     MaxWidth="980" />
      </v:StackPanel>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="Hover transition group" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="One EnterAction animates the background and the border together; ExitAction reverses both."
                       Foreground="{DynamicResource MutedBrush}" />
          <v:Border x:Name="hoverCard"
                    Width="360"
                    Height="130"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource FieldBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
            <v:Border.Triggers>
              <v:Trigger Property="IsPointerOver" Value="True">
                <v:Trigger.EnterAction>
                  <v:TransitionAction Property="Background" To="#FF24365B" Duration="0:0:0.18" Ease="CubicOut" />
                  <v:TransitionAction Property="BorderBrush" To="#FF5B8CFF" Duration="0:0:0.18" Ease="CubicOut" />
                </v:Trigger.EnterAction>
                <v:Trigger.ExitAction>
                  <v:TransitionAction Property="Background" To="#FF20242D" Duration="0:0:0.24" Ease="CubicOut" />
                  <v:TransitionAction Property="BorderBrush" To="#FF2C3340" Duration="0:0:0.24" Ease="CubicOut" />
                </v:Trigger.ExitAction>
              </v:Trigger>
            </v:Border.Triggers>
            <v:TextBlock Text="Hover this card" TextAlignment="Center" VerticalAlignment="Center" />
          </v:Border>
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="Keyframes with loop and auto-reverse" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="The chain is split into one transition per segment; LoopTime and IsAutoReverse wrap the whole run."
                       Foreground="{DynamicResource MutedBrush}" />
          <v:Border Width="360" Height="130" HorizontalAlignment="Left" Background="{DynamicResource FieldBrush}">
            <v:Border.Triggers>
              <v:Trigger Property="IsPointerOver" Value="True">
                <v:Trigger.EnterAction>
                  <v:KeyFrameAnimation Property="Background" Duration="0:0:0.9" Ease="SineInOut" LoopTime="2" IsAutoReverse="True">
                    <v:KeyFrame Offset="0" Value="#FF20242D" />
                    <v:KeyFrame Offset="0.5" Value="#FF3555A8" />
                    <v:KeyFrame Offset="1" Value="#FF20242D" />
                  </v:KeyFrameAnimation>
                </v:Trigger.EnterAction>
              </v:Trigger>
            </v:Border.Triggers>
            <v:TextBlock Text="Hover for a looping keyframe run" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
          </v:Border>
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="Custom action and Thickness animation" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="PulseAction is a local TriggerAction; BorderThickness is a Thickness value sampled by the adapter."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <v:Border x:Name="pulseCard"
                    Width="420"
                    Height="120"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource FieldBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1">
            <v:Border.Triggers>
              <v:Trigger Property="IsPointerOver" Value="True">
                <v:Trigger.EnterAction>
                  <local:PulseAction Radius="30" />
                  <v:TransitionAction Property="BorderThickness" To="3" Duration="0:0:0.18" Ease="CubicOut" />
                </v:Trigger.EnterAction>
                <v:Trigger.ExitAction>
                  <v:TransitionAction Property="CornerRadius" To="10" Duration="0:0:0.22" Ease="CubicOut" />
                  <v:TransitionAction Property="BorderThickness" To="1" Duration="0:0:0.22" Ease="CubicOut" />
                </v:Trigger.ExitAction>
              </v:Trigger>
            </v:Border.Triggers>
            <v:TextBlock Text="Hover: corners round, then settle back" TextAlignment="Center" VerticalAlignment="Center" />
          </v:Border>
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="VisualStateManager" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="States are configured in code-behind; GoToState applies the setters and restores the previous state on exit."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <v:StackPanel Orientation="Horizontal" Spacing="10">
            <v:Button Content="Normal" Height="34" Click="OnNormalStateClick" />
            <v:Button Content="Hot" Height="34" Click="OnHotStateClick" />
            <v:Button Content="Pinned" Height="34" Click="OnPinnedStateClick" />
          </v:StackPanel>
          <v:Border x:Name="vsmCard"
                    Width="420"
                    Height="110"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource FieldBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
            <v:TextBlock x:Name="vsmLabel" Text="Normal" TextAlignment="Center" VerticalAlignment="Center" />
          </v:Border>
        </v:StackPanel>
      </v:Border>

    </v:StackPanel>
  </v:ScrollableControl>
</v:UserControl>
