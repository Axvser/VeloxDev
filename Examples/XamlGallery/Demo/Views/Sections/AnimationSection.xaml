<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:Demo.Views"
    xmlns:local="clr-namespace:Demo"
    x:Class="Demo.Views.Sections.AnimationSection">

  <ScrollableControl Dock="Fill" Background="{DynamicResource WindowBrush}">
    <StackPanel Dock="Top" Spacing="16" Padding="4,4,20,28">

      <StackPanel Spacing="6">
        <TextBlock Text="06 · Animation" Font="{x:Static app:GalleryTypography.Mono}" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="Transitions, keyframes and states" Font="{x:Static app:GalleryTypography.SectionTitle}" />
        <TextBlock Text="Dependency properties animate through the WinForms transition system; actions can be grouped, looped or replaced by a custom action."
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MutedBrush}"
                     MaxWidth="980" />
      </StackPanel>

      <Border x:Name="CardHoverTransition">
        <StackPanel Spacing="10">
          <TextBlock Text="Hover transition group" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="One EnterAction animates the background and the border together; ExitAction reverses both."
                       Foreground="{DynamicResource MutedBrush}" />
          <Border x:Name="hoverCard"
                    Width="360"
                    Height="130"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource FieldBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
            <Border.Triggers>
              <Trigger Property="IsPointerOver" Value="True">
                <Trigger.EnterAction>
                  <TransitionAction Property="Background" To="#FF24365B" Duration="0:0:0.18" Ease="CubicOut" />
                  <TransitionAction Property="BorderBrush" To="#FF5B8CFF" Duration="0:0:0.18" Ease="CubicOut" />
                </Trigger.EnterAction>
                <Trigger.ExitAction>
                  <TransitionAction Property="Background" To="#FF20242D" Duration="0:0:0.24" Ease="CubicOut" />
                  <TransitionAction Property="BorderBrush" To="#FF2C3340" Duration="0:0:0.24" Ease="CubicOut" />
                </Trigger.ExitAction>
              </Trigger>
            </Border.Triggers>
            <TextBlock Text="Hover this card" TextAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </StackPanel>
      </Border>

      <Border x:Name="CardKeyframes">
        <StackPanel Spacing="10">
          <TextBlock Text="Keyframes with loop and auto-reverse" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="The chain is split into one transition per segment; LoopTime and IsAutoReverse wrap the whole run."
                       Foreground="{DynamicResource MutedBrush}" />
          <Border Width="360" Height="130" HorizontalAlignment="Left" Background="{DynamicResource FieldBrush}">
            <Border.Triggers>
              <Trigger Property="IsPointerOver" Value="True">
                <Trigger.EnterAction>
                  <KeyFrameAnimation Property="Background" Duration="0:0:0.9" Ease="SineInOut" LoopTime="2" IsAutoReverse="True">
                    <KeyFrame Offset="0" Value="#FF20242D" />
                    <KeyFrame Offset="0.5" Value="#FF3555A8" />
                    <KeyFrame Offset="1" Value="#FF20242D" />
                  </KeyFrameAnimation>
                </Trigger.EnterAction>
              </Trigger>
            </Border.Triggers>
            <TextBlock Text="Hover for a looping keyframe run" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </Border>

      <Border x:Name="CardCustomAction">
        <StackPanel Spacing="10">
          <TextBlock Text="Custom action and Thickness animation" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="PulseAction is a local TriggerAction; BorderThickness is a Thickness value sampled by the adapter."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <Border x:Name="pulseCard"
                    Width="420"
                    Height="120"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource FieldBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1">
            <Border.Triggers>
              <Trigger Property="IsPointerOver" Value="True">
                <Trigger.EnterAction>
                  <local:PulseAction Radius="30" />
                  <TransitionAction Property="BorderThickness" To="3" Duration="0:0:0.18" Ease="CubicOut" />
                </Trigger.EnterAction>
                <Trigger.ExitAction>
                  <TransitionAction Property="CornerRadius" To="10" Duration="0:0:0.22" Ease="CubicOut" />
                  <TransitionAction Property="BorderThickness" To="1" Duration="0:0:0.22" Ease="CubicOut" />
                </Trigger.ExitAction>
              </Trigger>
            </Border.Triggers>
            <TextBlock Text="Hover: corners round, then settle back" TextAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </StackPanel>
      </Border>

      <Border x:Name="CardVisualStates">
        <StackPanel Spacing="10">
          <TextBlock Text="VisualStateManager" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="States are configured in code-behind; GoToState applies the setters and restores the previous state on exit."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Normal" Height="34" Click="OnNormalStateClick" />
            <Button Content="Hot" Height="34" Click="OnHotStateClick" />
            <Button Content="Pinned" Height="34" Click="OnPinnedStateClick" />
          </StackPanel>
          <Border x:Name="vsmCard"
                    Width="420"
                    Height="110"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource FieldBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
            <TextBlock x:Name="vsmLabel" Text="Normal" TextAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollableControl>
</UserControl>
