<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:Demo.Views"
    xmlns:demo="clr-namespace:Demo"
    x:Class="Demo.Views.Sections.StylesSection">

  <UserControl.Resources>
    <ResourceDictionary>
      <Style x:Key="BaseCard" TargetType="Border">
        <Style.Setters>
          <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="CornerRadius" Value="8" />
          <Setter Property="Padding" Value="14" />
        </Style.Setters>
      </Style>

      <Style x:Key="ElevatedCard" TargetType="Border" BasedOn="{StaticResource BaseCard}">
        <Style.Setters>
          <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
          <Setter Property="CornerRadius" Value="14" />
        </Style.Setters>
      </Style>

      <Style x:Key="LiftCard" TargetType="Border">
        <Style.Setters>
          <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="CornerRadius" Value="8" />
          <Setter Property="Padding" Value="14" />
        </Style.Setters>
        <Style.Triggers>
          <Trigger Property="IsPointerOver" Value="True">
            <Trigger.Setters>
              <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger.Setters>
            <Trigger.EnterAction>
              <TransitionAction Property="CornerRadius" To="18" Duration="0:0:0.18" Ease="CubicOut" />
            </Trigger.EnterAction>
            <Trigger.ExitAction>
              <TransitionAction Property="CornerRadius" To="8" Duration="0:0:0.18" Ease="CubicOut" />
            </Trigger.ExitAction>
          </Trigger>
        </Style.Triggers>
      </Style>

      <ControlTemplate x:Key="BadgeTemplate" TargetType="demo:GalleryBadge">
        <Border x:Name="PART_Chrome"
                  Padding="14,10"
                  BorderThickness="1"
                  CornerRadius="8"
                  Background="{DynamicResource FieldBrush}"
                  BorderBrush="{DynamicResource BorderBrush}">
          <StackPanel Spacing="4">
            <TextBlock x:Name="PART_Label"
                         Text="{TemplateBinding Label}"
                         Font="{x:Static app:GalleryTypography.CardTitle}" />
            <TextBlock Text="{TemplateBinding Note}" Foreground="{DynamicResource MutedBrush}" />
          </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHot" Value="True">
            <Trigger.Setters>
              <Setter TargetName="PART_Chrome" TargetType="Border" Property="BorderBrush" Value="#FF5B8CFF" />
              <Setter TargetName="PART_Label" TargetType="TextBlock" Property="Foreground" Value="#FF5B8CFF" />
            </Trigger.Setters>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>

      <Style x:Key="BadgeStyle" TargetType="demo:GalleryBadge" Template="{StaticResource BadgeTemplate}">
        <Style.Setters>
          <Setter Property="Width" Value="360" />
          <Setter Property="Height" Value="84" />
          <Setter Property="Note" Value="idle" />
        </Style.Setters>
        <Style.Triggers>
          <DataTrigger Binding="{Binding OptionalName}" Value="">
            <DataTrigger.Setters>
              <Setter Property="Note" Value="empty optional name" />
            </DataTrigger.Setters>
          </DataTrigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsHot" Value="True" />
              <Condition Property="IsPinned" Value="True" />
            </MultiTrigger.Conditions>
            <MultiTrigger.Setters>
              <Setter Property="Note" Value="hot + pinned" />
            </MultiTrigger.Setters>
          </MultiTrigger>
        </Style.Triggers>
      </Style>

      <DataTemplate x:Key="ChipTemplate">
        <Border Height="28" Padding="8,0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}">
          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <ScrollableControl Dock="Fill" Background="{DynamicResource WindowBrush}">
    <StackPanel Dock="Top" Spacing="16" Padding="4,4,20,28">

      <StackPanel Spacing="6">
        <TextBlock Text="08 · Styles" Font="{x:Static app:GalleryTypography.Mono}" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="Styles, templates and triggers" Font="{x:Static app:GalleryTypography.SectionTitle}" />
        <TextBlock Text="Explicit and implicit styles, BasedOn, ControlTemplate with TemplateBinding, data and multi triggers, and the theme fallback."
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MutedBrush}"
                     MaxWidth="980" />
      </StackPanel>

      <Border x:Name="CardExplicitStyles">
        <StackPanel Spacing="10">
          <TextBlock Text="Explicit styles and BasedOn" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="Both tiles use a keyed style; the second inherits every setter from the first and overrides three."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="14">
            <Border Width="300" Height="86" Style="{StaticResource BaseCard}">
              <StackPanel Spacing="4">
                <TextBlock Text="BaseCard" Font="{x:Static app:GalleryTypography.CardTitle}" />
                <TextBlock Text="Field background, 8px corners." Foreground="{DynamicResource MutedBrush}" />
              </StackPanel>
            </Border>
            <Border Width="300" Height="86" Style="{StaticResource ElevatedCard}">
              <StackPanel Spacing="4">
                <TextBlock Text="ElevatedCard : BaseCard" Font="{x:Static app:GalleryTypography.CardTitle}" />
                <TextBlock Text="Overrides background, border and radius." Foreground="{DynamicResource MutedBrush}" />
              </StackPanel>
            </Border>
            <Border Width="300" Height="86" Style="{StaticResource LiftCard}">
              <StackPanel Spacing="4">
                <TextBlock Text="LiftCard" Font="{x:Static app:GalleryTypography.CardTitle}" />
                <TextBlock Text="Hover rounds the corners via a style trigger." Foreground="{DynamicResource MutedBrush}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="CardControlTemplate">
        <StackPanel Spacing="10">
          <TextBlock Text="ControlTemplate, TemplateBinding and template triggers" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="GalleryBadge has generated dependency properties; the template binds them and a trigger repaints a named part."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="14">
            <demo:GalleryBadge x:Name="badge" Style="{StaticResource BadgeStyle}" Label="Templated badge" />
            <StackPanel Spacing="10" VerticalAlignment="Center">
              <ToggleButton Content="IsHot" Height="34" Width="150" IsChecked="{Binding ElementName=badge, Path=IsHot, Mode=TwoWay}" />
              <ToggleButton Content="IsPinned" Height="34" Width="150" IsChecked="{Binding ElementName=badge, Path=IsPinned, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="{Binding ElementName=badge, Path=Note, StringFormat='Note: {0}'}" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="The note comes from the style's data and multi triggers." Foreground="{DynamicResource MutedBrush}" Font="{x:Static app:GalleryTypography.Caption}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="CardDataMultiTrigger">
        <StackPanel Spacing="10">
          <TextBlock Text="DataTrigger and MultiTrigger" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="Clear the name to satisfy the data condition; turn on both toggles to satisfy the multi condition."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBox x:Name="nameDriver" Width="300" Height="34" Text="{Binding OptionalName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Clear" Height="34" Click="OnClearClick" />
            <Button Content="Restore" Height="34" Click="OnRestoreClick" />
          </StackPanel>
          <TextBlock Text="The badge above reacts to both triggers; its note is the visible result." Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>
      </Border>

      <Border x:Name="CardThemeFallback">
        <StackPanel Spacing="10">
          <TextBlock Text="Theme fallback" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="These controls set no colours. ThemeStyles supplies surface, border, foreground and corner radius from the active palette."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="14">
            <Button Content="Theme button" Height="34" />
            <ToggleButton Content="Theme toggle" Height="34" />
            <TextBox Width="240" Height="34" PlaceholderText="Theme text box" />
            <ComboBox Width="180" Height="34" ItemsSource="{Binding Rows}" DisplayMemberPath="Name" />
            <ProgressBar Width="180" Height="20" Minimum="0" Maximum="100" Value="55" />
          </StackPanel>
          <Border x:Name="localOverride" Width="360" Height="76" HorizontalAlignment="Left" Background="#FF123A2A" BorderBrush="#FF3DD68C" BorderThickness="1" CornerRadius="8" Padding="14">
            <TextBlock Text="A local value beats the theme fallback." VerticalAlignment="Center" />
          </Border>
        </StackPanel>
      </Border>

      <Border x:Name="CardPresenters">
        <StackPanel Spacing="10">
          <TextBlock Text="Presenters and headered items" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="ContentPresenter materializes a template for one object; HeaderedItemsControl adds a themed strip above generated items; Separator is a themed line."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="16">
            <ContentPresenter Width="220" Height="120"
                                Content="{Binding Rows[0]}"
                                ContentTemplate="{StaticResource ChipTemplate}" />
            <HeaderedItemsControl Width="360"
                                    Header="Headered items"
                                    ItemsSource="{Binding Rows}"
                                    ItemTemplate="{StaticResource ChipTemplate}">
              <HeaderedItemsControl.ItemsPanel>
                <StackPanel Spacing="4" />
              </HeaderedItemsControl.ItemsPanel>
            </HeaderedItemsControl>
            <Separator Width="2" Height="180" Orientation="Vertical" />
            <StackPanel Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="Separator" />
              <Separator Width="220" Height="1" />
              <TextBlock Text="Above is a horizontal separator." Foreground="{DynamicResource MutedBrush}" Font="{x:Static app:GalleryTypography.Caption}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollableControl>
</UserControl>
