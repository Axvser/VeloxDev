<v:UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="clr-namespace:VeloxDev.WinForms.Xaml;assembly=VeloxDev.WinForms"
    xmlns:app="clr-namespace:Demo.Views"
    xmlns:demo="clr-namespace:Demo"
    x:Class="Demo.Views.Sections.StylesSection">

  <v:UserControl.Resources>
    <v:ResourceDictionary>
      <v:Style x:Key="BaseCard" TargetType="v:Border">
        <v:Style.Setters>
          <v:Setter Property="Background" Value="{DynamicResource FieldBrush}" />
          <v:Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
          <v:Setter Property="BorderThickness" Value="1" />
          <v:Setter Property="CornerRadius" Value="8" />
          <v:Setter Property="Padding" Value="14" />
        </v:Style.Setters>
      </v:Style>

      <v:Style x:Key="ElevatedCard" TargetType="v:Border" BasedOn="{StaticResource BaseCard}">
        <v:Style.Setters>
          <v:Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
          <v:Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
          <v:Setter Property="CornerRadius" Value="14" />
        </v:Style.Setters>
      </v:Style>

      <v:Style x:Key="LiftCard" TargetType="v:Border">
        <v:Style.Setters>
          <v:Setter Property="Background" Value="{DynamicResource FieldBrush}" />
          <v:Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
          <v:Setter Property="BorderThickness" Value="1" />
          <v:Setter Property="CornerRadius" Value="8" />
          <v:Setter Property="Padding" Value="14" />
        </v:Style.Setters>
        <v:Style.Triggers>
          <v:Trigger Property="IsPointerOver" Value="True">
            <v:Trigger.Setters>
              <v:Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </v:Trigger.Setters>
            <v:Trigger.EnterAction>
              <v:TransitionAction Property="CornerRadius" To="18" Duration="0:0:0.18" Ease="CubicOut" />
            </v:Trigger.EnterAction>
            <v:Trigger.ExitAction>
              <v:TransitionAction Property="CornerRadius" To="8" Duration="0:0:0.18" Ease="CubicOut" />
            </v:Trigger.ExitAction>
          </v:Trigger>
        </v:Style.Triggers>
      </v:Style>

      <v:ControlTemplate x:Key="BadgeTemplate" TargetType="demo:GalleryBadge">
        <v:Border x:Name="PART_Chrome"
                  Padding="14,10"
                  BorderThickness="1"
                  CornerRadius="8"
                  Background="{DynamicResource FieldBrush}"
                  BorderBrush="{DynamicResource BorderBrush}">
          <v:StackPanel Spacing="4">
            <v:TextBlock x:Name="PART_Label"
                         Text="{TemplateBinding Label}"
                         Font="{x:Static app:GalleryTypography.CardTitle}" />
            <v:TextBlock Text="{TemplateBinding Note}" Foreground="{DynamicResource MutedBrush}" />
          </v:StackPanel>
        </v:Border>
        <v:ControlTemplate.Triggers>
          <v:Trigger Property="IsHot" Value="True">
            <v:Trigger.Setters>
              <v:Setter TargetName="PART_Chrome" TargetType="v:Border" Property="BorderBrush" Value="#FF5B8CFF" />
              <v:Setter TargetName="PART_Label" TargetType="v:TextBlock" Property="Foreground" Value="#FF5B8CFF" />
            </v:Trigger.Setters>
          </v:Trigger>
        </v:ControlTemplate.Triggers>
      </v:ControlTemplate>

      <v:Style x:Key="BadgeStyle" TargetType="demo:GalleryBadge" Template="{StaticResource BadgeTemplate}">
        <v:Style.Setters>
          <v:Setter Property="Width" Value="360" />
          <v:Setter Property="Height" Value="84" />
          <v:Setter Property="Note" Value="idle" />
        </v:Style.Setters>
        <v:Style.Triggers>
          <v:DataTrigger Binding="{Binding OptionalName}" Value="">
            <v:DataTrigger.Setters>
              <v:Setter Property="Note" Value="empty optional name" />
            </v:DataTrigger.Setters>
          </v:DataTrigger>
          <v:MultiTrigger>
            <v:MultiTrigger.Conditions>
              <v:Condition Property="IsHot" Value="True" />
              <v:Condition Property="IsPinned" Value="True" />
            </v:MultiTrigger.Conditions>
            <v:MultiTrigger.Setters>
              <v:Setter Property="Note" Value="hot + pinned" />
            </v:MultiTrigger.Setters>
          </v:MultiTrigger>
        </v:Style.Triggers>
      </v:Style>

      <v:DataTemplate x:Key="ChipTemplate">
        <v:Border Height="28" Padding="8,0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}">
          <v:TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
        </v:Border>
      </v:DataTemplate>
    </v:ResourceDictionary>
  </v:UserControl.Resources>

  <v:ScrollableControl Dock="Fill" Background="{DynamicResource WindowBrush}">
    <v:StackPanel Dock="Top" Spacing="16" Padding="4,4,20,28">

      <v:StackPanel Spacing="6">
        <v:TextBlock Text="08 · Styles" Font="{x:Static app:GalleryTypography.Mono}" Foreground="{DynamicResource AccentBrush}" />
        <v:TextBlock Text="Styles, templates and triggers" Font="{x:Static app:GalleryTypography.SectionTitle}" />
        <v:TextBlock Text="Explicit and implicit styles, BasedOn, ControlTemplate with TemplateBinding, data and multi triggers, and the theme fallback."
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MutedBrush}"
                     MaxWidth="980" />
      </v:StackPanel>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="Explicit styles and BasedOn" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="Both tiles use a keyed style; the second inherits every setter from the first and overrides three."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <v:StackPanel Orientation="Horizontal" Spacing="14">
            <v:Border Width="300" Height="86" Style="{StaticResource BaseCard}">
              <v:StackPanel Spacing="4">
                <v:TextBlock Text="BaseCard" Font="{x:Static app:GalleryTypography.CardTitle}" />
                <v:TextBlock Text="Field background, 8px corners." Foreground="{DynamicResource MutedBrush}" />
              </v:StackPanel>
            </v:Border>
            <v:Border Width="300" Height="86" Style="{StaticResource ElevatedCard}">
              <v:StackPanel Spacing="4">
                <v:TextBlock Text="ElevatedCard : BaseCard" Font="{x:Static app:GalleryTypography.CardTitle}" />
                <v:TextBlock Text="Overrides background, border and radius." Foreground="{DynamicResource MutedBrush}" />
              </v:StackPanel>
            </v:Border>
            <v:Border Width="300" Height="86" Style="{StaticResource LiftCard}">
              <v:StackPanel Spacing="4">
                <v:TextBlock Text="LiftCard" Font="{x:Static app:GalleryTypography.CardTitle}" />
                <v:TextBlock Text="Hover rounds the corners via a style trigger." Foreground="{DynamicResource MutedBrush}" />
              </v:StackPanel>
            </v:Border>
          </v:StackPanel>
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="ControlTemplate, TemplateBinding and template triggers" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="GalleryBadge has generated dependency properties; the template binds them and a trigger repaints a named part."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <v:StackPanel Orientation="Horizontal" Spacing="14">
            <demo:GalleryBadge x:Name="badge" Style="{StaticResource BadgeStyle}" Label="Templated badge" />
            <v:StackPanel Spacing="10" VerticalAlignment="Center">
              <v:ToggleButton Content="IsHot" Height="34" Width="150" IsChecked="{Binding ElementName=badge, Path=IsHot, Mode=TwoWay}" />
              <v:ToggleButton Content="IsPinned" Height="34" Width="150" IsChecked="{Binding ElementName=badge, Path=IsPinned, Mode=TwoWay}" />
            </v:StackPanel>
            <v:StackPanel Spacing="6" VerticalAlignment="Center">
              <v:TextBlock Text="{Binding ElementName=badge, Path=Note, StringFormat='Note: {0}'}" Foreground="{DynamicResource AccentBrush}" />
              <v:TextBlock Text="The note comes from the style's data and multi triggers." Foreground="{DynamicResource MutedBrush}" Font="{x:Static app:GalleryTypography.Caption}" />
            </v:StackPanel>
          </v:StackPanel>
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="DataTrigger and MultiTrigger" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="Clear the name to satisfy the data condition; turn on both toggles to satisfy the multi condition."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <v:StackPanel Orientation="Horizontal" Spacing="12">
            <v:TextBox x:Name="nameDriver" Width="300" Height="34" Text="{Binding OptionalName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <v:Button Content="Clear" Height="34" Click="OnClearClick" />
            <v:Button Content="Restore" Height="34" Click="OnRestoreClick" />
          </v:StackPanel>
          <v:TextBlock Text="The badge above reacts to both triggers; its note is the visible result." Foreground="{DynamicResource MutedBrush}" />
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="Theme fallback" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="These controls set no colours. ThemeStyles supplies surface, border, foreground and corner radius from the active palette."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <v:StackPanel Orientation="Horizontal" Spacing="14">
            <v:Button Content="Theme button" Height="34" />
            <v:ToggleButton Content="Theme toggle" Height="34" />
            <v:TextBox Width="240" Height="34" PlaceholderText="Theme text box" />
            <v:ComboBox Width="180" Height="34" ItemsSource="{Binding Rows}" DisplayMemberPath="Name" />
            <v:ProgressBar Width="180" Height="20" Minimum="0" Maximum="100" Value="55" />
          </v:StackPanel>
          <v:Border x:Name="localOverride" Width="360" Height="76" HorizontalAlignment="Left" Background="#FF123A2A" BorderBrush="#FF3DD68C" BorderThickness="1" CornerRadius="8" Padding="14">
            <v:TextBlock Text="A local value beats the theme fallback." VerticalAlignment="Center" />
          </v:Border>
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="Presenters and headered items" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="ContentPresenter materializes a template for one object; HeaderedItemsControl adds a themed strip above generated items; Separator is a themed line."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <v:StackPanel Orientation="Horizontal" Spacing="16">
            <v:ContentPresenter Width="220" Height="120"
                                Content="{Binding Rows[0]}"
                                ContentTemplate="{StaticResource ChipTemplate}" />
            <v:HeaderedItemsControl Width="360"
                                    Header="Headered items"
                                    ItemsSource="{Binding Rows}"
                                    ItemTemplate="{StaticResource ChipTemplate}">
              <v:HeaderedItemsControl.ItemsPanel>
                <v:StackPanel Spacing="4" />
              </v:HeaderedItemsControl.ItemsPanel>
            </v:HeaderedItemsControl>
            <v:Separator Width="2" Height="180" Orientation="Vertical" />
            <v:StackPanel Spacing="10" VerticalAlignment="Center">
              <v:TextBlock Text="Separator" />
              <v:Separator Width="220" Height="1" />
              <v:TextBlock Text="Above is a horizontal separator." Foreground="{DynamicResource MutedBrush}" Font="{x:Static app:GalleryTypography.Caption}" />
            </v:StackPanel>
          </v:StackPanel>
        </v:StackPanel>
      </v:Border>

    </v:StackPanel>
  </v:ScrollableControl>
</v:UserControl>
