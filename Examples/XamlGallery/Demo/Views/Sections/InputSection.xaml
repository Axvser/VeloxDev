<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:Demo.Views"
    x:Class="Demo.Views.Sections.InputSection">

  <ScrollableControl Dock="Fill" Background="{DynamicResource WindowBrush}">
    <StackPanel Dock="Top" Spacing="16" Padding="4,4,20,28">

      <StackPanel Spacing="6">
        <TextBlock Text="04 · Input" Font="{x:Static app:GalleryTypography.Mono}" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="Commands, ranges and chrome" Font="{x:Static app:GalleryTypography.SectionTitle}" />
        <TextBlock Text="Buttons and toggles, keyboard and mouse gestures, ranges, menus, status bars, tooltips and a popup."
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MutedBrush}"
                     MaxWidth="980" />
      </StackPanel>

      <Border x:Name="CardButtons">
        <StackPanel Spacing="10">
          <TextBlock Text="Buttons, toggles and commands" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="Command drives IsEnabled through CanExecuteChanged; each button paints its own hover and press states."
                       Foreground="{DynamicResource MutedBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Save" Command="{Binding SaveCommand}" Height="34" />
            <RepeatButton Content="Repeat" Height="34" />
            <ToggleButton Content="Toggle" Height="34" />
            <CheckBox Content="Check" Height="34" Background="{DynamicResource CardBrush}" />
            <RadioButton Content="Radio" GroupName="gallery" Height="34" Background="{DynamicResource CardBrush}" />
            <Button Content="Disabled" Height="34" IsEnabled="False" />
          </StackPanel>
          <TextBlock Text="{Binding SaveCount, StringFormat='Save count: {0}'}" Foreground="{DynamicResource AccentBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="keyButton" Content="Press F5" Height="34">
              <Button.InputBindings>
                <KeyBinding Key="F5" Command="{Binding SaveCommand}" />
              </Button.InputBindings>
            </Button>
            <Button x:Name="mouseButton" Content="Double-click Ctrl+S" Height="34">
              <Button.InputBindings>
                <MouseBinding Action="LeftDoubleClick" Modifiers="Control" Command="{Binding SaveCommand}" />
              </Button.InputBindings>
            </Button>
            <TextBlock Text="Focus a button, then use its gesture." VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="CardRanges">
        <StackPanel Spacing="10">
          <TextBlock Text="Ranges" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="Slider, ProgressBar and ScrollBar share value clamping and theme brushes." Foreground="{DynamicResource MutedBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="20">
            <StackPanel Spacing="6" Width="280">
              <TextBlock Text="Slider" Font="{x:Static app:GalleryTypography.Caption}" Foreground="{DynamicResource MutedBrush}" />
              <Slider Height="34" Minimum="0" Maximum="100" Value="42" />
            </StackPanel>
            <StackPanel Spacing="6" Width="280">
              <TextBlock Text="ProgressBar" Font="{x:Static app:GalleryTypography.Caption}" Foreground="{DynamicResource MutedBrush}" />
              <ProgressBar Height="22" Minimum="0" Maximum="100" Value="64" />
            </StackPanel>
            <StackPanel Spacing="6" Width="280">
              <TextBlock Text="ScrollBar" Font="{x:Static app:GalleryTypography.Caption}" Foreground="{DynamicResource MutedBrush}" />
              <ScrollBar Height="22" Orientation="Horizontal" Minimum="0" Maximum="100" Value="30" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="CardMenusToolbars">
        <StackPanel Spacing="10">
          <TextBlock Text="Menus, toolbars and status bars" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="Declarative wrappers around the native menu, tool strip and status strip." Foreground="{DynamicResource MutedBrush}" />
          <Menu Height="30">
            <MenuItem Header="File">
              <MenuItem Header="New" />
              <MenuItem Header="Open" />
              <MenuItem Header="Exit" />
            </MenuItem>
            <MenuItem Header="Edit">
              <MenuItem Header="Copy" />
              <MenuItem Header="Paste" />
            </MenuItem>
            <MenuItem Header="Help" />
          </Menu>
          <ToolBar Height="40">
            <ToolBar.Items>
              <Button Content="New" Height="30" />
              <Button Content="Open" Height="30" />
              <Button Content="Save" Height="30" />
            </ToolBar.Items>
          </ToolBar>
          <StatusBar Height="28">
            <StatusBar.Items>
              <StatusBarItem Content="Ready" />
              <StatusBarItem IsSeparator="True" />
              <StatusBarItem Content="XAML runtime" />
            </StatusBar.Items>
          </StatusBar>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Hover for a tooltip" ToolTip="A declarative tooltip" Height="34" />
            <Button Content="Right-click for a menu" Height="34">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Copy" />
                  <MenuItem Header="Duplicate" />
                  <MenuItem Header="Delete" />
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <TextBlock Text="ToolTipService below" ToolTipService.ToolTip="Attached to any control" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="CardPointerKeyboard">
        <StackPanel Spacing="10">
          <TextBlock Text="Pointer and keyboard input" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="The XAML pointer and key events bubble from the control under the pointer."
                       Foreground="{DynamicResource MutedBrush}" />
          <Border x:Name="inputPad"
                    Height="110"
                    Padding="0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="{DynamicResource FieldBrush}"
                    Focusable="True"
                    PointerEntered="OnPadPointerEntered"
                    PointerMoved="OnPadPointerMoved"
                    PointerExited="OnPadPointerExited"
                    KeyInputDown="OnPadKeyDown">
            <TextBlock x:Name="inputReadout"
                         Text="Move the pointer here, click to focus, then press a key."
                         TextAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource MutedBrush}" />
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="popupButton" Content="Open popup" Height="34" Click="OnPopupClick" />
            <TextBlock Text="The popup is a borderless top-level window." VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
          </StackPanel>
          <Popup x:Name="popup" IsOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=popupButton}" VerticalOffset="6">
            <Popup.Child>
              <Border Width="260" Height="96" Padding="16" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <TextBlock Text="Popup content lives in its own borderless Form and is detached while closed." TextWrapping="Wrap" />
              </Border>
            </Popup.Child>
          </Popup>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollableControl>
</UserControl>
