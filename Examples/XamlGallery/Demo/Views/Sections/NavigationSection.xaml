<v:UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="clr-namespace:VeloxDev.WinForms.Xaml;assembly=VeloxDev.WinForms"
    xmlns:app="clr-namespace:Demo.Views"
    x:Class="Demo.Views.Sections.NavigationSection">

  <v:ScrollableControl Dock="Fill" Background="{DynamicResource WindowBrush}">
    <v:StackPanel Dock="Top" Spacing="16" Padding="4,4,20,28">

      <v:StackPanel Spacing="6">
        <v:TextBlock Text="10 · Navigation" Font="{x:Static app:GalleryTypography.Mono}" Foreground="{DynamicResource AccentBrush}" />
        <v:TextBlock Text="Frames and detached windows" Font="{x:Static app:GalleryTypography.SectionTitle}" />
        <v:TextBlock Text="A Frame keeps a page journal; Window and NavigationWindow host content in their own borderless forms."
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MutedBrush}"
                     MaxWidth="980" />
      </v:StackPanel>

      <v:Border>
        <v:StackPanel Spacing="12">
          <v:TextBlock Text="Frame and Page journal" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="Navigate pushes a page; Back and Forward walk the journal without rebuilding the pages."
                       Foreground="{DynamicResource MutedBrush}" />
          <v:StackPanel Orientation="Horizontal" Spacing="10">
            <v:Button Content="Back" Height="34" Click="OnBackClick" />
            <v:Button Content="Forward" Height="34" Click="OnForwardClick" />
            <v:Button Content="Open Window" Height="34" Click="OnOpenWindowClick" />
            <v:Button Content="Open NavigationWindow" Height="34" Click="OnOpenNavigationWindowClick" />
          </v:StackPanel>
          <v:Frame x:Name="frame" Height="330" />
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="NavigationWindow" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="NavigationWindow forwards the same journal to a hosted Frame and adds Back/Forward chrome; the detached Window hosts arbitrary XAML content."
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
          <v:TextBlock Text="Both windows are real top-level Forms; closing one detaches its content so it can be shown again."
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
        </v:StackPanel>
      </v:Border>

    </v:StackPanel>
  </v:ScrollableControl>
</v:UserControl>
