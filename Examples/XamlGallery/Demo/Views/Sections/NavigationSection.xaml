<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:Demo.Views"
    x:Class="Demo.Views.Sections.NavigationSection">

  <ScrollableControl Dock="Fill" Background="{DynamicResource WindowBrush}">
    <StackPanel Dock="Top" Spacing="16" Padding="4,4,20,28">

      <StackPanel Spacing="6">
        <TextBlock Text="10 · Navigation" Font="{x:Static app:GalleryTypography.Mono}" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="Frames and detached windows" Font="{x:Static app:GalleryTypography.SectionTitle}" />
        <TextBlock Text="A Frame keeps a page journal; Window and NavigationWindow host content in their own borderless forms."
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MutedBrush}"
                     MaxWidth="980" />
      </StackPanel>

      <Border x:Name="CardFrameJournal">
        <StackPanel Spacing="12">
          <TextBlock Text="Frame and Page journal" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="Navigate pushes a page; Back and Forward walk the journal without rebuilding the pages."
                       Foreground="{DynamicResource MutedBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Back" Height="34" Click="OnBackClick" />
            <Button Content="Forward" Height="34" Click="OnForwardClick" />
            <Button Content="Open Window" Height="34" Click="OnOpenWindowClick" />
            <Button Content="Open NavigationWindow" Height="34" Click="OnOpenNavigationWindowClick" />
          </StackPanel>
          <Frame x:Name="frame" Height="330" />
        </StackPanel>
      </Border>

      <Border x:Name="CardNavigationWindow">
        <StackPanel Spacing="10">
          <TextBlock Text="NavigationWindow" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="NavigationWindow forwards the same journal to a hosted Frame and adds Back/Forward chrome; the detached Window hosts arbitrary XAML content."
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
          <TextBlock Text="Both windows are real top-level Forms; closing one detaches its content so it can be shown again."
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollableControl>
</UserControl>
