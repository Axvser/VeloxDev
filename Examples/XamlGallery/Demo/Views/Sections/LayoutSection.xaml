<v:UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="clr-namespace:VeloxDev.WinForms.Xaml;assembly=VeloxDev.WinForms"
    xmlns:app="clr-namespace:Demo.Views"
    x:Class="Demo.Views.Sections.LayoutSection">

  <v:ScrollableControl Dock="Fill" Background="{DynamicResource WindowBrush}">
    <v:StackPanel Dock="Top" Spacing="16" Padding="4,4,20,28">

      <v:StackPanel Spacing="6">
        <v:TextBlock Text="01 · Layout" Font="{x:Static app:GalleryTypography.Mono}" Foreground="{DynamicResource AccentBrush}" />
        <v:TextBlock Text="Panels, tracks and containers" Font="{x:Static app:GalleryTypography.SectionTitle}" />
        <v:TextBlock Text="Stack, dock and wrap tracks, grids, uniform cells, canvas coordinates, splitters, viewbox scaling and the chrome containers."
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MutedBrush}"
                     MaxWidth="980" />
      </v:StackPanel>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="StackPanel" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="Children stack along one axis with an explicit gap; the cross axis stretches."
                       Foreground="{DynamicResource MutedBrush}" />
          <v:StackPanel Orientation="Horizontal" Height="58" Spacing="10">
            <v:Border Width="104" Height="48" Padding="0" BorderThickness="0" Background="{DynamicResource AccentSoftBrush}">
              <v:TextBlock Text="One" TextAlignment="Center" VerticalAlignment="Center" />
            </v:Border>
            <v:Border Width="104" Height="48" Padding="0" BorderThickness="0" Background="{DynamicResource FieldBrush}">
              <v:TextBlock Text="Two" TextAlignment="Center" VerticalAlignment="Center" />
            </v:Border>
            <v:Border Width="104" Height="48" Padding="0" BorderThickness="0" Background="{DynamicResource AccentGradient}">
              <v:TextBlock Text="Three" TextAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" />
            </v:Border>
            <v:Border Width="104" Height="48" Padding="0" BorderThickness="0" Background="{DynamicResource FieldBrush}">
              <v:TextBlock Text="Four" TextAlignment="Center" VerticalAlignment="Center" />
            </v:Border>
          </v:StackPanel>
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="DockPanel" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="Top, left and bottom edges claim their room; the last child fills what is left."
                       Foreground="{DynamicResource MutedBrush}" />
          <v:DockPanel Height="100" LastChildFill="True">
            <v:Border v:DockPanel.Dock="Top" Height="28" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}">
              <v:TextBlock Text="Dock.Top" TextAlignment="Center" VerticalAlignment="Center" />
            </v:Border>
            <v:Border v:DockPanel.Dock="Left" Width="112" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}">
              <v:TextBlock Text="Dock.Left" TextAlignment="Center" VerticalAlignment="Center" />
            </v:Border>
            <v:Border v:DockPanel.Dock="Bottom" Height="28" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}">
              <v:TextBlock Text="Dock.Bottom" TextAlignment="Center" VerticalAlignment="Center" />
            </v:Border>
            <v:Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentGradient}">
              <v:TextBlock Text="Last child fills" TextAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" />
            </v:Border>
          </v:DockPanel>
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="WrapPanel and UniformGrid" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="Wrap rows reflow by available width; uniform cells divide the same room evenly."
                       Foreground="{DynamicResource MutedBrush}" />
          <v:StackPanel Orientation="Horizontal" Height="102" Spacing="20">
            <v:WrapPanel Width="360" Height="102" ItemWidth="84" ItemHeight="30">
              <v:Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}"><v:TextBlock Text="A" TextAlignment="Center" VerticalAlignment="Center" /></v:Border>
              <v:Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}"><v:TextBlock Text="B" TextAlignment="Center" VerticalAlignment="Center" /></v:Border>
              <v:Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}"><v:TextBlock Text="C" TextAlignment="Center" VerticalAlignment="Center" /></v:Border>
              <v:Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}"><v:TextBlock Text="D" TextAlignment="Center" VerticalAlignment="Center" /></v:Border>
              <v:Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}"><v:TextBlock Text="E" TextAlignment="Center" VerticalAlignment="Center" /></v:Border>
              <v:Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}"><v:TextBlock Text="F" TextAlignment="Center" VerticalAlignment="Center" /></v:Border>
              <v:Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}"><v:TextBlock Text="G" TextAlignment="Center" VerticalAlignment="Center" /></v:Border>
              <v:Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}"><v:TextBlock Text="H" TextAlignment="Center" VerticalAlignment="Center" /></v:Border>
            </v:WrapPanel>
            <v:UniformGrid Width="360" Height="102" Rows="2" Columns="4">
              <v:Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}"><v:TextBlock Text="1" TextAlignment="Center" VerticalAlignment="Center" /></v:Border>
              <v:Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}"><v:TextBlock Text="2" TextAlignment="Center" VerticalAlignment="Center" /></v:Border>
              <v:Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}"><v:TextBlock Text="3" TextAlignment="Center" VerticalAlignment="Center" /></v:Border>
              <v:Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}"><v:TextBlock Text="4" TextAlignment="Center" VerticalAlignment="Center" /></v:Border>
              <v:Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}"><v:TextBlock Text="5" TextAlignment="Center" VerticalAlignment="Center" /></v:Border>
              <v:Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}"><v:TextBlock Text="6" TextAlignment="Center" VerticalAlignment="Center" /></v:Border>
              <v:Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}"><v:TextBlock Text="7" TextAlignment="Center" VerticalAlignment="Center" /></v:Border>
              <v:Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}"><v:TextBlock Text="8" TextAlignment="Center" VerticalAlignment="Center" /></v:Border>
            </v:UniformGrid>
          </v:StackPanel>
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="Grid and Canvas" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="Rows, columns and spans on the left; explicit left/top coordinates on the right."
                       Foreground="{DynamicResource MutedBrush}" />
          <v:StackPanel Orientation="Horizontal" Height="128" Spacing="20">
            <v:Grid Width="480" Height="128">
              <v:Grid.RowDefinitions>
                <v:RowDefinition Height="34" />
                <v:RowDefinition Height="*" />
                <v:RowDefinition Height="34" />
              </v:Grid.RowDefinitions>
              <v:Grid.ColumnDefinitions>
                <v:ColumnDefinition Width="*" />
                <v:ColumnDefinition Width="2*" />
              </v:Grid.ColumnDefinitions>
              <v:Border v:Grid.Row="0" v:Grid.Column="0" v:Grid.ColumnSpan="2" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}">
                <v:TextBlock Text="Row 0 · spans both columns" TextAlignment="Center" VerticalAlignment="Center" />
              </v:Border>
              <v:Border v:Grid.Row="1" v:Grid.Column="0" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}">
                <v:TextBlock Text="1*" TextAlignment="Center" VerticalAlignment="Center" />
              </v:Border>
              <v:Border v:Grid.Row="1" v:Grid.Column="1" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentGradient}">
                <v:TextBlock Text="2*" TextAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" />
              </v:Border>
              <v:Border v:Grid.Row="2" v:Grid.Column="0" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}">
                <v:TextBlock Text="Auto" TextAlignment="Center" VerticalAlignment="Center" />
              </v:Border>
              <v:Border v:Grid.Row="2" v:Grid.Column="1" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}">
                <v:TextBlock Text="Auto" TextAlignment="Center" VerticalAlignment="Center" />
              </v:Border>
            </v:Grid>
            <v:Canvas Width="320" Height="128">
              <v:Border v:Canvas.Left="0" v:Canvas.Top="0" Width="150" Height="54" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}">
                <v:TextBlock Text="Canvas 0,0" TextAlignment="Center" VerticalAlignment="Center" />
              </v:Border>
              <v:Border v:Canvas.Left="64" v:Canvas.Top="52" Width="180" Height="60" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentGradient}">
                <v:TextBlock Text="Canvas 64,52" TextAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" />
              </v:Border>
              <v:Border v:Canvas.Right="0" v:Canvas.Bottom="0" Width="110" Height="42" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}">
                <v:TextBlock Text="Right / Bottom" TextAlignment="Center" VerticalAlignment="Center" />
              </v:Border>
            </v:Canvas>
          </v:StackPanel>
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="GridSplitter and Viewbox" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="Drag the grip to resize siblings; a fixed composition scales into the available area."
                       Foreground="{DynamicResource MutedBrush}" />
          <v:StackPanel Orientation="Horizontal" Height="104" Spacing="20">
            <v:StackPanel Orientation="Horizontal" Width="400" Height="92" Spacing="8">
              <v:Border Width="160" MinWidth="80" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}">
                <v:TextBlock Text="Left pane" TextAlignment="Center" VerticalAlignment="Center" />
              </v:Border>
              <v:GridSplitter Width="12" Height="92" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
              <v:Border Width="190" MinWidth="80" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}">
                <v:TextBlock Text="Right pane" TextAlignment="Center" VerticalAlignment="Center" />
              </v:Border>
            </v:StackPanel>
            <v:Viewbox Width="420" Height="100" Stretch="Uniform">
              <v:StackPanel Orientation="Horizontal" Width="380" Height="88" Spacing="14" Padding="14" Background="{DynamicResource FieldBrush}">
                <v:Ellipse Width="60" Height="60" Fill="{DynamicResource AccentGradient}" />
                <v:StackPanel Spacing="4" VerticalAlignment="Center">
                  <v:TextBlock Text="Viewbox" Font="{x:Static app:GalleryTypography.CardTitle}" />
                  <v:TextBlock Text="Text and geometry share one scale." Foreground="{DynamicResource MutedBrush}" />
                </v:StackPanel>
              </v:StackPanel>
            </v:Viewbox>
          </v:StackPanel>
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="Chrome containers" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="GroupBox, Expander and a nested TabControl are XAML controls with themed chrome."
                       Foreground="{DynamicResource MutedBrush}" />
          <v:StackPanel Orientation="Horizontal" Height="176" Spacing="14">
            <v:GroupBox Width="250" Height="176" Header="GroupBox">
              <v:StackPanel Spacing="6" Padding="10" Background="{DynamicResource SurfaceBrush}">
                <v:TextBlock Text="A titled frame." />
                <v:TextBlock Text="Children keep their own layout." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
              </v:StackPanel>
            </v:GroupBox>
            <v:Expander Width="270" Height="176" Header="Expander" IsExpanded="True">
              <v:StackPanel Spacing="6" Padding="10" Background="{DynamicResource SurfaceBrush}">
                <v:TextBlock Text="Collapsible content." />
                <v:TextBlock Text="Click the header to fold it." Foreground="{DynamicResource MutedBrush}" />
              </v:StackPanel>
            </v:Expander>
            <v:TabControl Width="330" Height="176" Padding="10">
              <v:TabItem Header="First" Background="{DynamicResource SurfaceBrush}">
                <v:TextBlock Text="First tab body" Margin="8" />
              </v:TabItem>
              <v:TabItem Header="Second" Background="{DynamicResource SurfaceBrush}">
                <v:TextBlock Text="Second tab body" Margin="8" />
              </v:TabItem>
            </v:TabControl>
          </v:StackPanel>
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="Decorators" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="Decorator and AdornerDecorator pass the full area to their content; BulletDecorator pairs a glyph with a line of text."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <v:StackPanel Orientation="Horizontal" Height="120" Spacing="14">
            <v:Decorator Width="240" Height="110">
              <v:Border Padding="0" BorderThickness="0" CornerRadius="8" Background="{DynamicResource FieldBrush}">
                <v:TextBlock Text="Decorator" TextAlignment="Center" VerticalAlignment="Center" />
              </v:Border>
            </v:Decorator>
            <v:AdornerDecorator Width="240" Height="110">
              <v:Border Padding="0" BorderThickness="0" CornerRadius="8" Background="{DynamicResource FieldBrush}">
                <v:TextBlock Text="AdornerDecorator" TextAlignment="Center" VerticalAlignment="Center" />
              </v:Border>
            </v:AdornerDecorator>
            <v:BulletDecorator Width="320" Height="110">
              <v:BulletDecorator.Bullet>
                <v:Ellipse Width="16" Height="16" Fill="{DynamicResource AccentBrush}" />
              </v:BulletDecorator.Bullet>
              <v:BulletDecorator.Child>
                <v:TextBlock Text="BulletDecorator keeps the glyph aligned with the first line of its content."
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource MutedBrush}" />
              </v:BulletDecorator.Child>
            </v:BulletDecorator>
          </v:StackPanel>
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="ZIndex and RowSpan" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="Panel.ZIndex decides which canvas sibling paints in front; Grid.RowSpan lets one child cover two rows."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <v:StackPanel Orientation="Horizontal" Height="140" Spacing="24">
            <v:Canvas Width="300" Height="120">
              <v:Border v:Canvas.Left="0" v:Canvas.Top="0" Width="180" Height="76" Padding="0" BorderThickness="0" CornerRadius="8" Background="{DynamicResource FieldBrush}">
                <v:TextBlock Text="ZIndex 0" TextAlignment="Center" VerticalAlignment="Center" />
              </v:Border>
              <v:Border v:Canvas.Left="60" v:Canvas.Top="40" Width="180" Height="76" v:Panel.ZIndex="5" Padding="0" BorderThickness="0" CornerRadius="8" Background="{DynamicResource AccentGradient}">
                <v:TextBlock Text="ZIndex 5" TextAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" />
              </v:Border>
            </v:Canvas>
            <v:Grid Width="360" Height="120">
              <v:Grid.RowDefinitions>
                <v:RowDefinition Height="*" />
                <v:RowDefinition Height="*" />
              </v:Grid.RowDefinitions>
              <v:Grid.ColumnDefinitions>
                <v:ColumnDefinition Width="*" />
                <v:ColumnDefinition Width="*" />
              </v:Grid.ColumnDefinitions>
              <v:Border v:Grid.Row="0" v:Grid.Column="0" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}">
                <v:TextBlock Text="0,0" TextAlignment="Center" VerticalAlignment="Center" />
              </v:Border>
              <v:Border v:Grid.Row="0" v:Grid.Column="1" v:Grid.RowSpan="2" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}">
                <v:TextBlock Text="RowSpan 2" TextAlignment="Center" VerticalAlignment="Center" />
              </v:Border>
              <v:Border v:Grid.Row="1" v:Grid.Column="0" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}">
                <v:TextBlock Text="1,0" TextAlignment="Center" VerticalAlignment="Center" />
              </v:Border>
            </v:Grid>
          </v:StackPanel>
        </v:StackPanel>
      </v:Border>

    </v:StackPanel>
  </v:ScrollableControl>
</v:UserControl>
