<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:Demo.Views"
    x:Class="Demo.Views.Sections.LayoutSection">

  <ScrollableControl Dock="Fill" Background="{DynamicResource WindowBrush}">
    <StackPanel Dock="Top" Spacing="16" Padding="4,4,20,28">

      <StackPanel Spacing="6">
        <TextBlock Text="01 · Layout" Font="{x:Static app:GalleryTypography.Mono}" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="Panels, tracks and containers" Font="{x:Static app:GalleryTypography.SectionTitle}" />
        <TextBlock Text="Stack, dock and wrap tracks, grids, uniform cells, canvas coordinates, splitters, viewbox scaling and the chrome containers."
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MutedBrush}"
                     MaxWidth="980" />
      </StackPanel>

      <Border x:Name="CardStackPanel">
        <StackPanel Spacing="10">
          <TextBlock Text="StackPanel" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="Children stack along one axis with an explicit gap; the cross axis stretches."
                       Foreground="{DynamicResource MutedBrush}" />
          <StackPanel Orientation="Horizontal" Height="58" Spacing="10">
            <Border Width="104" Height="48" Padding="0" BorderThickness="0" Background="{DynamicResource AccentSoftBrush}">
              <TextBlock Text="One" TextAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Width="104" Height="48" Padding="0" BorderThickness="0" Background="{DynamicResource FieldBrush}">
              <TextBlock Text="Two" TextAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Width="104" Height="48" Padding="0" BorderThickness="0" Background="{DynamicResource AccentGradient}">
              <TextBlock Text="Three" TextAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" />
            </Border>
            <Border Width="104" Height="48" Padding="0" BorderThickness="0" Background="{DynamicResource FieldBrush}">
              <TextBlock Text="Four" TextAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="CardDockPanel">
        <StackPanel Spacing="10">
          <TextBlock Text="DockPanel" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="Top, left and bottom edges claim their room; the last child fills what is left."
                       Foreground="{DynamicResource MutedBrush}" />
          <DockPanel Height="100" LastChildFill="True">
            <Border DockPanel.Dock="Top" Height="28" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}">
              <TextBlock Text="Dock.Top" TextAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border DockPanel.Dock="Left" Width="112" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}">
              <TextBlock Text="Dock.Left" TextAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border DockPanel.Dock="Bottom" Height="28" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}">
              <TextBlock Text="Dock.Bottom" TextAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentGradient}">
              <TextBlock Text="Last child fills" TextAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" />
            </Border>
          </DockPanel>
        </StackPanel>
      </Border>

      <Border x:Name="CardWrapUniform">
        <StackPanel Spacing="10">
          <TextBlock Text="WrapPanel and UniformGrid" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="Wrap rows reflow by available width; uniform cells divide the same room evenly."
                       Foreground="{DynamicResource MutedBrush}" />
          <StackPanel Orientation="Horizontal" Height="102" Spacing="20">
            <WrapPanel Width="360" Height="102" ItemWidth="84" ItemHeight="30">
              <Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}"><TextBlock Text="A" TextAlignment="Center" VerticalAlignment="Center" /></Border>
              <Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}"><TextBlock Text="B" TextAlignment="Center" VerticalAlignment="Center" /></Border>
              <Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}"><TextBlock Text="C" TextAlignment="Center" VerticalAlignment="Center" /></Border>
              <Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}"><TextBlock Text="D" TextAlignment="Center" VerticalAlignment="Center" /></Border>
              <Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}"><TextBlock Text="E" TextAlignment="Center" VerticalAlignment="Center" /></Border>
              <Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}"><TextBlock Text="F" TextAlignment="Center" VerticalAlignment="Center" /></Border>
              <Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}"><TextBlock Text="G" TextAlignment="Center" VerticalAlignment="Center" /></Border>
              <Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}"><TextBlock Text="H" TextAlignment="Center" VerticalAlignment="Center" /></Border>
            </WrapPanel>
            <UniformGrid Width="360" Height="102" Rows="2" Columns="4">
              <Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}"><TextBlock Text="1" TextAlignment="Center" VerticalAlignment="Center" /></Border>
              <Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}"><TextBlock Text="2" TextAlignment="Center" VerticalAlignment="Center" /></Border>
              <Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}"><TextBlock Text="3" TextAlignment="Center" VerticalAlignment="Center" /></Border>
              <Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}"><TextBlock Text="4" TextAlignment="Center" VerticalAlignment="Center" /></Border>
              <Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}"><TextBlock Text="5" TextAlignment="Center" VerticalAlignment="Center" /></Border>
              <Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}"><TextBlock Text="6" TextAlignment="Center" VerticalAlignment="Center" /></Border>
              <Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}"><TextBlock Text="7" TextAlignment="Center" VerticalAlignment="Center" /></Border>
              <Border Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}"><TextBlock Text="8" TextAlignment="Center" VerticalAlignment="Center" /></Border>
            </UniformGrid>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="CardGridCanvas">
        <StackPanel Spacing="10">
          <TextBlock Text="Grid and Canvas" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="Rows, columns and spans on the left; explicit left/top coordinates on the right."
                       Foreground="{DynamicResource MutedBrush}" />
          <StackPanel Orientation="Horizontal" Height="128" Spacing="20">
            <Grid Width="480" Height="128">
              <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}">
                <TextBlock Text="Row 0 · spans both columns" TextAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Border Grid.Row="1" Grid.Column="0" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}">
                <TextBlock Text="1*" TextAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Border Grid.Row="1" Grid.Column="1" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentGradient}">
                <TextBlock Text="2*" TextAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" />
              </Border>
              <Border Grid.Row="2" Grid.Column="0" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}">
                <TextBlock Text="Auto" TextAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Border Grid.Row="2" Grid.Column="1" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}">
                <TextBlock Text="Auto" TextAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
            <Canvas Width="320" Height="128">
              <Border Canvas.Left="0" Canvas.Top="0" Width="150" Height="54" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}">
                <TextBlock Text="Canvas 0,0" TextAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Border Canvas.Left="64" Canvas.Top="52" Width="180" Height="60" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentGradient}">
                <TextBlock Text="Canvas 64,52" TextAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" />
              </Border>
              <Border Canvas.Right="0" Canvas.Bottom="0" Width="110" Height="42" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}">
                <TextBlock Text="Right / Bottom" TextAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Canvas>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="CardSplitterViewbox">
        <StackPanel Spacing="10">
          <TextBlock Text="GridSplitter and Viewbox" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="Drag the grip to resize siblings; a fixed composition scales into the available area."
                       Foreground="{DynamicResource MutedBrush}" />
          <StackPanel Orientation="Horizontal" Height="104" Spacing="20">
            <StackPanel Orientation="Horizontal" Width="400" Height="92" Spacing="8">
              <Border Width="160" MinWidth="80" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}">
                <TextBlock Text="Left pane" TextAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <GridSplitter Width="12" Height="92" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
              <Border Width="190" MinWidth="80" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}">
                <TextBlock Text="Right pane" TextAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
            <Viewbox Width="420" Height="100" Stretch="Uniform">
              <StackPanel Orientation="Horizontal" Width="380" Height="88" Spacing="14" Padding="14" Background="{DynamicResource FieldBrush}">
                <Ellipse Width="60" Height="60" Fill="{DynamicResource AccentGradient}" />
                <StackPanel Spacing="4" VerticalAlignment="Center">
                  <TextBlock Text="Viewbox" Font="{x:Static app:GalleryTypography.CardTitle}" />
                  <TextBlock Text="Text and geometry share one scale." Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
              </StackPanel>
            </Viewbox>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="CardChrome">
        <StackPanel Spacing="10">
          <TextBlock Text="Chrome containers" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="GroupBox, Expander and a nested TabControl are XAML controls with themed chrome."
                       Foreground="{DynamicResource MutedBrush}" />
          <StackPanel Orientation="Horizontal" Height="176" Spacing="14">
            <GroupBox Width="250" Height="176" Header="GroupBox">
              <StackPanel Spacing="6" Padding="10" Background="{DynamicResource SurfaceBrush}">
                <TextBlock Text="A titled frame." />
                <TextBlock Text="Children keep their own layout." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </GroupBox>
            <Expander Width="270" Height="176" Header="Expander" IsExpanded="True">
              <StackPanel Spacing="6" Padding="10" Background="{DynamicResource SurfaceBrush}">
                <TextBlock Text="Collapsible content." />
                <TextBlock Text="Click the header to fold it." Foreground="{DynamicResource MutedBrush}" />
              </StackPanel>
            </Expander>
            <TabControl Width="330" Height="176" Padding="10">
              <TabItem Header="First" Background="{DynamicResource SurfaceBrush}">
                <TextBlock Text="First tab body" Margin="8" />
              </TabItem>
              <TabItem Header="Second" Background="{DynamicResource SurfaceBrush}">
                <TextBlock Text="Second tab body" Margin="8" />
              </TabItem>
            </TabControl>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="CardDecorators">
        <StackPanel Spacing="10">
          <TextBlock Text="Decorators" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="Decorator and AdornerDecorator pass the full area to their content; BulletDecorator pairs a glyph with a line of text."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Height="120" Spacing="14">
            <Decorator Width="240" Height="110">
              <Border Padding="0" BorderThickness="0" CornerRadius="8" Background="{DynamicResource FieldBrush}">
                <TextBlock Text="Decorator" TextAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Decorator>
            <AdornerDecorator Width="240" Height="110">
              <Border Padding="0" BorderThickness="0" CornerRadius="8" Background="{DynamicResource FieldBrush}">
                <TextBlock Text="AdornerDecorator" TextAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </AdornerDecorator>
            <BulletDecorator Width="320" Height="110">
              <BulletDecorator.Bullet>
                <Ellipse Width="16" Height="16" Fill="{DynamicResource AccentBrush}" />
              </BulletDecorator.Bullet>
              <BulletDecorator.Child>
                <TextBlock Text="BulletDecorator keeps the glyph aligned with the first line of its content."
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource MutedBrush}" />
              </BulletDecorator.Child>
            </BulletDecorator>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="CardZIndexRowSpan">
        <StackPanel Spacing="10">
          <TextBlock Text="ZIndex and RowSpan" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="Panel.ZIndex decides which canvas sibling paints in front; Grid.RowSpan lets one child cover two rows."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Height="140" Spacing="24">
            <Canvas Width="300" Height="120">
              <Border Canvas.Left="0" Canvas.Top="0" Width="180" Height="76" Padding="0" BorderThickness="0" CornerRadius="8" Background="{DynamicResource FieldBrush}">
                <TextBlock Text="ZIndex 0" TextAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Border Canvas.Left="60" Canvas.Top="40" Width="180" Height="76" Panel.ZIndex="5" Padding="0" BorderThickness="0" CornerRadius="8" Background="{DynamicResource AccentGradient}">
                <TextBlock Text="ZIndex 5" TextAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" />
              </Border>
            </Canvas>
            <Grid Width="360" Height="120">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Row="0" Grid.Column="0" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}">
                <TextBlock Text="0,0" TextAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}">
                <TextBlock Text="RowSpan 2" TextAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Border Grid.Row="1" Grid.Column="0" Padding="0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}">
                <TextBlock Text="1,0" TextAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollableControl>
</UserControl>
