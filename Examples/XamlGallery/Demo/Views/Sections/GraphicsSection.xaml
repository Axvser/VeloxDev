<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:Demo.Views"
    xmlns:local="clr-namespace:Demo.Views.Sections"
    x:Class="Demo.Views.Sections.GraphicsSection">

  <UserControl.Resources>
    <ResourceDictionary>
      <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <LinearGradientBrush.GradientStops>
          <GradientStop Color="#FF5B8CFF" Offset="0" />
          <GradientStop Color="#FF9B6BFF" Offset="1" />
        </LinearGradientBrush.GradientStops>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="WarmGradient" StartPoint="0,1" EndPoint="1,0">
        <LinearGradientBrush.GradientStops>
          <GradientStop Color="#FFF2B44B" Offset="0" />
          <GradientStop Color="#FFFF6B6B" Offset="1" />
        </LinearGradientBrush.GradientStops>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="CoolGradient" StartPoint="0,0" EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
          <GradientStop Color="#FF3DD68C" Offset="0" />
          <GradientStop Color="#FF2A9D8F" Offset="1" />
        </LinearGradientBrush.GradientStops>
      </LinearGradientBrush>
    </ResourceDictionary>
  </UserControl.Resources>

  <ScrollableControl Dock="Fill" Background="{DynamicResource WindowBrush}">
    <StackPanel Dock="Top" Spacing="16" Padding="4,4,20,28">

      <StackPanel Spacing="6">
        <TextBlock Text="05 · Graphics" Font="{x:Static app:GalleryTypography.Mono}" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="Shapes, brushes and geometry" Font="{x:Static app:GalleryTypography.SectionTitle}" />
        <TextBlock Text="Vector primitives share one fill/stroke surface; gradients and bitmaps are first-class brushes and sources."
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MutedBrush}"
                     MaxWidth="980" />
      </StackPanel>

      <Border x:Name="CardShapes">
        <StackPanel Spacing="10">
          <TextBlock Text="Basic shapes" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="Rectangle, Ellipse, Line, Path, Polygon and Polyline." Foreground="{DynamicResource MutedBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="28">
            <Rectangle Width="96" Height="76" RadiusX="14" RadiusY="14" Fill="{DynamicResource AccentGradient}" />
            <Ellipse Width="96" Height="76" Fill="{DynamicResource CoolGradient}" />
            <Line Width="110" Height="84" X1="4" Y1="76" X2="106" Y2="8" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" />
            <Path Width="96" Height="84" Stretch="Uniform" Data="M 10 74 C 20 10, 70 10, 84 74 Z"
                    Fill="{DynamicResource AccentSoftBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" />
            <Polygon Width="96" Height="84" Points="{x:Static local:ShapePoints.Triangle}" Fill="{DynamicResource WarmGradient}" />
            <Polyline Width="110" Height="84" Points="{x:Static local:ShapePoints.ZigZag}" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" />
          </StackPanel>
          <TextBlock Text="The ellipse and rounded rectangle only differ by radius; the path uses a cubic curve and a fill rule."
                       Foreground="{DynamicResource MutedBrush}" Font="{x:Static app:GalleryTypography.Caption}" />
        </StackPanel>
      </Border>

      <Border x:Name="CardBrushesBitmap">
        <StackPanel Spacing="10">
          <TextBlock Text="Gradients and a bitmap" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="A LinearGradientBrush can paint borders, shapes and cards; Image draws a GDI+ bitmap."
                       Foreground="{DynamicResource MutedBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="20" Height="150">
            <Border Width="260" Height="140" BorderThickness="0" Background="{DynamicResource AccentGradient}">
              <StackPanel Spacing="4" Padding="18" VerticalAlignment="Center">
                <TextBlock Text="Gradient card" Font="{x:Static app:GalleryTypography.CardTitle}" Foreground="#FFFFFFFF" />
                <TextBlock Text="Painted by the same brush pipeline." Foreground="#CCFFFFFF" Font="{x:Static app:GalleryTypography.Caption}" />
              </StackPanel>
            </Border>
            <Ellipse Width="140" Height="140" Fill="{DynamicResource WarmGradient}" />
            <Rectangle Width="260" Height="140" RadiusX="20" RadiusY="20" Fill="{DynamicResource CoolGradient}" />
            <Image Width="140" Height="140" Stretch="Uniform" Source="{x:Static local:GalleryArt.Orb}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="CardStrokedGeometry">
        <StackPanel Spacing="10">
          <TextBlock Text="Pen-stroked geometry" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="StrokeThickness draws the outline; a polygon closes its figure while a polyline stays open."
                       Foreground="{DynamicResource MutedBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="24" Height="140">
            <Path Width="180" Height="120" Stretch="Uniform" Data="M 10 100 L 46 12 L 82 100 L 118 12 L 154 100"
                    Stroke="{DynamicResource AccentBrush}" StrokeThickness="4" />
            <Polygon Width="150" Height="120" Points="{x:Static local:ShapePoints.TallTriangle}"
                       Fill="#225B8CFF" Stroke="{DynamicResource WarmGradient}" StrokeThickness="4" />
            <Path Width="150" Height="120" Stretch="Uniform"
                    Data="M 60 6 L 74 44 L 114 44 L 82 68 L 94 106 L 60 82 L 26 106 L 38 68 L 6 44 L 46 44 Z"
                    Fill="{DynamicResource AccentSoftBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="CardViewboxArtwork">
        <StackPanel Spacing="10">
          <TextBlock Text="Viewbox-scaled artwork" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="One fixed-size composition scaled uniformly into the card." Foreground="{DynamicResource MutedBrush}" />
          <Viewbox Height="150" Stretch="Uniform">
            <StackPanel Orientation="Horizontal" Width="720" Height="128" Spacing="22" Padding="18" Background="{DynamicResource FieldBrush}">
              <Ellipse Width="92" Height="92" Fill="{DynamicResource AccentGradient}" />
              <StackPanel Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Scaled icon card" Font="{x:Static app:GalleryTypography.CardTitle}" />
                <TextBlock Text="Geometry and text share the viewbox scale." Foreground="{DynamicResource MutedBrush}" />
              </StackPanel>
              <Path Width="92" Height="92" Stretch="Uniform" Data="M 50 6 L 62 38 L 96 38 L 68 58 L 78 92 L 50 72 L 22 92 L 32 58 L 4 38 L 38 38 Z"
                      Fill="{DynamicResource WarmGradient}" />
              <Polygon Width="92" Height="92" Points="{x:Static local:ShapePoints.Triangle}" Fill="{DynamicResource CoolGradient}" />
            </StackPanel>
          </Viewbox>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollableControl>
</UserControl>
