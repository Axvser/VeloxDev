<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:Demo.Views"
    x:Class="Demo.Views.Sections.VisualsSection">

  <ScrollableControl Dock="Fill" Background="{DynamicResource WindowBrush}">
    <StackPanel Dock="Top" Spacing="16" Padding="4,4,20,28">

      <StackPanel Spacing="6">
        <TextBlock Text="11 · Visuals" Font="{x:Static app:GalleryTypography.Mono}" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="A lightweight visual tree" Font="{x:Static app:GalleryTypography.SectionTitle}" />
        <TextBlock Text="Container, text and shape visuals are painted in one pass with transforms, opacity, clipping and effects, without a window handle per visual."
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MutedBrush}"
                     MaxWidth="980" />
      </StackPanel>

      <Border x:Name="CardVisualComposition">
        <StackPanel Spacing="10">
          <TextBlock Text="Composition without HWNDs" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="The scene is a ContainerVisual tree. The sliders and toggles mutate it and invalidate one host."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <VisualHost x:Name="visualHost" Height="320" Background="{DynamicResource FieldBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="14">
            <StackPanel Spacing="4" Width="260">
              <TextBlock Text="Group opacity" Font="{x:Static app:GalleryTypography.Caption}" Foreground="{DynamicResource MutedBrush}" />
              <Slider x:Name="opacitySlider" Width="240" Height="34" Minimum="0" Maximum="100" Value="100" ValueChanged="OnOpacityChanged" />
            </StackPanel>
            <Button x:Name="rotateButton" Content="Rotate" Height="34" Click="OnRotateClick" />
            <Button x:Name="clipButton" Content="Clip" Height="34" Click="OnClipClick" />
            <Button x:Name="shadowButton" Content="Toggle shadow" Height="34" Click="OnShadowClick" />
            <TextBlock x:Name="visualStatus" Text="1 pass · 0 HWNDs" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="CardConnectorBatch">
        <StackPanel Spacing="10">
          <TextBlock Text="Connector batch" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="Hundreds of cubic curves share a few batched paths. They are visual nodes, not controls."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <VisualHost x:Name="connectorHost" Height="250" Background="{DynamicResource FieldBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="14">
            <Button x:Name="addConnectorsButton" Content="Add 200 curves" Height="34" Click="OnAddConnectorsClick" />
            <TextBlock x:Name="connectorStatus" Text="400 curves · 3 paths · 0 HWNDs" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollableControl>
</UserControl>
