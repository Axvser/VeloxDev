<v:UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="clr-namespace:VeloxDev.WinForms.Xaml;assembly=VeloxDev.WinForms"
    xmlns:app="clr-namespace:Demo.Views"
    x:Class="Demo.Views.Sections.VisualsSection">

  <v:ScrollableControl Dock="Fill" Background="{DynamicResource WindowBrush}">
    <v:StackPanel Dock="Top" Spacing="16" Padding="4,4,20,28">

      <v:StackPanel Spacing="6">
        <v:TextBlock Text="11 · Visuals" Font="{x:Static app:GalleryTypography.Mono}" Foreground="{DynamicResource AccentBrush}" />
        <v:TextBlock Text="A lightweight visual tree" Font="{x:Static app:GalleryTypography.SectionTitle}" />
        <v:TextBlock Text="Container, text and shape visuals are painted in one pass with transforms, opacity, clipping and effects, without a window handle per visual."
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MutedBrush}"
                     MaxWidth="980" />
      </v:StackPanel>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="Composition without HWNDs" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="The scene is a ContainerVisual tree. The sliders and toggles mutate it and invalidate one host."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <v:VisualHost x:Name="visualHost" Height="320" Background="{DynamicResource FieldBrush}" />
          <v:StackPanel Orientation="Horizontal" Spacing="14">
            <v:StackPanel Spacing="4" Width="260">
              <v:TextBlock Text="Group opacity" Font="{x:Static app:GalleryTypography.Caption}" Foreground="{DynamicResource MutedBrush}" />
              <v:Slider x:Name="opacitySlider" Width="240" Height="34" Minimum="0" Maximum="100" Value="100" ValueChanged="OnOpacityChanged" />
            </v:StackPanel>
            <v:Button x:Name="rotateButton" Content="Rotate" Height="34" Click="OnRotateClick" />
            <v:Button x:Name="clipButton" Content="Clip" Height="34" Click="OnClipClick" />
            <v:Button x:Name="shadowButton" Content="Toggle shadow" Height="34" Click="OnShadowClick" />
            <v:TextBlock x:Name="visualStatus" Text="1 pass · 0 HWNDs" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
          </v:StackPanel>
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="Connector batch" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="Hundreds of cubic curves share one path and one pen. They are visual nodes, not controls."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <v:VisualHost x:Name="connectorHost" Height="250" Background="{DynamicResource FieldBrush}" />
          <v:StackPanel Orientation="Horizontal" Spacing="14">
            <v:Button x:Name="addConnectorsButton" Content="Add 200 curves" Height="34" Click="OnAddConnectorsClick" />
            <v:TextBlock x:Name="connectorStatus" Text="400 curves · 1 path · 0 HWNDs" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
          </v:StackPanel>
        </v:StackPanel>
      </v:Border>

    </v:StackPanel>
  </v:ScrollableControl>
</v:UserControl>
