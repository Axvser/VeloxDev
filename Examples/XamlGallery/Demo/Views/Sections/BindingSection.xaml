<v:UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="clr-namespace:VeloxDev.WinForms.Xaml;assembly=VeloxDev.WinForms"
    xmlns:app="clr-namespace:Demo.Views"
    xmlns:demo="clr-namespace:Demo"
    xmlns:local="clr-namespace:Demo.Views.Sections"
    x:Class="Demo.Views.Sections.BindingSection">

  <v:UserControl.Resources>
    <v:ResourceDictionary>
      <demo:UppercaseConverter x:Key="Upper" />
      <demo:PrefixConverter x:Key="Prefix" />
      <v:SolidColorBrush x:Key="LiveBrush" Color="#FF5B8CFF" />
    </v:ResourceDictionary>
  </v:UserControl.Resources>

  <v:ScrollableControl Dock="Fill" Background="{DynamicResource WindowBrush}">
    <v:StackPanel Dock="Top" Spacing="16" Padding="4,4,20,28">

      <v:StackPanel Spacing="6">
        <v:TextBlock Text="07 · Binding" Font="{x:Static app:GalleryTypography.Mono}" Foreground="{DynamicResource AccentBrush}" />
        <v:TextBlock Text="Sources, shaping and validation" Font="{x:Static app:GalleryTypography.SectionTitle}" />
        <v:TextBlock Text="Converters, formatting, fallbacks, indexers, element and relative sources, dynamic resources and two validation styles."
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MutedBrush}"
                     MaxWidth="980" />
      </v:StackPanel>

      <v:Border>
        <v:StackPanel Spacing="8">
          <v:TextBlock Text="Value shaping" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="{Binding Amount, StringFormat='Amount: {0:N2}'}" />
          <v:TextBlock Text="{Binding Amount, Converter={StaticResource Prefix}, ConverterParameter='≈ '}" />
          <v:TextBlock Text="{Binding OptionalName, TargetNullValue='(null target)'}" />
          <v:TextBlock Text="{Binding Missing, FallbackValue='fallback value'}" />
          <v:TextBlock Text="{Binding Rows[0].Name, Converter={StaticResource Upper}}" />
          <v:TextBlock Text="{Binding Rows[1].Name, StringFormat='Second row: {0}'}" />
          <v:TextBlock Text="{x:Static demo:GalleryStatics.SampleText}" Foreground="{DynamicResource AccentBrush}" />
          <v:TextBlock Text="{Binding Width, RelativeSource={RelativeSource Self}, StringFormat='Self width: {0}'}" Width="220" HorizontalAlignment="Left" />
          <v:TextBlock Text="{Binding DataContext.Amount, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:BindingSection}}, StringFormat='Ancestor amount: {0:N2}'}" />
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="8">
          <v:TextBlock Text="ElementName" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="A dependency property on one element is the source for another; edits flow immediately."
                       Foreground="{DynamicResource MutedBrush}" />
          <v:TextBox x:Name="elementSource" Width="320" Height="34" HorizontalAlignment="Left" Text="Edit this value" />
          <v:TextBlock Text="{Binding ElementName=elementSource, Path=Text}" Foreground="{DynamicResource AccentBrush}" />
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="Two-way and validation" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="The first field reads INotifyDataErrorInfo from the model; the second uses a custom ValidationRule attached in code."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <v:StackPanel Orientation="Horizontal" Spacing="12">
            <v:TextBox x:Name="nameEditor" Width="300" Height="34" HorizontalAlignment="Left" Text="{Binding OptionalName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
              <v:TextBox.Triggers>
                <v:Trigger Property="v:Validation.HasError" Value="True">
                  <v:Trigger.Setters>
                    <v:Setter Property="BorderBrush" Value="#FFFF6B6B" />
                  </v:Trigger.Setters>
                </v:Trigger>
              </v:TextBox.Triggers>
            </v:TextBox>
            <v:Button Content="Clear the name" Height="34" Click="OnClearNameClick" />
            <v:Button Content="Fill the name" Height="34" Click="OnFillNameClick" />
          </v:StackPanel>
          <v:StackPanel Orientation="Horizontal" Spacing="12">
            <v:TextBox x:Name="ruleEditor" Width="300" Height="34" HorizontalAlignment="Left" PlaceholderText="Type more than ten characters">
              <v:TextBox.Triggers>
                <v:Trigger Property="v:Validation.HasError" Value="True">
                  <v:Trigger.Setters>
                    <v:Setter Property="BorderBrush" Value="#FFF2B44B" />
                  </v:Trigger.Setters>
                </v:Trigger>
              </v:TextBox.Triggers>
            </v:TextBox>
            <v:TextBlock Text="Custom MaxLengthRule (10)" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
          </v:StackPanel>
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="DynamicResource" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="Replacing a dictionary value repaints every consumer without rebinding."
                       Foreground="{DynamicResource MutedBrush}" />
          <v:StackPanel Orientation="Horizontal" Spacing="14">
            <v:Border Width="240" Height="86" Padding="0" BorderThickness="0" CornerRadius="8" Background="{DynamicResource LiveBrush}">
              <v:TextBlock Text="Live resource" TextAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" />
            </v:Border>
            <v:StackPanel Spacing="8" VerticalAlignment="Center">
              <v:Button Content="Next accent" Height="34" Click="OnNextAccentClick" />
              <v:TextBlock Text="The swatch key is replaced; DynamicResource follows." Foreground="{DynamicResource MutedBrush}" Font="{x:Static app:GalleryTypography.Caption}" />
            </v:StackPanel>
          </v:StackPanel>
        </v:StackPanel>
      </v:Border>

    </v:StackPanel>
  </v:ScrollableControl>
</v:UserControl>
