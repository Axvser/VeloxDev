<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:Demo.Views"
    xmlns:demo="clr-namespace:Demo"
    xmlns:local="clr-namespace:Demo.Views.Sections"
    x:Class="Demo.Views.Sections.BindingSection">

  <UserControl.Resources>
    <ResourceDictionary>
      <demo:UppercaseConverter x:Key="Upper" />
      <demo:PrefixConverter x:Key="Prefix" />
      <SolidColorBrush x:Key="LiveBrush" Color="#FF5B8CFF" />
    </ResourceDictionary>
  </UserControl.Resources>

  <ScrollableControl Dock="Fill" Background="{DynamicResource WindowBrush}">
    <StackPanel Dock="Top" Spacing="16" Padding="4,4,20,28">

      <StackPanel Spacing="6">
        <TextBlock Text="07 · Binding" Font="{x:Static app:GalleryTypography.Mono}" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="Sources, shaping and validation" Font="{x:Static app:GalleryTypography.SectionTitle}" />
        <TextBlock Text="Converters, formatting, fallbacks, indexers, element and relative sources, dynamic resources and two validation styles."
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MutedBrush}"
                     MaxWidth="980" />
      </StackPanel>

      <Border x:Name="CardValueShaping">
        <StackPanel Spacing="8">
          <TextBlock Text="Value shaping" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="{Binding Amount, StringFormat='Amount: {0:N2}'}" />
          <TextBlock Text="{Binding Amount, Converter={StaticResource Prefix}, ConverterParameter='≈ '}" />
          <TextBlock Text="{Binding OptionalName, TargetNullValue='(null target)'}" />
          <TextBlock Text="{Binding Missing, FallbackValue='fallback value'}" />
          <TextBlock Text="{Binding Rows[0].Name, Converter={StaticResource Upper}}" />
          <TextBlock Text="{Binding Rows[1].Name, StringFormat='Second row: {0}'}" />
          <TextBlock Text="{x:Static demo:GalleryStatics.SampleText}" Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Text="{Binding Width, RelativeSource={RelativeSource Self}, StringFormat='Self width: {0}'}" Width="220" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding DataContext.Amount, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:BindingSection}}, StringFormat='Ancestor amount: {0:N2}'}" />
        </StackPanel>
      </Border>

      <Border x:Name="CardElementName">
        <StackPanel Spacing="8">
          <TextBlock Text="ElementName" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="A dependency property on one element is the source for another; edits flow immediately."
                       Foreground="{DynamicResource MutedBrush}" />
          <TextBox x:Name="elementSource" Width="320" Height="34" HorizontalAlignment="Left" Text="Edit this value" />
          <TextBlock Text="{Binding ElementName=elementSource, Path=Text}" Foreground="{DynamicResource AccentBrush}" />
        </StackPanel>
      </Border>

      <Border x:Name="CardTwoWayValidation">
        <StackPanel Spacing="10">
          <TextBlock Text="Two-way and validation" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="The first field reads INotifyDataErrorInfo from the model; the second uses a custom ValidationRule attached in code."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBox x:Name="nameEditor" Width="300" Height="34" HorizontalAlignment="Left" Text="{Binding OptionalName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
              <TextBox.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                  <Trigger.Setters>
                    <Setter Property="BorderBrush" Value="#FFFF6B6B" />
                  </Trigger.Setters>
                </Trigger>
              </TextBox.Triggers>
            </TextBox>
            <Button Content="Clear the name" Height="34" Click="OnClearNameClick" />
            <Button Content="Fill the name" Height="34" Click="OnFillNameClick" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBox x:Name="ruleEditor" Width="300" Height="34" HorizontalAlignment="Left" PlaceholderText="Type more than ten characters">
              <TextBox.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                  <Trigger.Setters>
                    <Setter Property="BorderBrush" Value="#FFF2B44B" />
                  </Trigger.Setters>
                </Trigger>
              </TextBox.Triggers>
            </TextBox>
            <TextBlock Text="Custom MaxLengthRule (10)" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="CardDynamicResource">
        <StackPanel Spacing="10">
          <TextBlock Text="DynamicResource" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="Replacing a dictionary value repaints every consumer without rebinding."
                       Foreground="{DynamicResource MutedBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="14">
            <Border Width="240" Height="86" Padding="0" BorderThickness="0" CornerRadius="8" Background="{DynamicResource LiveBrush}">
              <TextBlock Text="Live resource" TextAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" />
            </Border>
            <StackPanel Spacing="8" VerticalAlignment="Center">
              <Button Content="Next accent" Height="34" Click="OnNextAccentClick" />
              <TextBlock Text="The swatch key is replaced; DynamicResource follows." Foreground="{DynamicResource MutedBrush}" Font="{x:Static app:GalleryTypography.Caption}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollableControl>
</UserControl>
