<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:Demo.Views"
    xmlns:demo="clr-namespace:Demo"
    x:Class="Demo.Views.Sections.DataSection">

  <UserControl.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="RowTemplate">
        <Border Height="38" Padding="12,0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                         Text="{Binding Value, StringFormat='{}{0:N2}'}"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource MutedBrush}" />
          </Grid>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="MutedRowTemplate">
        <Border Height="38" Padding="12,0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
            <TextBlock Grid.Column="1" Text="disabled" VerticalAlignment="Center" Font="{x:Static app:GalleryTypography.Caption}" Foreground="{DynamicResource DangerBrush}" />
          </Grid>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="VirtualRowTemplate">
        <Border Height="28" Padding="12,0" BorderThickness="0" Background="{DynamicResource FieldBrush}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
          </Grid>
        </Border>
      </DataTemplate>
      <demo:EnabledRowTemplateSelector x:Key="RowSelector"
                                       EnabledTemplate="{StaticResource RowTemplate}"
                                       DisabledTemplate="{StaticResource MutedRowTemplate}" />
      <Style x:Key="RowContainer" TargetType="Border">
        <Style.Setters>
          <Setter Property="CornerRadius" Value="8" />
        </Style.Setters>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <ScrollableControl Dock="Fill" Background="{DynamicResource WindowBrush}">
    <StackPanel Dock="Top" Spacing="16" Padding="4,4,20,28">

      <StackPanel Spacing="6">
        <TextBlock Text="03 · Data" Font="{x:Static app:GalleryTypography.Mono}" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="Items, selectors and views" Font="{x:Static app:GalleryTypography.SectionTitle}" />
        <TextBlock Text="Generated item visuals, native-backed selectors, collection views, calendars and a virtualized list."
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MutedBrush}"
                     MaxWidth="980" />
      </StackPanel>

      <Border x:Name="CardItemsControl">
        <StackPanel Spacing="10">
          <TextBlock Text="ItemsControl + ItemsPanel + ItemTemplate + selector" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="Every item is a real control; the selector picks a muted template for disabled rows."
                       Foreground="{DynamicResource MutedBrush}" />
          <ItemsControl Width="620"
                          HorizontalAlignment="Left"
                          ItemsSource="{Binding Rows}"
                          ItemTemplateSelector="{StaticResource RowSelector}"
                          ItemContainerStyle="{StaticResource RowContainer}">
            <ItemsControl.ItemsPanel>
              <StackPanel Spacing="6" />
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border x:Name="CardSelectors">
        <StackPanel Spacing="10">
          <TextBlock Text="ListBox, ComboBox and TreeView" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="The native selectors provide selection and scrolling; TreeView discovers children by property name."
                       Foreground="{DynamicResource MutedBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="14">
            <StackPanel Spacing="6">
              <TextBlock Text="ListBox" Font="{x:Static app:GalleryTypography.Caption}" Foreground="{DynamicResource MutedBrush}" />
              <ListBox Width="220" Height="160" ItemsSource="{Binding Rows}" DisplayMemberPath="Name" />
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Text="ComboBox" Font="{x:Static app:GalleryTypography.Caption}" Foreground="{DynamicResource MutedBrush}" />
              <ComboBox Width="220" Height="34" ItemsSource="{Binding Rows}" DisplayMemberPath="Name" />
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Text="TreeView" Font="{x:Static app:GalleryTypography.Caption}" Foreground="{DynamicResource MutedBrush}" />
              <TreeView Width="260" Height="160" ItemsSource="{Binding TreeNodes}" DisplayMemberPath="Name" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="CardListGrid">
        <StackPanel Spacing="10">
          <TextBlock Text="ListView and DataGrid" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="Column views backed by the native list and grid, with themed colours from the active palette."
                       Foreground="{DynamicResource MutedBrush}" />
          <StackPanel Orientation="Horizontal" Height="194" Spacing="14">
            <ListView Width="420" Height="194" Background="{DynamicResource FieldBrush}" ItemsSource="{Binding Rows}">
              <ListView.View>
                <GridView>
                  <GridView.Columns>
                    <GridViewColumn Header="Name" DisplayMemberBinding="Name" Width="180" />
                    <GridViewColumn Header="Value" DisplayMemberBinding="Value" Width="120" />
                    <GridViewColumn Header="Enabled" DisplayMemberBinding="Enabled" Width="100" />
                  </GridView.Columns>
                </GridView>
              </ListView.View>
            </ListView>
            <DataGrid Width="450" Height="194" Background="{DynamicResource FieldBrush}" ItemsSource="{Binding Rows}" AutoGenerateColumns="False">
              <DataGrid.Columns>
                <DataGridColumn Header="Name" Binding="Name" Width="180" />
                <DataGridColumn Header="Value" Binding="Value" Width="120" />
                <DataGridColumn Header="Enabled" Binding="Enabled" Width="100" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="CardCalendar">
        <StackPanel Spacing="10">
          <TextBlock Text="Calendar and DatePicker" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="Both selectors write the same nullable date property; the binding is two-way."
                       Foreground="{DynamicResource MutedBrush}" />
          <StackPanel Orientation="Horizontal" Height="170" Spacing="18">
            <Calendar Width="240" Height="170" SelectedDate="{Binding Date, Mode=TwoWay}" />
            <StackPanel Spacing="10" Width="280">
              <TextBlock Text="DatePicker" Font="{x:Static app:GalleryTypography.Caption}" Foreground="{DynamicResource MutedBrush}" />
              <DatePicker Width="260" Height="34" HorizontalAlignment="Left" SelectedDate="{Binding Date, Mode=TwoWay}" />
              <TextBlock Text="{Binding Date, StringFormat='Selected: {0:dddd, MMMM d, yyyy}'}"
                           Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="CardCollectionView">
        <StackPanel Spacing="10">
          <TextBlock Text="CollectionView sorting and filtering" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="The view is a WPF-shaped CollectionView over the same rows; Refresh republishes it to the ItemsControl."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Sort by name" Height="34" Click="OnSortClick" />
            <Button Content="Enabled only" Height="34" Click="OnFilterClick" />
            <TextBlock Text="{Binding CollectionState}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
          </StackPanel>
          <ItemsControl Width="620"
                          HorizontalAlignment="Left"
                          ItemsSource="{Binding RowsView}"
                          ItemTemplate="{StaticResource RowTemplate}">
            <ItemsControl.ItemsPanel>
              <StackPanel Spacing="6" />
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border x:Name="CardVirtualizedList">
        <StackPanel Spacing="10">
          <TextBlock Text="Virtualizing ItemsControl" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="Four hundred rows, fixed row height; only the rows inside the viewport are realized."
                       Foreground="{DynamicResource MutedBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="14">
            <ScrollViewer x:Name="virtualViewer" Width="620" Height="190" VerticalScrollBarVisibility="Visible">
              <Canvas x:Name="virtualCanvas">
                <Canvas x:Name="virtualContent">
                  <ItemsControl x:Name="virtualList"
                                  ItemsSource="{Binding VirtualRows}"
                                  ItemTemplate="{StaticResource VirtualRowTemplate}"
                                  Virtualizing="True"
                                  ItemHeight="28" />
                </Canvas>
              </Canvas>
            </ScrollViewer>
            <StackPanel Spacing="8" Width="250">
              <TextBlock x:Name="virtualStatus" Text="Realized 0 of 400" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="The ScrollViewer reports its extent and offset; the control materializes only the intersecting rows."
                           TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Font="{x:Static app:GalleryTypography.Caption}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollableControl>
</UserControl>
