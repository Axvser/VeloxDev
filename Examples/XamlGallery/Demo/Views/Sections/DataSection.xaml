<v:UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="clr-namespace:VeloxDev.WinForms.Xaml;assembly=VeloxDev.WinForms"
    xmlns:app="clr-namespace:Demo.Views"
    xmlns:demo="clr-namespace:Demo"
    x:Class="Demo.Views.Sections.DataSection">

  <v:UserControl.Resources>
    <v:ResourceDictionary>
      <v:DataTemplate x:Key="RowTemplate">
        <v:Border Height="38" Padding="12,0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}">
          <v:Grid>
            <v:Grid.ColumnDefinitions>
              <v:ColumnDefinition Width="*" />
              <v:ColumnDefinition Width="Auto" />
            </v:Grid.ColumnDefinitions>
            <v:TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            <v:TextBlock v:Grid.Column="1"
                         Text="{Binding Value, StringFormat='{}{0:N2}'}"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource MutedBrush}" />
          </v:Grid>
        </v:Border>
      </v:DataTemplate>
      <v:DataTemplate x:Key="MutedRowTemplate">
        <v:Border Height="38" Padding="12,0" BorderThickness="0" CornerRadius="6" Background="{DynamicResource FieldBrush}">
          <v:Grid>
            <v:Grid.ColumnDefinitions>
              <v:ColumnDefinition Width="*" />
              <v:ColumnDefinition Width="Auto" />
            </v:Grid.ColumnDefinitions>
            <v:TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
            <v:TextBlock v:Grid.Column="1" Text="disabled" VerticalAlignment="Center" Font="{x:Static app:GalleryTypography.Caption}" Foreground="{DynamicResource DangerBrush}" />
          </v:Grid>
        </v:Border>
      </v:DataTemplate>
      <v:DataTemplate x:Key="VirtualRowTemplate">
        <v:Border Height="28" Padding="12,0" BorderThickness="0" Background="{DynamicResource FieldBrush}">
          <v:Grid>
            <v:Grid.ColumnDefinitions>
              <v:ColumnDefinition Width="*" />
              <v:ColumnDefinition Width="Auto" />
            </v:Grid.ColumnDefinitions>
            <v:TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            <v:TextBlock v:Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
          </v:Grid>
        </v:Border>
      </v:DataTemplate>
      <demo:EnabledRowTemplateSelector x:Key="RowSelector"
                                       EnabledTemplate="{StaticResource RowTemplate}"
                                       DisabledTemplate="{StaticResource MutedRowTemplate}" />
      <v:Style x:Key="RowContainer" TargetType="v:Border">
        <v:Style.Setters>
          <v:Setter Property="CornerRadius" Value="8" />
        </v:Style.Setters>
      </v:Style>
    </v:ResourceDictionary>
  </v:UserControl.Resources>

  <v:ScrollableControl Dock="Fill" Background="{DynamicResource WindowBrush}">
    <v:StackPanel Dock="Top" Spacing="16" Padding="4,4,20,28">

      <v:StackPanel Spacing="6">
        <v:TextBlock Text="03 · Data" Font="{x:Static app:GalleryTypography.Mono}" Foreground="{DynamicResource AccentBrush}" />
        <v:TextBlock Text="Items, selectors and views" Font="{x:Static app:GalleryTypography.SectionTitle}" />
        <v:TextBlock Text="Generated item visuals, native-backed selectors, collection views, calendars and a virtualized list."
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MutedBrush}"
                     MaxWidth="980" />
      </v:StackPanel>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="ItemsControl + ItemsPanel + ItemTemplate + selector" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="Every item is a real control; the selector picks a muted template for disabled rows."
                       Foreground="{DynamicResource MutedBrush}" />
          <v:ItemsControl Width="620"
                          HorizontalAlignment="Left"
                          ItemsSource="{Binding Rows}"
                          ItemTemplateSelector="{StaticResource RowSelector}"
                          ItemContainerStyle="{StaticResource RowContainer}">
            <v:ItemsControl.ItemsPanel>
              <v:StackPanel Spacing="6" />
            </v:ItemsControl.ItemsPanel>
          </v:ItemsControl>
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="ListBox, ComboBox and TreeView" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="The native selectors provide selection and scrolling; TreeView discovers children by property name."
                       Foreground="{DynamicResource MutedBrush}" />
          <v:StackPanel Orientation="Horizontal" Spacing="14">
            <v:StackPanel Spacing="6">
              <v:TextBlock Text="ListBox" Font="{x:Static app:GalleryTypography.Caption}" Foreground="{DynamicResource MutedBrush}" />
              <v:ListBox Width="220" Height="160" ItemsSource="{Binding Rows}" DisplayMemberPath="Name" />
            </v:StackPanel>
            <v:StackPanel Spacing="6">
              <v:TextBlock Text="ComboBox" Font="{x:Static app:GalleryTypography.Caption}" Foreground="{DynamicResource MutedBrush}" />
              <v:ComboBox Width="220" Height="34" ItemsSource="{Binding Rows}" DisplayMemberPath="Name" />
            </v:StackPanel>
            <v:StackPanel Spacing="6">
              <v:TextBlock Text="TreeView" Font="{x:Static app:GalleryTypography.Caption}" Foreground="{DynamicResource MutedBrush}" />
              <v:TreeView Width="260" Height="160" ItemsSource="{Binding TreeNodes}" DisplayMemberPath="Name" />
            </v:StackPanel>
          </v:StackPanel>
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="ListView and DataGrid" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="Column views backed by the native list and grid, with themed colours from the active palette."
                       Foreground="{DynamicResource MutedBrush}" />
          <v:StackPanel Orientation="Horizontal" Height="194" Spacing="14">
            <v:ListView Width="420" Height="194" Background="{DynamicResource FieldBrush}" ItemsSource="{Binding Rows}">
              <v:ListView.View>
                <v:GridView>
                  <v:GridView.Columns>
                    <v:GridViewColumn Header="Name" DisplayMemberBinding="Name" Width="180" />
                    <v:GridViewColumn Header="Value" DisplayMemberBinding="Value" Width="120" />
                    <v:GridViewColumn Header="Enabled" DisplayMemberBinding="Enabled" Width="100" />
                  </v:GridView.Columns>
                </v:GridView>
              </v:ListView.View>
            </v:ListView>
            <v:DataGrid Width="450" Height="194" Background="{DynamicResource FieldBrush}" ItemsSource="{Binding Rows}" AutoGenerateColumns="False">
              <v:DataGrid.Columns>
                <v:DataGridColumn Header="Name" Binding="Name" Width="180" />
                <v:DataGridColumn Header="Value" Binding="Value" Width="120" />
                <v:DataGridColumn Header="Enabled" Binding="Enabled" Width="100" />
              </v:DataGrid.Columns>
            </v:DataGrid>
          </v:StackPanel>
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="Calendar and DatePicker" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="Both selectors write the same nullable date property; the binding is two-way."
                       Foreground="{DynamicResource MutedBrush}" />
          <v:StackPanel Orientation="Horizontal" Height="170" Spacing="18">
            <v:Calendar Width="240" Height="170" SelectedDate="{Binding Date, Mode=TwoWay}" />
            <v:StackPanel Spacing="10" Width="280">
              <v:TextBlock Text="DatePicker" Font="{x:Static app:GalleryTypography.Caption}" Foreground="{DynamicResource MutedBrush}" />
              <v:DatePicker Width="260" Height="34" HorizontalAlignment="Left" SelectedDate="{Binding Date, Mode=TwoWay}" />
              <v:TextBlock Text="{Binding Date, StringFormat='Selected: {0:dddd, MMMM d, yyyy}'}"
                           Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
            </v:StackPanel>
          </v:StackPanel>
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="CollectionView sorting and filtering" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="The view is a WPF-shaped CollectionView over the same rows; Refresh republishes it to the ItemsControl."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <v:StackPanel Orientation="Horizontal" Spacing="10">
            <v:Button Content="Sort by name" Height="34" Click="OnSortClick" />
            <v:Button Content="Enabled only" Height="34" Click="OnFilterClick" />
            <v:TextBlock Text="{Binding CollectionState}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
          </v:StackPanel>
          <v:ItemsControl Width="620"
                          HorizontalAlignment="Left"
                          ItemsSource="{Binding RowsView}"
                          ItemTemplate="{StaticResource RowTemplate}">
            <v:ItemsControl.ItemsPanel>
              <v:StackPanel Spacing="6" />
            </v:ItemsControl.ItemsPanel>
          </v:ItemsControl>
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="Virtualizing ItemsControl" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="Four hundred rows, fixed row height; only the rows inside the viewport are realized."
                       Foreground="{DynamicResource MutedBrush}" />
          <v:StackPanel Orientation="Horizontal" Spacing="14">
            <v:ScrollViewer x:Name="virtualViewer" Width="620" Height="190" VerticalScrollBarVisibility="Visible">
              <v:Canvas x:Name="virtualCanvas">
                <v:Canvas x:Name="virtualContent">
                  <v:ItemsControl x:Name="virtualList"
                                  ItemsSource="{Binding VirtualRows}"
                                  ItemTemplate="{StaticResource VirtualRowTemplate}"
                                  Virtualizing="True"
                                  ItemHeight="28" />
                </v:Canvas>
              </v:Canvas>
            </v:ScrollViewer>
            <v:StackPanel Spacing="8" Width="250">
              <v:TextBlock x:Name="virtualStatus" Text="Realized 0 of 400" Foreground="{DynamicResource AccentBrush}" />
              <v:TextBlock Text="The ScrollViewer reports its extent and offset; the control materializes only the intersecting rows."
                           TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Font="{x:Static app:GalleryTypography.Caption}" />
            </v:StackPanel>
          </v:StackPanel>
        </v:StackPanel>
      </v:Border>

    </v:StackPanel>
  </v:ScrollableControl>
</v:UserControl>
