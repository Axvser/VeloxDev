<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:Demo.Views"
    x:Class="Demo.Views.Sections.TextSection">

  <UserControl.Resources>
    <ResourceDictionary>
      <FlowDocument x:Key="SampleDocument">
        <Paragraph>
          <Run Text="A paragraph can mix " />
          <Bold><Run Text="bold" /></Bold>
          <Run Text=", " />
          <Italic><Run Text="italic" /></Italic>
          <Run Text=", " />
          <Underline><Run Text="underline" /></Underline>
          <Run Text=" and a " />
          <Hyperlink NavigateUri="https://learn.microsoft.com"><Run Text="hyperlink" /></Hyperlink>
          <Run Text="." />
        </Paragraph>
        <ListBlock>
          <ListItem><Paragraph><Run Text="A bulleted list item" /></Paragraph></ListItem>
          <ListItem><Paragraph><Run Text="A second list item" /></Paragraph></ListItem>
        </ListBlock>
        <Table>
          <TableRow>
            <TableCell><Paragraph><Run Text="Name" /></Paragraph></TableCell>
            <TableCell><Paragraph><Run Text="Value" /></Paragraph></TableCell>
          </TableRow>
          <TableRow>
            <TableCell><Paragraph><Run Text="Alpha" /></Paragraph></TableCell>
            <TableCell><Paragraph><Run Text="12.5" /></Paragraph></TableCell>
          </TableRow>
        </Table>
      </FlowDocument>
    </ResourceDictionary>
  </UserControl.Resources>

  <ScrollableControl Dock="Fill" Background="{DynamicResource WindowBrush}">
    <StackPanel Dock="Top" Spacing="16" Padding="4,4,20,28">

      <StackPanel Spacing="6">
        <TextBlock Text="02 · Text" Font="{x:Static app:GalleryTypography.Mono}" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="Text, editors and documents" Font="{x:Static app:GalleryTypography.SectionTitle}" />
        <TextBlock Text="Self-painted text blocks, native-backed editors and the FlowDocument model rendered by three hosts."
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MutedBrush}"
                     MaxWidth="980" />
      </StackPanel>

      <Border x:Name="CardTextPrimitives">
        <StackPanel Spacing="10">
          <TextBlock Text="TextBlock, Label and AccessText" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="Wrapping, trimming, alignment and an access-key marker all come from the text primitives."
                       Foreground="{DynamicResource MutedBrush}" />
          <TextBlock Text="A wrapping block keeps its words inside the card: the quick brown fox jumps over the lazy dog and keeps going until the line is full."
                       TextWrapping="Wrap"
                       MaxWidth="620" />
          <TextBlock Text="This line is trimmed with an ellipsis when it no longer fits the available width."
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="420" />
          <TextBlock Text="Right aligned text" TextAlignment="Right" MaxWidth="620" />
          <Label Text="Label renders plain text with the theme foreground." />
          <AccessText Text="Press _Alt to see the mnemonic underline." />
          <StackPanel Orientation="Horizontal" Spacing="16">
            <TextBlock Text="Caption" Font="{x:Static app:GalleryTypography.Caption}" Foreground="{DynamicResource MutedBrush}" />
            <TextBlock Text="Body" Font="{x:Static app:GalleryTypography.Body}" />
            <TextBlock Text="Card title" Font="{x:Static app:GalleryTypography.CardTitle}" />
            <TextBlock Text="Section title" Font="{x:Static app:GalleryTypography.SectionTitle}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="CardTextEditors">
        <StackPanel Spacing="10">
          <TextBlock Text="TextBox, PasswordBox and multiline input" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="The native editor is themed by the runtime; dependency properties stay two-way in sync."
                       Foreground="{DynamicResource MutedBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBox Width="300" Height="34" PlaceholderText="Type a display name" Text="{Binding OptionalName, Mode=TwoWay}" />
            <PasswordBox Width="220" Height="34" Password="veloxdev" />
            <TextBox Width="200" Height="34" Text="Read-only value" IsReadOnly="True" />
          </StackPanel>
          <TextBox Width="740" Height="78" HorizontalAlignment="Left" AcceptsReturn="True"
                     Text="A multiline TextBox keeps its native scrolling and accepts Return." />
        </StackPanel>
      </Border>

      <Border x:Name="CardHeaderedContent">
        <StackPanel Spacing="10">
          <TextBlock Text="HeaderedContentControl" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="A themed header strip above a single content child." Foreground="{DynamicResource MutedBrush}" />
          <HeaderedContentControl Width="460" Height="96" HorizontalAlignment="Left" Header="Header strip">
            <StackPanel Spacing="4" Padding="10">
              <TextBlock Text="Content sits below the header." />
              <TextBlock Text="The strip reads the active theme palette." Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
          </HeaderedContentControl>
        </StackPanel>
      </Border>

      <Border x:Name="CardFlowDocuments">
        <StackPanel Spacing="10">
          <TextBlock Text="RichTextBox, FlowDocumentScrollViewer and DocumentViewer" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <TextBlock Text="All three hosts render the same FlowDocument resource; the first two are for reading, the last one is paged."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="14" Height="180">
            <RichTextBox Width="440" Height="180" IsReadOnly="True" Document="{StaticResource SampleDocument}" />
            <FlowDocumentScrollViewer Width="440" Height="180" Document="{StaticResource SampleDocument}" />
          </StackPanel>
          <DocumentViewer Width="894" Height="150" Document="{StaticResource SampleDocument}" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollableControl>
</UserControl>
