<v:UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="clr-namespace:VeloxDev.WinForms.Xaml;assembly=VeloxDev.WinForms"
    xmlns:app="clr-namespace:Demo.Views"
    x:Class="Demo.Views.Sections.TextSection">

  <v:UserControl.Resources>
    <v:ResourceDictionary>
      <v:FlowDocument x:Key="SampleDocument">
        <v:Paragraph>
          <v:Run Text="A paragraph can mix " />
          <v:Bold><v:Run Text="bold" /></v:Bold>
          <v:Run Text=", " />
          <v:Italic><v:Run Text="italic" /></v:Italic>
          <v:Run Text=", " />
          <v:Underline><v:Run Text="underline" /></v:Underline>
          <v:Run Text=" and a " />
          <v:Hyperlink NavigateUri="https://learn.microsoft.com"><v:Run Text="hyperlink" /></v:Hyperlink>
          <v:Run Text="." />
        </v:Paragraph>
        <v:ListBlock>
          <v:ListItem><v:Paragraph><v:Run Text="A bulleted list item" /></v:Paragraph></v:ListItem>
          <v:ListItem><v:Paragraph><v:Run Text="A second list item" /></v:Paragraph></v:ListItem>
        </v:ListBlock>
        <v:Table>
          <v:TableRow>
            <v:TableCell><v:Paragraph><v:Run Text="Name" /></v:Paragraph></v:TableCell>
            <v:TableCell><v:Paragraph><v:Run Text="Value" /></v:Paragraph></v:TableCell>
          </v:TableRow>
          <v:TableRow>
            <v:TableCell><v:Paragraph><v:Run Text="Alpha" /></v:Paragraph></v:TableCell>
            <v:TableCell><v:Paragraph><v:Run Text="12.5" /></v:Paragraph></v:TableCell>
          </v:TableRow>
        </v:Table>
      </v:FlowDocument>
    </v:ResourceDictionary>
  </v:UserControl.Resources>

  <v:ScrollableControl Dock="Fill" Background="{DynamicResource WindowBrush}">
    <v:StackPanel Dock="Top" Spacing="16" Padding="4,4,20,28">

      <v:StackPanel Spacing="6">
        <v:TextBlock Text="02 · Text" Font="{x:Static app:GalleryTypography.Mono}" Foreground="{DynamicResource AccentBrush}" />
        <v:TextBlock Text="Text, editors and documents" Font="{x:Static app:GalleryTypography.SectionTitle}" />
        <v:TextBlock Text="Self-painted text blocks, native-backed editors and the FlowDocument model rendered by three hosts."
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MutedBrush}"
                     MaxWidth="980" />
      </v:StackPanel>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="TextBlock, Label and AccessText" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="Wrapping, trimming, alignment and an access-key marker all come from the text primitives."
                       Foreground="{DynamicResource MutedBrush}" />
          <v:TextBlock Text="A wrapping block keeps its words inside the card: the quick brown fox jumps over the lazy dog and keeps going until the line is full."
                       TextWrapping="Wrap"
                       MaxWidth="620" />
          <v:TextBlock Text="This line is trimmed with an ellipsis when it no longer fits the available width."
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="420" />
          <v:TextBlock Text="Right aligned text" TextAlignment="Right" MaxWidth="620" />
          <v:Label Text="Label renders plain text with the theme foreground." />
          <v:AccessText Text="Press _Alt to see the mnemonic underline." />
          <v:StackPanel Orientation="Horizontal" Spacing="16">
            <v:TextBlock Text="Caption" Font="{x:Static app:GalleryTypography.Caption}" Foreground="{DynamicResource MutedBrush}" />
            <v:TextBlock Text="Body" Font="{x:Static app:GalleryTypography.Body}" />
            <v:TextBlock Text="Card title" Font="{x:Static app:GalleryTypography.CardTitle}" />
            <v:TextBlock Text="Section title" Font="{x:Static app:GalleryTypography.SectionTitle}" />
          </v:StackPanel>
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="TextBox, PasswordBox and multiline input" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="The native editor is themed by the runtime; dependency properties stay two-way in sync."
                       Foreground="{DynamicResource MutedBrush}" />
          <v:StackPanel Orientation="Horizontal" Spacing="12">
            <v:TextBox Width="300" Height="34" PlaceholderText="Type a display name" Text="{Binding OptionalName, Mode=TwoWay}" />
            <v:PasswordBox Width="220" Height="34" Password="veloxdev" />
            <v:TextBox Width="200" Height="34" Text="Read-only value" IsReadOnly="True" />
          </v:StackPanel>
          <v:TextBox Width="740" Height="78" HorizontalAlignment="Left" AcceptsReturn="True"
                     Text="A multiline TextBox keeps its native scrolling and accepts Return." />
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="HeaderedContentControl" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="A themed header strip above a single content child." Foreground="{DynamicResource MutedBrush}" />
          <v:HeaderedContentControl Width="460" Height="96" HorizontalAlignment="Left" Header="Header strip">
            <v:StackPanel Spacing="4" Padding="10">
              <v:TextBlock Text="Content sits below the header." />
              <v:TextBlock Text="The strip reads the active theme palette." Foreground="{DynamicResource MutedBrush}" />
            </v:StackPanel>
          </v:HeaderedContentControl>
        </v:StackPanel>
      </v:Border>

      <v:Border>
        <v:StackPanel Spacing="10">
          <v:TextBlock Text="RichTextBox, FlowDocumentScrollViewer and DocumentViewer" Font="{x:Static app:GalleryTypography.CardTitle}" />
          <v:TextBlock Text="All three hosts render the same FlowDocument resource; the first two are for reading, the last one is paged."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <v:StackPanel Orientation="Horizontal" Spacing="14" Height="180">
            <v:RichTextBox Width="440" Height="180" IsReadOnly="True" Document="{StaticResource SampleDocument}" />
            <v:FlowDocumentScrollViewer Width="440" Height="180" Document="{StaticResource SampleDocument}" />
          </v:StackPanel>
          <v:DocumentViewer Width="894" Height="150" Document="{StaticResource SampleDocument}" />
        </v:StackPanel>
      </v:Border>

    </v:StackPanel>
  </v:ScrollableControl>
</v:UserControl>
