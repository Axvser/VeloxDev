<StackPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Demo.Views.ViewModelBoard"
    Width="250"
    Spacing="10">

  <TextBlock Text="MVVM · [VeloxProperty] + [VeloxCommand]"
             Foreground="{StaticResource Text}"
             FontSize="15"
             Wrap="True" />

  <TextBlock Text="The fields become notifying properties and the methods become commands on this partial class."
             Foreground="{StaticResource Muted}"
             Wrap="True" />

  <TextBox Placeholder="Next task…"
           Text="{Binding Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

  <StackPanel Orientation="Horizontal" Spacing="8">
    <Button x:Name="addButton" Text="Add" Command="{Binding AddCommand}" />
    <Button Text="Remove" Command="{Binding RemoveCommand}" />
    <Button Text="Clear" Command="{Binding ClearCommand}" />
  </StackPanel>

  <TextBlock Text="{Binding Status}"
             Foreground="{StaticResource Muted}"
             Wrap="True" />

  <ListBox Height="150"
           ItemsSource="{Binding Tasks}"
           SelectedItem="{Binding Selected, Mode=TwoWay}">
    <ListBox.ItemTemplate>
      <DataTemplate>
        <TextBlock Text="{Binding Title}" />
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>

</StackPanel>
