<Window x:Class="Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Demo"
        mc:Ignorable="d"
        Title="MonoBehaviour — 两条泵的自对比" Height="980" Width="1260"
        Background="#1e1e1e">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <!-- 标题、控制条、读数：一切不在画面里的东西都收在这一段 -->
            <RowDefinition Height="Auto"></RowDefinition>
            <!-- 舞台：两只球和它们的高度差 -->
            <RowDefinition Height="Auto"></RowDefinition>
            <!-- 钩子日志 -->
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <!--
                AutomationProperties.AutomationId is the acceptance suites' handle on these controls, so a suite
                never matches on the Chinese labels: the tokens are language-independent and stable, and the labels
                stay exactly what a reader expects them to say.

                The button rows are grouped by what they act on — the channel, the two pump settings, the two ways
                of stalling a pump — and not by which number they write. Each group is a different lifecycle or
                timing property, and keeping them apart is what lets a reader point at one row and say what it
                demonstrates.
            -->
            <TextBlock Foreground="#ECF0F1" FontSize="15" FontWeight="Bold" Margin="2,0,0,6"
                       Text="同一个积分器,两条泵:Update 用实测的 dt,FixedUpdate 用恒定的步长"></TextBlock>

            <WrapPanel>
                <TextBlock Text="帧率" Foreground="#808080" FontSize="12" VerticalAlignment="Center" Margin="2,0,6,0"/>
                <Button Width="56" Height="30" Margin="1" Content="60" AutomationProperties.AutomationId="mono.btn.fps60" Click="Fps60"/>
                <Button Width="56" Height="30" Margin="1" Content="30" AutomationProperties.AutomationId="mono.btn.fps30" Click="Fps30"/>
                <Button Width="56" Height="30" Margin="1" Content="10" AutomationProperties.AutomationId="mono.btn.fps10" Click="Fps10"/>
                <Button Width="56" Height="30" Margin="1" Content="2" AutomationProperties.AutomationId="mono.btn.fps2" Click="Fps2"/>

                <TextBlock Text="固定步长" Foreground="#808080" FontSize="12" VerticalAlignment="Center" Margin="14,0,6,0"/>
                <Button Width="62" Height="30" Margin="1" Content="16 ms" AutomationProperties.AutomationId="mono.btn.step16" Click="Step16"/>
                <Button Width="62" Height="30" Margin="1" Content="33 ms" AutomationProperties.AutomationId="mono.btn.step33" Click="Step33"/>
                <Button Width="62" Height="30" Margin="1" Content="50 ms" AutomationProperties.AutomationId="mono.btn.step50" Click="Step50"/>

                <TextBlock Text="速率" Foreground="#808080" FontSize="12" VerticalAlignment="Center" Margin="14,0,6,0"/>
                <Button Width="52" Height="30" Margin="1" Content="0×" AutomationProperties.AutomationId="mono.btn.rate0" Click="Rate0"/>
                <Button Width="52" Height="30" Margin="1" Content="1×" AutomationProperties.AutomationId="mono.btn.rate1" Click="Rate1"/>
                <Button Width="52" Height="30" Margin="1" Content="2×" AutomationProperties.AutomationId="mono.btn.rate2" Click="Rate2"/>
                <Button Width="52" Height="30" Margin="1" Content="4×" AutomationProperties.AutomationId="mono.btn.rate4" Click="Rate4"/>
            </WrapPanel>

            <!--
                卡顿。这三个按钮是本演示的主题,区别不在"谁慢",而在欠下的东西用什么还:
                Update 里的睡眠欠的是一帧,下一帧一个巨大的 DeltaTime 还清;FixedUpdate 里的睡眠欠的是步,
                下一次 Advance 推一批步还清。所以前者屏幕上是一跳,后者屏幕上不动、日志里多出好几行。
            -->
            <WrapPanel Margin="0,4,0,0">
                <TextBlock Text="卡顿(在钩子里睡)" Foreground="#808080" FontSize="12" VerticalAlignment="Center" Margin="2,0,6,0"/>
                <Button Width="150" Height="30" Margin="1" Content="Update 里睡 300 ms" AutomationProperties.AutomationId="mono.btn.hitch.update" Click="HitchUpdate"/>
                <Button Width="150" Height="30" Margin="1" Content="FixedUpdate 里睡 200 ms" AutomationProperties.AutomationId="mono.btn.hitch.fixed" Click="HitchFixed"/>
                <Button Width="160" Height="30" Margin="1" Content="FixedUpdate 里睡 1500 ms" AutomationProperties.AutomationId="mono.btn.hitch.forgive" Click="HitchForgive"/>
                <TextBlock Text="(1500 ms 会让欠账超过 64 步上限,超出的部分被宽恕并永久丢失)" Foreground="#E67E22"
                           FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </WrapPanel>

            <WrapPanel Margin="0,4,0,0">
                <TextBlock Text="通道" Foreground="#808080" FontSize="12" VerticalAlignment="Center" Margin="2,0,6,0"/>
                <Button Width="72" Height="30" Margin="1" Content="启动" AutomationProperties.AutomationId="mono.btn.start" Click="StartChannel"/>
                <Button Width="72" Height="30" Margin="1" Content="停止" AutomationProperties.AutomationId="mono.btn.stop" Click="StopChannel"/>
                <Button Width="72" Height="30" Margin="1" Content="暂停" AutomationProperties.AutomationId="mono.btn.pause" Click="PauseChannel"/>
                <Button Width="72" Height="30" Margin="1" Content="恢复" AutomationProperties.AutomationId="mono.btn.resume" Click="ResumeChannel"/>

                <TextBlock Text="钩子" Foreground="#808080" FontSize="12" VerticalAlignment="Center" Margin="14,0,6,0"/>
                <!--
                    注销后重新注册会再触发一次 Awake 与 Start —— 引擎给新的包装器重新走一遍这两个钩子,而停止再
                    启动不会(计数器不变)。这是五个钩子里最锋利的一条对比,也是唯一一条只能从"注册"这一侧看到的。
                -->
                <Button x:Name="BtnUnregister" Width="88" Height="30" Margin="1" Content="注销" AutomationProperties.AutomationId="mono.btn.unregister" Click="Unregister"/>
                <Button x:Name="BtnRegister" Width="88" Height="30" Margin="1" Content="重新注册" IsEnabled="False" AutomationProperties.AutomationId="mono.btn.register" Click="RegisterAgain"/>
                <Button Width="88" Height="30" Margin="1" Content="重置两球" AutomationProperties.AutomationId="mono.btn.restart" Click="RestartBalls"/>
                <Button Width="88" Height="30" Margin="1" Content="清空日志" AutomationProperties.AutomationId="mono.btn.clear" Click="ClearLog"/>

                <CheckBox x:Name="ChkEveryHook" Content="记录每一帧" Foreground="#BDC3C7" FontSize="12"
                          VerticalAlignment="Center" Margin="14,0,0,0" Checked="EveryHookChanged" Unchecked="EveryHookChanged"
                          AutomationProperties.AutomationId="mono.chk.everyhook"/>
                <CheckBox x:Name="ChkHandled" Content="Update 里置 Handled" Foreground="#BDC3C7" FontSize="12"
                          VerticalAlignment="Center" Margin="10,0,0,0" Checked="HandledChanged" Unchecked="HandledChanged"
                          AutomationProperties.AutomationId="mono.chk.handled"/>
            </WrapPanel>

            <TextBlock x:Name="Lifecycle" FontFamily="Consolas" FontSize="12" Foreground="#ECF0F1" Margin="2,8,0,0"
                       AutomationProperties.AutomationId="mono.life" Text="生命周期"></TextBlock>
            <TextBlock x:Name="Ordering" FontFamily="Consolas" FontSize="12" Foreground="#BDC3C7" Margin="2,2,0,0"
                       AutomationProperties.AutomationId="mono.order" Text="次序"></TextBlock>
            <TextBlock x:Name="UpdatePump" FontFamily="Consolas" FontSize="12" Foreground="#3498DB" Margin="2,2,0,0"
                       AutomationProperties.AutomationId="mono.update" Text="Update 泵"></TextBlock>
            <TextBlock x:Name="FixedPump" FontFamily="Consolas" FontSize="12" Foreground="#E67E22" Margin="2,2,0,0"
                       AutomationProperties.AutomationId="mono.fixed" Text="FixedUpdate 泵"></TextBlock>
            <TextBlock x:Name="UnspentLine" FontFamily="Consolas" FontSize="12" Foreground="#2ECC71" Margin="2,2,0,0"
                       AutomationProperties.AutomationId="mono.unspent" Text="未交付时间"></TextBlock>
            <TextBlock x:Name="ChannelLine" FontFamily="Consolas" FontSize="12" Foreground="#BDC3C7" Margin="2,2,0,0"
                       AutomationProperties.AutomationId="mono.chan" Text="通道"></TextBlock>
            <TextBlock x:Name="HandledLine" FontFamily="Consolas" FontSize="12" Foreground="#BDC3C7" Margin="2,2,0,0"
                       AutomationProperties.AutomationId="mono.handled" Text="Handled"></TextBlock>

            <!-- The machine-readable twin of the readout: the same poll, the same values, but a fixed key=value
                 payload instead of prose, so a suite never has to parse a layout a designer may reformat.
                 折行仍然要给：Height=0 只让它不占版面,文本本身一个字都不能少。 -->
            <TextBlock x:Name="Payload" Height="0" FontFamily="Consolas" FontSize="10" Foreground="#808080"
                       TextWrapping="Wrap" AutomationProperties.AutomationId="mono.state" Text="v=1"></TextBlock>
        </StackPanel>

        <!--
            舞台。两球各自从地面线出发、落地即复位,所以画面里永远有它们 —— 而差多少一眼看出来的,是那条 ×10 的
            镜面条,不是两球本身:60 fps 与 16 ms 步长下它们的差不到一个像素,那正是闭式解 (g/2)·Σdt² 的预言。
            跟随环画在 Update 球的周围,由 LateUpdate 定位 —— 它唯一的工作就是被 Handled 冻住。
        -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
            <Border Background="#101010" BorderBrush="#333333" BorderThickness="1" VerticalAlignment="Top">
                <Canvas x:Name="Stage" Width="320" Height="320" ClipToBounds="True">
                    <Line x:Name="Floor" X1="0" Y1="300" X2="320" Y2="300" Stroke="#555555" StrokeThickness="1"></Line>
                    <Ellipse x:Name="Follower" Width="30" Height="30" Stroke="#2ECC71" StrokeThickness="1.5" Opacity="0.85"></Ellipse>
                    <Line x:Name="MirrorBar" X1="160" Y1="150" X2="160" Y2="150" Stroke="#2ECC71" StrokeThickness="4" Opacity="0.6"></Line>
                    <Ellipse x:Name="BallUpdate" Width="18" Height="18" Fill="#3498DB"></Ellipse>
                    <Ellipse x:Name="BallFixed" Width="18" Height="18" Fill="#E67E22"></Ellipse>
                    <TextBlock Canvas.Left="82" Canvas.Top="302" FontFamily="Consolas" FontSize="11" Foreground="#3498DB" Text="Update"></TextBlock>
                    <TextBlock Canvas.Left="176" Canvas.Top="302" FontFamily="Consolas" FontSize="11" Foreground="#E67E22" Text="FixedUpdate"></TextBlock>
                </Canvas>
            </Border>

            <!--
                舞台上写不下的前提全在这里,而且只写事实:每条都是本演示真的演示出来的,或者诚实地说明它演示不了。
            -->
            <TextBlock Width="900" TextWrapping="Wrap" FontSize="12" Foreground="#95A5A6" Margin="12,2,0,0" LineHeight="19">
                <Run FontWeight="Bold" Foreground="#BDC3C7">镜面条 = 两球高度差 × 10。</Run>
                <LineBreak/>两球同型号同积分器,<Run FontWeight="Bold" Foreground="#BDC3C7">唯一的区别是喂进去的 dt</Run>:Update 是实测的、不补偿;FixedUpdate 是恒定的、欠一步还一步。
                <LineBreak/><Run FontWeight="Bold" Foreground="#BDC3C7">偏差恒等式</Run>:从静止展开半隐式欧拉,<Run FontFamily="Consolas">Height − (g/2)t² = −(g/2)·Σdt²</Run> 对任意 dt 序列精确成立(恒为负),所以每条泵的 Σdt²/Σdt 就是它实际的步长。
                <LineBreak/><Run FontWeight="Bold" Foreground="#BDC3C7">落地即复位</Run>:越过地面线的整步被丢弃,所以步长大的那只会更早、更频繁地落地,几轮之后相位就分开了。
                <LineBreak/><Run FontWeight="Bold" Foreground="#BDC3C7">尖峰晚一帧</Run>:采样发生在钩子之前,所以 Update 里睡的觉不会记在本帧的 DeltaTime 上,而是下一帧一次性到账 —— 日志把两帧都标出来。
                <LineBreak/><Run FontWeight="Bold" Foreground="#BDC3C7">未交付时间不回落就是丢了步</Run>:它是固定泵手里"已经过去、却还没凑成一步"的时间。稳态必落在 <Run FontFamily="Consolas">[0, h)</Run> 内;改速率/步长/暂停会让采样器丢掉余数(epoch 变),它归零后重新爬;而欠账超过 64 步之后超出的部分被宽恕、永不偿还,于是它升上去就不再回来。
                <LineBreak/><Run FontWeight="Bold" Foreground="#BDC3C7">Σdt²/Σdt 会略高于目标间隔</Run>:dt 的抖动被 Σdt² 放大,所以它量的是泵真实的节拍,不是按钮上的数字 —— 包含 Windows 睡眠量化带来的误差。
                <LineBreak/><Run FontWeight="Bold" Foreground="#BDC3C7">每帧几步</Run>取一秒窗口内 Δ固定步数 / Δ帧数。它与 TargetFPS、与步长都无关:帧率从 60 掉到 2,它基本不变 —— 这就是"定步长泵跟帧率脱钩"的直接读数。
                <LineBreak/><Run FontWeight="Bold" Foreground="#BDC3C7">本通道只有一个行为</Run>,所以 Handled 只能演示"本帧的 LateUpdate 被跳过":没有排在后面的行为可跳。
            </TextBlock>
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0,6,0,0">
            <TextBlock x:Name="LogLine" DockPanel.Dock="Top" FontFamily="Consolas" FontSize="12" Foreground="#BDC3C7"
                       AutomationProperties.AutomationId="mono.logsummary" Text="钩子日志"></TextBlock>
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                <TextBlock x:Name="Log" FontFamily="Consolas" FontSize="11" Foreground="#95A5A6"
                           AutomationProperties.AutomationId="mono.log" Text=""></TextBlock>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
