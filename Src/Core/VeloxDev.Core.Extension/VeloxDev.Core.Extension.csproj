<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<IsTrimmable>false</IsTrimmable>
		<Title>VeloxDev.Core.Extension</Title>
		<Version>7.0.142</Version>
		<Authors>Axvser</Authors>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Description>Optional companion to the dependency-free VeloxDev.Core. Adds MAF-based Workflow Agent tools (60+ function-calling tools, MCP support) and runtime extensions for building AI-controllable workflow editors on WPF, Avalonia, WinUI, MAUI, WinForms, and Blazor/Razor.</Description>
		<PackageIcon>veloxdev-logo.png</PackageIcon>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
		<!-- MCP9007: MCP SDK obsolete-API diagnostic (AuthorizationRedirectDelegate retained for compatibility; RFC 9207 callback-handler migration is a separate SDK-upgrade task). -->
		<NoWarn>$(NoWarn);MCP9007</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CliWrap" Version="3.10.2" />
		<PackageReference Include="Microsoft.Agents.AI" Version="1.13.0" />
		<PackageReference Include="Microsoft.Extensions.AI" Version="10.8.0" />
		<PackageReference Include="ModelContextProtocol" Version="2.2.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<ProjectReference Include="../VeloxDev.Core/VeloxDev.Core.csproj" Condition="'$(Configuration)' == 'Debug'" />
		<PackageReference Include="VeloxDev.Core" Version="7.0.0" Condition="'$(Configuration)' != 'Debug'" />
	</ItemGroup>

	<ItemGroup>
	   <None Include="..\..\..\Assets\veloxdev-logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="BuildConfigs\VeloxDev.Core.Extension.props">
			<Pack>True</Pack>
			<PackagePath>buildTransitive\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Resources\**\*">
		<WithCulture>false</WithCulture>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="VeloxDev.Core.Extension.Test" />
	</ItemGroup>

</Project>
