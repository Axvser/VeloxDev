<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);MSTEST0032;MSTEST0037;CS0067</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VeloxDev.Core\VeloxDev.Core.csproj" />
  </ItemGroup>

  <!-- 签名覆盖测试要用 [VeloxCommand]，而 analyzer 不随 ProjectReference 传递。
       这里与别的项目不同，**不分 Debug/Release**：本项目的测试对象就是生成器源码本身，
       测一个已发布的快照等于没测。同时保留程序集引用（ReferenceOutputAssembly 默认 true），
       CommandSignatureDiagnosticsTests 要直接驱动 Command 生成器来断言它报的诊断。 -->
  <ItemGroup>
    <ProjectReference Include="..\..\Generators\VeloxDev.Core.Generator\VeloxDev.Core.Generator.csproj"
                      OutputItemType="Analyzer" />
    <!-- 版本与生成器自身编译所依赖的一致（见 VeloxDev.Core.Generator.csproj）；该版本在本机缓存中。 -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
