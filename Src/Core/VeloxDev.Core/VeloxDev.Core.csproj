<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<NoWarn>1573;1591;NU5104</NoWarn>
		<TargetFrameworks>netstandard2.0;netframework4.6.1;net5.0;netcoreapp3.0;net8.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<!-- net8.0 那一档是裁剪/AOT 契约的载体：IL2xxx/IL3xxx 在这里常开，
		     把「这个包在裁剪与 NativeAOT 下可用」写进程序集元数据交给消费方。
		     旧的几档不支持分析器，只能靠 net8.0 这一档替它们守。 -->
		<IsAotCompatible Condition="'$(TargetFramework)' == 'net8.0'">true</IsAotCompatible>
		<!-- 本程序集的 Agent 面属于框架侧：生成的分片挂在 Framework/ 根下，而不是 Customer/。 -->
		<VeloxAgentContextTreeRoot>Framework</VeloxAgentContextTreeRoot>
		<Title>VeloxDev.Core</Title>
		<Version>9.0.0</Version>
		<Authors>Axvser</Authors>
		<Description>Build modern, AI-controllable workflow editors on any .NET GUI — WPF, Avalonia, WinUI, MAUI ...</Description>
		<PackageIcon>veloxdev-logo.png</PackageIcon>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<RepositoryUrl>https://github.com/Axvser/VeloxDev</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://www.nuget.org/packages/VeloxDev.Core/</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
	</ItemGroup>

	<!-- MSBuild 属性默认不透给分析器，必须显式声明，否则生成器读到的永远是默认值。 -->
	<ItemGroup>
		<CompilerVisibleProperty Include="VeloxAgentContextTreeRoot" />
		<CompilerVisibleProperty Include="VeloxAgentContextTree" />
	</ItemGroup>

	<!-- Debug 用本地生成器源码，Release 用包。analyzer 不随 ProjectReference 传递，
	     所以用到生成器特性的项目都要各自重复这一对。 -->
	<ItemGroup>
		<ProjectReference Include="../../Generators/VeloxDev.Core.Generator/VeloxDev.Core.Generator.csproj"
		                  OutputItemType="Analyzer"
		                  ReferenceOutputAssembly="false"
		                  Condition="'$(Configuration)' == 'Debug'" />
		<PackageReference Include="VeloxDev.Core.Generator" Version="9.0.0"
		                  Condition="'$(Configuration)' != 'Debug'" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\..\Assets\veloxdev-logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\..\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
