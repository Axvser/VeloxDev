<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<NoWarn>1573;1591;NU5104</NoWarn>
		<TargetFrameworks>netstandard2.0;netframework4.6.1;net5.0;netcoreapp3.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<IsTrimmable>false</IsTrimmable>
		<Title>VeloxDev.Core</Title>
		<Version>9.0.0</Version>
		<Authors>Axvser</Authors>
		<Description>Build modern, AI-controllable workflow editors on any .NET GUI — WPF, Avalonia, WinUI, MAUI ...</Description>
		<PackageIcon>veloxdev-logo.png</PackageIcon>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<RepositoryUrl>https://github.com/Axvser/VeloxDev</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://www.nuget.org/packages/VeloxDev.Core/</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
		<!-- Resolved from nuget.org in a normal build. A local generator change cannot be wired in
		     here: an analyzer passed by ProjectReference never reaches WPF's generated
		     *_wpftmp.csproj (it takes analyzers from the NuGet asset graph), so every WPF consumer
		     fails with CS9248. Verify generator changes in a throwaway project that references the
		     built DLLs and attaches bin\...\VeloxDev.Core.Generator.dll as <Analyzer>.
		     This pins Generator 9.0.0, so VeloxDev.Core stops restoring until that package exists:
		     publish VeloxDev.Core.Generator 9.0.0 BEFORE packing VeloxDev.Core 9.0.0. -->
		<PackageReference Include="VeloxDev.Core.Generator" Version="9.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\..\Assets\veloxdev-logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\..\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="BuildConfigs\VeloxDev.Core.props">
			<Pack>True</Pack>
			<PackagePath>buildTransitive\</PackagePath>
		</None>
	</ItemGroup>

</Project>
