<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- MAUI 不能在控制台宿主里跑：这家要一台自己的 Windows 应用，把同一份
		     HeadedBenchmarkCore 跑在真实窗口上。TFM 与适配器/示例保持一致。 -->
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>VeloxDev.Adapters.Benchmarks.MAUI</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<NoWarn>$(NoWarn);CA1416;CS1591</NoWarn>

		<ApplicationTitle>VeloxDev MAUI view pipeline benchmark</ApplicationTitle>
		<ApplicationId>dev.velox.benchmarks.maui</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<WindowsPackageType>None</WindowsPackageType>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_BREAK_ON_UNHANDLED_EXCEPTION</DefineConstants>
		<!-- 与适配器固定的 10.0.20 对齐；$(MauiVersion) 默认值取自工作负载，两者不一致会 NU1605。-->
		<MauiVersion>10.0.20</MauiVersion>

		<!-- 验证工程：不打包、不被 dotnet test 发现。-->
		<IsPackable>false</IsPackable>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>

	<ItemGroup>
		<!-- 只在 Debug 构建/运行：适配器 Release 配置引用 NuGet 上的旧 Core，
		     基准必须量当前源码里的新视图管线。-->
		<ProjectReference Include="..\..\Core\VeloxDev.Core\VeloxDev.Core.csproj" />
		<ProjectReference Include="..\..\Adapters\VeloxDev.MAUI\VeloxDev.MAUI.csproj" />
		<ProjectReference Include="..\VeloxDev.Adapters.Benchmarks.Headed\VeloxDev.Adapters.Benchmarks.Headed.csproj" />
	</ItemGroup>

</Project>
