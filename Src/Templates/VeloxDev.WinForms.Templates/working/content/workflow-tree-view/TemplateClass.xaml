<!-- VeloxDev customization: generate the sibling views, then update the local type names if you renamed them. -->
<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hosting="clr-namespace:VeloxDev.WorkflowSystem.VisualHosting;assembly=VeloxDev.WinForms"
    x:Class="TemplateNamespace.TemplateClass"
    BackColor="TemplateSurfaceBackground">

  <!-- VeloxDev customization: the HWND-free surface; assign an ITreeComponent to ViewModel to render a tree. -->
  <Panel Dock="Fill" BackColor="TemplateSurfaceBackground">
    <hosting:VisualWorkflowSurface x:Name="workflowHost" Dock="Fill" />
  </Panel>

</UserControl>
