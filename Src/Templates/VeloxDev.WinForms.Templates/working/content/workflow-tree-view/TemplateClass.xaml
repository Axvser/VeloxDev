<!-- VeloxDev customization: generate the sibling views, then update the local type names if you renamed them. -->
<v:UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TemplateNamespace"
    xmlns:v="clr-namespace:VeloxDev.WinForms.Xaml;assembly=VeloxDev.WinForms"
    xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.WinForms"
    x:Class="TemplateNamespace.TemplateClass"
    BackColor="TemplateSurfaceBackground"
    behaviors:WorkflowSurfaceBehavior.IsEnabled="True"
    behaviors:WorkflowSurfaceBehavior.ZoomEnabled="True"
    behaviors:WorkflowSurfaceBehavior.TemplateSelector="{StaticResource WorkflowTemplateSelector}"
    behaviors:WorkflowSurfaceBehavior.ScrollViewerName="PART_ScrollViewer"
    behaviors:WorkflowSurfaceBehavior.CanvasName="PART_Canvas"
    behaviors:WorkflowSurfaceBehavior.GridDecoratorName="PART_GridDecorator"
    behaviors:WorkflowSurfaceBehavior.MinimapOverlayName="PART_MinimapOverlay"
    behaviors:WorkflowSurfaceBehavior.PointerPressSourceName="PART_Surface">

  <!-- VeloxDev customization: keep the PART_* names in step with the attached properties above. -->

  <v:UserControl.Resources>
    <v:ResourceDictionary>
      <v:DataTemplate x:Key="NodeTemplate">
        <local:NodeView />
      </v:DataTemplate>
      <v:DataTemplate x:Key="LinkTemplate">
        <local:LinkView />
      </v:DataTemplate>
      <!-- VeloxDev customization: choose the view each pooled item kind gets. -->
      <local:CustomTemplateSelector x:Key="WorkflowTemplateSelector"
                              NodeTemplate="{StaticResource NodeTemplate}"
                              LinkTemplate="{StaticResource LinkTemplate}" />
      <!-- VeloxDev customization: restyle the surface scroll bars here. -->
      <v:Style x:Key="SurfaceScrollBarStyle" TargetType="v:ScrollBar">
        <v:Style.Setters>
          <v:Setter Property="TrackBrush" Value="#22FFFFFF" />
          <v:Setter Property="ThumbBrush" Value="#66FFFFFF" />
          <v:Setter Property="ThumbHoverBrush" Value="#AAFFFFFF" />
          <v:Setter Property="ThumbBorderBrush" Value="#30FFFFFF" />
          <v:Setter Property="ThumbBorderThickness" Value="1" />
          <v:Setter Property="ThumbCornerRadius" Value="6" />
          <v:Setter Property="BarThickness" Value="12" />
          <v:Setter Property="ThumbMinLength" Value="24" />
        </v:Style.Setters>
      </v:Style>
    </v:ResourceDictionary>
  </v:UserControl.Resources>

  <v:Panel x:Name="surfaceHost"
           Name="PART_Surface"
           Dock="Fill"
           BackColor="TemplateSurfaceBackground">
    <local:GridDecorator x:Name="gridDecorator"
                         Name="PART_GridDecorator"
                         Dock="Fill"
                         GridBackground="TemplateSurfaceBackground"
                         SurfaceBorderBrush="TemplateSurfaceBorderBrush"
                         SurfaceBorderThickness="TemplateSurfaceBorderThickness"
                         SurfaceCornerRadius="TemplateSurfaceCornerRadius">
      <v:ScrollViewer x:Name="surfaceScrollHost"
                      Name="PART_ScrollViewer"
                      Dock="Fill"
                      BackColor="Transparent"
                      BarThickness="12"
                      HorizontalBarStyle="{StaticResource SurfaceScrollBarStyle}"
                      VerticalBarStyle="{StaticResource SurfaceScrollBarStyle}">
        <local:SurfaceCanvas x:Name="surfaceCanvas"
                             Name="PART_Canvas"
                             Dock="Fill"
                             behaviors:WorkflowLinkLayer.IsEnabled="True"
                             behaviors:WorkflowLinkLayer.LineColor="#DDFFFFFF"
                             behaviors:WorkflowLinkLayer.Thickness="2" />
      </v:ScrollViewer>
    </local:GridDecorator>

    <local:MinimapOverlay x:Name="minimapOverlay"
                          Name="PART_MinimapOverlay" />
  </v:Panel>

</v:UserControl>
