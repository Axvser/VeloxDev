<local:TemplateClass
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.WinForms"
    xmlns:local="clr-namespace:TemplateNamespace"
    x:Class="TemplateNamespace.TemplateClass"
    IsHitTestVisible="True"
    behaviors:WorkflowSlotLayoutBehavior.IsEnabled="True"
    behaviors:WorkflowSlotLayoutBehavior.SlotNames="PART_InputSlot"
    behaviors:WorkflowSlotLayoutBehavior.SlotEnumeratorNames="PART_OutputSlots"
    behaviors:WorkflowSlotLayoutBehavior.CoordinateHostName="PART_Canvas"
    ClipToBounds="False">

  <!-- VeloxDev customization: customize the card content; PART_InputSlot and PART_OutputSlots are the slot parts.
       The root is a visual UserControl rendered by the workflow surface inside VisualHost. -->
  <Viewbox Stretch="Uniform">
    <Grid Width="260" Height="180" ClipToBounds="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="36" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Backdrop behind the semi-transparent card; the card background is the node background below. -->
      <Border Grid.RowSpan="2"
              Background="TemplateSurfaceBackground"
              CornerRadius="TemplateNodeCornerRadius" />

      <Border Grid.RowSpan="2"
              Background="TemplateNodeBackground"
              BorderBrush="TemplateNodeBorderBrush"
              BorderThickness="TemplateNodeBorderThickness"
              CornerRadius="TemplateNodeCornerRadius" />

      <Grid Grid.Row="0" Background="Transparent"
              behaviors:WorkflowNodeDragBehavior.IsEnabled="True"
              behaviors:WorkflowNodeDragBehavior.CoordinateHostName="PART_Canvas">
        <TextBlock Text="{Binding Name}"
                   Foreground="TemplateNodeForeground"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="12,0" />
      </Grid>

      <Grid Grid.Row="1" Panel.ZIndex="6" ClipToBounds="False">
        <local:SlotView x:Name="PART_InputSlot"
                        DataContext="{Binding InputSlot}"
                        Width="18"
                        Height="18"
                        Margin="2,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center" />
      </Grid>

      <ItemsControl x:Name="PART_OutputSlots"
                    ItemsSource="{Binding OutputSlots.Items}"
                    Grid.Row="1"
                    Margin="12,6"
                    VerticalAlignment="Center">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,3" ClipToBounds="False">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Name}"
                         Foreground="TemplateNodeForeground"
                         Margin="0,0,10,0"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center" />
              <local:SlotView DataContext="{Binding Slot}"
                              Grid.Column="1"
                              Width="14"
                              Height="14"
                              Margin="0" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Viewbox>

</local:TemplateClass>
