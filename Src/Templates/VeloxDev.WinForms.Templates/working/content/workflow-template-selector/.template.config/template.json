{
  "$schema": "http://json.schemastore.org/template",
  "author": "Axvser",
  "classifications": [
    "VeloxDev",
    "Workflow",
    "WinForms",
    "Code"
  ],
  "identity": "VeloxDev.WinForms.WorkflowTemplateSelector",
  "name": "VeloxDev WinForms Workflow Template Selector",
  "description": "A WinForms TemplateSelector for VeloxDev node, slot, link, and tree view models.",
  "shortName": "winforms-v-selector",
  "sourceName": "TemplateClass",
  "defaultName": "CustomTemplateSelector",
  "preferNameDirectory": false,
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "symbols": {
    "namespace": {
      "type": "parameter",
      "datatype": "text",
      "description": "Namespace for the generated selector.",
      "defaultValue": "MyApp.Views",
      "replaces": "TemplateNamespace"
    }
  },
  "primaryOutputs": [
    {
      "path": "TemplateClass.cs"
    }
  ]
}
