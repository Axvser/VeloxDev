<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.WinForms"
    x:Class="TemplateNamespace.TemplateClass"
    Background="TemplateSlotBackground">

  <!-- VeloxDev customization: the connector glyph is this path; the state colours are assigned in code-behind. -->
  <Path x:Name="RootPath"
          Dock="Fill"
          Margin="0"
          Stretch="Uniform"
          behaviors:WorkflowSlotConnectionBehavior.IsEnabled="True"
          Data="TemplateSlotPath"
          Fill="TemplateSlotColor" />

</UserControl>
