<local:TemplateClass
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.WinForms"
    xmlns:local="clr-namespace:TemplateNamespace"
    x:Class="TemplateNamespace.TemplateClass"
    Background="TemplateSlotBackground"
    IsHitTestVisible="True"
    ClipToBounds="False"
    behaviors:WorkflowSlotConnectionBehavior.IsEnabled="True">
  <local:TemplateClass.Resources>
    <behaviors:SlotStateBrushConverter x:Key="SlotStateBrush"
                                       StandByColor="TemplateSlotColor"
                                       BorderColor="TemplateSlotBorderColor" />
  </local:TemplateClass.Resources>

  <!-- VeloxDev customization: this visual UserControl draws the connector; the engine writes PART_Glyph.Fill
       from the slot's model state, so the code-behind stays at InitializeComponent(). -->
  <Viewbox Stretch="Uniform">
    <!-- The outline width is in the glyph's 1024-unit space; the Viewbox scales it with the icon. -->
    <Path x:Name="PART_Glyph"
          Fill="{Binding State, Converter={StaticResource SlotStateBrush}}"
          Stroke="{Binding State, Converter={StaticResource SlotStateBrush}, ConverterParameter=Border}"
          StrokeThickness="48"
          Data="TemplateSlotPath" />
  </Viewbox>

</local:TemplateClass>
