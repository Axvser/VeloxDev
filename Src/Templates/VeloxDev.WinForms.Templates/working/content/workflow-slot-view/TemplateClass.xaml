<local:TemplateClass
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.WinForms"
    xmlns:local="clr-namespace:TemplateNamespace"
    x:Class="TemplateNamespace.TemplateClass"
    Background="TemplateSlotBackground"
    IsHitTestVisible="True"
    ClipToBounds="False"
    behaviors:WorkflowSlotConnectionBehavior.IsEnabled="True">
  <!-- VeloxDev customization: replace the fixed glyph colour with your own. -->
  <Ellipse x:Name="PART_Glyph"
           Fill="TemplateSlotColor"
           Stroke="TemplateSlotBorderColor"
           StrokeThickness="1.5" />

</local:TemplateClass>
