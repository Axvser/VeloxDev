@namespace TemplateNamespace
@using VeloxDev.WorkflowSystem
@using VeloxDev.WorkflowSystem.AttachedBehaviors
@using TemplateNamespace
@* VeloxDev customization: Generate the Node, Slot, Link, selector, minimap, and grid-decorator templates, then update the type names below if you renamed them. *@

@if (Tree is not null)
{
    <WorkflowSurfaceBehavior Tree="Tree"
                             IsEnabled="true"
                             ZoomEnabled="true"
                             ScrollViewerId="@ScrollViewerId"
                             CanvasId="@CanvasId"
                             GridSpacing="@GridSpacing"
                             GridColor="@MinorGridColor"
                             Background="@Background">
        <GridDecorator Context="vp">
            <GridDecorator Viewport="vp"
                           RulerThickness="28"
                           GridSpacing="@GridSpacing"
                           RulerBackground="@RulerBackground"
                           RulerTickColor="@RulerTickColor"
                           RulerDividerColor="@RulerDividerColor" />
        </GridDecorator>
        <Minimap Context="vp">
            <MinimapOverlay Viewport="vp"
                            Width="180" Height="120"
                            ScrollViewerId="@ScrollViewerId" />
        </Minimap>
        <ChildContent Context="sc">
            @* VeloxDev customization: assign the view each component gets here — the pooled layer below
               renders every visible node and link (the gesture's virtual link included); swap the selector
               or the two templates to change which view a component gets. *@
            <TemplateSelector Items="Tree.GetHelper().VisibleItems" KeySelector="i => i"
                              NodeTemplate="NodeTemplate ?? RenderGenericNode"
                              LinkTemplate="RenderGenericLink(sc)" />
        </ChildContent>
    </WorkflowSurfaceBehavior>
}

@code {
    // Link template for the pooled layer: swap it for your own markup, and keep the wrapper
    // non-interactive — the surface's canvas gestures rely on that.
    private static RenderFragment<IWorkflowLinkViewModel> RenderGenericLink(SurfaceCanvas canvas)
        => link => @<div style="display:contents;pointer-events:none;">
                        <LinkView Link="link" CanvasWidth="@canvas.Width" CanvasHeight="@canvas.Height" />
                    </div>;

    /// <summary>
    /// Default node template used when the caller does not supply <see cref="TemplateClass.NodeTemplate"/>:
    /// the generated <c>NodeView</c> with input/output slot hosts populated generically
    /// from <c>Node.Slots</c> (channel-based input/output split).
    /// </summary>
    private RenderFragment<IWorkflowNodeViewModel> RenderGenericNode => node => @<text>
        @{ var names = SlotNamesOf(node); }
        <NodeView Node="node" Tree="Tree" AllowOverflow="true">
            <InputSlots>
                @* SlotView already opens the connection behavior for its slot; do not wrap it in
                   another one (a double-stamped wrapper doubles the measured anchors and the
                   connection gesture handlers). *@
                @foreach (var slot in InputSlotsOf(node))
                {
                    <SlotView Slot="slot" Tree="Tree" SlotSize="18" />
                }
            </InputSlots>
            <OutputSlots>
                @foreach (var slot in OutputSlotsOf(node))
                {
                    names.TryGetValue(slot, out var name);
                    <div style="display:flex;align-items:center;">
                        @if (name is not null)
                        {
                            <span style="margin-left:auto;margin-right:8px;color:@NodeForegroundCss;font-size:11px;white-space:nowrap;">@name</span>
                        }
                        <SlotView Slot="slot" Tree="Tree" SlotSize="14" />
                    </div>
                }
            </OutputSlots>
        </NodeView>
    </text>;
}
