@namespace TemplateNamespace
@using VeloxDev.WorkflowSystem
@using VeloxDev.WorkflowSystem.AttachedBehaviors
@using TemplateNamespace
@* VeloxDev customization: generate the sibling views, then update the type names if you renamed them. *@

@if (Tree is not null)
{
    <div style="position:relative;width:100%;height:100%;">
        <WorkflowSurfaceBehavior Tree="Tree"
                                 IsEnabled="true"
                                 ZoomEnabled="true"
                                 ScrollViewerId="@ScrollViewerId"
                                 CanvasId="@CanvasId"
                                 GridSpacing="@GridSpacing"
                                 GridColor="@WorkflowPresentation.MinorGridColor"
                                 Background="TemplateSurfaceBackground">
            <GridDecorator Context="vp">
                <GridDecorator Viewport="vp"
                               RulerThickness="28"
                               GridSpacing="@GridSpacing"
                               RulerBackground="@WorkflowPresentation.RulerBackground"
                               RulerTickColor="@WorkflowPresentation.RulerTickColor"
                               RulerDividerColor="@WorkflowPresentation.RulerDividerColor" />
            </GridDecorator>
            <Minimap Context="vp">
                <MinimapOverlay Viewport="vp"
                                Width="180" Height="120"
                                ScrollViewerId="@ScrollViewerId" />
            </Minimap>
            <ChildContent Context="sc">
                @* VeloxDev customization: choose the view each component gets. *@
                <TemplateSelector Items="Tree.GetHelper().VisibleItems" KeySelector="i => i"
                                  NodeTemplate="NodeTemplate ?? RenderGenericNode"
                                  LinkTemplate="RenderGenericLink(sc)" />
            </ChildContent>
            @* VeloxDev customization: add or remove the link menu's entries; each entry receives the pressed link. *@
            <LinkMenu Context="link">
            </LinkMenu>
        </WorkflowSurfaceBehavior>
    </div>
}

@code {
    // VeloxDev customization: swap this template for your own; keep the wrapper non-interactive.
    private static RenderFragment<ILinkComponent> RenderGenericLink(SurfaceCanvas canvas)
        => link => @<div style="display:contents;pointer-events:none;">
                        <LinkView Link="link" CanvasWidth="@canvas.Width" CanvasHeight="@canvas.Height" />
                    </div>;

    /// <summary>Default node template used when the caller does not supply <see cref="TemplateClass.NodeTemplate"/>.</summary>
    private RenderFragment<INodeComponent> RenderGenericNode => node => @<text>
        @{ var names = WorkflowPresentation.SlotNamesOf(node); }
        <NodeView Node="node" Tree="Tree" AllowOverflow="true">
            <InputSlots>
                @* SlotView already opens the connection behavior; do not wrap it in another pointer target. *@
                @foreach (var slot in WorkflowPresentation.InputSlotsOf(node))
                {
                    <SlotView Slot="slot" Tree="Tree" SlotSize="18" />
                }
            </InputSlots>
            <OutputSlots>
                @foreach (var slot in WorkflowPresentation.OutputSlotsOf(node))
                {
                    names.TryGetValue(slot, out var name);
                    <div style="display:flex;align-items:center;">
                        @if (name is not null)
                        {
                            <span style="margin-left:auto;margin-right:8px;color:@WorkflowPresentation.NodeForegroundCss;font-size:11px;white-space:nowrap;">@name</span>
                        }
                        <SlotView Slot="slot" Tree="Tree" SlotSize="14" />
                    </div>
                }
            </OutputSlots>
        </NodeView>
    </text>;
}
