@namespace TemplateNamespace
@using VeloxDev.WorkflowSystem
@using VeloxDev.WorkflowSystem.AttachedBehaviors
@* VeloxDev customization: Customize the slot connector markup and styles here; keep the WorkflowSlotConnectionBehavior wrapper. *@

@if (Slot is not null)
{
    <WorkflowSlotConnectionBehavior Slot="Slot" Tree="Tree" IsEnabled="true" Style="@Style">
        <svg class="veloxdev-wf-slot-svg"
             width="@(SlotSizeCss)" height="@(SlotSizeCss)"
             viewBox="0 0 1024 1024">
            <path d="TemplateSlotPath"
                  fill="@FillColor"
                  stroke="@StrokeColor"
                  stroke-width="8"
                  stroke-linejoin="round" />
        </svg>
    </WorkflowSlotConnectionBehavior>
}
