{
  "$schema": "http://json.schemastore.org/template",
  "author": "Axvser",
  "classifications": [
    "VeloxDev",
    "Workflow",
    "Razor",
    "Blazor",
    "Code"
  ],
  "identity": "VeloxDev.Razor.WorkflowGridDecorator",
  "name": "VeloxDev Razor Workflow Grid Decorator",
  "description": "A lightweight Razor/Blazor workflow grid implementing IWorkflowGridDecorator.",
  "shortName": "razor-v-decorator",
  "sourceName": "TemplateClass",
  "defaultName": "GridDecorator",
  "preferNameDirectory": false,
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "symbols": {
    "namespace": {
      "type": "parameter",
      "datatype": "text",
      "description": "Namespace for the generated decorator.",
      "defaultValue": "MyApp.Views",
      "replaces": "TemplateNamespace"
    },
    "axisColor": {
      "type": "parameter",
      "datatype": "text",
      "description": "Grid axis color.",
      "defaultValue": "#4D4D4D",
      "replaces": "TemplateAxisColor"
    },
    "gridSpacing": {
      "type": "parameter",
      "datatype": "text",
      "description": "Minor grid spacing.",
      "defaultValue": "40d",
      "replaces": "TemplateGridSpacing"
    },
    "majorLineEvery": {
      "type": "parameter",
      "datatype": "text",
      "description": "Number of minor cells between major lines.",
      "defaultValue": "5",
      "replaces": "TemplateMajorLineEvery"
    },
    "rulerBackground": {
      "type": "parameter",
      "datatype": "text",
      "description": "Ruler area background color.",
      "defaultValue": "#C8252526",
      "replaces": "TemplateRulerBackground"
    },
    "rulerTickColor": {
      "type": "parameter",
      "datatype": "text",
      "description": "Ruler tick mark color.",
      "defaultValue": "#555555",
      "replaces": "TemplateRulerTickColor"
    },
    "rulerLabelColor": {
      "type": "parameter",
      "datatype": "text",
      "description": "Ruler label text color.",
      "defaultValue": "#888888",
      "replaces": "TemplateRulerLabelColor"
    },
    "rulerDividerColor": {
      "type": "parameter",
      "datatype": "text",
      "description": "Divider line between ruler and content area.",
      "defaultValue": "#3A3D40",
      "replaces": "TemplateRulerDividerColor"
    },
    "gridBackground": {
      "type": "parameter",
      "datatype": "text",
      "description": "Grid surface background color. Accepted for cross-GUI CLI parity; this GUI's decorator does not paint the surface background.",
      "defaultValue": "#1E1E1E"
    },
    "minorGridColor": {
      "type": "parameter",
      "datatype": "text",
      "description": "Minor grid line color. Accepted for cross-GUI CLI parity when the decorator draws rulers only.",
      "defaultValue": "#2A2D2E"
    },
    "majorGridColor": {
      "type": "parameter",
      "datatype": "text",
      "description": "Major grid line color. Accepted for cross-GUI CLI parity when the decorator draws rulers only.",
      "defaultValue": "#3A3D40"
    }
  },
  "primaryOutputs": [
    {
      "path": "TemplateClass.razor"
    },
    {
      "path": "TemplateClass.razor.cs"
    }
  ]
}
