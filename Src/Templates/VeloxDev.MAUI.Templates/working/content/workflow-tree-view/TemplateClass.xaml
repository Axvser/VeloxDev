<?xml version="1.0" encoding="utf-8" ?>
<!-- VeloxDev customization: Generate the Node, Slot, Link, selector, minimap, and grid-decorator templates, then update the local type names below if you renamed them. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TemplateNamespace"
             xmlns:behaviors="clr-namespace:VeloxDev.WorkflowSystem.AttachedBehaviors;assembly=VeloxDev.MAUI"
             x:Class="TemplateNamespace.TemplateClass"
             x:Name="Root"
             behaviors:WorkflowSurfaceBehavior.IsEnabled="True"
             behaviors:WorkflowSurfaceBehavior.ZoomEnabled="True"
             behaviors:WorkflowSurfaceBehavior.ScrollViewerName="PART_ScrollViewer"
             behaviors:WorkflowSurfaceBehavior.CanvasName="PART_Canvas"
             behaviors:WorkflowSurfaceBehavior.GridDecoratorName="PART_GridDecorator"
             behaviors:WorkflowSurfaceBehavior.PointerPressSourceName="PART_SurfaceBorder"
             behaviors:WorkflowSurfaceBehavior.MinimapOverlayName="PART_MinimapOverlay">
    <ContentView.Resources>
        <DataTemplate x:Key="NodeTemplate">
            <local:NodeView WidthRequest="{Binding Size.Width}" HeightRequest="{Binding Size.Height}" />
        </DataTemplate>
        <!-- Links are NOT pooled anymore: the shared link layer renders them in one viewport-sized
             GraphicsView (see LinkView below), so the pool only materializes node views and the
             selector needs no LinkTemplate. -->
        <local:TemplateSelector x:Key="WorkflowTemplateSelector" NodeTemplate="{StaticResource NodeTemplate}" />
    </ContentView.Resources>

    <Grid>
        <Border x:Name="PART_SurfaceBorder"
                Stroke="TemplateSurfaceBorderBrush"
                StrokeThickness="TemplateSurfaceBorderThickness"
                StrokeShape="RoundRectangle TemplateSurfaceCornerRadius"
                BackgroundColor="TemplateSurfaceBackground">
            <local:GridDecorator x:Name="PART_GridDecorator">
                <!-- Viewport-sized link layer (sibling of the scroll viewer, never inside the growing
                     world canvas → no Win2D texture cap on deep zoom). One GraphicsView draw at
                     px = Ruler + anchor + ContentOffset − Scroll. z order: grid < links < nodes < rulers. -->
                <local:LinkView WorkflowTree="{Binding BindingContext, Source={x:Reference Root}}"
                                ScrollOffsetX="{Binding ScrollOffsetX, Source={x:Reference PART_GridDecorator}}"
                                ScrollOffsetY="{Binding ScrollOffsetY, Source={x:Reference PART_GridDecorator}}"
                                ContentOffsetX="{Binding ContentOffsetX, Source={x:Reference PART_GridDecorator}}"
                                ContentOffsetY="{Binding ContentOffsetY, Source={x:Reference PART_GridDecorator}}"
                                RulerThickness="{Binding RulerThickness, Source={x:Reference PART_GridDecorator}}"
                                StrokeWidth="2" />
                <ScrollView x:Name="PART_ScrollViewer"
                            Orientation="Both">
                    <AbsoluteLayout x:Name="PART_RulerOffsetHost"
                                    TranslationX="{Binding RulerThickness, Source={x:Reference PART_GridDecorator}}"
                                    TranslationY="{Binding RulerThickness, Source={x:Reference PART_GridDecorator}}">
                        <AbsoluteLayout x:Name="PART_Canvas"
                                        BackgroundColor="Transparent"
                                        behaviors:ViewPool.ItemsSource="{Binding NodeItemsSource, Source={x:Reference Root}}"
                                        behaviors:ViewPool.TemplateSelector="{StaticResource WorkflowTemplateSelector}" />
                    </AbsoluteLayout>
                </ScrollView>
            </local:GridDecorator>
        </Border>
        <local:MinimapOverlay x:Name="PART_MinimapOverlay"
                              HorizontalOptions="End"
                              VerticalOptions="Start"
                              Margin="0,12,12,0"
                              ScrollViewerName="PART_ScrollViewer" />
    </Grid>
</ContentView>
