{
  "$schema": "http://json.schemastore.org/template",
  "author": "Axvser",
  "classifications": [
    "VeloxDev",
    "Workflow",
    "Jalium"
  ],
  "identity": "VeloxDev.Jalium.WorkflowMinimapOverlay",
  "name": "VeloxDev Jalium Workflow Minimap Overlay",
  "description": "A styled minimap overlay for a Jalium.UI workflow surface.",
  "shortName": "jalium-v-minimap",
  "sourceName": "TemplateClass",
  "defaultName": "MinimapOverlay",
  "preferNameDirectory": false,
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "symbols": {
    "namespace": {
      "type": "parameter",
      "datatype": "text",
      "description": "Namespace for the generated view.",
      "defaultValue": "VeloxDevWorkflowDemo",
      "replaces": "TemplateNamespace"
    },
    "minimapBackground": {
      "type": "parameter",
      "datatype": "text",
      "description": "Minimap background.",
      "defaultValue": "#D2141922",
      "replaces": "TemplateMinimapBackground"
    },
    "minimapBorder": {
      "type": "parameter",
      "datatype": "text",
      "description": "Minimap border color.",
      "defaultValue": "#DC94A3B8",
      "replaces": "TemplateMinimapBorder"
    },
    "nodeFill": {
      "type": "parameter",
      "datatype": "text",
      "description": "Node rectangle fill.",
      "defaultValue": "#DC38BDF8",
      "replaces": "TemplateNodeFill"
    },
    "viewportStroke": {
      "type": "parameter",
      "datatype": "text",
      "description": "Viewport rectangle stroke.",
      "defaultValue": "#F0FFFFFF",
      "replaces": "TemplateViewportStroke"
    }
  },
  "primaryOutputs": [
    {
      "path": "TemplateClass.cs"
    }
  ]
}