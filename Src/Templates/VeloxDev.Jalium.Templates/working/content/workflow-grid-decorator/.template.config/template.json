{
  "$schema": "http://json.schemastore.org/template",
  "author": "Axvser",
  "classifications": [
    "VeloxDev",
    "Workflow",
    "Jalium"
  ],
  "identity": "VeloxDev.Jalium.WorkflowGridDecorator",
  "name": "VeloxDev Jalium Workflow Grid Decorator",
  "description": "A styled grid decorator for a Jalium.UI workflow surface.",
  "shortName": "jalium-v-decorator",
  "sourceName": "TemplateClass",
  "defaultName": "GridDecorator",
  "preferNameDirectory": false,
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "symbols": {
    "namespace": {
      "type": "parameter",
      "datatype": "text",
      "description": "Namespace for the generated view.",
      "defaultValue": "MyApp.Views",
      "replaces": "TemplateNamespace"
    },
    "minorGridColor": {
      "type": "parameter",
      "datatype": "text",
      "description": "Minor grid line color.",
      "defaultValue": "#2A2D2E",
      "replaces": "TemplateMinorGridColor"
    },
    "majorGridColor": {
      "type": "parameter",
      "datatype": "text",
      "description": "Major grid line color.",
      "defaultValue": "#3A3D40",
      "replaces": "TemplateMajorGridColor"
    },
    "axisColor": {
      "type": "parameter",
      "datatype": "text",
      "description": "Axis line color.",
      "defaultValue": "#4D4D4D",
      "replaces": "TemplateAxisColor"
    },
    "gridSpacing": {
      "type": "parameter",
      "datatype": "text",
      "description": "Grid spacing in world units.",
      "defaultValue": "40d",
      "replaces": "TemplateGridSpacing"
    },
    "majorLineEvery": {
      "type": "parameter",
      "datatype": "text",
      "description": "Major line every N minor lines.",
      "defaultValue": "5",
      "replaces": "TemplateMajorLineEvery"
    },
    "rulerBackground": {
      "type": "parameter",
      "datatype": "text",
      "description": "Ruler band background.",
      "defaultValue": "#C8252526",
      "replaces": "TemplateRulerBackground"
    },
    "rulerTickColor": {
      "type": "parameter",
      "datatype": "text",
      "description": "Ruler tick color.",
      "defaultValue": "#555555",
      "replaces": "TemplateRulerTickColor"
    },
    "rulerLabelColor": {
      "type": "parameter",
      "datatype": "text",
      "description": "Ruler label color.",
      "defaultValue": "#888888",
      "replaces": "TemplateRulerLabelColor"
    },
    "rulerDividerColor": {
      "type": "parameter",
      "datatype": "text",
      "description": "Ruler divider line color.",
      "defaultValue": "#3A3D40",
      "replaces": "TemplateRulerDividerColor"
    },
    "gridBackground": {
      "type": "parameter",
      "datatype": "text",
      "description": "Grid surface background color. Accepted for cross-GUI CLI parity; this GUI's decorator does not paint the surface background.",
      "defaultValue": "#1E1E1E"
    }
  },
  "primaryOutputs": [
    {
      "path": "TemplateClass.cs"
    }
  ]
}
