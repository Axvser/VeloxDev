<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- 一个属性，不要拆两行：MSBuild 后写覆盖前写，拆开会静默丢掉前一个 ID。 -->
		<NoWarn>1573;1591</NoWarn>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<TargetFrameworks>netframework4.6.1;net5.0-windows;netcoreapp3.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<UseWPF>true</UseWPF>
		<ImplicitUsings>enable</ImplicitUsings>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>VeloxDev.WPF</Title>
		<Version>9.0.0</Version>
		<Authors>Axvser</Authors>
		<Description>VeloxDev.Core + WPF</Description>
	 <PackageIcon>veloxdev-logo.png</PackageIcon>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\..\Assets\veloxdev-logo.png" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../../Core/VeloxDev.Core/VeloxDev.Core.csproj" Condition="'$(Configuration)' == 'Debug'" />
		<PackageReference Include="VeloxDev.Core" Version="9.0.0" Condition="'$(Configuration)' != 'Debug'" />
	</ItemGroup>

</Project>