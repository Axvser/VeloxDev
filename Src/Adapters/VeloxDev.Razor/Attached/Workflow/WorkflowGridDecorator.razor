@namespace VeloxDev.WorkflowSystem.AttachedBehaviors

<div class="veloxdev-wf-ruler">
    <div class="veloxdev-wf-ruler-corner"
         style="width:@RulerThicknessCss;height:@RulerThicknessCss;background:@RulerBackground;border-right:1px solid @DividerColor;border-bottom:1px solid @DividerColor;"></div>
    <div class="veloxdev-wf-ruler-top"
         style="height:@RulerThicknessCss;background:@RulerBackground;border-bottom:1px solid @DividerColor;">
        <div class="veloxdev-wf-ruler-inner" style="transform:@TopTransform;">
            @foreach (var tick in TopTicks)
            {
                <span class="veloxdev-wf-ruler-label" style="left:@tick.Pos.ToString("0.#")px;">
                    <span class="veloxdev-wf-ruler-tickline" style="height:@TickLengthCss(tick.IsMajor);background:@(tick.IsZero ? AxisColorCss : TickColor);"></span>
                    @if (tick.IsMajor)
                    {
                        <span class="veloxdev-wf-ruler-text" style="color:@LabelColor;">@FormatGridValue(tick.Pos)</span>
                    }
                </span>
            }
        </div>
    </div>
    <div class="veloxdev-wf-ruler-left"
         style="width:@RulerThicknessCss;background:@RulerBackground;border-right:1px solid @DividerColor;">
        <div class="veloxdev-wf-ruler-inner" style="transform:@LeftTransform;">
            @foreach (var tick in LeftTicks)
            {
                <span class="veloxdev-wf-ruler-label" style="top:@tick.Pos.ToString("0.#")px;">
                    <span class="veloxdev-wf-ruler-tickline" style="width:@TickLengthCss(tick.IsMajor);background:@(tick.IsZero ? AxisColorCss : TickColor);"></span>
                    @if (tick.IsMajor)
                    {
                        <span class="veloxdev-wf-ruler-text" style="color:@LabelColor;">@FormatGridValue(tick.Pos)</span>
                    }
                </span>
            }
        </div>
    </div>
</div>
