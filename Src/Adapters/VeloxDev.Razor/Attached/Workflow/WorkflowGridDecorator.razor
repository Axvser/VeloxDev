@namespace VeloxDev.WorkflowSystem.AttachedBehaviors

<div class="veloxdev-wf-ruler">
    <div class="veloxdev-wf-ruler-corner"
         style="width:@RulerThicknessCss;height:@RulerThicknessCss;background:@RulerBackground;border-right:1px solid @DividerColor;border-bottom:1px solid @DividerColor;"></div>
    <div class="veloxdev-wf-ruler-top"
         style="height:@RulerThicknessCss;left:@RulerThicknessCss;background:@RulerBackground;border-bottom:1px solid @DividerColor;transform:@TopTransform;background-image:repeating-linear-gradient(to right, transparent calc(var(--veloxdev-rs,40px) - 1px), var(--veloxdev-rt,#555555) calc(var(--veloxdev-rs,40px) - 1px), var(--veloxdev-rt,#555555) var(--veloxdev-rs,40px)), linear-gradient(to bottom, transparent calc(100% - 6px), var(--veloxdev-rt,#555555) calc(100% - 6px));--veloxdev-rs:@SpacingCss;--veloxdev-rt:@TickColor;"></div>
    <div class="veloxdev-wf-ruler-left"
         style="width:@RulerThicknessCss;top:@RulerThicknessCss;background:@RulerBackground;border-right:1px solid @DividerColor;transform:@LeftTransform;background-image:repeating-linear-gradient(to bottom, transparent calc(var(--veloxdev-rs,40px) - 1px), var(--veloxdev-rt,#555555) calc(var(--veloxdev-rs,40px) - 1px), var(--veloxdev-rt,#555555) var(--veloxdev-rs,40px)), linear-gradient(to right, transparent calc(100% - 6px), var(--veloxdev-rt,#555555) calc(100% - 6px));--veloxdev-rs:@SpacingCss;--veloxdev-rt:@TickColor;"></div>
</div>
