@namespace VeloxDev.WorkflowSystem.AttachedBehaviors

@* The surface cascades itself so a link view nested in ChildContent can forward pointer input into
   the tree's LinkInteraction hub (see ForwardPointerAsync). *@
<CascadingValue TValue="WorkflowSurfaceBehavior" Value="@this" IsFixed="true">
<CascadingValue TValue="SurfaceViewportFeed" Value="_feed">
    @* tabindex + keydown: the surface is the key host, so Delete reaches the interaction hub and
       Escape closes the link menu from a generated project without any host code. Focused on link
       hover (see ForwardPointerAsync) with preventScroll, which is this platform's guard against the
       focus-scroll jump. The contextmenu handler is the menu's one entry point (see OnSurfaceContextMenu). *@
    <div class="veloxdev-wf-surface" tabindex="0" @onkeydown="OnSurfaceKeyDown" @ref="_surfaceRoot"
         @oncontextmenu="OnSurfaceContextMenu" @oncontextmenu:preventDefault="true"
         style="outline:none;">
        <div id="@ScrollViewerId" class="veloxdev-wf-scroll" @ref="_scroller">
            @* Canvas host owns the pixel size (grows via edge expansion) and is set ONLY by JS, so a
               Blazor re-render can never shrink the canvas under the content. The canvas inside is
               solid-background only; the grid and axis are separate JS-positioned layers. *@
            <div class="veloxdev-wf-canvas-host" @ref="_canvasHost">
                <div id="@CanvasId" class="veloxdev-wf-canvas" style="@CanvasBackgroundStyle" @ref="_canvas">
                    <div class="veloxdev-wf-grid" @ref="_grid"></div>
                    <div class="veloxdev-wf-axis veloxdev-wf-axis-x" @ref="_axisX"></div>
                    <div class="veloxdev-wf-axis veloxdev-wf-axis-y" @ref="_axisY"></div>
                    <div class="veloxdev-wf-canvas-content" @ref="_content">
                        @if (ChildContent is not null)
                        {
                            @ChildContent(new SurfaceCanvas(ContentWidth, ContentHeight))
                        }
                    </div>
                </div>
            </div>
        </div>
        @if (GridDecorator is not null && _viewport is not null)
        {
            @GridDecorator(_viewport)
        }
        @if (Minimap is not null && _viewport is not null)
        {
            @Minimap(_viewport)
        }
        @* Link context menu: the chrome lives here (and is styled by veloxdev.workflow.css), while the
           entries are the host's — passed in as LinkMenu. The backdrop is what makes click-away dismiss
           work with no JS, and while it is up it swallows canvas gestures — which is what a menu should
           do. *@
        @if (MenuLink is not null)
        {
            <div class="wf-link-menu-backdrop"
                 @onclick="CloseLinkMenu"
                 @oncontextmenu="CloseLinkMenu"
                 @oncontextmenu:preventDefault="true"
                 @oncontextmenu:stopPropagation="true"></div>
            <div class="wf-link-menu"
                 style="left:@MenuLeftCss;top:@MenuTopCss;"
                 @onclick="OnMenuPanelClick"
                 @oncontextmenu="CloseLinkMenu"
                 @oncontextmenu:preventDefault="true"
                 @oncontextmenu:stopPropagation="true">
                @if (LinkMenu is not null)
                {
                    @LinkMenu(MenuLink)
                }
            </div>
        }
    </div>
</CascadingValue>
</CascadingValue>
