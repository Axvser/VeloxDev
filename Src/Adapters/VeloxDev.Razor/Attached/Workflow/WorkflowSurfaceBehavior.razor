@namespace VeloxDev.WorkflowSystem.AttachedBehaviors

@* The surface cascades itself so a nested link view can forward pointer input into the tree's
   input route. *@
<CascadingValue TValue="WorkflowSurfaceBehavior" Value="@this" IsFixed="true">
<CascadingValue TValue="SurfaceViewportFeed" Value="_feed">
    @* The surface is the key host: Delete reaches the input route and Escape closes the menu with no host
       code. Focus is taken on link hover with preventScroll, and contextmenu is the menu's entry point.
       The wheel is not bound here: the plain wheel needs a synchronous preventDefault, which only JS can do
       (see initWheelScroll), so it lives there and hand routes one wheel once. *@
    <div class="veloxdev-wf-surface" tabindex="0" @ref="_surfaceRoot"
         @onkeydown="OnSurfaceKeyDown" @onkeyup="OnSurfaceKeyUp"
         @onpointermove="OnSurfacePointerMove" @onpointerup="OnSurfacePointerUp"
         @oncontextmenu="OnSurfaceContextMenu" @oncontextmenu:preventDefault="true"
         style="outline:none;">
        <div id="@ScrollViewerId" class="veloxdev-wf-scroll" @ref="_scroller">
            @* Canvas host owns the pixel size and is set ONLY by JS, so a Blazor re-render cannot
               shrink the canvas; the grid and axis are separate JS-positioned layers. *@
            <div class="veloxdev-wf-canvas-host" @ref="_canvasHost">
                <div id="@CanvasId" class="veloxdev-wf-canvas" style="@CanvasBackgroundStyle" @ref="_canvas">
                    <div class="veloxdev-wf-grid" @ref="_grid"></div>
                    <div class="veloxdev-wf-axis veloxdev-wf-axis-x" @ref="_axisX"></div>
                    <div class="veloxdev-wf-axis veloxdev-wf-axis-y" @ref="_axisY"></div>
                    <div class="veloxdev-wf-canvas-content" @ref="_content">
                        @if (ChildContent is not null)
                        {
                            @ChildContent(new SurfaceCanvas(ContentWidth, ContentHeight))
                        }
                    </div>
                </div>
            </div>
        </div>
        @if (GridDecorator is not null && _viewport is not null)
        {
            @GridDecorator(_viewport)
        }
        @if (Minimap is not null && _viewport is not null)
        {
            @Minimap(_viewport)
        }
        @* Link context menu chrome; the entries come from the host as LinkMenu. The backdrop makes
           click-away dismiss work with no JS and swallows canvas gestures while open. *@
        @if (MenuLink is not null)
        {
            <div class="wf-link-menu-backdrop"
                 @onclick="CloseLinkMenu"
                 @oncontextmenu="CloseLinkMenu"
                 @oncontextmenu:preventDefault="true"
                 @oncontextmenu:stopPropagation="true"></div>
            <div class="wf-link-menu"
                 style="left:@MenuLeftCss;top:@MenuTopCss;"
                 @onclick="OnMenuPanelClick"
                 @oncontextmenu="CloseLinkMenu"
                 @oncontextmenu:preventDefault="true"
                 @oncontextmenu:stopPropagation="true">
                @if (LinkMenu is not null)
                {
                    @LinkMenu(MenuLink)
                }
            </div>
        }
    </div>
</CascadingValue>
</CascadingValue>
