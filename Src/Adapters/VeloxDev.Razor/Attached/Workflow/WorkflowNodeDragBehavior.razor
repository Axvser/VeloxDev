@namespace VeloxDev.WorkflowSystem.AttachedBehaviors
@* data-veloxdev-node-id lets applyZoomSurface map a per-node geometry array to this exact
   wrapper element, with no DOM-order coupling. *@
<div class="veloxdev-wf-node-drag" data-veloxdev-node-id="@NodeId" style="@WrapperStyle" @ref="_element">
    @ChildContent
</div>
