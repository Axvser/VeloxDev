@namespace VeloxDev.WorkflowSystem.AttachedBehaviors

@if (IsMinimapVisible && Viewport is not null)
{
    <div class="veloxdev-wf-minimap">
        <div class="veloxdev-wf-minimap-inner"
             style="width:@RectWidthCss;height:@RectHeightCss;top:@RectTopCss;right:@RectRightCss;background:@Background;border:1px solid @BorderColor;visibility:@InnerVisibilityCss;"
             @ref="_element">
            <svg class="veloxdev-wf-minimap-svg" width="@RectWidthCss" height="@RectHeightCss">
                @if (MappedNodes is not null)
                {
                    @foreach (var n in MappedNodes)
                    {
                        <rect x="@n.XCss" y="@n.YCss" width="@n.WCss" height="@n.HCss"
                              fill="@NodeFill" rx="@NodeRadiusCss" />
                    }
                }
                @* Viewport block x/y/width/height are owned entirely by JS (setMinimapViewport),
                   so a re-render cannot overwrite it with stale coordinates. *@
                <rect class="veloxdev-wf-minimap-viewport"
                      fill="@ViewportFill" stroke="@ViewportStroke"
                      stroke-width="@ViewportStrokeWidthCss" rx="2" />
                @if (DrawMinimap is not null)
                {
                    @DrawMinimap(DrawContext)
                }
            </svg>
        </div>
    </div>
}
