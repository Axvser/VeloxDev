<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netframework4.6.1;net5.0-windows;netcoreapp3.0;net8.0-windows</TargetFrameworks>
		<EnableTrimAnalyzer Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</EnableTrimAnalyzer>
		<EnableAotAnalyzer Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</EnableAotAnalyzer>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
		<!-- WFO1000: the adapter's existing public designer properties are not designer-serialized.
		     IL2026/IL2075: the workflow surface reflects over template views and native properties. -->
		<NoWarn>$(NoWarn);WFO1000;IL2026;IL2059;IL2067;IL2075</NoWarn>
		<!-- The .NET Framework 4.6.1 and .NET Core 3.0 reference assemblies carry less nullable metadata;
		     the same code is warning-free on net5/net8. Keep the old TFMs building without hiding warnings there. -->
		<NoWarn Condition="'$(TargetFramework)' == 'netframework4.6.1' Or '$(TargetFramework)' == 'netcoreapp3.0'">$(NoWarn);CS8600;CS8602;CS8603;CS8604</NoWarn>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageId>VeloxDev.WinForms</PackageId>
		<Title>VeloxDev.WinForms</Title>
		<Version>12.0.0</Version>
		<Authors>Axvser</Authors>
		<Description>VeloxDev.Core + WinForms: the workflow surface and the VeloxDev transition engine adapter over the Easel visual runtime.</Description>
		<PackageIcon>veloxdev-logo.png</PackageIcon>
		<PackageTags>winforms;workflow;ui;veloxdev;easel</PackageTags>
		<RepositoryUrl>https://github.com/Axvser/VeloxDev</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\..\Assets\veloxdev-logo.png" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<!-- Easel is a git submodule at the repository root. Debug builds it from source; Release resolves
		     the published package so the adapter's nuspec carries the real Easel dependency. -->
		<ProjectReference Include="..\..\..\Easel\Src\Easel\Easel.csproj" Condition="'$(Configuration)' == 'Debug'" />
		<PackageReference Include="WinForms.Easel" Version="1.1.0" Condition="'$(Configuration)' != 'Debug'" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../../Core/VeloxDev.Core/VeloxDev.Core.csproj" Condition="'$(Configuration)' == 'Debug'" />
		<PackageReference Include="VeloxDev.Core" Version="12.0.0" Condition="'$(Configuration)' != 'Debug'" />
	</ItemGroup>

</Project>
