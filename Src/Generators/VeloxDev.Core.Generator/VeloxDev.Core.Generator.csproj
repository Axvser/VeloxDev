<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IsRoslynComponent>true</IsRoslynComponent>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<TargetFramework>netstandard2.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>VeloxDev.Core.Generator</Title>
		<Version>10.0.0</Version>
		<Authors>Axvser</Authors>
		<PackageIcon>veloxdev-logo.png</PackageIcon>
		<!-- Don't put the Roslyn DLLs into lib -->
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<AnalyzerLanguage>cs</AnalyzerLanguage>
		<!-- NU5128: analyzer-only packages intentionally have no lib folder -->
		<NoWarn>$(NoWarn);NU5128</NoWarn>
	</PropertyGroup>

	<!-- Roslyn dependencies aren't exported; minimum 4.8.0, which is the compiler .NET 8 ships -->
	<ItemGroup>
		<!-- 4.4 起才有 `ISymbol.IsRequired`；编译器合成的 `[RequiredMember]` 在源码符号上看不到，
		     所以检测 required 成员没有别的路。4.8 是 .NET 8 SDK 自带的编译器版本，消费方不会因此抬高门槛。 -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
	</ItemGroup>

	<!-- 诊断 ID 的发布跟踪：`EnforceExtendedAnalyzerRules` 打开的 RS2008 要的就是这两份文件。
	     ID 一旦发布就改不得（改名对下游是源码级破坏），所以把现行的那一批登记下来。 -->
	<ItemGroup>
		<AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
		<AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\..\Assets\veloxdev-logo.png" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

	<!-- Pack into the analyzers folder -->
	<ItemGroup>
		<None Include="bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>

	<!-- .targets ships with the package: detects the Roslyn version when building the consumer project and emits a diagnostic -->
	<ItemGroup>
		<None Include="VeloxDev.Core.Generator.targets" Pack="true" PackagePath="build/VeloxDev.Core.Generator.targets" Visible="false" />
		<None Include="VeloxDev.Core.Generator.targets" Pack="true" PackagePath="buildMultiTargeting/VeloxDev.Core.Generator.targets" Visible="false" />
	</ItemGroup>

</Project>
