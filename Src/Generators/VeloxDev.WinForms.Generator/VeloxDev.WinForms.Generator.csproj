<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IsRoslynComponent>true</IsRoslynComponent>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<TargetFramework>netstandard2.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageId>VeloxDev.WinForms.Generator</PackageId>
		<Title>VeloxDev.WinForms.Generator</Title>
		<Version>12.0.0</Version>
		<Authors>Axvser</Authors>
		<Description>XAML compiler and dependency-property source generators for the VeloxDev.WinForms adapter.</Description>
		<PackageIcon>veloxdev-logo.png</PackageIcon>
		<PackageTags>xaml;winforms;source-generator;dependency-property;veloxdev</PackageTags>
		<RepositoryUrl>https://github.com/Axvser/VeloxDev</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<AnalyzerLanguage>cs</AnalyzerLanguage>
		<!-- NU5128: analyzer-only packages intentionally have no lib folder -->
		<NoWarn>$(NoWarn);NU5128</NoWarn>
	</PropertyGroup>

	<!-- Roslyn 4.8 keeps the generator loadable by the .NET 8 compiler, matching the core generator. -->
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
		<AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\..\Assets\veloxdev-logo.png" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

	<!-- Pack into the analyzers folder; IncludeBuildOutput=false keeps the Roslyn DLLs out of lib. -->
	<ItemGroup>
		<None Include="bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>

</Project>
