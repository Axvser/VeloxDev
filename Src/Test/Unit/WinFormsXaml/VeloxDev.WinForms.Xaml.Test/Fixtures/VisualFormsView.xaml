<StackPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VeloxDev.WinForms.Xaml.Test.Fixtures"
    x:Class="VeloxDev.WinForms.Xaml.Test.Fixtures.VisualFormsView"
    Orientation="Vertical"
    Spacing="2"
    Background="{StaticResource RootBackground}">

  <StackPanel.Resources>
    <x:Color x:Key="RootBackground">#FF112233</x:Color>
    <Style TargetType="TextBlock">
      <Style.Setters>
        <Setter Property="Width" Value="120" />
      </Style.Setters>
    </Style>
    <Style x:Key="CaptionStyle" TargetType="TextBlock">
      <Style.Setters>
        <Setter Property="Foreground" Value="#FF00FF00" />
      </Style.Setters>
    </Style>
    <x:Color x:Key="ChildBackground">#FF334455</x:Color>
    <ControlTemplate x:Key="CardChrome" TargetType="local:VisualFormsView">
      <Border x:Name="PART_Frame" Background="#FF202020">
        <ContentPresenter />
      </Border>
    </ControlTemplate>
    <DataTemplate x:Key="RowTemplate">
      <TextBlock Text="{Binding}" Width="60" />
    </DataTemplate>
    <local:Selector x:Key="RowSelector" Template="{StaticResource RowTemplate}" />
  </StackPanel.Resources>

  <TextBlock x:Name="caption" Text="caption" Style="{StaticResource CaptionStyle}" Background="{StaticResource ChildBackground}" />

  <Grid x:Name="grid">
    <Border x:Name="topCell" Grid.Row="1" Width="10" Height="10" />
  </Grid>

  <Canvas x:Name="surface" Width="40" Height="40">
    <Border x:Name="placed" Canvas.Left="7" Canvas.Top="9" Width="4" Height="4" />
  </Canvas>

  <Button x:Name="action" Text="Go" Click="OnActionClick" />

  <ItemsControl x:Name="list">
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <TextBlock Text="{Binding}" Width="50" />
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>

  <TextBlock x:Name="implicitCaption" Text="implicit" />

</StackPanel>
