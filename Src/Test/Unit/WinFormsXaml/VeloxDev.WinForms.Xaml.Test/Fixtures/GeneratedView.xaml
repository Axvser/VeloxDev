<local:GeneratedView
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VeloxDev.WinForms.Xaml.Test.Fixtures"
    xmlns:native="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
    x:Class="VeloxDev.WinForms.Xaml.Test.Fixtures.GeneratedView"
    Size="420, 320">

  <local:GeneratedView.Resources>
    <ResourceDictionary>
      <local:GeneratedModel x:Key="ModelResource" Title="resource title" />
      <x:Color x:Key="Accent">#FF5B8CFF</x:Color>
      <x:String x:Key="Caption">caption from a static resource</x:String>
      <x:String x:Key="ActionTag">style-resource</x:String>
      <DataTemplate x:Key="ItemTemplate">
        <local:GeneratedCard Title="{Binding Title}" AccentColor="{StaticResource Accent}" Size="160, 60" />
      </DataTemplate>
      <Style x:Key="CardStyle" TargetType="local:GeneratedCard">
        <Style.Setters>
          <Setter Property="StyleValue" Value="2" />
        </Style.Setters>
        <Style.Triggers>
          <Trigger Property="IsHot" Value="True">
            <Trigger.Setters>
              <Setter Property="StyleValue" Value="4" />
            </Trigger.Setters>
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ChildCardStyle" TargetType="local:GeneratedCard" BasedOn="{StaticResource CardStyle}">
        <Style.Setters>
          <Setter Property="StyleValue" Value="3" />
        </Style.Setters>
        <Style.Triggers>
          <Trigger Property="IsHot" Value="True">
            <Trigger.Setters>
              <Setter Property="StyleValue" Value="5" />
            </Trigger.Setters>
          </Trigger>
        </Style.Triggers>
      </Style>
      <ControlTemplate x:Key="CardTemplate">
        <local:CardChrome Label="{Binding Title}" />
      </ControlTemplate>
      <Style x:Key="TemplatedCardStyle" TargetType="local:GeneratedCard">
        <Style.Setters>
          <Setter Property="StyleValue" Value="31" />
        </Style.Setters>
        <Style.Template>
          <StaticResource Key="CardTemplate" />
        </Style.Template>
      </Style>
      <Style x:Key="NativeButtonStyle" TargetType="native:Button">
        <Style.Setters>
          <Setter Property="Text" Value="Styled probe" />
          <Setter Property="BackColor" Value="#FF203040" />
        </Style.Setters>
      </Style>
      <Style TargetType="local:GeneratedCard">
        <Style.Setters>
          <Setter Property="StyleValue" Value="11" />
        </Style.Setters>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Title}" Value="generated title">
            <DataTrigger.Setters>
              <Setter Property="Note" Value="data" />
            </DataTrigger.Setters>
          </DataTrigger>
          <DataTrigger Binding="{Binding Column}" Value="5">
            <DataTrigger.Setters>
              <Setter Property="StyleValue" Value="15" />
            </DataTrigger.Setters>
          </DataTrigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsHot" Value="True" />
              <Condition Property="IsPinned" Value="True" />
            </MultiTrigger.Conditions>
            <MultiTrigger.Setters>
              <Setter Property="Note" Value="multi" />
            </MultiTrigger.Setters>
          </MultiTrigger>
          <Trigger Property="IsPinned" Value="True">
            <Trigger.EnterAction>
              <local:ConfigurableRecordingAction Tag="{StaticResource ActionTag}" Amount="5" />
            </Trigger.EnterAction>
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </local:GeneratedView.Resources>

  <native:Label x:Name="captionLabel"
         Text="{Binding Caption}"
         local:WorkflowPanel.Column="{Binding Column}"
         local:WorkflowPanel.Label="{Binding Title, Mode=OneTime}"
         Location="12, 12"
         Size="240, 24" />

  <local:GeneratedCard x:Name="card"
                       Title="{Binding Title}"
                       AccentColor="{StaticResource Accent}"
                       Style="{StaticResource ChildCardStyle}"
                       Location="12, 48"
                       Size="240, 120">
    <local:GeneratedCard.Triggers>
      <Trigger Property="IsHot" Value="True">
        <Trigger.Setters>
          <Setter Property="BorderWidth" Value="4" />
        </Trigger.Setters>
        <Trigger.EnterAction>
          <TransitionAction Property="Glow" To="1" Duration="0:0:0.1" />
        </Trigger.EnterAction>
        <Trigger.ExitAction>
          <TransitionAction Property="Glow" To="0" Duration="0:0:0.1" />
        </Trigger.ExitAction>
      </Trigger>
      <DataTrigger Binding="{Binding Title}" Value="generated title">
        <DataTrigger.Setters>
          <Setter Property="Note" Value="control-data" />
        </DataTrigger.Setters>
      </DataTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsHot" Value="True" />
          <Condition Property="IsPinned" Value="True" />
        </MultiTrigger.Conditions>
        <MultiTrigger.Setters>
          <Setter Property="Note" Value="control-multi" />
        </MultiTrigger.Setters>
      </MultiTrigger>
      <Trigger Property="IsPinned" Value="True">
        <Trigger.EnterAction>
          <local:ConfigurableRecordingAction Tag="entered" Amount="3" />
        </Trigger.EnterAction>
        <Trigger.ExitAction>
          <local:ConfigurableRecordingAction Tag="exited" Amount="4" />
        </Trigger.ExitAction>
      </Trigger>
    </local:GeneratedCard.Triggers>
  </local:GeneratedCard>

  <native:Button x:Name="probeButton"
          Text="Probe"
          Style="{StaticResource NativeButtonStyle}"
          local:WorkflowPanel.Column="2"
          local:WorkflowPanel.Label="{StaticResource Caption}"
          local:GeneratedAttachments.Note="xaml note"
          Location="12, 184"
          Size="120, 32"
          Click="OnProbeClick" />

</local:GeneratedView>
