<local:CommandView
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VeloxDev.WinForms.Xaml.Test.Fixtures"
    x:Class="VeloxDev.WinForms.Xaml.Test.Fixtures.CommandView"
    Size="320, 120">

  <Button x:Name="commandButton"
            Content="Save"
            Command="{Binding SaveCommand}"
            Size="100, 32" />

  <Button x:Name="keyButton"
            Content="Key"
            Size="100, 32">
    <Button.InputBindings>
      <KeyBinding Key="F5" Command="{Binding SaveCommand}" />
    </Button.InputBindings>
  </Button>

</local:CommandView>
