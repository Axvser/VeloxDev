<local:ChromeView
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VeloxDev.WinForms.Xaml.Test.Fixtures"
    x:Class="VeloxDev.WinForms.Xaml.Test.Fixtures.ChromeView"
    Size="480, 360">

  <local:ChromeView.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="CardTemplate">
        <Border Size="40, 20" />
      </DataTemplate>
    </ResourceDictionary>
  </local:ChromeView.Resources>

  <Decorator x:Name="decorator" Size="80, 40">
    <Border Size="20, 20" />
  </Decorator>

  <AdornerDecorator x:Name="adornerHost" Size="80, 40">
    <Border Size="20, 20" />
  </AdornerDecorator>

  <HeaderedContentControl x:Name="headered" Header="Head" Size="160, 80">
    <TextBlock Text="body" />
  </HeaderedContentControl>

  <ContentPresenter x:Name="presenter"
                      Content="{Binding Caption}"
                      ContentTemplate="{StaticResource CardTemplate}"
                      Size="80, 40" />

  <ToolBar x:Name="toolbar" Size="200, 32">
    <ToolBar.Items>
      <Button Content="A" Size="40, 24" />
    </ToolBar.Items>
  </ToolBar>

  <StatusBar x:Name="status" Size="200, 24">
    <StatusBar.Items>
      <StatusBarItem Content="Ready" />
    </StatusBar.Items>
  </StatusBar>

  <VirtualizingStackPanel x:Name="virtualizing"
                            ItemsSource="{Binding Items}"
                            ItemHeight="20"
                            Size="200, 100" />

</local:ChromeView>
