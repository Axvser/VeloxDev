<local:BatchOneView
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VeloxDev.WinForms.Xaml.Test.Fixtures"
    x:Class="VeloxDev.WinForms.Xaml.Test.Fixtures.BatchOneView"
    Size="640, 480">

  <UniformGrid x:Name="grid"
                 Rows="2"
                 Columns="2"
                 Size="200, 100">
    <Border Size="20, 20" />
    <Border Size="20, 20" />
    <Border Size="20, 20" />
    <Border Size="20, 20" />
  </UniformGrid>

  <GroupBox x:Name="group" Header="Group" Size="200, 80">
    <TextBlock Text="group content" />
  </GroupBox>

  <Expander x:Name="expander" Header="More" IsExpanded="True" Size="200, 80">
    <TextBlock Text="expanded content" />
  </Expander>

  <TabControl x:Name="tabs" Size="240, 120">
    <TabItem Header="One">
      <TextBlock Text="first" />
    </TabItem>
    <TabItem Header="Two">
      <TextBlock Text="second" />
    </TabItem>
  </TabControl>

  <TreeView x:Name="tree"
              ItemsSource="{Binding Items}"
              DisplayMemberPath="Name"
              Size="200, 100" />

  <ListView x:Name="list"
              ItemsSource="{Binding Items}"
              Size="240, 100">
    <ListView.View>
      <GridView>
        <GridView.Columns>
          <GridViewColumn Header="Name" DisplayMemberBinding="Name" Width="120" />
        </GridView.Columns>
      </GridView>
    </ListView.View>
  </ListView>

  <DataGrid x:Name="dataGrid"
              ItemsSource="{Binding Items}"
              AutoGenerateColumns="False"
              Size="240, 100">
    <DataGrid.Columns>
      <DataGridColumn Header="Name" Binding="Name" Width="120" />
    </DataGrid.Columns>
  </DataGrid>

  <Calendar x:Name="calendar"
              SelectedDate="{Binding Date, Mode=TwoWay}"
              Size="200, 160" />

  <DatePicker x:Name="datePicker"
                SelectedDate="{Binding Date, Mode=TwoWay}"
                Size="200, 32" />

  <Polygon x:Name="polygon"
             Points="0,0 20,0 10,20"
             Size="20, 20" />

</local:BatchOneView>
