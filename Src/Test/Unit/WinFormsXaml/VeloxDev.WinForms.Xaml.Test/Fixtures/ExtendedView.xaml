<local:ExtendedView
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VeloxDev.WinForms.Xaml.Test.Fixtures"
    xmlns:native="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
    x:Class="VeloxDev.WinForms.Xaml.Test.Fixtures.ExtendedView"
    Size="480, 360">

  <local:ExtendedView.Resources>
    <ResourceDictionary>
      <local:BracketConverter x:Key="Bracket" />
      <DataTemplate x:Key="ItemTemplate">
        <TextBlock Text="{Binding Name}" Size="120, 20" />
      </DataTemplate>
      <Style x:Key="BoundTitleStyle" TargetType="local:ExtendedCard">
        <Style.Setters>
          <Setter Property="Title" Value="{Binding Caption}" />
        </Style.Setters>
      </Style>
      <ControlTemplate x:Key="CardTemplate" TargetType="local:ExtendedCard">
        <Border Padding="0">
          <TextBlock x:Name="PART_Text" Text="{TemplateBinding Title}" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHot" Value="True">
            <Trigger.Setters>
              <Setter TargetName="PART_Text"
                        TargetType="TextBlock"
                        Property="Text"
                        Value="hot" />
            </Trigger.Setters>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="TemplatedCardStyle" TargetType="local:ExtendedCard">
        <Style.Setters>
          <Setter Property="StyleValue" Value="9" />
        </Style.Setters>
        <Style.Template>
          <StaticResource Key="CardTemplate" />
        </Style.Template>
      </Style>
    </ResourceDictionary>
  </local:ExtendedView.Resources>

  <native:Label x:Name="sourceLabel" Text="source text" Size="120, 20" />
  <TextBlock x:Name="staticText" Text="{x:Static local:ExtendedStatics.Value}" Size="120, 20" />
  <TextBlock x:Name="elementText" Text="{Binding ElementName=sourceLabel, Path=Text}" Size="120, 20" />
  <TextBlock x:Name="formattedText" Text="{Binding Amount, StringFormat=N2}" Size="120, 20" />

  <local:ExtendedCard x:Name="card"
                      Style="{StaticResource BoundTitleStyle}"
                      Size="160, 60" />
  <local:ExtendedCard x:Name="templateCard"
                      Style="{StaticResource TemplatedCardStyle}"
                      Size="160, 60" />

  <Border x:Name="lowLayer" Panel.ZIndex="0" Size="40, 40" />
  <Border x:Name="highLayer" Panel.ZIndex="5" Size="40, 40" />

  <Button x:Name="menuButton"
           Content="Menu"
           ToolTip="tip text"
           Size="80, 24">
    <Button.ContextMenu>
      <ContextMenu>
        <MenuItem Header="Open" Click="OnMenuOpen" />
      </ContextMenu>
    </Button.ContextMenu>
  </Button>

  <Menu x:Name="menu" Size="80, 24">
    <MenuItem Header="File" />
  </Menu>

  <ItemsControl x:Name="items"
                  ItemsSource="{Binding Items}"
                  ItemTemplate="{StaticResource ItemTemplate}"
                  Size="160, 80">
    <ItemsControl.ItemsPanel>
      <StackPanel />
    </ItemsControl.ItemsPanel>
  </ItemsControl>

  <Popup x:Name="popup" IsOpen="False">
    <Popup.Child>
      <Border x:Name="popupChild" Size="40, 40" />
    </Popup.Child>
  </Popup>

</local:ExtendedView>
