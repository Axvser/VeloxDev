<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>VeloxDev.Adapters.Benchmarks.WinUI</RootNamespace>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<!-- 未打包 + 自带 Windows App SDK 运行时：产物目录直接双击可跑，不依赖已安装的运行时包。 -->
		<UseWinUI>true</UseWinUI>
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
		<!-- 有头基准宿主：不打包、不被 dotnet test 发现。 -->
		<IsPackable>false</IsPackable>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<!-- 适配器编译期仍是 1.6；1.6 的运行时装不进 .NET 10 进程（XAML 启动即 fail-fast），
		     所以宿主用与 Examples/Workflow/WinUI 同一版 1.8。 -->
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6584" />
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.251003001" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\Core\VeloxDev.Core\VeloxDev.Core.csproj" />
		<ProjectReference Include="..\..\..\Adapters\VeloxDev.WinUI\VeloxDev.WinUI.csproj" />
		<ProjectReference Include="..\VeloxDev.Adapters.Benchmarks.Headed\VeloxDev.Adapters.Benchmarks.Headed.csproj" />
	</ItemGroup>

  <ItemGroup>
    <Compile Include="..\BenchmarkArtifacts.cs" Link="BenchmarkArtifacts.cs" />
  </ItemGroup>
</Project>
